  ]}},
  {"column": {"modifiers": ["fillMaxSize", {"background": "#FF101828"}, {"padding": 18}], "children": [
   {"flow": {"children": [
    {"box": {"verticalAlignment": "center", "modifiers": [
      {"includeMacro": {"pattern": "ButtonStyle", "arguments": ["#FF4DA3FF"]}}, "ripple",
      {"semantics": {"contentDescription": "Save", "role": "button"}}],
     "children": [{"text": {"value": "Save", "fontSize": 15, "color": "#FF0B1A2E"}}]}},
    {"box": {"modifiers": [{"size": [10, 54]}]}},
    {"box": {"verticalAlignment": "center", "modifiers": [
      {"includeMacro": {"pattern": "ButtonStyle", "arguments": ["#FF7C4DFF"]}}, "ripple",
      {"semantics": {"contentDescription": "Share", "role": "button"}}],
     "children": [{"text": {"value": "Share", "fontSize": 15, "color": "#FFFFFFFF"}}]}},
    {"box": {"modifiers": [{"size": [10, 54]}]}},
    {"box": {"verticalAlignment": "center", "modifiers": [
      {"includeMacro": {"pattern": "ButtonStyle", "arguments": ["#FFEF5350"]}}, "ripple",
      {"semantics": {"contentDescription": "Delete", "role": "button"}}],
     "children": [{"text": {"value": "Delete", "fontSize": 15, "color": "#FFFFFFFF"}}]}}
   ]}},
   {"box": {"modifiers": [{"height": 22}]}},
   {"row": {"children": [
    {"box": {"modifiers": [{"includeMacro": {"pattern": "TagStyle", "arguments": []}}],
     "children": [{"text": {"value": "draft", "fontSize": 12, "color": "#FFB0BEC5"}}]}},
    {"box": {"modifiers": [{"width": 8}]}},
    {"box": {"modifiers": [{"includeMacro": {"pattern": "TagStyle", "arguments": []}}],
     "children": [{"text": {"value": "3 attachments", "fontSize": 12, "color": "#FFB0BEC5"}}]}}
   ]}}
  ]}}
 ]
}
