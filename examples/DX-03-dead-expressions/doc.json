{
 "header": {
  "apiLevel": 7,
  "width": 300,
  "height": 200,
  "profiles": 513,
  "contentDescription": "A static card with three unused expressions"
 },
 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize"
  ],
  "commands": [
   {
    "variable": {
     "name": "inset",
     "value": "density() * 4",
     "commit": true
    }
   },
   {
    "variable": {
     "name": "padded",
     "value": "@inset + 8",
     "commit": true
    }
   },
   {
    "variable": {
     "name": "third",
     "value": "@padded / 3",
     "commit": true
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FF101828"
      }
     ]
    }
   },
   {
    "drawRect": {
     "left": 0,
     "top": 0,
     "right": "componentWidth()",
     "bottom": "componentHeight()"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FF26A69A"
      }
     ]
    }
   },
   {
    "drawRoundRect": {
     "left": 30,
     "top": "componentHeight() / 2 - 50",
     "right": "componentWidth() - 30",
     "bottom": "componentHeight() / 2 + 50",
     "rx": 20,
     "ry": 20
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FFFFFFFF"
      },
      {
       "textSize": 20
      }
     ]
    }
   },
   {
    "drawTextAnchored": {
     "text": "Static card",
     "x": "componentWidth() / 2",
     "y": "componentHeight() / 2",
     "panX": 0,
     "panY": 0
    }
   }
  ]
 }
}
