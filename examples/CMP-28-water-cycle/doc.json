 "root": {
  "StepExplainer": {
   "title": "The water cycle",
   "step": "@stage",
   "shown": "@stageNow",
   "controls": "play",
   "progress": "dots",
   "loop": true,
   "playing": "@play",
   "interval": 4,
   "captionLines": 3,
   "visualLabel": "A coast with sea, land and sun; the current stage of the water cycle is drawn over it",
   "steps": [
    {
     "title": "Evaporation",
     "text": "The sun warms the sea, and water rises into the air as invisible vapour.",
     "short": "Sun lifts vapour from the sea."
    },
    {
     "title": "Condensation",
     "text": "High up the air is cold, so the vapour turns into tiny droplets: a cloud.",
     "short": "Cold air makes vapour a cloud."
    },
    {
     "title": "Precipitation",
     "text": "The wind pushes the cloud over the hills, where the droplets fall as rain or snow.",
     "short": "Droplets fall as rain or snow."
    },
    {
     "title": "Collection",
     "text": "Rivers carry the water back to the sea, and the cycle starts again.",
     "short": "Rivers carry it back to the sea."
    }
   ],
   "slots": {
    "visual": [
     {
      "WaterCycle": {
       "now": "@stageNow"
      }
     }
    ]
   }
  }
 }
