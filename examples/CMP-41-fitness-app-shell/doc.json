{
 "header": {
  "apiLevel": 7, "width": 360, "height": 640, "profiles": 513,
  "contentDescription": "Stride, a fitness app with four destinations, Today, Workouts, Progress and Profile, in a bottom bar on a phone, a rail when wider and a drawer when wide; Today shows the activity rings and the step and water goals"
 },
 "resources": {
  "variables": { "tab": 0 },
  "floatArrays": { "weekMin": [32, 45, 0, 28, 60, 15, 34] }
 },
 "root": {
  "NavShell": {
   "title": "Stride",
   "selected": "@tab",
   "destinations": [
    { "icon": "today", "label": "Today", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 16 }], "children": [
     { "box": { "modifiers": ["fillMaxWidth", { "height": 180 }], "children": [
      { "ActivityRings": { "label": "Today", "rings": [
       { "label": "Move", "value": 420, "target": 600, "unit": "kcal" },
       { "label": "Exercise", "value": 24, "target": 30, "unit": "min" },
       { "label": "Stand", "value": 7, "target": 12, "unit": "h" }
      ] } }
     ] } },
     { "GoalBar": { "value": 8432, "target": 10000, "label": "Steps", "unit": "steps" } },
     { "GoalBar": { "value": 1500, "target": 2000, "label": "Water", "unit": "ml" } }
    ] } } },
    { "icon": "fitness_center", "label": "Workouts", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 12 }], "children": [
     { "column": { "modifiers": ["fillMaxWidth"], "children": [
      { "ListItem": { "title": "Morning run", "subtitle": "5.2 km, 28 min, today", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "directions_run", "color": "@colors.primary" } }] } } },
      { "ListItem": { "title": "Upper body strength", "subtitle": "45 min, yesterday", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "fitness_center", "color": "@colors.primary" } }] } } },
      { "ListItem": { "title": "Evening yoga", "subtitle": "30 min, Monday", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "self_improvement", "color": "@colors.primary" } }] } } }
     ] } },
     { "Button": { "label": "Start a workout", "fill": true, "onClick": { "type": "hostNamedAction", "name": "startWorkout" } } }
    ] } } },
    { "icon": "monitoring", "label": "Progress", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 16 }], "children": [
     { "flow": { "modifiers": ["fillMaxWidth", { "spacedBy": 8 }], "children": [
      { "box": { "modifiers": [{ "width": 156 }], "children": [{ "StatTile": { "label": "Distance", "value": 23.4, "decimals": 1, "unit": "km", "delta": 12 } }] } },
      { "box": { "modifiers": [{ "width": 156 }], "children": [{ "StatTile": { "label": "Resting heart", "value": 58, "unit": "bpm", "delta": -2, "invert": true } }] } }
     ] } },
     { "text": { "value": "Active minutes this week", "fontSize": 13, "color": "@colors.muted" } },
     { "BarChart": { "values": "@weekMin", "labels": ["M", "T", "W", "T", "F", "S", "S"], "width": 300, "height": 140, "label": "Active minutes per day this week" } }
    ] } } },
    { "icon": "person", "label": "Profile", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 12 }], "children": [
     { "row": { "verticalAlignment": "center", "modifiers": [{ "spacedBy": 16 }], "children": [
      { "Avatar": { "initials": "MR", "size": 56 } },
      { "column": { "children": [
       { "text": { "value": "Maya Rossi", "fontSize": 18, "fontWeight": 600, "color": "@colors.onSurface" } },
       { "text": { "value": "Premium member", "fontSize": 13, "color": "@colors.muted" } }
      ] } }
     ] } },
     { "KeyValueRow": { "key": "Daily step goal", "value": "10,000" } },
     { "KeyValueRow": { "key": "Move goal", "value": "600 kcal" } },
     { "KeyValueRow": { "key": "Units", "value": "Metric" } }
    ] } } }
   ]
  }
 }
}
