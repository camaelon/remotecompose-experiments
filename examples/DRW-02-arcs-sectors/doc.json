{
 "header": {"apiLevel": 7, "width": 360, "height": 200, "profiles": 513,
  "contentDescription": "A 270 degree progress ring at 70% and a three-slice pie"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 200)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 200) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 100}},
   {"paint": {"color": "#FF2A3342", "style": "stroke", "strokeWidth": 14, "strokeCap": "round"}},
   {"drawArc": {"left": 30, "top": 30, "right": 170, "bottom": 170, "startAngle": 135, "sweepAngle": 270}},
   {"paint": {"color": "#FF4DA3FF"}},
   {"drawArc": {"left": 30, "top": 30, "right": 170, "bottom": 170, "startAngle": 135, "sweepAngle": 189}},
   {"paint": {"color": "#FFFFFFFF", "style": "fill", "textSize": 26}},
   {"drawTextAnchored": {"text": "70%", "x": 100, "y": 100, "panX": 0, "panY": 0}},
   {"paint": {"color": "#FFEF5350"}},
   {"drawSector": {"left": 200, "top": 30, "right": 340, "bottom": 170, "startAngle": -90, "sweepAngle": 144}},
   {"paint": {"color": "#FFFFCA28"}},
   {"drawSector": {"left": 200, "top": 30, "right": 340, "bottom": 170, "startAngle": 54, "sweepAngle": 108}},
   {"paint": {"color": "#FF66BB6A"}},
   {"drawSector": {"left": 200, "top": 30, "right": 340, "bottom": 170, "startAngle": 162, "sweepAngle": 108}}
  ]
 }
}
