 "name": "text-formatting",
 "version": 2,
 "title": "Number formatting flags",
 "summary": "Eight numbers turned into text by textFromFloat flags and textMerge: thousands grouping, period-comma and underscore separators, negative parentheses, zero padding, mm:ss from seconds, a percent and whole-digit clipping.",
 "prompt": "A reference card of number formats: $1,234.50, 1.234,50 €, 9_876_543, (42.50), 007, 07:05 from 425 seconds, 65 % and what happens when the whole digits are too few.",
 "level": 2,
 "family": "EXP",
