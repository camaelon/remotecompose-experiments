{
 "header": {"apiLevel": 7, "width": 360, "height": 180, "profiles": 513,
  "contentDescription": "A contact card built from raw strings: capitalised name, initial, a role pill sized to its text and a trimmed message preview"},
 "root": [
  {"variable": {"name": "name", "vtype": "string", "value": "ada lovelace", "export": true}},
  {"variable": {"name": "role", "vtype": "string", "value": "analyst", "export": true}},
  {"variable": {"name": "msg", "vtype": "string", "value": "The engine might compose elaborate pieces of music", "export": true}},
  {"type": "canvas",
   "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
   "commands": [
    {"textTransform": {"text": "@name", "start": 0, "len": -1, "operation": 4, "varName": "title"}},
    {"textTransform": {"text": "@name", "start": 0, "len": 1, "operation": 2, "varName": "initial"}},
    {"textTransform": {"text": "@role", "start": 0, "len": -1, "operation": 2, "varName": "roleUp"}},
    {"textSubtext": {"text": "@msg", "start": 0, "len": 30, "varName": "preview"}},
    {"textLength": {"text": "@msg", "name": "chars"}},
    {"variable": {"name": "s", "value": "min(1, componentWidth() / 360)"}},
    {"translate": {"dx": 0, "dy": "(componentHeight() - 180 * @s) / 2"}},
    {"scale": {"sx": "@s", "sy": "@s"}},
    {"variable": {"name": "w", "value": "componentWidth() / @s"}},
    {"paint": {"ops": [{"color": "#FF1E2A3A"}]}},
    {"drawRoundRect": {"left": 12, "top": 12, "right": "@w - 12", "bottom": 168, "rx": 14, "ry": 14}},
    {"paint": {"ops": [{"color": "#FF7C4DFF"}]}},
    {"drawCircle": {"cx": 60, "cy": 62, "radius": 30}},
    {"paint": {"ops": [{"color": "#FFFFFFFF"}, {"textSize": 28}]}},
    {"drawTextAnchored": {"text": "@initial", "x": 60, "y": 62, "panX": 0, "panY": 0}},
    {"paint": {"ops": [{"textSize": 21}]}},
    {"drawTextAnchored": {"text": "@title", "x": 106, "y": 48, "panX": -1, "panY": 0}},
    {"paint": {"ops": [{"textSize": 11}]}},
    {"textMeasure": {"text": "@roleUp", "mode": 0, "name": "roleW"}},
    {"paint": {"ops": [{"color": "#FF26A69A"}]}},
    {"drawRoundRect": {"left": 106, "top": 66, "right": "122 + @roleW", "bottom": 86, "rx": 10, "ry": 10}},
    {"paint": {"ops": [{"color": "#FF101828"}]}},
    {"drawTextAnchored": {"text": "@roleUp", "x": 114, "y": 76, "panX": -1, "panY": 0}},
    {"paint": {"ops": [{"color": "#FF2A3A4E"}]}},
    {"drawRect": {"left": 28, "top": 108, "right": "@w - 28", "bottom": 109}},
    {"paint": {"ops": [{"color": "#FFB0BEC5"}, {"textSize": 14}]}},
    {"drawTextAnchored": {"text": {"type": "textMerge", "id1": "@preview", "id2": "…"}, "x": 28, "y": 130, "panX": -1, "panY": 0}},
    {"paint": {"ops": [{"color": "#FF5C6B7E"}, {"textSize": 11}]}},
    {"drawTextAnchored": {"text": {"type": "textMerge", "id1": {"type": "textFromFloat", "value": "@chars", "whole": 3, "decimal": 0, "flags": 5}, "id2": " characters"},
      "x": 28, "y": 152, "panX": -1, "panY": 0}}
   ]}
 ]
}
