{
 "header": {"apiLevel": 7, "width": 360, "height": 200, "profiles": 513,
  "contentDescription": "A sentence riding along a sine wave"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"pathExpression": {"id": "wave", "expressionX": "20 + a[0] * (componentWidth() - 40) / 6.2832", "expressionY": "componentHeight() * (0.5 - 0.225 * sin(a[0]))",
     "start": 0, "end": 6.2832, "count": 96}},
   {"paint": {"color": "#554DA3FF", "style": "stroke", "strokeWidth": 2}},
   {"drawPath": {"path": "wave"}},
   {"paint": {"color": "#FFFFFFFF", "style": "fill", "textSize": 20}},
   {"drawTextOnPath": {"text": "Riding the wave, letter by letter", "path": "wave", "hOffset": 12, "vOffset": -6}}
  ]
 }
}
