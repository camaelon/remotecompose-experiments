   "d11": "ifElse(@d10, step(@h10, @l8), step(@at, 10.5))",
   "l12": "ifElse(@h11, min(@h11, @l9), step(@at, 11.5))",
   "h12": "ifElse(@l9, max(@h11, @l9), step(@at, 11.5))",
   "d12": "ifElse(@d11, step(@h11, @l9), step(@at, 11.5))",
   "l13": "ifElse(@l10, min(@l10, @l11), step(@at, 12.5))",
   "h13": "ifElse(@l11, max(@l10, @l11), step(@at, 12.5))",
   "d13": "ifElse(@d12, step(@l10, @l11), step(@at, 12.5))",
   "l14": "ifElse(@h13, min(@h13, @l12), step(@at, 13.5))",
   "h14": "ifElse(@l12, max(@h13, @l12), step(@at, 13.5))",
   "d14": "ifElse(@d13, step(@h13, @l12), step(@at, 13.5))",
   "l15": "ifElse(@l13, min(@l13, @l14), step(@at, 14.5))",
   "h15": "ifElse(@l14, max(@l13, @l14), step(@at, 14.5))",
   "d15": "ifElse(@d14, step(@l13, @l14), step(@at, 14.5))",
   "a0": "@l15",
   "a1": "@h15",
   "a2": "@h14",
   "a3": "@h12",
   "a4": "@h9",
   "a5": "@h5",
   "swapped": "@d15",
   "late1": "step(@s0, @s1)",
   "late2": "step(@s0, @s2) + step(@s1, @s2)",
   "late3": "step(@s0, @s3) + step(@s1, @s3) + step(@s2, @s3)",
   "late4": "step(@s0, @s4) + step(@s1, @s4) + step(@s2, @s4) + step(@s3, @s4)",
   "late5": "step(@s0, @s5) + step(@s1, @s5) + step(@s2, @s5) + step(@s3, @s5) + step(@s4, @s5)",
   "passes": "min(5, 1 + max(max(max(max(@late1, @late2), @late3), @late4), @late5))",
   "total": "@passes * 6 - @passes * (@passes + 1) / 2",
   "cmp": "clamp(0, 14, @at - 1)",
   "cell": "arrayGet(@cellOf, @cmp)",
   "pass": "arrayGet(@passOf, @cmp)",
   "inPass": "@cell + 1",
   "ended": "step(@at, @total + 0.5)",
   "comparing": "(1 - @ended) * min(1, @at)",
   "pairL": "ifElse(ifElse(ifElse(ifElse(@a4, @a3, step(3.5, @cell)), @a2, step(2.5, @cell)), @a1, step(1.5, @cell)), @a0, step(0.5, @cell))",
   "pairR": "ifElse(ifElse(ifElse(ifElse(@a5, @a4, step(3.5, @cell)), @a3, step(2.5, @cell)), @a2, step(1.5, @cell)), @a1, step(0.5, @cell))",
   "mark": "ifElse(-1, @cell, @comparing)",
   "settled": "ifElse(ifElse(6, 7 - @pass, min(1, @at)), 0, @ended)",
   "which": "ifElse(ifElse(ifElse(2 - @swapped, 0, step(0.5, @at)), 3 + step(@total, 14.5), @ended), 0, step(0.5, @at))"
  }
 },
