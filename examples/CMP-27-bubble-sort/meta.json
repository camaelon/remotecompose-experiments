 "id": "CMP-27",
 "name": "bubble-sort",
 "version": 1,
 "title": "Bubble sort, computed steps that end early",
 "prompt": "Explain how bubble sort works on six numbers, step by step: pick a list, compare neighbours, and stop as soon as a pass makes no swap.",
 "level": 3,
 "family": "CMP",
 "components": [
  "Button",
