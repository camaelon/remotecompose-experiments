   "W": "windowWidth()",
   "H": "windowHeight()",
   "pad": "ifElse(ifElse(8, 12, step(min(@W, @H), 199)), 16, step(min(@W, @H), 300))",
   "iw": "@W - 2 * @pad",
   "ih": "@H - 2 * @pad",
   "solo": "(1 - step(max(@W, @H), min(@W, @H) * 1.25)) * (1 - step(min(@W, @H), 240))",
   "hasP": "1 - @solo",
   "wide": "step(@W, @H * 1.25) * @hasP",
   "hasT": "@hasP * step(@H, 300)",
   "tH": "@hasT * 36",
   "bodyH": "@ih - @tH",
   "g": "ifElse(16, 10, step(320, @H))",
   "rw": "ifElse(@iw, (@iw - @g) * ifElse(0.5, 0.42, step(240, @H)), @wide)",
   "pH": "@hasP * ifElse(max(130, @bodyH * 0.42), @bodyH, @wide)",
   "pw": "ifElse(@iw, @iw - @rw - @g, @wide)",
   "rh": "ifElse(ifElse(@ih, @bodyH - @pH - @g, @hasP), @bodyH, @wide)",
   "px": "@wide * (@rw + @g)",
   "py": "(1 - @wide) * (@rh + @g) * @hasP",
   "sleepH": "max(0, @pH - 33 - 12)",
   "hasSH": "step(@sleepH, 118)",
   "shH": "@hasSH * 24",
   "chartH": "@sleepH - @shH",
   "hasSleep": "step(@chartH, 40)"
  },
  "floatArrays": {
