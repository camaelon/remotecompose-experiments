{
 "id": "CMP-24",
 "name": "daily-activity",
 "version": 1,
 "title": "Daily activity",
 "summary": "A day at a glance: move, exercise and stand rings with their numbers, steps against a goal and a hypnogram of last night's sleep. Stacked on a phone, side by side in landscape and at 4x2, rings alone at 2x2 and on a round watch.",
 "prompt": "Build a daily activity screen: move, exercise and stand rings with goals, steps against a goal, and last night's sleep as stages over time. Rings past their goal must show it. It must fit a phone, landscape, a 4x2 and a 2x2 widget and a round watch.",
 "level": 3,
 "family": "CMP",
 "components": [
  "ActivityRings",
  "GoalBar",
  "SleepStages"
 ],
 "capabilities": {
  "primary": [
   "layout.stack",
   "host.variables",
   "data.array"
  ],
  "secondary": [
   "expr.system",
   "a11y.labels",
   "text.dynamic"
  ]
 },
 "use_cases": [
  "fitness",
  "dashboard",
  "widget"
 ],
 "form_factor": "phone",
 "keywords": [
  "health",
  "fitness",
  "calories",
  "macros",
  "steps",
  "activity rings",
  "sleep",
  "heart rate",
  "workout",
  "water",
  "weight",
  "goal",
  "daily activity",
  "activity tracker",
  "move exercise stand",
  "rings",
  "hypnogram",
  "sleep stages",
  "rem",
  "deep sleep",
  "step goal",
  "step counter",
  "fitness tracker",
  "smartwatch",
  "wear"
 ],
 "teaches": [
  "The same tree stacks or goes side by side through spacer lengths from windowWidth() and windowHeight(), and rings get what the panel leaves",
  "ActivityRings decides its own legend from its box: under the rings when tall, beside when wide, none in a watch-sized square",
  "Sleep comes from one exported array of stage indexes; the minutes per stage come from the host, since an expression cannot total an array by stage"
 ],
 "snippets": [
  {
   "pointer": "/resources/variables/wide",
   "shows": "expr.system",
   "note": "side by side when the window is wide; hasP drops the panel on a watch"
  },
  {
   "pointer": "/root/5/column/children/0/column/children/1/box/children/0",
   "shows": "layout.stack",
   "note": "the rings' box, with the panel placed after it by spacer lengths"
  },
  {
   "pointer": "/resources/floatArrays/night",
   "shows": "data.array",
   "note": "the night: one stage index per 15 minutes"
  },
  {
   "pointer": "/resources/variables/steps",
   "shows": "host.variables",
   "note": "exported numbers the app sends"
  }
 ],
