{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 200,
  "profiles": 513,
  "contentDescription": "Three pages swiped horizontally with page dots"
 },
 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize",
   {
    "background": "#FF101828"
   },
   {
    "semantics": {
     "contentDescription": "Pager, swipe left or right to change page"
    }
   }
  ],
  "commands": [
   {
    "variable": {
     "name": "w",
     "value": "componentWidth()"
    }
   },
   {
    "variable": {
     "name": "h",
     "value": "componentHeight()"
    }
   },
   {
    "touchExpression": {
     "name": "px",
     "defaultValue": "2 * @w",
     "min": 0,
     "max": "2 * @w",
     "expression": [
      "touchX()"
     ],
     "touchMode": 1
    }
   },
   {
    "variable": {
     "name": "page",
     "value": "round((2 * @w - @px) / @w)"
    }
   },
   {
    "variable": {
     "name": "shift",
     "value": {
      "value": "@w * -@page",
      "anim": 0.35
     }
    }
   },
   {
    "save": {
     "commands": [
      {
       "translate": {
        "dx": "@shift",
        "dy": 0
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FF4DA3FF"
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": 16,
        "top": 16,
        "right": "@w - 16",
        "bottom": "@h - 50",
        "rx": 20,
        "ry": 20
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FFFFFFFF"
         },
         {
          "textSize": 26
         }
        ]
       }
      },
      {
       "drawTextAnchored": {
        "text": "Today",
        "x": "@w / 2",
        "y": "@h / 2 - 17",
        "panX": 0,
        "panY": 0
       }
      },
      {
       "translate": {
        "dx": "@w",
        "dy": 0
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FF7C4DFF"
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": 16,
        "top": 16,
        "right": "@w - 16",
        "bottom": "@h - 50",
        "rx": 20,
        "ry": 20
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FFFFFFFF"
         }
        ]
       }
      },
      {
       "drawTextAnchored": {
        "text": "This week",
        "x": "@w / 2",
        "y": "@h / 2 - 17",
        "panX": 0,
        "panY": 0
       }
      },
      {
       "translate": {
        "dx": "@w",
        "dy": 0
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FF26A69A"
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": 16,
        "top": 16,
        "right": "@w - 16",
        "bottom": "@h - 50",
        "rx": 20,
        "ry": 20
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FFFFFFFF"
         }
        ]
       }
      },
      {
       "drawTextAnchored": {
        "text": "This month",
        "x": "@w / 2",
        "y": "@h / 2 - 17",
        "panX": 0,
        "panY": 0
       }
      }
     ]
    }
   },
   {
    "save": {
     "commands": [
      {
       "translate": {
        "dx": "@w / 2",
        "dy": "@h - 24"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FF3A4456"
         }
        ]
       }
      },
      {
       "drawCircle": {
        "cx": -20,
        "cy": 0,
        "radius": 5
       }
      },
      {
       "drawCircle": {
        "cx": 0,
        "cy": 0,
        "radius": 5
       }
      },
      {
       "drawCircle": {
        "cx": 20,
        "cy": 0,
        "radius": 5
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "#FFFFFFFF"
         }
        ]
       }
      },
      {
       "drawCircle": {
        "cx": "-20 - @shift / @w * 20",
        "cy": 0,
        "radius": 5
       }
      }
     ]
    }
   }
  ]
 }
}
