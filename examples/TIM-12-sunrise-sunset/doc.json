 "resources": {
  "variables": {
   "latitude": {
    "value": 37.7749,
    "export": true
   },
   "longitude": {
    "value": -122.4194,
    "export": true
   },
   "off": "offsetToUtc() / 60",
   "n": "365 * (year() - 2000) + floor((year() - 1997) / 4) + dayOfYear() - 1 - offsetToUtc() / 86400",
   "L": "(280.46 + 0.9856474 * @n) % 360",
   "g": "0.0174533 * ((357.528 + 0.9856003 * @n) % 360)",
   "lam": "0.0174533 * (@L + 1.915 * sin(@g) + 0.02 * sin(2 * @g))",
   "eps": "0.0174533 * (23.439 - 0.0000004 * @n)",
   "dec": "asin(sin(@eps) * sin(@lam))",
   "ra": "57.29578 * atan2(cos(@eps) * sin(@lam), cos(@lam))",
   "E": "@L - @ra",
   "eot": "4 * (@E - 360 * floor((@E + 180) / 360))",
   "noon": "720 - 4 * @longitude - @eot + @off",
   "phi": "0.0174533 * @latitude",
   "A": "sin(@phi) * sin(@dec)",
   "B": "cos(@phi) * cos(@dec)",
   "H0": "229.18312 * acos(clamp(-1, 1, (-0.0145439 - @A) / @B))",
   "Hc": "229.18312 * acos(clamp(-1, 1, (-0.1045285 - @A) / @B))",
   "H6": "229.18312 * acos(clamp(-1, 1, (0.1045285 - @A) / @B))",
   "rise": "@noon - @H0",
   "set": "@noon + @H0",
   "riseR": "floor(@rise + 0.5)",
   "setR": "floor(@set + 0.5)",
   "dawnR": "floor(@noon - @Hc + 0.5)",
   "duskR": "floor(@noon + @Hc + 0.5)",
   "noonR": "floor(@noon + 0.5)",
   "goldR": "floor(@noon + @H6 + 0.5)",
   "dayLen": "@setR - @riseR",
   "now": "timeInMin()",
   "sNow": "@A + @B * cos((@now - @noon) * 0.0043633)",
   "left": "floor(min(@dayLen, max(0, @set - @now)))",
   "alt": "57.29578 * asin(@sNow)"
  }
 },
