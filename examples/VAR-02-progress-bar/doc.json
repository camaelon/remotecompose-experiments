{
 "header": {"apiLevel": 7, "width": 300, "height": 80, "profiles": 513,
  "contentDescription": "A progress bar at 65 percent"},
 "resources": {
  "variables": {
   "progress": {"value": 0.65, "export": true}
  }
 },
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"paint": {"ops": [{"color": "#FF2A3342"}]}},
   {"drawRoundRect": {"left": 16, "top": 44, "right": "componentWidth() - 16", "bottom": 60, "rx": 8, "ry": 8}},
   {"paint": {"ops": [{"color": "#FF4DA3FF"}]}},
   {"drawRoundRect": {"left": 16, "top": 44, "right": "16 + (componentWidth() - 32) * @progress", "bottom": 60, "rx": 8, "ry": 8}},
   {"paint": {"ops": [{"color": "#FFFFFFFF"}, {"textSize": 15}]}},
   {"drawTextAnchored": {"text": "Uploading", "x": 16, "y": 24, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {
     "text": {"type": "textFromFloat", "value": "@progress * 100", "whole": 3, "decimal": 0},
     "x": "componentWidth() - 30", "y": 24, "panX": 1, "panY": 0}},
   {"drawTextAnchored": {"text": "%", "x": "componentWidth() - 16", "y": 24, "panX": 1, "panY": 0}}
  ]
 }
}
