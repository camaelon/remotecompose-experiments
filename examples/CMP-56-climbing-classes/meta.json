 ],
 "teaches": [
  "No year or month: the calendar follows the clock (month name, the weekday of the 1st, 28 to 31 days, today) and is right every month without a rebuild",
  "Events that repeat by weekday (weekly, 0 = Monday) are honest in any month: each class shows on every such day, as dots on a phone and chips on a tablet",
  "emptyText for a day without classes; agendaEnd holds one Book button, written once, sending hostNamedAction bookClass with the selected day"
 ],
 "snippets": [
  {
   "pointer": "/root/CalendarMonth",
   "shows": "time.date",
   "note": "no year or month: the current month from the clock"
  },
