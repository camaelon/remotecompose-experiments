 "name": "climbing-classes",
 "version": 1,
 "title": "A class timetable on this month's calendar",
 "prompt": "Make the class timetable of a climbing wall as a calendar of the current month: the weekly classes shown on every day they run, today marked, and the selected day's classes with times, level and places, with a button to book. It must stay right next month without being rebuilt.",
 "level": 3,
 "family": "CMP",
