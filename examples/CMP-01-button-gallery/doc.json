{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 300,
  "profiles": 513,
  "contentDescription": "Button component gallery: filled, outlined and text styles, enabled and disabled, with an icon"
 },
 "resources": { "variables": { "last": 0 } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }, { "spacedBy": 10 }],
   "children": [
    { "text": { "value": "Button", "fontSize": 20, "color": "@colors.onSurface" } },
    { "text": { "value": "Styles", "fontSize": 12, "color": "@colors.muted" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [{ "spacedBy": 8 }],
      "children": [
       { "Button": { "label": "Save", "onClick": { "type": "valueFloatChange", "target": "@last", "value": 1 } } },
       {
        "Button": {
         "label": "Edit",
         "style": "outlined",
         "onClick": { "type": "valueFloatChange", "target": "@last", "value": 2 }
        }
       },
       {
        "Button": { "label": "Skip", "style": "text", "onClick": { "type": "valueFloatChange", "target": "@last", "value": 3 } }
       }
      ]
     }
    },
    { "text": { "value": "Disabled", "fontSize": 12, "color": "@colors.muted" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [{ "spacedBy": 8 }],
      "children": [
       {
        "Button": { "label": "Save", "enabled": false, "onClick": { "type": "valueFloatChange", "target": "@last", "value": 9 } }
       },
       {
        "Button": {
         "label": "Edit",
         "style": "outlined",
         "enabled": false,
         "onClick": { "type": "valueFloatChange", "target": "@last", "value": 9 }
        }
       },
       {
        "Button": {
         "label": "Skip",
         "style": "text",
         "enabled": false,
         "onClick": { "type": "valueFloatChange", "target": "@last", "value": 9 }
        }
       }
      ]
     }
    },
    { "text": { "value": "Icon and colour", "fontSize": 12, "color": "@colors.muted" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [{ "spacedBy": 8 }],
      "children": [
       {
        "Button": {
         "label": "Add",
         "onClick": { "type": "valueFloatChange", "target": "@last", "value": 4 },
         "slots": {
          "icon": [
           {
            "canvas": {
             "modifiers": [{ "width": 16 }, { "height": 16 }],
             "commands": [
              {
               "paint": {
                "ops": [{ "color": "@colors.onPrimary" }, { "style": "stroke" }, { "strokeWidth": 2 }, { "strokeCap": "round" }]
               }
              },
              { "drawLine": { "x1": 8, "y1": 2, "x2": 8, "y2": 14 } },
              { "drawLine": { "x1": 2, "y1": 8, "x2": 14, "y2": 8 } }
             ]
            }
           }
          ]
         }
        }
       },
       {
        "Button": {
         "label": "Delete",
         "style": "outlined",
         "color": "@colors.error",
         "onClick": { "type": "valueFloatChange", "target": "@last", "value": 5 }
        }
       }
      ]
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [{ "spacedBy": 8 }],
      "children": [
       { "text": { "value": "Last tapped:", "fontSize": 14, "color": "@colors.muted" } },
       {
        "text": {
         "value": { "type": "textFromFloat", "value": "@last", "whole": 1, "decimal": 0 },
         "fontSize": 14,
         "color": "@colors.onSurface"
        }
       }
      ]
     }
    }
   ]
  }
 }
}
