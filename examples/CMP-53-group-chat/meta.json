 "id": "CMP-53",
 "name": "group-chat",
 "version": 1,
 "title": "A group chat anchored to the latest message, with the chat list beside it when wide",
 "prompt": "Make a group chat for four friends planning a climbing Sunday: names above their messages, small avatars, my messages on the right in blue, a shared PDF topo, heart and thumbs-up reactions, who has seen my last message, someone typing, and a message field with attach and send. On a tablet or desktop show my list of chats on the left.",
 "level": 2,
