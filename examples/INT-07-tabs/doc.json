{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 240,
  "profiles": 513,
  "contentDescription": "Three tabs: Songs, Albums and Artists, each showing its own panel"
 },
 "resources": {
  "variables": {
   "tab": 0,
   "show0": "1 - min(1, abs(@tab - 0))",
   "show1": "1 - min(1, abs(@tab - 1))",
   "show2": "1 - min(1, abs(@tab - 2))"
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    }
   ],
   "children": [
    {
     "Tabs": {
      "labels": [
       "Songs",
       "Albums",
       "Artists"
      ],
      "selected": "@tab"
     }
    },
    {
     "box": {
      "modifiers": [
       "fillMaxSize",
       {
        "padding": 16
       }
      ],
      "children": [
       {
        "box": {
         "modifiers": [
          {
           "visibility": "@show0"
          },
          "fillMaxWidth"
         ],
         "children": [
          {
           "Card": {
            "title": "Songs",
            "subtitle": "128 songs on this device"
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "visibility": "@show1"
          },
          "fillMaxWidth"
         ],
         "children": [
          {
           "Card": {
            "title": "Albums",
            "subtitle": "24 albums, newest first"
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "visibility": "@show2"
          },
          "fillMaxWidth"
         ],
         "children": [
          {
           "Card": {
            "title": "Artists",
            "subtitle": "57 artists you follow"
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 }
}
