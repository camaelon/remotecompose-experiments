 "teaches": [
  "WorldMap with night: true shades where it is night now, from the clock; cities by name, labels beside them",
  "UTC minutes of the day: (timeInMin() - offsetToUtc() / 60 + 1440) % 1440",
  "The map is geometry fixed at build time (~3.5 KB for the world at low detail); the night shade is one pathExpression that moves with the clock",
  "\"fill\": true makes the map take the height left in the column and rescale with the window; text, dots and lines grow with it (0.8x to 1.8x)"
 ],
 "inputs": {
  "variables": {},
  "clock": "2026-10-31T10:30:00Z",
  "touch": false
 },
 "check": {
  "describe": "At 10:30 UTC on 31 October the day is centred on Europe and Africa (the sun over 22.5°E), the Americas and East Asia are in night; the header reads 10:30 UTC in any time zone. The map fills the space under the header at every size (a world keeps its 2.5:1, so a tall window has bands above and below); city names grow with it.",
