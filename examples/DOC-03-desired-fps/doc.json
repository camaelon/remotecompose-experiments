{
 "header": {"apiLevel": 7, "width": 300, "height": 100, "profiles": 513, "desiredFPS": 30,
  "contentDescription": "A dot sliding left to right every two seconds"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#101828"}],
  "commands": [
   {"paint": {"ops": [{"color": "#2A3342"}, {"style": "stroke"}, {"strokeWidth": 4}, {"strokeCap": "round"}]}},
   {"drawLine": {"x1": 30, "y1": "componentHeight() / 2", "x2": "componentWidth() - 30", "y2": "componentHeight() / 2"}},
   {"paint": {"ops": [{"color": "#4DA3FF"}, {"style": "fill"}]}},
   {"drawCircle": {"cx": "30 + (continuousSec() % 2) / 2 * (componentWidth() - 60)", "cy": "componentHeight() / 2", "radius": 14}}
  ]
 }
}
