       { "box": { "modifiers": [{ "weight": 1 }, { "height": 104 }, { "padding": [3, 0] }], "children": [{ "Gauge": { "value": 72, "label": "Memory %", "size": 104, "thickness": 9, "fill": true } }] } },
       { "box": { "modifiers": [{ "weight": 1 }, { "height": 104 }, { "padding": { "start": 6 } }], "children": [{ "Gauge": { "value": 93, "label": "Disk %", "size": 104, "thickness": 9, "fill": true } }] } }
