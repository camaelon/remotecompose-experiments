{
 "id": "CMP-23",
 "name": "calorie-tracker",
 "version": 1,
 "title": "Calorie tracker",
 "summary": "Calories eaten against a target as a big ring with what is left, and macros as bars with their own targets. Ring over bars on a phone, side by side in landscape and at 4x2, ring alone at 2x2 and on a round watch. Past the target the ring runs a second lap, in mono too, and a screen reader hears it all as one summary.",
 "prompt": "Build a calorie tracker: calories eaten against a daily target as a ring, with carbs, protein and fat as bars. Show what is left, and show clearly when a target is passed. It must fit a phone, landscape, a 4x2 and a 2x2 widget and a round watch.",
 "level": 2,
 "family": "CMP",
 "components": [
  "MeterBreakdown"
 ],
 "capabilities": {
  "primary": [
   "layout.stack",
   "host.variables"
  ],
  "secondary": [
   "expr.system",
   "a11y.labels",
   "text.dynamic"
  ]
 },
 "use_cases": [
  "fitness",
  "widget",
  "gauge"
 ],
 "form_factor": "phone",
 "keywords": [
  "health",
