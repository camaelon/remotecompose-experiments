  "diet"
 ],
 "teaches": [
  "One call fills the screen: MeterBreakdown arranges itself from the box it gets, so the document only sets the padding and whether a title fits",
  "Parts take \"@variable\" for value and target; list the most important part first, since parts drop from the end",
  "Past the target the ring runs a second lap and a bar marks the limit; the numbers say how much, for mono and screen readers"
 ],
 "snippets": [
  {
   "pointer": "/root/1/column/children/0/column/children/1/box/children/0",
   "shows": "layout.stack",
   "note": "the whole screen, one call: ring and parts"
  },
