{
 "header": {"apiLevel": 7, "width": 240, "height": 240, "profiles": 513,
  "contentDescription": "A ten by ten grid of dots shaded by their index"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"variable": {"name": "s", "value": "min(componentWidth() / 240, componentHeight() / 240)"}},
   {"translate": {"dx": "(componentWidth() - 240) / 2", "dy": "(componentHeight() - 240) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 120, "pivotY": 120}},
   {"paint": {"ops": [{"linearGradient": {"x1": 30, "y1": 30, "x2": 210, "y2": 210,
      "colors": ["#FF4DA3FF", "#FF7C4DFF", "#FFEF5350"]}}]}},
   {"loop": {"index": "row", "from": 0, "until": 10, "commands": [
     {"loop": {"index": "col", "from": 0, "until": 10, "commands": [
       {"paint": {"ops": [{"alpha": "0.25 + (row * 10 + col) * 0.0075"}]}},
       {"drawCircle": {"cx": "30 + col * 20", "cy": "30 + row * 20", "radius": "3 + (row * 10 + col) * 0.05"}}
     ]}}
   ]}}
  ]
 }
}
