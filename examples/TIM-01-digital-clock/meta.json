   "note": "seconds: timeInSec() % 60 (timeInSec is seconds within the hour)"
  }
 ],
 "inputs": {
  "variables": {},
  "clock": "10:10:05",
  "touch": false
 },
 "check": {
  "describe": "At 10:10:05 it reads 10:10:05; at 09:05:07 it reads 09:05:07 with leading zeros. Resized, the time stays centred in the box (a layout box with centred alignment); it needs about 220 dp of width at fontSize 56.",
  "render": {
   "clock": "2026-10-29T10:10:05"
  },
  "renders": [
   {
    "name": "narrow",
    "width": 240,
    "height": 160
   },
   {
    "name": "wide",
    "width": 540,
    "height": 160
   }
  ]
 },
 "pitfalls": [
  "timeInMin() is minutes since midnight and timeInSec() seconds within the hour, so both need % 60 to give a clock field",
  "Without flags 12 (PAD_PRE_ZERO) textFromFloat pads with spaces, so 9 shows as \" 9\" rather than 09",
  "timeInHr() is the 24-hour hour (0–23); a 12-hour clock needs (timeInHr() + 11) % 12 + 1",
  "A clock field needs decimal 0: inside a text value object decimal defaults to 3"
 ],
