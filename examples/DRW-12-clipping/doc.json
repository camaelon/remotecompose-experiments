{
 "header": {"apiLevel": 7, "width": 360, "height": 180, "profiles": 513, "contentDescription": "Stripes clipped to a square, a circle and a star"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 180)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 180) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 90}},
   {"pathExpression": {"id": "circle", "expressionX": "180 + 50 * cos(a[0])", "expressionY": "90 + 50 * sin(a[0])", "start": 0, "end": 6.2832, "count": 48, "flags": 1}},
   {"pathCreate": {"id": "star", "x": 290, "y": 40}},
   {"pathAppendLineTo": {"path": "star", "x": 302.3, "y": 75}},
   {"pathAppendLineTo": {"path": "star", "x": 339.5, "y": 75.9}},
   {"pathAppendLineTo": {"path": "star", "x": 310, "y": 98.5}},
   {"pathAppendLineTo": {"path": "star", "x": 320.6, "y": 134.1}},
   {"pathAppendLineTo": {"path": "star", "x": 290, "y": 113}},
   {"pathAppendLineTo": {"path": "star", "x": 259.4, "y": 134.1}},
   {"pathAppendLineTo": {"path": "star", "x": 270, "y": 98.5}},
   {"pathAppendLineTo": {"path": "star", "x": 240.5, "y": 75.9}},
   {"pathAppendLineTo": {"path": "star", "x": 277.7, "y": 75}},
   {"pathAppendClose": {"path": "star"}},
   {"paint": {"color": "#FFFFFFFF", "textSize": 13}},
   {"drawTextAnchored": {"text": "clipRect", "x": 70, "y": 164, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "clipPath circle", "x": 180, "y": 164, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "clipPath star", "x": 290, "y": 164, "panX": 0, "panY": 0}},
   {"paint": {"color": "#FF4DA3FF", "style": "stroke", "strokeWidth": 6}},
   {"save": {"commands": [
    {"clipRect": {"left": 20, "top": 40, "right": 120, "bottom": 140}},
    {"loop": {"index": "i", "from": 0, "until": 15, "commands": [
     {"drawLine": {"x1": "-80 + i * 14", "y1": 140, "x2": "20 + i * 14", "y2": 40}}]}}
   ]}},
   {"paint": {"color": "#FF26A69A"}},
   {"save": {"commands": [
    {"clipPath": {"path": "circle"}},
    {"loop": {"index": "i", "from": 0, "until": 15, "commands": [
     {"drawLine": {"x1": "30 + i * 14", "y1": 140, "x2": "130 + i * 14", "y2": 40}}]}}
   ]}},
   {"paint": {"color": "#FFFFCA28"}},
   {"save": {"commands": [
    {"clipPath": {"path": "star"}},
    {"loop": {"index": "i", "from": 0, "until": 15, "commands": [
     {"drawLine": {"x1": "140 + i * 14", "y1": 140, "x2": "240 + i * 14", "y2": 40}}]}}
   ]}}
  ]
 }
}
