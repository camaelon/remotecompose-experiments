              "Dust sheets",
              "Sandpaper, 120 grit"
             ]
            }
           }
          ]
         }
        }
       ],
       "second": [
        {
         "Card": {
          "title": "Steps",
          "children": [
           {
            "NumberedList": {
             "items": [
              "Move the furniture out and cover the floor",
              [
               "Fill the holes",
               "Sand them smooth once dry"
              ],
              "Tape the edges and sockets",
              "Prime the walls and leave them for two hours",
              "Cut in along the edges with the brush",
              "Roll the first coat, then a second after four hours",
              "Peel the tape while the paint is still soft"
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    }
