             "spoken": "litres",
             "spokenOne": "litre",
             "decimals": 1
            }
           },
           {
            "ScaledAmount": {
             "name": "Primer",
             "amount": 1.75,
             "factor": "@area / 20",
             "unit": "L",
             "spoken": "litres",
             "spokenOne": "litre",
             "format": "fraction"
            }
           },
           {
            "ScaledAmount": {
             "name": "Filler",
             "amount": 240,
             "factor": "@area / 20",
             "unit": "g",
             "step": 10
            }
           },
           {
            "ScaledAmount": {
             "name": "Masking tape",
