 "name": "chips-badges",
 "version": 3,
 "kind": "gallery",
 "title": "Chips and badges",
 "summary": "Six library Chips wrapping in a flow (Travel and Music preset through document variables, the rest keeping their own state) and Badges: a count, a live unread count from a host variable, 999+, New and Beta.",
 "prompt": "I need a set of topic filter chips that wrap onto several lines and toggle when tapped, plus small badges for an unread count and labels like New and Beta.",
 "level": 2,
 "family": "CMP",
 "components": [
  "Chip",
  "Badge"
 ],
 "capabilities": {
  "primary": [
   "input.toggle",
   "layout.flow"
  ],
  "secondary": [
   "layout.decoration",
   "text.dynamic",
   "host.variables",
   "a11y.labels"
  ]
 },
 "use_cases": [
  "control",
  "notification"
 ],
 "form_factor": "phone",
 "keywords": [
  "chip",
  "tag",
  "pill",
  "filter",
  "badge",
  "count",
  "notification dot",
  "component library",
  "filter chips",
  "tags",
  "pills",
  "unread badge",
  "counter badge",
  "label"
 ],
 "teaches": [
  "Toggle a filter with {\"Chip\": {\"label\": ..., \"selected\": \"@travel\"}}; leave selected out and it keeps its own",
  "Wrap chips onto lines with flow; the gaps come from end/bottom padding on a wrapper box, since flow ignores spacedBy",
  "Show a live count with {\"Badge\": {\"count\": \"@unread\"}}, or fixed text with {\"Badge\": {\"text\": \"New\"}}"
 ],
 "snippets": [
  {
   "pointer": "/root/column/children/1/flow/children/1",
   "shows": "input.toggle",
   "note": "a Chip bound to @travel (selected)"
  },
  {
   "pointer": "/root/column/children/1",
   "shows": "layout.flow",
   "note": "chips in a flow with padded wrappers"
  },
  {
   "pointer": "/root/column/children/3/row/children/1",
   "shows": "text.dynamic",
   "note": "a Badge bound to @unread"
  }
 ],
 "pitfalls": [
  "flow ignores spacedBy (Java and the players alike): wrap each chip in a box with end and bottom padding, which also keeps the first chip aligned with the text above",
  "A chip with no `selected` variable still toggles, but nothing else can read its state: bind a variable for every filter the document (or host) acts on",
  "Badge count uses textFromFloat with whole 4 and flags 5: fewer whole digits drop the leading ones (whole 1 prints 12 as 2); a count above 9999 should be text such as 999+",
  "A flow grows taller as the host narrows: content that fits at the header width can then run past the bottom, so make the page scroll (verticalScroll on the root column)"
 ],
 "inputs": {
  "variables": {
   "unread": {
    "type": "float",
    "meaning": "unread messages; 1000 and up shows 999+",
    "default": 12,
    "min": 0,
    "max": 999,
    "step": 1
   }
  },
  "clock": null,
  "touch": true
 },
 "check": {
  "describe": "Travel and Music start selected; tapping Photography selects it; variables {unread: 3} shows 3 in the second badge. Resized, the chips re-flow to the width: one line at 540 wide, three at 234, where the badges move below the fold and the page scrolls (verticalScroll) instead of overflowing.",
