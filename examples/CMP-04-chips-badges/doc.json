{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 210,
  "profiles": 513,
  "contentDescription": "Filter chips in a wrapping flow, two of them selected, and badges with short text and counts"
 },
 "resources": { "variables": { "scroll": 0, "travel": 1, "music": 1, "unread": { "value": 12, "export": true } } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "verticalScroll": "@scroll" }, { "padding": 12 }, { "spacedBy": 10 }],
   "children": [
    { "text": { "value": "Chip", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "flow": {
      "modifiers": ["fillMaxWidth"],
      "children": [
       {
        "box": {
         "modifiers": [{ "padding": { "end": 8, "bottom": 8 } }],
         "children": [{ "Chip": { "label": "Photography" } }]
        }
       },
       {
        "box": {
         "modifiers": [{ "padding": { "end": 8, "bottom": 8 } }],
         "children": [{ "Chip": { "label": "Travel", "selected": "@travel" } }]
        }
       },
       {
        "box": { "modifiers": [{ "padding": { "end": 8, "bottom": 8 } }], "children": [{ "Chip": { "label": "Food" } }] }
       },
       {
        "box": { "modifiers": [{ "padding": { "end": 8, "bottom": 8 } }], "children": [{ "Chip": { "label": "Design" } }] }
       },
       {
        "box": {
         "modifiers": [{ "padding": { "end": 8, "bottom": 8 } }],
         "children": [{ "Chip": { "label": "Music", "selected": "@music" } }]
        }
       },
       {
        "box": { "modifiers": [{ "padding": { "end": 8, "bottom": 8 } }], "children": [{ "Chip": { "label": "Science" } }] }
       }
      ]
     }
    },
    { "text": { "value": "Badge", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [{ "spacedBy": 10 }],
      "children": [
       { "Badge": { "count": 1 } },
       { "Badge": { "count": "@unread" } },
       { "Badge": { "text": "999+" } },
       { "Badge": { "text": "New", "color": "@colors.success" } },
       { "Badge": { "text": "Beta", "color": "@colors.secondary" } }
      ]
     }
    }
   ]
  }
 }
}
