         }
        },
        {
         "variable": {
          "name": "cy",
          "value": "ifElse(88 + @Ro, 72 + (@h - 72) / 2, @L)"
         }
        },
        {
         "variable": {
          "name": "q",
          "value": "(@Ro - @T - 12) * 0.7071"
         }
        },
