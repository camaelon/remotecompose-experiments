{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "A now playing screen: cover, title, artist, seek bar and transport controls, side by side when landscape, compact as a 4x2 or 2x2 widget"
 },
 "resources": {
  "variables": {
   "pos": {
    "value": 83,
    "export": true
   },
   "dur": {
    "value": 225,
    "export": true
   },
   "playing": {
    "value": 1,
    "export": true
   },
   "shuf": {
    "value": 0,
    "export": true
   },
   "rep": {
    "value": 0,
    "export": true
   },
   "seed": {
    "value": 1,
    "export": true
   },
   "W": "windowWidth()",
   "H": "windowHeight()",
   "tiny": "1 - step(@W, 220)",
   "land": "(1 - @tiny) * step(@W, @H * 1.15) * step(@H, 247.5) * step(@W, 351.5)",
   "port": "(1 - @tiny) * (1 - @land) * step(@H, 355.5)",
   "big": "@land + @port",
   "bar": "(1 - @tiny) * (1 - @big)",
   "fw": "ifElse(min(@W, 560), min(@W, 1000), @land)",
   "cw": "@fw - 32",
   "ch": "@H - 32",
   "five": "step(@W, 459.5)",
   "rsv": "ifElse(200, 264, @five)",
   "pcs": "max(0, min(@cw - 16, @ch - 228))",
   "lcs": "max(0, min(min(@ch - 16, @cw - 24 - @rsv), @fw / 2))",
   "ex": "max(0, (@ch - @pcs - 228) / 2)",
   "aw": "ifElse(@cw, @lcs + 16, @land)",
   "ah": "ifElse(@pcs + 12, @ch, @land)",
   "bw": "ifElse(@cw, @cw - @aw - 8, @land)",
   "bh": "ifElse(216, @ch, @land)",
   "acs": "ifElse(@pcs, @lcs, @land)",
   "sb": "step(@H, 127.5)",
   "topH": "max(36, @H - 16 - 48 - 16 * @sb)",
   "barCover": "min(@topH, max(48, @W - 172))",
   "secAt": "ifElse(300, ifElse(99999, 0, @five), @land)"
  }
 },
