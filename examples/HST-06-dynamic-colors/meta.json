  "material you",
  "dynamic color",
  "monet",
  "wallpaper colors",
  "system palette",
  "theming",
  "tonal palette"
 ],
 "components": [
  "Card"
 ],
 "teaches": [
  "Name resources.colors entries after Material roles (\"color.system_accent1_200\") so the host can substitute its palette",
  "Give each role a fallback value that works on its own (a dark-theme tone here)",
  "Reference the roles everywhere with \"@colors.color.system_...\": backgrounds and text colours",
  "Give single-line labels maxLines 1 and an ellipsis so a narrower card truncates them instead of wrapping word by word"
 ],
