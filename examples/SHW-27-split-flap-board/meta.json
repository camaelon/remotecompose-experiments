{
 "id": "SHW-27",
 "name": "split-flap-board",
 "version": 1,
 "title": "A split-flap departure board whose letters flip through the alphabet",
 "summary": "A railway departure board drawn on one canvas: rows of flap tiles for time, destination, train and platform, and a whole-word status flap in green, amber, orange or red. Every nine seconds the top train leaves and every tile flips mechanically through the character drum to its new letter, in a wave from top-left; a flap clock flips on the minute and a ticker runs underneath. Dark (classic charcoal), light (white flaps on a warm wall) and two still mono looks where the status is told by a lamp shape. One row of 26 tiles is a loop over a float array of character codes, so twelve trains cost 312 numbers.",
 "prompt": "Make an airport or train station split-flap departure board: rows of departures with time, destination, platform and status, where every character flips through the letters with the mechanical flap animation when a row changes. Boarding and Delayed in their own colours. It should look great on a tablet in landscape and still work on a phone.",
 "level": 5,
 "family": "SHW",
 "capabilities": {
  "primary": [
   "data.loop",
   "data.array",
   "time.animation",
   "expr.string"
  ],
  "secondary": [
   "anim.stagger",
