         "value": "ifElse(26, ifElse(16, 26, @tall), @nar)"
        }
       },
       {
        "variable": {
         "name": "cbase",
         "value": "ifElse(0, 26 + 16 * @tall, @nar)"
        }
       },
       {
        "variable": {
         "name": "sx",
         "value": "@m + @cw * ifElse(28.4, 17.8, @nar) * (1 - @tall)"
        }
