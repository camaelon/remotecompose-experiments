    {
     "canvas": {
      "modifiers": [
       "fillMaxSize"
      ],
      "commands": [
       {
        "loop": {
         "index": "r",
         "from": 0,
         "until": "@rows",
         "commands": [
          {
           "variable": {
            "name": "wy",
            "value": "@top + r * @pitch + @lh * @tall"
           }
          },
          {
           "variable": {
            "name": "wx0",
            "value": "@sx"
           }
          },
          {
           "variable": {
            "name": "wx1",
            "value": "@sx + @sw"
           }
          },
          {
           "variable": {
            "name": "wy1",
            "value": "@wy + @th"
           }
          },
          {
           "variable": {
            "name": "wmd",
            "value": "@wy + @th / 2"
           }
          },
          {
           "variable": {
            "name": "wcur",
            "value": "arrayGet(@status, (@k + r) % 12)"
           }
          },
          {
           "variable": {
            "name": "wn",
            "value": "(@wcur - arrayGet(@status, (@k + r + 11) % 12) * @hasOld + 5) % 5"
           }
          },
          {
           "variable": {
