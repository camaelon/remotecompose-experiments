        }
       },
       {
        "variable": {
         "name": "m",
         "value": "max(12, @W * 0.03)"
        }
       },
       {
        "variable": {
         "name": "cw",
         "value": "(@W - 2 * @m) / ifElse(36.8, ifElse(26.2, 17.6, @tall), @nar)"
        }
       },
       {
        "variable": {
         "name": "th",
         "value": "@cw * 1.42"
        }
       },
       {
        "variable": {
         "name": "lh",
         "value": "@th + @cw * 0.22"
