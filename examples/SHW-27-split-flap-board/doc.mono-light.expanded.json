       },
       {
        "paint": {
         "color": "@colors.muted",
         "textSize": "@th * 0.3"
        }
       },
       {
        "drawTextAnchored": {
         "text": "ABFAHRT  ·  DÉPARTS  ·  PARTENZE",
         "x": "@m",
         "y": "@hy + @th * 1.08",
         "panX": -1,
         "panY": 0
        }
       },
       {
        "variable": {
         "name": "hm",
