       },
       {
        "variable": {
         "name": "dh",
         "value": "@th + @lh * @tall"
        }
       },
       {
        "variable": {
         "name": "hy",
         "value": "@m + @th * 0.1"
        }
       },
       {
        "variable": {
         "name": "top",
         "value": "@hy + @th * 2"
        }
       },
       {
        "variable": {
         "name": "tk",
         "value": "max(22, @cw * 1.3)"
        }
       },
       {
        "variable": {
         "name": "room",
         "value": "@H - @top - @tk - @m * 1.5"
        }
       },
       {
        "variable": {
         "name": "rows",
         "value": "clamp(floor((@room + @cw * 0.5) / (@dh + @cw * 0.5)), 10, 1)"
        }
       },
       {
        "variable": {
         "name": "pitch",
         "value": "@dh + min(@th * 0.6, (@room - @rows * @dh) / max(1, @rows - 1))"
        }
       },
       {
        "variable": {
         "name": "t",
         "value": "6"
        }
       },
       {
        "variable": {
         "name": "k",
         "value": "floor(@t / 9)"
        }
       },
       {
        "variable": {
         "name": "tc",
         "value": "@t - @k * 9"
        }
       },
       {
        "variable": {
