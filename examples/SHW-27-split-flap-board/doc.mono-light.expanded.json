               "bottom": "@wy1"
              }
             },
             {
              "paint": {
               "style": "stroke"
              }
             },
             {
              "drawCircle": {
               "cx": "@wx0 + @cw * ifElse(0.7, 0.42, @tall)",
               "cy": "@wmd",
               "radius": "@cw * ifElse(0.27, 0.17, @tall)"
              }
             },
             {
              "paint": {
               "style": "fill"
              }
             },
             {
              "drawCircle": {
               "cx": "@wx0 + @cw * ifElse(0.7, 0.42, @tall)",
               "cy": "@wmd",
               "radius": "@cw * ifElse(0.27, 0.17, @tall)"
              }
             }
            ]
           }
          },
          {
           "save": {
            "commands": [
             {
              "clipRect": {
               "left": "@wx0",
               "top": "@wy1 - @th",
               "right": "@wx0 + (@wx1 - @wx0) * (1 - min(1, abs(@wcur - 3))) * @wdone",
               "bottom": "@wy1"
              }
             },
             {
              "paint": {
               "style": "stroke"
              }
             },
             {
