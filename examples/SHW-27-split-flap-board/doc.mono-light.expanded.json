               "radius": "@cw * ifElse(0.27, 0.17, @tall)"
              }
             },
             {
              "paint": {
               "style": "fill"
              }
             },
             {
              "drawSector": {
               "left": "@wx0 + @cw * ifElse(0.7, 0.42, @tall) - @cw * ifElse(0.27, 0.17, @tall)",
               "top": "@wmd - @cw * ifElse(0.27, 0.17, @tall)",
               "right": "@wx0 + @cw * ifElse(0.7, 0.42, @tall) + @cw * ifElse(0.27, 0.17, @tall)",
               "bottom": "@wmd + @cw * ifElse(0.27, 0.17, @tall)",
