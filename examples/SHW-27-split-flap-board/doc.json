             "cx": "@wx0 + @cw * ifElse(0.7, 0.42, @tall)",
             "cy": "@wmd",
             "radius": "@cw * ifElse(0.2, 0.13, @tall)"
            }
           }
          ]
         }
        }
       ]
      },
      {
       "$if": "!theme.mono",
       "then": [
        {
         "paint": {
          "color": "@colors.sDelayed",
          "style": "fillAndStroke",
          "strokeWidth": "@cw * 0.035",
          "textSize": "@th * ifElse(0.46, 0.38, @tall)"
         }
        },
        {
         "save": {
          "commands": [
           {
            "clipRect": {
             "left": "@wx0",
             "top": "@wy1 - @th",
             "right": "@wx0 + (@wx1 - @wx0) * (1 - min(1, abs(@wcur - 3))) * @wdone",
             "bottom": "@wy1"
            }
           },
           {
            "drawTextAnchored": {
             "text": "@wgC",
             "x": "@wx0 + @cw * ifElse(1.4, 0.85, @tall)",
             "y": "@wmd",
             "panX": -1,
             "panY": 0
            }
           },
           {
            "paint": {
             "style": "fill",
             "alpha": 1
            }
           },
           {
            "drawCircle": {
             "cx": "@wx0 + @cw * ifElse(0.7, 0.42, @tall)",
             "cy": "@wmd",
             "radius": "@cw * ifElse(0.2, 0.13, @tall)"
            }
           }
          ]
         }
        }
       ]
      },
      {
       "$if": "!theme.mono",
       "then": [
        {
         "paint": {
          "color": "@colors.sCanceled",
          "style": "fillAndStroke",
          "strokeWidth": "@cw * 0.035",
          "textSize": "@th * ifElse(0.46, 0.38, @tall)"
         }
        },
        {
         "save": {
          "commands": [
           {
            "clipRect": {
             "left": "@wx0",
             "top": "@wy1 - @th",
             "right": "@wx0 + (@wx1 - @wx0) * (1 - min(1, abs(@wcur - 4))) * @wdone",
             "bottom": "@wy1"
            }
           },
           {
            "drawTextAnchored": {
             "text": "@wgC",
             "x": "@wx0 + @cw * ifElse(1.4, 0.85, @tall)",
             "y": "@wmd",
             "panX": -1,
             "panY": 0
            }
           },
           {
            "paint": {
             "style": "fill",
             "alpha": 1
            }
           },
           {
            "drawCircle": {
             "cx": "@wx0 + @cw * ifElse(0.7, 0.42, @tall)",
             "cy": "@wmd",
             "radius": "@cw * ifElse(0.2, 0.13, @tall)"
            }
           }
          ]
         }
        }
       ]
      },
      {
       "$if": "theme.mono",
       "then": [
        {
         "paint": {
          "color": "@colors.outline",
          "style": "stroke",
          "strokeWidth": 1
         }
        },
        {
         "drawRoundRect": {
          "left": "@wx0",
          "top": "@sy",
          "right": "@wx1",
          "bottom": "@wy1",
          "rx": "@cw * 0.12",
          "ry": "@cw * 0.12"
         }
        }
       ]
      },
      {
       "paint": {
        "color": {
         "$if": "theme.mono",
         "then": "@colors.background",
         "else": "@colors.split"
        },
        "alpha": 1,
        "style": "fill"
       }
      },
      {
       "drawRect": {
        "left": {
         "$if": "theme.mono",
         "then": "@wx0 - 1",
         "else": "@wx0"
        },
        "top": "@wmd - @cw * 0.03",
        "right": {
         "$if": "theme.mono",
         "then": "@wx1 + 1",
         "else": "@wx1"
        },
        "bottom": "@wmd + @cw * 0.03"
       }
      }
     ]
    }
   },
   {
    "variable": {
     "name": "tky",
     "value": "@H - @m * 0.5 - @tk"
    }
   },
   {
    "$if": "theme.mono",
    "then": [
     {
      "paint": {
       "color": "@colors.onSurface",
       "style": "stroke",
       "strokeWidth": 1.5
      }
     },
     {
      "drawLine": {
       "x1": 0,
       "y1": "@tky",
       "x2": "@W",
       "y2": "@tky"
      }
     }
    ],
    "else": [
     {
      "paint": {
       "color": "@colors.band",
       "style": "fill"
      }
     },
     {
      "drawRect": {
       "left": 0,
       "top": "@tky",
       "right": "@W",
       "bottom": "@tky + @tk"
      }
     }
    ]
   },
   {
    "paint": {
     "color": {
      "$if": "theme.mono",
      "then": "@colors.onSurface",
      "else": "@colors.bandText"
     },
     "style": "fill",
     "textSize": "@tk * 0.5"
    }
   },
   {
    "textMeasure": {
     "text": "IC 718 TO ZURICH HB IS NOW BOARDING AT PLATFORM 7   •   RJ 64 TO MUNCHEN HBF IS DELAYED BY ABOUT 15 MINUTES   •   IR 15 TO GENEVE IS CANCELED: PLEASE USE IC 8 TO BERN AND CHANGE   •   ",
     "mode": 0,
     "name": "tw"
    }
   },
   {
    "variable": {
     "name": "tx",
     "value": "-((@t * 70) % @tw)"
    }
   },
   {
    "save": {
     "commands": [
      {
       "clipRect": {
        "left": 0,
        "top": "@tky",
        "right": "@W",
        "bottom": "@tky + @tk"
       }
      },
      {
       "loop": {
        "index": "i",
        "from": 0,
        "until": "ceil(@W / @tw) + 1",
        "commands": [
         {
          "drawTextAnchored": {
           "text": "IC 718 TO ZURICH HB IS NOW BOARDING AT PLATFORM 7   •   RJ 64 TO MUNCHEN HBF IS DELAYED BY ABOUT 15 MINUTES   •   IR 15 TO GENEVE IS CANCELED: PLEASE USE IC 8 TO BERN AND CHANGE   •   ",
           "x": "@tx + i * @tw",
           "y": "@tky + @tk / 2",
           "panX": -1,
           "panY": 0
          }
         }
        ]
       }
      }
     ]
    }
   }
  ]
 }
}