 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize",
   {
    "background": {
     "$if": "theme.mono",
     "then": "@colors.background",
     "else": "@colors.page"
    }
   }
  ],
  "commands": [
   {
    "variable": {
     "name": "W",
     "value": "componentWidth()"
    }
   },
   {
    "variable": {
     "name": "H",
     "value": "componentHeight()"
    }
   },
   {
    "variable": {
     "name": "tall",
     "value": "step(@H, @W * 1.2)"
    }
   },
   {
    "variable": {
     "name": "nar",
     "value": "max(step(700, @W), @tall)"
    }
   },
   {
    "variable": {
     "name": "m",
     "value": "max(12, @W * 0.03)"
    }
   },
   {
    "variable": {
     "name": "cw",
     "value": "(@W - 2 * @m) / ifElse(36.8, ifElse(26.2, 17.6, @tall), @nar)"
    }
   },
   {
    "variable": {
     "name": "th",
     "value": "@cw * 1.42"
    }
   },
   {
    "variable": {
     "name": "lh",
     "value": "@th + @cw * 0.22"
    }
   },
   {
    "variable": {
     "name": "dh",
     "value": "@th + @lh * @tall"
    }
   },
   {
    "variable": {
     "name": "hy",
     "value": "@m + @th * 0.1"
    }
   },
   {
    "variable": {
     "name": "top",
     "value": "@hy + @th * 2"
    }
   },
   {
    "variable": {
     "name": "tk",
     "value": "max(22, @cw * 1.3)"
    }
   },
   {
    "variable": {
     "name": "room",
     "value": "@H - @top - @tk - @m * 1.5"
    }
   },
   {
    "variable": {
     "name": "rows",
     "value": "clamp(floor((@room + @cw * 0.5) / (@dh + @cw * 0.5)), 10, 1)"
    }
   },
   {
    "variable": {
     "name": "pitch",
     "value": "@dh + min(@th * 0.6, (@room - @rows * @dh) / max(1, @rows - 1))"
    }
   },
   {
    "variable": {
     "name": "t",
     "value": {
      "$if": "theme.mono",
      "then": "6",
      "else": "animationTime()"
     }
    }
   },
   {
    "variable": {
     "name": "k",
     "value": "floor(@t / 9)"
    }
   },
   {
    "variable": {
     "name": "tc",
     "value": "@t - @k * 9"
    }
   },
   {
    "variable": {
     "name": "hasOld",
     "value": "step(@k, 0.5)"
    }
   },
   {
    "variable": {
     "name": "ncol",
     "value": "ifElse(26, ifElse(16, 26, @tall), @nar)"
    }
   },
   {
    "variable": {
     "name": "cbase",
     "value": "ifElse(0, 26 + 16 * @tall, @nar)"
    }
   },
   {
    "variable": {
     "name": "sx",
     "value": "@m + @cw * ifElse(28.4, 17.8, @nar) * (1 - @tall)"
    }
   },
   {
    "variable": {
     "name": "sw",
     "value": "@cw * ifElse(8.3, 4.9, @tall)"
    }
   },
   {
    "paint": {
     "color": {
      "$if": "theme.mono",
      "then": "@colors.onSurface",
      "else": "@colors.accent"
     },
     "style": "fill",
     "textSize": "@th * 0.78"
    }
   },
   {
    "drawTextAnchored": {
     "text": "DEPARTURES",
     "x": "@m",
     "y": "@hy + @th * 0.42",
     "panX": -1,
     "panY": 0
    }
   },
   {
    "paint": {
     "color": {
      "$if": "theme.mono",
      "then": "@colors.muted",
      "else": "@colors.muted"
     },
     "textSize": "@th * 0.3"
    }
   },
   {
    "drawTextAnchored": {
     "text": "ABFAHRT  ·  DÉPARTS  ·  PARTENZE",
     "x": "@m",
     "y": "@hy + @th * 1.08",
     "panX": -1,
     "panY": 0
    }
   },
   {
    "variable": {
     "name": "hm",
     "value": "timeInHr() * 100 + timeInMin() % 60"
    }
   },
   {
    "variable": {
     "name": "mo",
     "value": "(timeInHr() * 60 + timeInMin() % 60 + 1439) % 1440"
    }
   },
   {
    "variable": {
     "name": "hmo",
     "value": "floor(@mo / 60) * 100 + @mo % 60"
    }
   },
   {
    "variable": {
     "name": "cs",
     "value": {
      "$if": "theme.mono",
      "then": "30",
      "else": "continuousSec() % 60"
     }
    }
   },
   {
    "loop": {
     "index": "j",
     "from": 0,
     "until": 5,
     "commands": [
      {
       "variable": {
        "name": "jj",
        "value": "j - step(j, 2)"
       }
      },
      {
       "variable": {
        "name": "isc",
        "value": "1 - min(1, abs(j - 2))"
       }
      },
      {
       "variable": {
        "name": "ho",
        "value": "ifElse(27 + floor(@hmo / pow(10, 3 - @jj)) % 10, 37, @isc)"
       }
      },
      {
       "variable": {
        "name": "hnw",
        "value": "ifElse(27 + floor(@hm / pow(10, 3 - @jj)) % 10, 37, @isc)"
       }
      },
      {
       "variable": {
        "name": "hn",
        "value": "(@hnw - @ho + 40) % 40"
       }
      },
      {
       "variable": {
        "name": "hf",
        "value": "clamp((@cs - j * 0.06 + 0.1) * 22, @hn, 0)"
       }
      },
      {
       "variable": {
        "name": "hcur",
        "value": "(@ho + floor(@hf)) % 40"
       }
      },
      {
       "variable": {
        "name": "hnx",
        "value": "(@hcur + 1 - step(@hf, @hn)) % 40"
       }
      },
      {
       "variable": {
        "name": "hs",
        "value": "@hf - floor(@hf)"
       }
      },
      {
       "variable": {
        "name": "hlo",
        "value": "step(0.5, @hs)"
       }
      },
      {
       "variable": {
        "name": "hx0",
        "value": "@W - @m - (5 - j) * @cw"
       }
      },
      {
       "variable": {
        "name": "hx1",
        "value": "@hx0 + @cw * 0.9"
       }
      },
      {
       "variable": {
        "name": "hy1",
        "value": "@hy + @th"
       }
      },
      {
       "variable": {
        "name": "hmd",
        "value": "@hy + @th / 2"
       }
      },
      {
       "textSubtext": {
        "text": " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:-.",
        "start": "(@hnx) * 1",
        "len": 1,
        "varName": "hgN"
       }
      },
      {
       "textSubtext": {
        "text": " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:-.",
        "start": "(@hcur) * 1",
        "len": 1,
        "varName": "hgC"
       }
      },
      {
       "textSubtext": {
        "text": " ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:-.",
