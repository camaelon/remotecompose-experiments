{
 "header": {"apiLevel": 7, "width": 360, "height": 240, "profiles": 513,
  "contentDescription": "Five easing curves from 0 to 1 drawn on one chart, with a legend"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "fit", "value": "min(componentWidth() / 360, componentHeight() / 240)"}},
   {"translate": {"dx": "(componentWidth() - 360 * @fit) / 2", "dy": "(componentHeight() - 240 * @fit) / 2"}},
   {"scale": {"sx": "@fit", "sy": "@fit"}},
   {"paint": {"ops": [{"color": "#FF1E2A3A"}]}},
   {"drawRoundRect": {"left": 12, "top": 12, "right": 212, "bottom": 228, "rx": 10, "ry": 10}},
   {"paint": {"ops": [{"color": "#FF2A3A4E"}, {"style": "stroke"}, {"strokeWidth": 1}]}},
   {"drawRect": {"left": 24, "top": 36, "right": 200, "bottom": 212}},
   {"drawLine": {"x1": 24, "y1": 124, "x2": 200, "y2": 124}},
   {"drawLine": {"x1": 112, "y1": 36, "x2": 112, "y2": 212}},
   {"pathExpression": {"id": "linear", "expressionX": "24 + 176 * a[0]", "expressionY": "212 - 176 * a[0]",
     "start": 0, "end": 1, "count": 2, "flags": 4}},
   {"pathExpression": {"id": "easeIn", "expressionX": "24 + 176 * a[0]", "expressionY": "212 - 176 * square(a[0])",
     "start": 0, "end": 1, "count": 64, "flags": 4}},
   {"pathExpression": {"id": "easeOut", "expressionX": "24 + 176 * a[0]", "expressionY": "212 - 176 * (1 - square(1 - a[0]))",
     "start": 0, "end": 1, "count": 64, "flags": 4}},
   {"pathExpression": {"id": "smooth", "expressionX": "24 + 176 * a[0]", "expressionY": "212 - 176 * smooth_step(a[0], 1, 0)",
     "start": 0, "end": 1, "count": 64, "flags": 4}},
   {"pathExpression": {"id": "smoother", "expressionX": "24 + 176 * a[0]",
     "expressionY": "212 - 176 * a[0] * a[0] * a[0] * (a[0] * (6 * a[0] - 15) + 10)",
     "start": 0, "end": 1, "count": 64, "flags": 4}},
   {"paint": {"ops": [{"color": "#FF5C6B7E"}, {"strokeWidth": 2}, {"strokeCap": "round"}, {"strokeJoin": "round"}]}},
   {"drawPath": {"path": "linear"}},
   {"paint": {"ops": [{"color": "#FF4DA3FF"}, {"strokeWidth": 2.5}]}},
   {"drawPath": {"path": "easeIn"}},
   {"paint": {"ops": [{"color": "#FF26A69A"}]}},
   {"drawPath": {"path": "easeOut"}},
   {"paint": {"ops": [{"color": "#FFFFCA28"}]}},
   {"drawPath": {"path": "smooth"}},
   {"paint": {"ops": [{"color": "#FFEF5350"}]}},
   {"drawPath": {"path": "smoother"}},
   {"paint": {"ops": [{"color": "#FFFFFFFF"}, {"style": "fill"}, {"textSize": 14}]}},
   {"drawTextAnchored": {"text": "Easing curves", "x": 24, "y": 24, "panX": -1, "panY": 0}},
   {"paint": {"ops": [{"color": "#FF8899AA"}, {"textSize": 10}]}},
   {"drawTextAnchored": {"text": "t", "x": 200, "y": 222, "panX": 1, "panY": 0}},
   {"paint": {"ops": [{"textSize": 12}]}},
   {"drawTextAnchored": {"text": "linear  t", "x": 236, "y": 48, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "ease in", "x": 236, "y": 84, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "ease out", "x": 236, "y": 120, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "smooth_step", "x": 236, "y": 156, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "smootherstep", "x": 236, "y": 192, "panX": -1, "panY": 0}},
   {"paint": {"ops": [{"color": "#FF5C6B7E"}, {"textSize": 9}]}},
   {"drawTextAnchored": {"text": "square(t)", "x": 236, "y": 98, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "1 - square(1 - t)", "x": 236, "y": 134, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "(t, 1, 0)", "x": 236, "y": 170, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "t³(t(6t - 15) + 10)", "x": 236, "y": 206, "panX": -1, "panY": 0}},
   {"paint": {"ops": [{"color": "#FF5C6B7E"}]}},
   {"drawCircle": {"cx": 226, "cy": 48, "radius": 4}},
   {"paint": {"ops": [{"color": "#FF4DA3FF"}]}},
   {"drawCircle": {"cx": 226, "cy": 84, "radius": 4}},
   {"paint": {"ops": [{"color": "#FF26A69A"}]}},
   {"drawCircle": {"cx": 226, "cy": 120, "radius": 4}},
   {"paint": {"ops": [{"color": "#FFFFCA28"}]}},
   {"drawCircle": {"cx": 226, "cy": 156, "radius": 4}},
   {"paint": {"ops": [{"color": "#FFEF5350"}]}},
   {"drawCircle": {"cx": 226, "cy": 192, "radius": 4}}
  ]
 }
}
