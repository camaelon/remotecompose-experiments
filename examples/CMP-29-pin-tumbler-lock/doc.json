             "color": "@colors.muted"
            },
            {
             "style": "stroke"
            },
            {
             "strokeWidth": 1.5
            },
            {
             "alpha": 1
            }
           ]
          }
         },
         {
          "loop": {
           "index": "m",
           "from": 0,
           "until": 4,
           "commands": [
            {
             "drawLine": {
              "x1": "60 + k * 32 - 7 + 14 * (m % 2)",
              "y1": "16 + m * (@pt - 34 - 16) / 4",
              "x2": "60 + k * 32 + 7 - 14 * (m % 2)",
              "y2": "16 + (m + 1) * (@pt - 34 - 16) / 4"
             }
            }
           ]
          }
         },
