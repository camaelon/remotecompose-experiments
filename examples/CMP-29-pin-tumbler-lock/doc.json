        "left": "262 - 24 * @turn",
        "top": 96,
        "right": "300 - 24 * @turn",
        "bottom": 130,
        "rx": 4,
        "ry": 4
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.onSurface"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": 2
         },
         {
          "strokeCap": "round"
         },
         {
          "alpha": 1
         }
        ]
       }
      },
      {
       "drawCircle": {
        "cx": 270,
        "cy": 48,
        "radius": 18
       }
      },
      {
       "drawLine": {
        "x1": "270 - 11 * sin(1.5708 * @turn)",
        "y1": "48 + 11 * cos(1.5708 * @turn)",
        "x2": "270 + 11 * sin(1.5708 * @turn)",
        "y2": "48 - 11 * cos(1.5708 * @turn)"
       }
      }
     ]
    }
   }
  }
 },
 "root": {
  "StepExplainer": {
   "title": "How a lock opens",
   "step": "@stage",
   "eased": "@keyAt",
   "progress": "scrub",
   "frame": "panel",
   "visualLabel": "Cross-section of a lock: a plug in a housing, five pin stacks held down by springs, a key entering from the left",
   "steps": [
    {
     "title": "Locked",
     "text": "Springs push five pin stacks down. The upper, driver pins cross the shear line, where plug meets housing, and stop the plug turning.",
     "short": "Driver pins cross the shear line."
    },
    {
     "title": "Key enters",
     "text": "Ridges on the key push each stack up as it passes, then let it fall back. Only a key this shape will do.",
     "short": "Ridges lift the pins as it goes."
    },
    {
     "title": "Key home",
     "text": "Each ridge lifts its stack exactly so the gap between the pins sits on the shear line.",
     "short": "Every gap is on the shear line."
    },
    {
     "title": "Plug turns",
     "text": "Nothing crosses the shear line now, so the plug turns with the key and pulls the bolt back.",
     "short": "The plug turns; the bolt retracts."
    }
   ],
   "slots": {
    "visual": [
     {
      "PinLock": {
       "pos": "@keyAt"
      }
     }
    ]
   }
  }
 }
}