            },
            {
             "strokeWidth": 2
            },
            {
             "alpha": 1
            }
           ]
          }
         },
         {
          "drawRoundRect": {
           "left": "60 + k * 32 - 8",
           "top": "@pt + 1",
           "right": "60 + k * 32 + 8",
           "bottom": "@pb - 1",
           "rx": 2,
           "ry": 2
          }
         }
        ]
