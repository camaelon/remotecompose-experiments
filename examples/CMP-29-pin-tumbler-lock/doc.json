            {
             "style": "fill"
            },
            {
             "alpha": 1
            }
           ]
          }
         },
         {
          "drawRoundRect": {
           "left": "60 + k * 32 - 9",
           "top": "@pt - 34",
           "right": "60 + k * 32 + 9",
           "bottom": "@pt - 1",
           "rx": 2,
           "ry": 2
          }
         },
         {
          "paint": {
