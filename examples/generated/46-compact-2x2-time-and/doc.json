 "resources": {
  "variables": {
   "cond": {
    "value": 1,
    "export": true
   },
   "night": {
    "value": 0,
    "export": true
   },
   "temp": {
    "value": 18,
    "export": true
   },
   "use24h": {
    "value": 1,
    "export": true
   },
   "hr": "timeInHr()",
   "mn": "timeInMin() % 60",
   "h12": "(@hr + 11) % 12 + 1",
   "pm": "step(@hr, 11.5)",
   "show12": "1 - @use24h",
   "tempR": "round(@temp)",
   "iconIdx": "@cond + @night * 7 * (1 - step(@cond, 1.5))",
   "wide": "step(windowWidth(), windowHeight() * 1.6) * step(windowWidth(), 230)",
   "layoutIdx": "@wide + 2 * (1 - @wide) * (1 - step(windowHeight(), 120))"
  }
