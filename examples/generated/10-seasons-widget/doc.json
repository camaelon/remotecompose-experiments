 "resources": {
  "variables": {
   "south": {
    "value": 0,
    "export": true
   },
   "y": "year()",
   "L": "(1 - min(1, abs(@y % 4))) * min(1, abs(@y % 100)) + (1 - min(1, abs(@y % 400)))",
   "L1": "(1 - min(1, abs((@y + 1) % 4))) * min(1, abs((@y + 1) % 100)) + (1 - min(1, abs((@y + 1) % 400)))",
   "today": "365 * (@y - 1970) + floor((@y - 1969) / 4) - floor((@y - 1901) / 100) + floor((@y - 1601) / 400) + dayOfYear() - 1",
   "tz": "offsetToUtc() / 86400",
   "dy": "@y - 2000",
   "eP": "floor(11312.55952 + 365.24274 * (@dy - 1) + @tz)",
   "e0": "floor(11036.30984 + 365.24237 * @dy + @tz)",
   "e1": "floor(11129.06767 + 365.24163 * @dy + @tz)",
   "e2": "floor(11222.71715 + 365.24202 * @dy + @tz)",
   "e3": "floor(11312.55952 + 365.24274 * @dy + @tz)",
   "e4": "floor(11036.30984 + 365.24237 * (@dy + 1) + @tz)",
   "n": "step(@today, @e0) + step(@today, @e1) + step(@today, @e2) + step(@today, @e3)",
   "nA": "@e0 + step(@n, 0.5) * (@e1 - @e0) + step(@n, 1.5) * (@e2 - @e1)",
   "next": "@nA + step(@n, 2.5) * (@e3 - @e2) + step(@n, 3.5) * (@e4 - @e3)",
   "pA": "@eP + step(@n, 0.5) * (@e0 - @eP) + step(@n, 1.5) * (@e1 - @e0)",
   "prev": "@pA + step(@n, 2.5) * (@e2 - @e1) + step(@n, 3.5) * (@e3 - @e2)",
   "days": "@next - @today",
   "isToday": "1 - min(1, @days)",
   "showNum": "min(1, @days)",
   "k": "@n % 4",
   "s": "(@n + @isToday + 3 + 2 * @south) % 4",
   "progress": "(1 - @isToday) * (@today - @prev) / (@next - @prev)",
   "jan1": "@today - dayOfYear() + 1",
   "mA": "@jan1 + 59 + @L + step(@n, 0.5) * 92 + step(@n, 1.5) * 92",
   "mS": "@mA + step(@n, 2.5) * 91 + step(@n, 3.5) * (90 + @L1)",
   "dom": "@next - @mS + 1",
   "wd": "(@next + 3) % 7",
   "evYear": "@y + step(@n, 3.5)",
   "v0": "1 - min(1, abs(@s))",
   "v1": "1 - min(1, abs(@s - 1))",
   "v2": "1 - min(1, abs(@s - 2))",
   "v3": "1 - min(1, abs(@s - 3))",
   "lW": "windowWidth()",
   "lH": "windowHeight()",
   "lSmall": "ifElse(4, 0, step(@lW, 119) * step(@lH, 59))",
   "lMid": "ifElse(@lSmall, 2, step(@lW, 239) * step(@lH, 75))",
   "lC": "ifElse(@lMid, 1, step(@lH, 149) * (1 - step(@lW, 299)))",
   "lay": "ifElse(@lC, 3, step(@lH, 129) * step(@lW, 299))"
  }
 },
