  "variables": {
   "total": {
    "value": 85213.57,
    "export": true
   },
   "change": {
    "value": 3.42,
    "export": true
   },
   "up": "step(@change, -0.00001)",
   "down": "1 - @up",
   "show0": "step(arrayLength(@coins), 0.5)",
   "show1": "step(arrayLength(@coins), 1.5)",
   "show2": "step(arrayLength(@coins), 2.5)",
   "show3": "step(arrayLength(@coins), 3.5)",
   "show4": "step(arrayLength(@coins), 4.5)",
   "wide": "step(windowWidth(), windowHeight() * 1.3)",
   "short": "1 - step(windowHeight(), 145)",
   "strip": "1 - step(windowHeight(), 55)",
   "shortIdx": "ifElse(0, 1 + 2 * @strip, @short)",
   "layoutIdx": "ifElse(2, @shortIdx, @wide)",
   "dside": "min(windowHeight() - 16, 100)",
   "dstrip": "windowHeight() - 8",
   "legendRow": "step(windowWidth() - @dside, 215)",
   "legendSq": "step(windowWidth(), 149)"
  },
  "floatArrays": {
   "coins": {
    "value": [
     52000,
     18000,
     9000,
     4000,
     2000
    ],
    "export": true
   }
  }
