 "components": {
  "CoinRow": {
   "component": "CoinRow",
   "version": 1,
   "summary": "One legend line of a DonutChart: a swatch in the slice's tone (thick/thin ring in mono), the coin's symbol and its share in percent; hidden when the array has no value at that index.",
   "params": {
    "values": {
     "type": "float",
     "required": true,
     "doc": "The same float array the DonutChart draws (\"@coins\")"
    },
    "index": {
     "type": "float",
     "required": true,
     "doc": "Slice index, 0-based"
    },
    "symbol": {
     "type": "string",
     "required": true,
     "doc": "The coin's symbol (a host string \"@sym0\")"
    },
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "The donut's colour"
    },
    "fontSize": {
     "type": "float",
     "default": 12,
     "static": true,
     "doc": "Text size in dp"
    },
    "shown": {
     "type": "float",
     "required": true,
     "doc": "A declared variable that is 1 when the row has a value (\"@show0\": step(arrayLength(@coins), 0.5))"
    }
   },
   "locals": {
    "n": "arrayLength(@values)"
   },
   "call": {
    "CoinRow": {
     "values": "@coins",
     "index": 0,
     "symbol": "BTC",
     "shown": "@show0"
    }
   },
   "body": {
    "row": {
     "verticalAlignment": "center",
     "modifiers": [
      {
       "visibility": "@shown"
      },
      {
       "semantics": {
        "contentDescription": {
         "type": "textMerge",
         "id1": {
          "type": "textMerge",
          "id1": "@symbol",
          "id2": ", "
         },
         "id2": {
          "type": "textMerge",
          "id1": {
           "type": "textFromFloat",
           "value": "round(100 * arrayGet(@values, @index) / max(arraySum(@values), 0.001))",
           "whole": 3,
           "decimal": 0,
           "flags": 5
          },
          "id2": " percent"
         }
        }
       }
      }
     ],
     "children": [
      {
       "canvas": {
        "modifiers": [
         {
          "size": 12
         }
        ],
        "commands": [
         {
          "$if": "theme.mono",
          "then": [
           {
            "paint": {
             "ops": [
              {
               "color": "@colors.onSurface"
              },
              {
               "style": "stroke"
              },
              {
               "strokeWidth": "1.5 + (1 - @index % 2) * 3"
              }
             ]
            }
           },
           {
            "drawCircle": {
             "cx": 6,
             "cy": 6,
             "radius": 3.5
            }
           }
          ],
          "else": [
           {
            "paint": {
             "ops": [
              {
               "color": "@color"
              },
              {
               "style": "fill"
              },
              {
               "alpha": "1 - 0.7 * @index / @n"
              }
             ]
            }
           },
           {
            "drawCircle": {
             "cx": 6,
             "cy": 6,
             "radius": 5
            }
           }
          ]
         }
        ]
       }
      },
      {
       "text": {
        "value": "@symbol",
        "fontSize": "@fontSize",
        "fontWeight": 600,
        "color": "@colors.onSurface",
        "maxLines": 1,
        "modifiers": [
         {
          "weight": 1
         },
         {
          "padding": {
           "start": 6
          }
         }
        ]
       }
      },
      {
       "text": {
        "value": {
         "type": "textMerge",
         "id1": {
          "type": "textFromFloat",
          "value": "round(100 * arrayGet(@values, @index) / max(arraySum(@values), 0.001))",
          "whole": 3,
          "decimal": 0,
          "flags": 5
