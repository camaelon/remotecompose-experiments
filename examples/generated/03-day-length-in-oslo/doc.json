{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 350,
  "profiles": 513,
  "contentDescription": "How the length of the day changes over the year in Oslo: a curve of daylight hours from January to December with a marker on today, today's day length, how much it changed since yesterday, and the longest and shortest days"
 },
 "componentTheme": "auto",
 "components": {
  "Duration": {
   "params": {
    "minutes": {
     "type": "float",
     "required": true,
     "doc": "A duration in whole minutes"
    },
    "fontSize": {
     "type": "float",
     "default": 14,
     "static": true,
     "doc": "Text size"
    },
    "color": {
     "type": "color",
     "default": "@colors.onSurface",
     "doc": "Text colour"
    }
   },
   "body": {
    "text": {
     "value": {
      "type": "textMerge",
      "id1": {
       "type": "textFromFloat",
       "value": "floor(@minutes / 60)",
       "whole": 2,
       "decimal": 0,
       "flags": 5
      },
      "id2": {
       "type": "textMerge",
       "id1": " h ",
       "id2": {
        "type": "textMerge",
        "id1": {
         "type": "textFromFloat",
         "value": "@minutes % 60",
         "whole": 2,
         "decimal": 0,
         "flags": 5
        },
        "id2": " min"
       }
      }
     },
     "fontSize": "@fontSize",
     "color": "@color",
     "maxLines": 1
    }
   }
  }
 },
 "resources": {
  "variables": {
   "latitude": {
    "value": 59.9139,
    "export": true
   },
   "phi": "@latitude * 0.0174533",
   "tp": "tan(@phi)",
   "k2": "-0.014538 / cos(@phi)",
   "dA": 0.40928,
   "w": 0.0172024,
   "u0": "dayOfYear()",
   "dl": "7.63944 * acos(clamp(-1, 1, @k2 - @tp * tan(@dA * sin(@w * (@u0 - 81)))))",
   "dlY": "7.63944 * acos(clamp(-1, 1, @k2 - @tp * tan(@dA * sin(@w * (@u0 - 82)))))",
   "dlMax": "7.63944 * acos(clamp(-1, 1, @k2 - @tp * tan(@dA * sin(@w * 91))))",
   "dlMin": "7.63944 * acos(clamp(-1, 1, @k2 - @tp * tan(@dA * sin(@w * 274))))",
   "m": "floor(@dl * 60 + 0.5)",
   "mMax": "floor(@dlMax * 60 + 0.5)",
   "mMin": "floor(@dlMin * 60 + 0.5)",
   "diff": "floor((@dl - @dlY) * 60 + 0.5)",
   "shorter": "step(0 - @diff, 0.5)",
   "longer": "1 - @shorter"
  }
 },
