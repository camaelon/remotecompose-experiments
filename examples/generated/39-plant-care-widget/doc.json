          ],
          "verticalArrangement": "spaceBetween",
          "children": [
           {
            "PlantName": {
             "size": 14
            }
           },
           {
            "box": {
             "modifiers": [
              "fillMaxWidth",
              {
               "height": 78
              }
             ],
             "children": [
              {
               "MoistureDial": {}
              }
             ]
            }
