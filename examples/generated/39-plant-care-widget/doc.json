          "modifiers": [
           "fillMaxSize"
          ],
          "children": [
           {
            "box": {
             "modifiers": [
              {
               "width": 112
              },
              "fillMaxHeight"
             ],
             "children": [
              {
               "MoistureDial": {}
              }
             ]
            }
           },
           {
            "box": {
