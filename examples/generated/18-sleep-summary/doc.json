  "variables": {
   "score": {
    "value": 82,
    "export": true
   },
   "sleepStart": {
    "value": 1390,
    "export": true
   },
   "sleepEnd": {
    "value": 400,
    "export": true
   },
   "slotMin": {
    "value": 15,
    "export": true
   },
   "n": "max(1, arrayLength(@stages))",
   "S": "arraySum(@stages)",
   "awakeN": "floor(@S / 10000)",
   "remN": "floor(@S / 100) % 100",
   "lightN": "@S % 100",
   "deepN": "@n - @awakeN - @remN - @lightN",
   "asleepMin": "(@n - @awakeN) * @slotMin",
   "asleepH": "floor(@asleepMin / 60)",
   "asleepM": "@asleepMin % 60",
   "awakePct": "floor(100 * @awakeN / @n + 0.5)",
   "remPct": "floor(100 * @remN / @n + 0.5)",
   "lightPct": "floor(100 * @lightN / @n + 0.5)",
   "deepPct": "floor(100 * @deepN / @n + 0.5)",
   "startH": "floor(@sleepStart / 60)",
   "startM": "@sleepStart % 60",
   "endH": "floor(@sleepEnd / 60)",
   "endM": "@sleepEnd % 60",
   "scoreFrac": "clamp(0, 1, @score / 100)",
   "scoreR": "floor(clamp(0, 100, @score) + 0.5)",
   "legendShown": "step(windowWidth(), 239) * step(windowHeight(), 139)",
   "layoutIdx": "(1 - step(windowHeight(), 100)) + 2 * step(windowHeight(), 100) * (1 - step(windowWidth(), 200))",
   "a11y_asleepH": "@asleepH + 0",
   "a11y_asleepM": "@asleepM + 0",
   "a11y_startH": "@startH + 0",
   "a11y_startM": "@startM + 0",
   "a11y_endH": "@endH + 0",
   "a11y_endM": "@endM + 0",
   "a11y_scoreR": "@scoreR + 0",
   "a11y_deepPct": "@deepPct + 0",
   "a11y_lightPct": "@lightPct + 0",
   "a11y_remPct": "@remPct + 0",
   "a11y_awakePct": "@awakePct + 0",
   "chartShownShort": "step(windowWidth(), 199)"
  }
 },
