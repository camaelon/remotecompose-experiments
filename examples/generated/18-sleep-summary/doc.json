{
 "header": {
  "apiLevel": 7,
  "width": 320,
  "height": 160,
  "profiles": 513,
  "contentDescription": "Sleep summary: hours slept, a hypnogram of the night's sleep stages and a quality score"
 },
 "components": {
  "Hypnogram": {
   "summary": "A hypnogram: a step chart of sleep stages over the night from a float array of stage codes per slot (0 deep, 1 light, 100 REM, 10000 awake), one bar per slot at its stage's level (deep lowest, awake highest) in its stage's colour; mono draws the step line only, over faint level guides",
   "params": {
    "stages": {
     "type": "float",
     "required": true,
     "doc": "\"@name\" of a resources.floatArrays entry: one stage code per slot, 0 = deep, 1 = light, 100 = REM, 10000 = awake (powers of 100, so arraySum gives every count); up to maxSlots entries"
    },
    "maxSlots": {
     "type": "float",
     "default": 96,
     "static": true,
     "doc": "Most slots drawn (96 = 24 h of 15-minute slots); the loop runs this many times, slots past the array's end draw nothing"
    },
    "awakeColor": {
     "type": "color",
     "default": "@colors.warning",
     "doc": "Fill of the awake slots (top level)"
    },
    "remColor": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "Fill of the REM slots"
    },
    "lightColor": {
     "type": "color",
     "default": "@colors.secondary",
     "doc": "Fill of the light-sleep slots"
    },
    "deepColor": {
     "type": "color",
     "default": "@colors.success",
     "doc": "Fill of the deep-sleep slots (bottom level)"
    },
    "label": {
     "type": "string",
     "default": "Sleep stages over the night",
     "doc": "Accessibility label"
    }
   },
   "locals": {
    "n": "arrayLength(@stages)",
    "n1": "arrayLength(@stages) - 1"
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxSize",
      {
       "semantics": {
        "contentDescription": "@label"
       }
      }
     ],
     "commands": [
      {
       "variable": {
        "name": "w",
        "value": "componentWidth()"
       }
      },
      {
       "variable": {
        "name": "h",
        "value": "componentHeight()"
       }
      },
      {
       "variable": {
        "name": "hu",
        "value": "(componentHeight() - 2) / 4"
       }
      },
      {
       "variable": {
        "name": "base",
        "value": "componentHeight() - 1"
       }
      },
      {
       "variable": {
        "name": "h2",
        "value": "@hu * 2"
       }
      },
      {
       "variable": {
        "name": "h3",
        "value": "@hu * 3"
       }
      },
      {
       "variable": {
        "name": "h4",
        "value": "@hu * 4"
       }
      },
      {
       "$if": "theme.mono",
       "then": [
        {
         "paint": {
          "color": "@colors.muted",
          "style": "stroke",
          "strokeWidth": 1
         }
        },
        {
         "drawLine": {
          "x1": 0,
          "y1": "@base - @hu",
          "x2": "@w",
          "y2": "@base - @hu"
         }
        },
        {
         "drawLine": {
          "x1": 0,
          "y1": "@base - @h2",
          "x2": "@w",
          "y2": "@base - @h2"
         }
        },
        {
         "drawLine": {
          "x1": 0,
          "y1": "@base - @h3",
          "x2": "@w",
          "y2": "@base - @h3"
         }
        },
        {
         "drawLine": {
          "x1": 0,
          "y1": "@base - @h4",
          "x2": "@w",
          "y2": "@base - @h4"
         }
        },
        {
         "paint": {
          "color": "@colors.onSurface",
          "style": "stroke",
          "strokeWidth": 2,
          "strokeCap": "square"
         }
        },
        {
         "loop": {
          "index": "i",
          "from": 0,
          "until": "@maxSlots",
          "commands": [
           {
            "drawLine": {
             "x1": "@w * min(@i, @n) / @n",
             "y1": "@base - @hu * (2 + log(max(arrayGet(@stages, min(@i, @n1)), 0.01)) / log(100))",
             "x2": "@w * min(@i + 1, @n) / @n",
             "y2": "@base - @hu * (2 + log(max(arrayGet(@stages, min(@i, @n1)), 0.01)) / log(100))"
            }
           },
           {
            "drawLine": {
             "x1": "@w * min(@i + 1, @n) / @n",
             "y1": "@base - @hu * (2 + log(max(arrayGet(@stages, min(@i, @n1)), 0.01)) / log(100))",
             "x2": "@w * min(@i + 1, @n) / @n",
             "y2": "@base - @hu * (2 + log(max(arrayGet(@stages, min(@i + 1, @n1)), 0.01)) / log(100))"
            }
           }
          ]
         }
        }
       ],
       "else": [
        {
         "paint": {
          "color": "@colors.outline",
          "style": "stroke",
          "strokeWidth": 1
         }
        },
        {
         "drawLine": {
          "x1": 0,
          "y1": "@base",
          "x2": "@w",
          "y2": "@base"
         }
        },
        {
         "loop": {
          "index": "i",
          "from": 0,
          "until": "@maxSlots",
          "commands": [
           {
            "paint": {
             "color": "@deepColor",
             "style": "fill"
            }
           },
           {
            "drawRect": {
             "left": "@w * min(@i, @n) / @n",
             "top": "@base - @hu * (1 - min(1, abs(arrayGet(@stages, min(@i, @n1)) - 0)))",
             "right": "@w * min(@i + 1, @n) / @n + 0.5",
             "bottom": "@base"
            }
           },
           {
            "paint": {
             "color": "@lightColor",
             "style": "fill"
            }
           },
           {
            "drawRect": {
             "left": "@w * min(@i, @n) / @n",
             "top": "@base - @h2 * (1 - min(1, abs(arrayGet(@stages, min(@i, @n1)) - 1)))",
             "right": "@w * min(@i + 1, @n) / @n + 0.5",
             "bottom": "@base"
            }
           },
           {
            "paint": {
             "color": "@remColor",
             "style": "fill"
            }
           },
           {
            "drawRect": {
             "left": "@w * min(@i, @n) / @n",
             "top": "@base - @h3 * (1 - min(1, abs(arrayGet(@stages, min(@i, @n1)) - 100)))",
             "right": "@w * min(@i + 1, @n) / @n + 0.5",
             "bottom": "@base"
            }
           },
           {
            "paint": {
             "color": "@awakeColor",
             "style": "fill"
            }
           },
           {
            "drawRect": {
             "left": "@w * min(@i, @n) / @n",
             "top": "@base - @h4 * (1 - min(1, abs(arrayGet(@stages, min(@i, @n1)) - 10000)))",
             "right": "@w * min(@i + 1, @n) / @n + 0.5",
             "bottom": "@base"
            }
           }
          ]
         }
        }
       ]
      }
     ]
    }
   },
   "call": {
    "Hypnogram": {
     "stages": "@stages"
    }
   }
  }
 },
