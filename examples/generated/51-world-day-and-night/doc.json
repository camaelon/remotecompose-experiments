{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 170,
  "profiles": 513,
  "contentDescription": "Day and night world map with your city marked, its local time and whether it is day or night there"
 },
 "resources": {
  "colors": {
   "mapSea": {
    "light": "#FFE9EEF5",
    "dark": "#FF1A2434",
    "mono-dark": "#FF000000",
    "mono-light": "#FFFFFFFF"
   },
   "mapLand": {
    "light": "#FFB4BFCE",
    "dark": "#FF3A475C"
   },
   "nightShade": {
    "light": "#FF0B1220",
    "dark": "#FF000000",
    "mono-dark": "#FF9E9E9E",
    "mono-light": "#FF616161"
   }
  },
  "variables": {
   "lat": {
    "value": 45.76,
    "export": true
   },
   "lon": {
    "value": 4.84,
    "export": true
   },
   "utcMin": "(timeInMin() - offsetToUtc() / 60 + 1440) % 1440",
   "dec": "-0.40911 * cos(6.2831853 * (dayOfYear() + 10) / 365)",
   "latR": "@lat * 0.0174533",
   "eotB": "6.2831853 * (dayOfYear() - 81) / 364",
   "eot": "9.87 * sin(2 * @eotB) - 7.53 * cos(@eotB) - 1.5 * sin(@eotB)",
   "ha": "((@utcMin + @eot) / 4 - 180 + @lon) * 0.0174533",
   "sinEl": "sin(@latR) * sin(@dec) + cos(@latR) * cos(@dec) * cos(@ha)",
   "dayIdx": "step(@sinEl, -0.1045) + step(@sinEl, -0.0145)",
   "midLon": "fract((180 - @utcMin / 4) / 360 + 1) * 360 - 180",
   "nightIdx": "floor((@midLon + 180) / 45) % 8",
   "layout": "step(windowHeight(), 130) + step(windowHeight(), 300)"
  }
 },
