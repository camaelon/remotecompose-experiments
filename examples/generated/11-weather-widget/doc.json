{
 "header": {
  "apiLevel": 7,
  "width": 320,
  "height": 160,
  "profiles": 513,
  "contentDescription": "Weather widget: the current temperature and condition, today's high and low, and the temperature for the next six hours as a chart"
 },
 "componentTheme": "auto",
 "resources": {
  "floatArrays": {
   "hourly": {
    "value": [
     20,
     21,
     23,
     24,
     23,
     21
    ],
    "export": true
   }
  },
  "variables": {
   "temp": {
    "value": 21,
    "export": true
   },
   "high": {
    "value": 25,
    "export": true
   },
   "low": {
    "value": 14,
    "export": true
   },
   "condition": {
    "value": 2,
    "export": true
   },
   "startHour": {
    "value": -1,
    "export": true
   },
   "isSun": "1 - min(1, abs(@condition - 0))",
   "isCloud": "1 - min(1, abs(@condition - 1))",
   "isRain": "1 - min(1, abs(@condition - 2))",
   "isSnow": "1 - min(1, abs(@condition - 3))",
   "isStorm": "1 - min(1, abs(@condition - 4))",
   "h0": "ifElse(timeInHr() + 1, @startHour, step(@startHour, -0.5))",
   "h1": "(@h0 + 0) % 24",
   "h2": "(@h0 + 1) % 24",
   "h3": "(@h0 + 2) % 24",
   "h4": "(@h0 + 3) % 24",
   "h5": "(@h0 + 4) % 24",
   "h6": "(@h0 + 5) % 24",
   "yLo": "arrayMin(@hourly) - 1",
   "yHi": "arrayMax(@hourly) + 1",
   "wide": "step(windowWidth(), 199)"
  }
 },
