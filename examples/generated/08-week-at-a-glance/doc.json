{
 "header": {
  "apiLevel": 7,
  "width": 320,
  "height": 120,
  "profiles": 513,
  "contentDescription": "Week at a glance: the seven days of this week with today highlighted, and the ISO week number"
 },
 "componentTheme": "auto",
 "components": {
  "Panel": {
   "summary": "The widget surface: a rounded surface in light/dark, a 1 dp outline ring in mono",
   "params": {},
   "slots": {
    "content": {
     "doc": "Rows"
    }
   },
   "body": {
    "column": {
     "verticalArrangement": "center",
     "modifiers": [
      "fillMaxSize",
      {
       "clip": {
        "roundedRect": 16
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "background": "@colors.outline"
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "padding": 1
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "clip": {
         "roundedRect": 15
        }
       }
      },
      {
       "background": "@colors.surface"
      },
      {
       "padding": {
        "$if": "theme.mono",
        "then": 11,
        "else": 12
       }
      }
     ],
     "children": [
      {
       "$slot": "content"
      }
     ]
    }
   }
  },
  "DayCell": {
   "summary": "One day of the week: a short weekday label over the day-of-month number; today is a filled primary disc (white on black in mono)",
   "params": {
    "label": {
     "type": "string",
     "required": true,
     "static": true,
     "doc": "Short weekday name, e.g. Mon"
    },
    "n": {
     "type": "float",
     "required": true,
     "doc": "The day-of-month number to show (a variable)"
    },
    "today": {
     "type": "float",
     "required": true,
     "doc": "1 when this cell is today, else 0 (an integer variable)"
    },
    "other": {
     "type": "float",
     "required": true,
     "doc": "1 - today (an integer variable)"
    },
    "size": {
     "type": "float",
     "default": 28,
     "static": true,
     "doc": "Disc diameter in dp"
    },
    "fontSize": {
     "type": "float",
     "default": 13,
     "static": true,
     "doc": "Number size in sp"
    },
    "labelSize": {
     "type": "float",
     "default": 11,
     "static": true,
     "doc": "Weekday label size in sp"
    }
   },
   "body": {
    "column": {
     "horizontalAlignment": "center",
     "modifiers": [
      {
       "weight": 1
      },
      {
       "spacedBy": 2
      }
     ],
     "children": [
