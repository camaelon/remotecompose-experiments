{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 180,
  "profiles": 513,
  "contentDescription": "World clock: local time, day or night, and the difference from your time in London, New York, Tokyo and Sydney"
 },
 "components": {
  "CityRow": {
   "summary": "One city as a row: day/night icon, name, difference from the user's time, local time",
   "params": {
    "city": {
     "type": "string",
     "required": true,
     "doc": "City name"
    },
    "rowHeight": {
     "type": "float",
     "default": 0,
     "static": true,
     "doc": "0: share the column's height (weight); else a fixed height in dp"
    },
    "hr": {
     "type": "float",
     "required": true,
     "doc": "per-city value from resources.variables (<key>_hr)"
    },
    "mn": {
     "type": "float",
     "required": true,
     "doc": "per-city value from resources.variables (<key>_mn)"
    },
    "night": {
     "type": "float",
     "required": true,
     "doc": "per-city value from resources.variables (<key>_night)"
    },
    "day": {
     "type": "float",
