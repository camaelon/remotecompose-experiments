     "required": true,
     "doc": "per-city value from resources.variables (<key>_tmr)"
    },
    "yst": {
     "type": "float",
     "required": true,
     "doc": "per-city value from resources.variables (<key>_yst)"
    }
   },
   "body": {
    "row": {
     "modifiers": [
      "fillMaxWidth",
      {
       "$if": "rowHeight",
       "then": {
        "height": "@rowHeight"
       },
       "else": {
        "verticalWeight": 1
       }
      }
     ],
     "verticalAlignment": "center",
     "children": [
      {
       "box": {
        "modifiers": [
         {
          "size": 24
         }
        ],
        "horizontalAlignment": "center",
        "verticalAlignment": "center",
        "children": [
         {
          "box": {
           "modifiers": [
            {
             "visibility": "@day"
            },
            {
             "semantics": {
              "contentDescription": {
               "type": "textMerge",
               "id1": "@city",
               "id2": {
                "type": "textMerge",
                "id1": ", ",
                "id2": {
                 "type": "textMerge",
                 "id1": {
                  "type": "textMerge",
                  "id1": {
                   "type": "textFromFloat",
                   "value": "@hr",
                   "whole": 2,
                   "decimal": 0,
                   "flags": 12
                  },
                  "id2": {
                   "type": "textMerge",
                   "id1": ":",
                   "id2": {
                    "type": "textFromFloat",
                    "value": "@mn",
                    "whole": 2,
                    "decimal": 0,
                    "flags": 12
                   }
                  }
                 },
                 "id2": {
                  "type": "textMerge",
                  "id1": ", day, ",
                  "id2": {
                   "type": "textMerge",
                   "id1": {
                    "type": "textFromFloat",
                    "value": "@dh",
                    "whole": 3,
                    "decimal": 0,
                    "flags": 5
                   },
                   "id2": " hours from your time"
                  }
                 }
                }
               }
              }
             }
            }
           ],
           "children": [
            {
             "Icon": {
