          "width": 8
         }
        ]
       }
      },
      {
       "text": {
        "value": {
         "type": "textMerge",
         "id1": {
          "type": "textFromFloat",
          "value": "@hr",
          "whole": 2,
          "decimal": 0,
          "flags": 12
         },
         "id2": {
          "type": "textMerge",
          "id1": ":",
          "id2": {
           "type": "textFromFloat",
           "value": "@mn",
           "whole": 2,
