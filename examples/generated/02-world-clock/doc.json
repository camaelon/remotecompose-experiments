 "resources": {
  "variables": {
   "off_lon": {
    "value": 0,
    "export": true
   },
   "off_nyc": {
    "value": -240,
    "export": true
   },
   "off_tyo": {
    "value": 540,
    "export": true
   },
   "off_syd": {
    "value": 660,
    "export": true
   },
   "userOff": "offsetToUtc() / 60",
   "lon_tot": "timeInMin() + @off_lon - @userOff + 2880",
   "lon_loc": "@lon_tot % 1440",
   "lon_dd": "floor(@lon_tot / 1440) - 2",
   "lon_hr": "floor(@lon_loc / 60)",
   "lon_mn": "@lon_loc % 60",
   "lon_night": "1 - step(@lon_loc, 359.5) * (1 - step(@lon_loc, 1079.5))",
   "lon_day": "1 - @lon_night",
   "lon_dh": "(@off_lon - @userOff) / 60",
   "lon_sgn": "step(@lon_dh, 0)",
   "lon_notSame": "min(1, abs(@off_lon - @userOff))",
   "lon_same": "1 - @lon_notSame",
   "lon_tmr": "step(@lon_dd, 0.5)",
   "lon_yst": "step(0 - @lon_dd, 0.5)",
   "nyc_tot": "timeInMin() + @off_nyc - @userOff + 2880",
   "nyc_loc": "@nyc_tot % 1440",
   "nyc_dd": "floor(@nyc_tot / 1440) - 2",
   "nyc_hr": "floor(@nyc_loc / 60)",
   "nyc_mn": "@nyc_loc % 60",
   "nyc_night": "1 - step(@nyc_loc, 359.5) * (1 - step(@nyc_loc, 1079.5))",
   "nyc_day": "1 - @nyc_night",
   "nyc_dh": "(@off_nyc - @userOff) / 60",
   "nyc_sgn": "step(@nyc_dh, 0)",
   "nyc_notSame": "min(1, abs(@off_nyc - @userOff))",
   "nyc_same": "1 - @nyc_notSame",
   "nyc_tmr": "step(@nyc_dd, 0.5)",
   "nyc_yst": "step(0 - @nyc_dd, 0.5)",
   "tyo_tot": "timeInMin() + @off_tyo - @userOff + 2880",
   "tyo_loc": "@tyo_tot % 1440",
   "tyo_dd": "floor(@tyo_tot / 1440) - 2",
   "tyo_hr": "floor(@tyo_loc / 60)",
   "tyo_mn": "@tyo_loc % 60",
   "tyo_night": "1 - step(@tyo_loc, 359.5) * (1 - step(@tyo_loc, 1079.5))",
   "tyo_day": "1 - @tyo_night",
   "tyo_dh": "(@off_tyo - @userOff) / 60",
   "tyo_sgn": "step(@tyo_dh, 0)",
   "tyo_notSame": "min(1, abs(@off_tyo - @userOff))",
   "tyo_same": "1 - @tyo_notSame",
   "tyo_tmr": "step(@tyo_dd, 0.5)",
   "tyo_yst": "step(0 - @tyo_dd, 0.5)",
   "syd_tot": "timeInMin() + @off_syd - @userOff + 2880",
   "syd_loc": "@syd_tot % 1440",
   "syd_dd": "floor(@syd_tot / 1440) - 2",
   "syd_hr": "floor(@syd_loc / 60)",
   "syd_mn": "@syd_loc % 60",
   "syd_night": "1 - step(@syd_loc, 359.5) * (1 - step(@syd_loc, 1079.5))",
   "syd_day": "1 - @syd_night",
   "syd_dh": "(@off_syd - @userOff) / 60",
   "syd_sgn": "step(@syd_dh, 0)",
   "syd_notSame": "min(1, abs(@off_syd - @userOff))",
   "syd_same": "1 - @syd_notSame",
   "syd_tmr": "step(@syd_dd, 0.5)",
   "syd_yst": "step(0 - @syd_dd, 0.5)",
   "phone": "step(windowHeight(), 300)",
   "narrow": "1 - step(windowWidth(), 259)",
   "short": "1 - step(windowHeight(), 139)",
   "layout": "@phone * 3 + (1 - @phone) * (@narrow * (1 + 3 * @short) + (1 - @narrow) * @short * 2)"
  }
 },
