{
 "header": {
  "apiLevel": 7,
  "width": 400,
  "height": 860,
  "profiles": 513,
  "contentDescription": "Meeting time planner: a slider picks the meeting time in your time zone; a world map shades where that moment is 09:00 to 18:00 local time, and a list gives each team city's local time and whether it is working hours, early, late or night"
 },
 "components": {
  "CityRow": {
   "summary": "One team city: its name and UTC offset, its local time for the meeting (with a day shift), and whether that is working hours, early, late or night",
   "params": {
    "name": {
     "type": "string",
     "required": true,
     "doc": "City name (a host string)"
    },
    "i": {
     "type": "float",
     "required": true,
     "static": true,
     "doc": "Index into the cityOff array"
    }
   },
   "locals": {
    "off": "arrayGet(@cityOff, @i)",
    "raw": "@q - @uo + @off",
    "t": "(@raw + 48) % 24",
    "hh": "floor(@t)",
    "mm": "round((@t - floor(@t)) * 60)",
    "work": "step(@t, 8.99) * (1 - step(@t, 17.99))",
    "early": "step(@t, 5.99) * (1 - step(@t, 8.99))",
    "late": "step(@t, 17.99) * (1 - step(@t, 21.99))",
    "night": "1 - step(@t, 5.99) + step(@t, 21.99)",
    "nextd": "step(@raw, 23.99)",
    "prevd": "1 - step(@raw, -0.001)",
    "pos": "step(@off, -0.001)",
    "neg": "1 - step(@off, -0.001)",
    "oh": "floor(abs(@off))",
    "om": "round((abs(@off) - floor(abs(@off))) * 60)"
   },
   "body": {
