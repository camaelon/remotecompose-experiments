  },
  "WorkHoursMap": {
   "summary": "A world map with the longitudes where it is 09:00-18:00 local solar time at a UTC hour shaded, and the team cities marked (filled when in working hours)",
   "params": {
    "utc": {
     "type": "float",
     "required": true,
     "doc": "Meeting time in UTC hours (0..24)"
    },
    "height": {
     "type": "float",
     "default": 160,
     "static": true,
     "doc": "Height in dp"
    },
    "label": {
     "type": "string",
     "default": "World map",
     "doc": "Accessibility label"
    }
   },
   "locals": {
    "x0": "((9 - @utc) * 1000 / 24 + 3500) % 1000"
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxWidth",
      {
       "height": "@height"
      },
      {
       "semantics": {
        "contentDescription": "@label"
       }
      }
     ],
     "commands": [
      {
       "variable": {
        "name": "mh",
        "value": {
         "$mapHeight": "world"
        }
       }
      },
      {
       "variable": {
        "name": "sc",
        "value": "min(componentWidth() / 1000, componentHeight() / @mh)"
       }
      },
      {
       "save": {}
      },
      {
       "translate": {
        "dx": "(componentWidth() - 1000 * @sc) / 2",
        "dy": "(componentHeight() - @mh * @sc) / 2"
       }
      },
      {
       "scale": {
        "sx": "@sc",
        "sy": "@sc"
       }
      },
      {
       "clipRect": {
        "left": 0,
        "top": 0,
        "right": 1000,
        "bottom": "@mh"
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "paint": {
         "color": "@colors.muted",
         "style": "fill",
         "alpha": 1
        }
       },
       "else": {
        "paint": {
         "color": "@colors.success",
         "style": "fill",
         "alpha": 0.35
        }
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "drawRect": {
         "left": "@x0",
         "top": 0,
         "right": "@x0 + 375",
         "bottom": 14
        }
       },
       "else": {
        "drawRect": {
         "left": "@x0",
         "top": 0,
         "right": "@x0 + 375",
         "bottom": "@mh"
        }
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "drawRect": {
         "left": "@x0 - 1000",
         "top": 0,
         "right": "@x0 - 625",
         "bottom": 14
        }
       },
       "else": {
        "drawRect": {
         "left": "@x0 - 1000",
         "top": 0,
         "right": "@x0 - 625",
         "bottom": "@mh"
        }
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "paint": {
         "color": "@colors.muted",
         "style": "stroke",
         "strokeWidth": 4
        }
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "drawLine": {
         "x1": "@x0",
         "y1": 0,
         "x2": "@x0",
         "y2": "@mh"
        }
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "drawLine": {
         "x1": "(@x0 + 375) % 1000",
         "y1": 0,
         "x2": "(@x0 + 375) % 1000",
         "y2": "@mh"
        }
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "paint": {
         "color": "@colors.onSurface",
         "style": "stroke",
         "strokeWidth": 2,
         "alpha": 1
        }
       },
       "else": {
        "paint": {
         "color": "@colors.track",
         "style": "fill",
         "alpha": 0.9
        }
       }
      },
      {
       "drawPath": {
        "path": {
         "$map": {
          "region": "world",
          "layer": "land",
          "detail": "low"
         }
        }
       }
      },
      {
       "loop": {
        "index": "k",
        "from": 0,
        "until": "arrayLength(@cityLon)",
        "commands": [
         {
          "variable": {
           "name": "mx",
           "value": "(arrayGet(@cityLon, k) + 180) * 1000 / 360"
          }
         },
         {
          "variable": {
           "name": "my",
           "value": "(84 - arrayGet(@cityLat, k)) * @mh / 142"
          }
         },
         {
          "variable": {
           "name": "lt",
           "value": "(@utc + arrayGet(@cityOff, k) + 48) % 24"
          }
         },
         {
          "variable": {
           "name": "w",
           "value": "step(@lt, 8.99) * (1 - step(@lt, 17.99))"
          }
         },
         {
          "paint": {
           "color": "@colors.onSurface",
           "style": "stroke",
           "strokeWidth": 4,
           "alpha": 1
          }
         },
         {
          "drawCircle": {
           "cx": "@mx",
           "cy": "@my",
           "radius": 12
          }
         },
         {
          "paint": {
           "color": "@colors.onSurface",
           "style": "fill"
          }
         },
         {
          "drawCircle": {
           "cx": "@mx",
           "cy": "@my",
           "radius": "@w * 12"
          }
         }
        ]
       }
      },
      {
       "restore": {}
      }
     ]
    }
   },
   "call": {
    "WorkHoursMap": {
     "utc": 12
    }
   }
  }
 },
 "resources": {
  "variables": {
   "hour": {
    "value": 16.5,
    "export": true
   },
   "q": "min(23.75, round(@hour * 4) / 4)",
   "uo": "offsetToUtc() / 3600",
   "utc": "(@q - @uo + 48) % 24",
   "qh": "floor(@q)",
   "qm": "round((@q - floor(@q)) * 60)",
   "uh": "floor(@utc)",
   "um": "round((@utc - floor(@utc)) * 60)",
   "uoPos": "step(@uo, -0.001)",
   "uoh": "floor(abs(@uo))",
   "uom": "round((abs(@uo) - floor(abs(@uo))) * 60)",
   "uoNeg": "1 - step(@uo, -0.001)",
   "scroll": 0
