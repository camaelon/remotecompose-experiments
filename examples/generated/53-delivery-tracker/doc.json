      51.4,
      0.15,
      51.62
     ],
     "lon": "@addrLon",
     "lat": "@addrLat"
    }
   },
   "ay": {
    "$mapPoint": {
     "region": [
      -0.35,
      51.4,
      0.15,
      51.62
     ],
     "lon": "@addrLon",
     "lat": "@addrLat",
     "axis": "y"
    }
   },
   "cxRaw": {
    "$mapPoint": {
     "region": [
      -0.35,
      51.4,
      0.15,
      51.62
     ],
     "lon": "@courierLon",
     "lat": "@courierLat"
    }
   },
   "cyRaw": {
    "$mapPoint": {
     "region": [
      -0.35,
      51.4,
      0.15,
      51.62
     ],
     "lon": "@courierLon",
     "lat": "@courierLat",
     "axis": "y"
    }
   },
   "vx": "@ax - @dx",
   "vy": "@ay - @dy",
   "len2": "max(0.0001, @vx * @vx + @vy * @vy)",
   "tRaw": "max(0, min(1, ((@cxRaw - @dx) * @vx + (@cyRaw - @dy) * @vy) / @len2))",
   "delivered": "step(@status, 2.5)",
   "arriving": "(1 - @delivered) * (1 - step(@eta, 1))",
   "showMin": "(1 - @delivered) * (1 - @arriving)",
   "layout": "step(windowWidth(), windowHeight() * 1.2)"
  }
 },
