{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 720,
  "profiles": 513,
  "contentDescription": "Delivery tracker: the courier moving on a map of London between the depot and the delivery address, with the ETA and the delivery status"
 },
 "components": {
  "DeliveryMap": {
   "summary": "Schematic London map fitted to the depot and address, the route line, the done part to the courier and the courier eased to its position",
   "params": {},
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxSize",
      {
       "clip": 16
      },
      {
       "semantics": {
        "contentDescription": {
         "type": "textMerge",
         "id1": "Map: courier ",
         "id2": {
          "type": "textMerge",
          "id1": {
           "type": "textFromFloat",
           "value": "round(@tRaw * 100)",
           "whole": 3,
           "decimal": 0,
           "flags": 5
          },
          "id2": {
           "type": "textMerge",
           "id1": "% of the way from ",
           "id2": {
            "type": "textMerge",
            "id1": "@depotLabel",
            "id2": {
             "type": "textMerge",
             "id1": " to ",
             "id2": "@addrLabel"
            }
           }
          }
         }
        }
       }
      }
     ],
     "commands": [
      {
       "variable": {
        "name": "cx",
        "value": {
         "value": "@cxRaw",
         "anim": 1.2
        }
       }
      },
      {
       "variable": {
        "name": "cy",
        "value": {
         "value": "@cyRaw",
         "anim": 1.2
        }
       }
      },
      {
       "variable": {
        "name": "hw",
        "value": "abs(@ax - @dx) / 2 + 70"
       }
      },
      {
       "variable": {
        "name": "hh",
        "value": "abs(@ay - @dy) / 2 + 70"
       }
      },
      {
       "variable": {
        "name": "s",
        "value": "min(componentWidth() / (2 * @hw), componentHeight() / (2 * @hh))"
       }
      },
      {
       "variable": {
        "name": "t",
        "value": "max(0, min(1, ((@cx - @dx) * @vx + (@cy - @dy) * @vy) / @len2))"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.surface"
         },
         {
          "style": "fill"
         }
        ]
       }
      },
      {
       "drawRect": {
        "left": 0,
        "top": 0,
        "right": "componentWidth()",
        "bottom": "componentHeight()"
       }
      },
      {
       "save": [
        {
         "translate": {
          "dx": "componentWidth() / 2 - @s * (@dx + @ax) / 2",
          "dy": "componentHeight() / 2 - @s * (@dy + @ay) / 2"
         }
        },
        {
         "scale": {
          "sx": "@s",
          "sy": "@s"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.surfaceHigh"
           },
           {
            "style": "fill"
           }
          ]
         }
        },
        {
         "drawRoundRect": {
          "left": 324,
          "top": 344,
          "right": 396,
          "bottom": 376,
          "rx": 8,
          "ry": 8
         }
        },
        {
         "drawRoundRect": {
          "left": 374,
          "top": 276,
          "right": 410,
          "bottom": 312,
          "rx": 8,
          "ry": 8
         }
        },
        {
         "drawRoundRect": {
          "left": 600,
          "top": 257,
          "right": 640,
          "bottom": 280,
          "rx": 8,
          "ry": 8
         }
        },
        {
         "drawRoundRect": {
          "left": 690,
          "top": 443,
          "right": 710,
          "bottom": 469,
          "rx": 8,
          "ry": 8
         }
        },
        {
         "drawRoundRect": {
          "left": 370,
          "top": 443,
          "right": 400,
          "bottom": 463,
          "rx": 8,
          "ry": 8
         }
        },
        {
         "drawRoundRect": {
          "left": 80,
          "top": 530,
          "right": 200,
          "bottom": 627,
          "rx": 8,
          "ry": 8
         }
        },
        {
         "drawRoundRect": {
          "left": 340,
          "top": 161,
          "right": 400,
          "bottom": 209,
          "rx": 8,
          "ry": 8
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.outline"
           },
           {
            "style": "stroke"
           },
           {
            "strokeWidth": "max(7, 7 / @s)"
           },
           {
            "strokeCap": "round"
           },
           {
            "strokeJoin": "round"
           }
          ]
         }
        },
        {
         "drawPath": {
          "path": "M -20 482 L 60 482 L 100 508 L 140 466 L 200 434 L 250 488 L 300 440 L 350 440 L 380 443 L 420 440 L 450 427 L 456 386 L 464 363 L 494 357 L 530 360 L 550 370 L 590 370 L 630 360 L 650 379 L 656 418 L 684 437 L 706 418 L 714 379 L 740 370 L 770 395 L 830 395 L 880 370 L 940 360 L 1020 370"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.muted"
           },
           {
            "strokeWidth": "4 / @s"
           }
          ]
         }
        },
        {
         "drawLine": {
          "x1": "@dx",
          "y1": "@dy",
          "x2": "@ax",
          "y2": "@ay"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.primary"
           },
           {
            "strokeWidth": "5 / @s"
           }
          ]
         }
        },
        {
         "drawLine": {
          "x1": "@dx",
          "y1": "@dy",
          "x2": "@dx + @t * (@ax - @dx)",
          "y2": "@dy + @t * (@ay - @dy)"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.onSurface"
           },
           {
            "style": "fill"
           }
          ]
         }
        },
        {
         "drawRect": {
          "left": "@dx - 8 / @s",
          "top": "@dy - 8 / @s",
          "right": "@dx + 8 / @s",
          "bottom": "@dy + 8 / @s"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.surface"
           }
          ]
         }
        },
        {
         "drawRect": {
          "left": "@dx - 4 / @s",
          "top": "@dy - 4 / @s",
          "right": "@dx + 4 / @s",
          "bottom": "@dy + 4 / @s"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.onSurface"
           }
          ]
         }
        },
        {
         "drawCircle": {
          "cx": "@ax",
          "cy": "@ay",
          "radius": "10 / @s"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.surface"
           }
          ]
         }
        },
        {
         "drawCircle": {
          "cx": "@ax",
          "cy": "@ay",
          "radius": "7 / @s"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.onSurface"
           }
          ]
         }
        },
        {
         "drawCircle": {
          "cx": "@ax",
          "cy": "@ay",
          "radius": "3.5 / @s"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.surface"
           }
          ]
         }
        },
        {
         "drawCircle": {
          "cx": "@cx",
          "cy": "@cy",
          "radius": "14 / @s"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.primary"
           }
          ]
         }
        },
        {
         "drawCircle": {
          "cx": "@cx",
          "cy": "@cy",
          "radius": "10 / @s"
         }
        }
       ]
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.outline"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": 1
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": 0.5,
        "top": 0.5,
        "right": "componentWidth() - 0.5",
        "bottom": "componentHeight() - 0.5",
        "rx": 16,
        "ry": 16
       }
      }
     ]
    }
   },
   "call": {
    "DeliveryMap": {}
   }
  },
  "EtaBlock": {
   "summary": "The ETA: N min, Arriving or Delivered",
   "params": {},
   "body": {
    "box": {
     "modifiers": [],
     "children": [
      {
       "text": {
        "value": {
         "type": "textMerge",
         "id1": {
          "type": "textFromFloat",
          "value": "max(1, round(@eta))",
          "whole": 3,
          "decimal": 0,
          "flags": 5
         },
         "id2": " min"
        },
        "fontSize": 28,
        "fontWeight": 700,
        "color": "@colors.onSurface",
        "modifiers": [
         {
          "visibility": "@showMin"
         }
        ]
       }
      },
      {
       "text": {
        "value": "Arriving",
        "fontSize": 28,
        "fontWeight": 700,
        "color": "@colors.primary",
        "modifiers": [
         {
          "visibility": "@arriving"
         }
        ]
       }
      },
      {
       "text": {
        "value": "Delivered",
        "fontSize": 28,
        "fontWeight": 700,
        "color": "@colors.success",
        "modifiers": [
         {
          "visibility": "@delivered"
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "EtaBlock": {}
   }
  }
 },
