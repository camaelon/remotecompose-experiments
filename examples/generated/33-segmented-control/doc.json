  "variables": {
   "view": {
    "value": 0,
    "export": true
   },
   "scroll": 0,
   "showDay": "1 - min(1, abs(@view))",
   "showWeek": "1 - min(1, abs(@view - 1))",
   "showMonth": "1 - min(1, abs(@view - 2))",
   "m": "calendarMonth()",
   "leap": "1 - min(1, year() % 4) - (1 - min(1, year() % 100)) + (1 - min(1, year() % 400))",
   "nd": "30 + (@m + floor(@m / 8)) % 2 - (1 - min(1, abs(@m - 2))) * (2 - @leap)",
   "nowHour": "timeInHr()",
   "today": "weekDay() - 1",
   "dom": "dayOfMonth() - 1",
   "dsum0": "arrayGet(@day, 0) * step(@nowHour + 0.5, 0) + arrayGet(@day, 1) * step(@nowHour + 0.5, 1) + arrayGet(@day, 2) * step(@nowHour + 0.5, 2)",
   "dsum1": "arrayGet(@day, 3) * step(@nowHour + 0.5, 3) + arrayGet(@day, 4) * step(@nowHour + 0.5, 4) + arrayGet(@day, 5) * step(@nowHour + 0.5, 5)",
   "dsum2": "arrayGet(@day, 6) * step(@nowHour + 0.5, 6) + arrayGet(@day, 7) * step(@nowHour + 0.5, 7) + arrayGet(@day, 8) * step(@nowHour + 0.5, 8)",
   "dsum3": "arrayGet(@day, 9) * step(@nowHour + 0.5, 9) + arrayGet(@day, 10) * step(@nowHour + 0.5, 10) + arrayGet(@day, 11) * step(@nowHour + 0.5, 11)",
   "dsum4": "arrayGet(@day, 12) * step(@nowHour + 0.5, 12) + arrayGet(@day, 13) * step(@nowHour + 0.5, 13) + arrayGet(@day, 14) * step(@nowHour + 0.5, 14)",
   "dsum5": "arrayGet(@day, 15) * step(@nowHour + 0.5, 15) + arrayGet(@day, 16) * step(@nowHour + 0.5, 16) + arrayGet(@day, 17) * step(@nowHour + 0.5, 17)",
   "dsum6": "arrayGet(@day, 18) * step(@nowHour + 0.5, 18) + arrayGet(@day, 19) * step(@nowHour + 0.5, 19) + arrayGet(@day, 20) * step(@nowHour + 0.5, 20)",
   "dsum7": "arrayGet(@day, 21) * step(@nowHour + 0.5, 21) + arrayGet(@day, 22) * step(@nowHour + 0.5, 22) + arrayGet(@day, 23) * step(@nowHour + 0.5, 23)",
   "dayTotal": "@dsum0 + @dsum1 + @dsum2 + @dsum3 + @dsum4 + @dsum5 + @dsum6 + @dsum7",
   "wsum0": "arrayGet(@week, 0) * step(@today + 0.5, 0) + arrayGet(@week, 1) * step(@today + 0.5, 1) + arrayGet(@week, 2) * step(@today + 0.5, 2)",
   "wsum1": "arrayGet(@week, 3) * step(@today + 0.5, 3) + arrayGet(@week, 4) * step(@today + 0.5, 4) + arrayGet(@week, 5) * step(@today + 0.5, 5)",
   "wsum2": "arrayGet(@week, 6) * step(@today + 0.5, 6)",
   "weekTotal": "@wsum0 + @wsum1 + @wsum2",
   "msum0": "arrayGet(@month, 0) * step(@dom + 0.5, 0) + arrayGet(@month, 1) * step(@dom + 0.5, 1) + arrayGet(@month, 2) * step(@dom + 0.5, 2)",
   "msum1": "arrayGet(@month, 3) * step(@dom + 0.5, 3) + arrayGet(@month, 4) * step(@dom + 0.5, 4) + arrayGet(@month, 5) * step(@dom + 0.5, 5)",
   "msum2": "arrayGet(@month, 6) * step(@dom + 0.5, 6) + arrayGet(@month, 7) * step(@dom + 0.5, 7) + arrayGet(@month, 8) * step(@dom + 0.5, 8)",
   "msum3": "arrayGet(@month, 9) * step(@dom + 0.5, 9) + arrayGet(@month, 10) * step(@dom + 0.5, 10) + arrayGet(@month, 11) * step(@dom + 0.5, 11)",
   "msum4": "arrayGet(@month, 12) * step(@dom + 0.5, 12) + arrayGet(@month, 13) * step(@dom + 0.5, 13) + arrayGet(@month, 14) * step(@dom + 0.5, 14)",
   "msum5": "arrayGet(@month, 15) * step(@dom + 0.5, 15) + arrayGet(@month, 16) * step(@dom + 0.5, 16) + arrayGet(@month, 17) * step(@dom + 0.5, 17)",
   "msum6": "arrayGet(@month, 18) * step(@dom + 0.5, 18) + arrayGet(@month, 19) * step(@dom + 0.5, 19) + arrayGet(@month, 20) * step(@dom + 0.5, 20)",
   "msum7": "arrayGet(@month, 21) * step(@dom + 0.5, 21) + arrayGet(@month, 22) * step(@dom + 0.5, 22) + arrayGet(@month, 23) * step(@dom + 0.5, 23)",
   "msum8": "arrayGet(@month, 24) * step(@dom + 0.5, 24) + arrayGet(@month, 25) * step(@dom + 0.5, 25) + arrayGet(@month, 26) * step(@dom + 0.5, 26)",
   "msum9": "arrayGet(@month, 27) * step(@dom + 0.5, 27) + arrayGet(@month, 28) * step(@dom + 0.5, 28) + arrayGet(@month, 29) * step(@dom + 0.5, 29)",
   "msum10": "arrayGet(@month, 30) * step(@dom + 0.5, 30)",
   "monthTotal": "@msum0 + @msum1 + @msum2 + @msum3 + @msum4 + @msum5 + @msum6 + @msum7 + @msum8 + @msum9 + @msum10"
  }
 },
