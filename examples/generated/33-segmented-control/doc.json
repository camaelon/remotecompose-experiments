{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "Activity summary with a Day, Week and Month view switcher"
 },
 "componentTheme": "auto",
 "components": {
  "PeriodBars": {
   "component": "PeriodBars",
   "version": 1,
   "summary": "Bars for the first `count` values of a float array, the bar at `highlight` (now: this hour, today) filled in the accent colour with a marker under it; optional static labels under the bars.",
   "params": {
    "values": {
     "type": "float",
     "required": true,
     "doc": "\"@name\" of a float array (host-exported)"
    },
    "count": {
     "type": "float",
     "required": true,
     "doc": "How many bars to draw (expression, e.g. days in this month)"
    },
    "highlight": {
     "type": "float",
     "default": -1,
     "doc": "Index of the highlighted bar (-1: none)"
    },
    "labels": {
     "type": "list",
     "doc": "Static labels under bars from index 0 (\"\" to skip one)"
    },
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "Highlighted bar colour"
    },
    "height": {
     "type": "float",
     "default": 200,
     "static": true,
     "doc": "Height in dp, labels included"
    },
    "label": {
     "type": "string",
     "default": "Bar chart",
     "doc": "Accessibility label"
    },
    "upTo": {
     "type": "float",
     "default": 1000,
     "doc": "Last index drawn (bars after it are the future: not drawn)"
    }
   },
   "locals": {
    "max": "max(arrayMax(@values), 0.001)",
    "base": 22
   },
   "call": {
    "PeriodBars": {
     "values": "@week",
     "count": 7,
     "highlight": 2,
     "labels": [
      "M",
      "T",
      "W",
      "T",
      "F",
      "S",
      "S"
     ],
     "label": "Steps per day this week"
    }
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxWidth",
      {
       "height": "@height"
      },
      {
       "semantics": {
        "contentDescription": "@label"
       }
      }
     ],
     "commands": [
      {
       "variable": {
        "name": "w",
        "value": "componentWidth() / @count"
       }
      },
      {
       "variable": {
        "name": "ph",
        "value": "componentHeight() - @base - 4"
       }
      },
      {
       "translate": {
        "dx": 0,
        "dy": "componentHeight() - @base"
       }
      },
      {
       "save": {
        "commands": [
         {
          "clipRect": {
           "left": 0,
           "top": "-componentHeight()",
           "right": "componentWidth()",
           "bottom": 0
          }
         },
         {
          "paint": {
           "ops": [
            {
             "$if": "theme.mono",
             "then": {
              "color": "@colors.onSurface"
             },
             "else": {
              "color": "@colors.muted"
             }
            },
            {
             "$if": "theme.mono",
             "then": {
              "style": "stroke"
             },
             "else": {
              "style": "fill"
             }
            },
            {
             "strokeWidth": 1.5
            }
           ]
          }
         },
         {
          "loop": {
           "index": "i",
           "from": 0,
           "until": "@count",
           "commands": [
            {
             "drawRoundRect": {
              "left": "(i + 0.15) * @w",
              "top": "-arrayGet(@values, i) * @ph / @max * (1 - step(i, @upTo + 0.5))",
              "right": "(i + 0.85) * @w",
              "bottom": 4,
              "rx": 3,
              "ry": 3
             }
            }
           ]
          }
         },
         {
          "paint": {
           "ops": [
            {
             "$if": "theme.mono",
             "then": {
              "color": "@colors.onSurface"
             },
             "else": {
              "color": "@color"
             }
            },
            {
             "style": "fill"
            }
           ]
          }
         },
         {
          "drawRoundRect": {
           "left": "(@highlight + 0.15) * @w",
           "top": "-arrayGet(@values, max(0, @highlight)) * @ph / @max",
           "right": "(@highlight + 0.85) * @w",
           "bottom": 4,
           "rx": 3,
           "ry": 3
          }
         }
        ]
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.outline"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": 1
         }
        ]
       }
      },
      {
       "drawLine": {
        "x1": 0,
        "y1": 0,
        "x2": "componentWidth()",
        "y2": 0
       }
      },
      {
       "paint": {
        "ops": [
         {
          "$if": "theme.mono",
          "then": {
           "color": "@colors.onSurface"
          },
          "else": {
           "color": "@color"
          }
         },
         {
          "style": "fill"
         }
        ]
       }
      },
      {
       "drawCircle": {
        "cx": "(@highlight + 0.5) * @w",
        "cy": 19,
        "radius": 2.5
       }
      },
      {
       "$if": "labels",
       "then": [
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.muted"
           },
           {
            "style": "fill"
           },
           {
            "textSize": 11
           }
          ]
         }
        },
        {
         "$each": "labels",
         "as": "text",
         "index": "k",
         "do": {
          "drawTextAnchored": {
           "text": "@text",
           "x": "(@k + 0.5) * @w",
           "y": 9,
           "panX": 0,
           "panY": 0
          }
         }
        }
       ]
      }
     ]
    }
   }
  }
 },
