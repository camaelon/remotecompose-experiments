   "activeMin": {
    "value": 34,
    "export": true
   },
   "activeGoal": {
    "value": 60,
    "export": true
   },
   "kcal": {
    "value": 1460,
    "export": true
   },
   "kcalGoal": {
    "value": 2200,
    "export": true
   },
   "z0": "1 - step(@hr, 99.5)",
   "z1": "step(@hr, 99.5) - step(@hr, 129.5)",
   "z2": "step(@hr, 129.5) - step(@hr, 159.5)",
   "z3": "step(@hr, 159.5)",
   "seg0": "1",
   "seg1": "0.25 + 0.75 * step(@hr, 99.5)",
   "seg2": "0.25 + 0.75 * step(@hr, 129.5)",
   "seg3": "0.25 + 0.75 * step(@hr, 159.5)",
   "hMin": "arrayMin(@hrHour)",
   "hMax": "arrayMax(@hrHour)",
   "varied": "step(@hMax - @hMin, 0.5)",
   "flat": "1 - @varied",
   "yLo": "max(0, floor((@hMin - 5) / 10) * 10)",
   "yHi": "ceil((@hMax + 5) / 10) * 10",
   "yMid": "(@yLo + @yHi) / 2",
   "aP": "min(1, @activeMin / max(1, @activeGoal))",
   "kP": "min(1, @kcal / max(1, @kcalGoal))",
   "aDone": "step(@activeMin, @activeGoal - 0.5)",
   "kDone": "step(@kcal, @kcalGoal - 0.5)",
   "layout": "step(windowHeight(), 300) + step(windowHeight(), 560) + step(windowWidth(), 600) * step(windowHeight(), 560)"
  }
