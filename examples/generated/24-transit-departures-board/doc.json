   "m5": "(@dep5 - timeInMin() + 2160) % 1440 - 720",
   "v5": "step(@dep5, -0.5) * step(@m5, -0.5)",
   "noneLeft": "1 - min(1, @v1 + @v2 + @v3 + @v4 + @v5)",
   "layout": "step(windowWidth(), 200)"
  },
