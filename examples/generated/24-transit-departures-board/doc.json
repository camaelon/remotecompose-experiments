             "else": "@colors.onLine"
            },
            "modifiers": [
             {
              "semantics": {
               "contentDescription": {
                "type": "textMerge",
                "id1": "Line ",
                "id2": "@line"
               }
              }
             },
             {
              "clip": {
               "roundedRect": 6
              }
             },
             {
              "background": {
               "$if": "theme.mono",
               "then": "@colors.primary",
               "else": "@color"
              }
             },
             {
              "padding": [
               5,
               1
              ]
             }
            ]
           }
          }
         ]
        }
       },
       {
        "text": {
         "value": "@dest",
         "fontSize": 14,
         "maxLines": 1,
         "overflow": "ellipsis",
         "color": "@colors.onSurface",
         "modifiers": [
          {
           "weight": 1
          },
          {
           "semantics": {
            "contentDescription": {
             "type": "textMerge",
             "id1": "to ",
             "id2": "@dest"
            }
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "width": 52
          }
         ],
         "horizontalAlignment": "end",
         "verticalAlignment": "center",
         "children": [
          {
           "text": {
            "value": "now",
            "fontSize": 14,
            "fontWeight": 700,
            "color": "@colors.primary",
            "modifiers": [
             {
              "visibility": "@isNow"
             },
             {
              "semantics": {
               "contentDescription": "departing now"
              }
             }
            ]
           }
          },
          {
           "text": {
            "value": "1 min",
            "fontSize": 14,
            "fontWeight": 700,
            "color": "@colors.onSurface",
            "modifiers": [
             {
              "visibility": "@isOne"
             },
             {
              "semantics": {
               "contentDescription": "in 1 minute"
              }
             }
            ]
           }
          },
          {
           "text": {
            "value": {
             "type": "textMerge",
             "id1": {
              "type": "textFromFloat",
              "value": "@mins",
              "whole": 3,
              "decimal": 0,
              "flags": 5
             },
             "id2": " min"
            },
            "fontSize": 14,
            "fontWeight": 700,
            "color": "@colors.onSurface",
            "modifiers": [
             {
              "visibility": "@later"
             },
             {
              "semantics": {
               "contentDescription": {
                "type": "textMerge",
                "id1": "in ",
                "id2": {
                 "type": "textMerge",
                 "id1": {
                  "type": "textFromFloat",
                  "value": "@mins",
                  "whole": 3,
                  "decimal": 0,
                  "flags": 5
                 },
                 "id2": " minutes"
                }
               }
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    }
   },
   "call": {
    "Departure": {
     "line": "42",
     "dest": "Central",
     "mins": 5,
     "shown": 1
    }
