{
 "header": {
  "apiLevel": 7,
  "width": 320,
  "height": 160,
  "profiles": 513,
  "contentDescription": "Bus departures: the next buses at this stop with minutes until each leaves"
 },
 "components": {
  "Departure": {
   "summary": "One departure row: line badge, destination, live minutes until departure; hidden when gone or empty",
   "params": {
    "line": {
     "type": "text",
     "required": true,
     "doc": "line number (text variable)"
    },
    "dest": {
     "type": "text",
     "required": true,
     "doc": "destination (text variable)"
    },
    "mins": {
     "type": "float",
     "required": true,
     "doc": "minutes until departure, computed in the document"
    },
    "shown": {
     "type": "float",
     "required": true,
     "doc": "declared variable: 1 when the slot holds a departure not yet gone"
    },
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "badge colour"
    },
    "priority": {
     "type": "float",
     "default": 1,
     "static": true,
     "doc": "collapsible priority (lowest dropped first)"
    },
    "style": {
     "type": "enum",
     "values": [
      "wide",
      "compact"
     ],
     "default": "wide",
     "doc": "wide: one line; compact: destination over minutes"
    }
   },
   "locals": {
    "isNow": "1 - step(@mins, 0.5)",
    "isOne": "step(@mins, 0.5) - step(@mins, 1.5)",
    "later": "step(@mins, 1.5)"
   },
   "body": {
    "$if": "style == 'compact'",
    "then": {
     "row": {
      "modifiers": [
       "fillMaxWidth",
       {
        "visibility": "@shown"
       },
       {
        "collapsiblePriority": {
         "orientation": "vertical",
         "priority": "@priority"
        }
       },
       {
        "padding": [
         0,
         2
        ]
       }
      ],
      "verticalAlignment": "center",
      "children": [
       {
        "box": {
         "modifiers": [
          {
           "width": 40
          }
         ],
         "horizontalAlignment": "start",
         "verticalAlignment": "center",
         "children": [
          {
           "text": {
            "value": "@line",
            "fontSize": 12,
            "fontWeight": 700,
            "maxLines": 1,
            "color": {
             "$if": "theme.mono",
             "then": "@colors.onPrimary",
             "else": "@colors.onLine"
            },
            "modifiers": [
             {
              "semantics": {
               "contentDescription": {
                "type": "textMerge",
                "id1": "Line ",
                "id2": "@line"
               }
              }
             },
             {
              "clip": {
               "roundedRect": 6
              }
             },
             {
              "background": {
               "$if": "theme.mono",
               "then": "@colors.primary",
               "else": "@color"
              }
             },
             {
              "padding": [
               5,
               1
              ]
             }
            ]
           }
          }
         ]
        }
       },
       {
        "column": {
         "modifiers": [
          {
           "weight": 1
          }
         ],
         "horizontalAlignment": "start",
         "children": [
          {
           "text": {
            "value": "@dest",
            "fontSize": 12,
            "maxLines": 1,
            "overflow": "ellipsis",
            "color": "@colors.onSurface",
            "modifiers": [
             {
              "semantics": {
               "contentDescription": {
                "type": "textMerge",
                "id1": "to ",
                "id2": "@dest"
               }
              }
             }
            ]
           }
          },
          {
           "box": {
            "children": [
             {
              "text": {
               "value": "now",
               "fontSize": 12,
               "fontWeight": 700,
               "color": "@colors.primary",
               "modifiers": [
                {
                 "visibility": "@isNow"
                },
                {
                 "semantics": {
                  "contentDescription": "departing now"
                 }
                }
               ]
              }
             },
             {
              "text": {
               "value": "1 min",
               "fontSize": 12,
               "fontWeight": 700,
               "color": "@colors.muted",
               "modifiers": [
                {
                 "visibility": "@isOne"
                },
                {
                 "semantics": {
                  "contentDescription": "in 1 minute"
                 }
                }
               ]
              }
             },
             {
              "text": {
               "value": {
                "type": "textMerge",
                "id1": {
                 "type": "textFromFloat",
                 "value": "@mins",
                 "whole": 3,
                 "decimal": 0,
                 "flags": 5
                },
                "id2": " min"
               },
               "fontSize": 12,
               "fontWeight": 700,
               "color": "@colors.muted",
               "modifiers": [
                {
                 "visibility": "@later"
                },
                {
                 "semantics": {
                  "contentDescription": {
                   "type": "textMerge",
                   "id1": "in ",
                   "id2": {
                    "type": "textMerge",
                    "id1": {
                     "type": "textFromFloat",
                     "value": "@mins",
                     "whole": 3,
                     "decimal": 0,
                     "flags": 5
                    },
                    "id2": " minutes"
                   }
                  }
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    },
    "else": {
     "row": {
      "modifiers": [
       "fillMaxWidth",
       {
        "visibility": "@shown"
       },
       {
        "collapsiblePriority": {
         "orientation": "vertical",
         "priority": "@priority"
        }
       },
       {
        "padding": [
         0,
         3
        ]
       }
      ],
      "verticalAlignment": "center",
      "children": [
       {
        "box": {
         "modifiers": [
          {
           "width": 44
          }
         ],
         "horizontalAlignment": "start",
         "verticalAlignment": "center",
         "children": [
          {
           "text": {
            "value": "@line",
            "fontSize": 13,
            "fontWeight": 700,
            "maxLines": 1,
            "color": {
             "$if": "theme.mono",
