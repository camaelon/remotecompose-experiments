{
 "header": {
  "apiLevel": 7,
  "width": 192,
  "height": 192,
  "profiles": 513,
  "contentDescription": "Always-on watch face: time, date and battery"
 },
 "resources": {
  "variables": {
   "battery": {
    "value": 76,
    "export": true
   },
   "side": "min(windowWidth(), windowHeight())",
   "timeSize": "@side * 0.24",
   "dateSize": "@side * 0.085",
   "smallSize": "@side * 0.065",
   "low": "1 - step(@battery, 14.5)"
  },
  "colors": {
   "background": {
    "light": "#FFFFFFFF",
    "dark": "#FF000000"
   }
  }
 },
 "root": {
  "box": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    }
   ],
   "horizontalAlignment": "center",
   "verticalAlignment": "center",
   "children": [
    {
     "canvas": {
      "modifiers": [
       {
        "size": 0
       }
      ],
      "commands": [
       {
        "global": {
         "commands": [
          {
           "textSubtext": {
            "text": "MONTUEWEDTHUFRISATSUN",
            "start": "(weekDay() - 1) * 3",
            "len": 3,
            "varName": "dayShort"
           }
          },
          {
           "textSubtext": {
            "text": "Monday   Tuesday  WednesdayThursday Friday   Saturday Sunday   ",
            "start": "(weekDay() - 1) * 9",
            "len": 9,
            "varName": "day9"
           }
          },
          {
           "textTransform": {
            "text": "@day9",
            "start": 0,
            "len": -1,
            "operation": 3,
            "varName": "dayName"
           }
          }
         ]
        }
       }
      ]
     }
    },
    {
     "column": {
      "horizontalAlignment": "center",
      "verticalArrangement": "center",
      "children": [
       {
        "text": {
         "value": {
          "type": "textMerge",
          "id1": {
           "type": "textMerge",
           "id1": "@dayShort",
           "id2": " "
          },
          "id2": {
           "type": "textFromFloat",
           "value": "dayOfMonth()",
           "whole": 2,
           "decimal": 0,
           "flags": 5
          }
         },
         "fontSize": "@dateSize",
         "fontWeight": 400,
         "color": "@colors.muted",
         "letterSpacing": 0.08,
         "maxLines": 1,
         "modifiers": [
          {
           "semantics": {
            "contentDescription": {
             "type": "textMerge",
             "id1": {
              "type": "textMerge",
              "id1": "@dayName",
              "id2": " "
             },
             "id2": {
              "type": "textFromFloat",
              "value": "dayOfMonth()",
              "whole": 2,
              "decimal": 0,
              "flags": 5
             }
            }
           }
          }
         ]
        }
       },
       {
        "text": {
         "value": {
          "type": "textMerge",
          "id1": {
           "type": "textMerge",
           "id1": {
            "type": "textFromFloat",
            "value": "timeInHr()",
            "whole": 2,
            "decimal": 0,
            "flags": 12
           },
           "id2": ":"
          },
          "id2": {
           "type": "textFromFloat",
           "value": "timeInMin() % 60",
           "whole": 2,
           "decimal": 0,
           "flags": 12
          }
         },
         "fontSize": "@timeSize",
         "fontWeight": 200,
         "color": "@colors.onSurface",
         "maxLines": 1
        }
       },
       {
        "row": {
         "verticalAlignment": "center",
         "modifiers": [
          {
           "spacedBy": 4
          }
         ],
         "children": [
          {
           "BatteryIndicator": {
            "level": "@battery",
            "size": 26,
            "fontSize": 12,
            "warnAt": 30,
            "lowAt": 15,
            "label": "Battery"
           }
          },
          {
           "box": {
            "modifiers": [
             {
              "visibility": "@low"
             }
            ],
            "children": [
             {
              "text": {
               "text": "LOW",
               "fontSize": "@smallSize",
               "fontWeight": 500,
               "color": "@colors.onSurface",
               "maxLines": 1
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 }
}