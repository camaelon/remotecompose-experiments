 "resources": {
  "variables": {
   "depDay": {
    "value": 20757,
    "export": true
   },
   "depMin": {
    "value": 1235,
    "export": true
   },
   "arrDay": {
    "value": 20758,
    "export": true
   },
   "arrMin": {
    "value": 570,
    "export": true
   },
   "depOff": {
    "value": 60,
    "export": true
   },
   "arrOff": {
    "value": 480,
    "export": true
   },
   "progress": {
    "value": 0.42,
    "export": true
   },
   "status": {
    "value": 2,
    "export": true
   },
   "delayMin": {
    "value": 0,
    "export": true
   },
   "yr": "year()",
   "today": "365 * (@yr - 1970) + floor((@yr - 1969) / 4) - floor((@yr - 1901) / 100) + floor((@yr - 1601) / 400) + dayOfYear() - 1",
   "nowRaw": "timeInMin() - floor(offsetToUtc() / 60)",
   "nowDay": "@today + floor(@nowRaw / 1440)",
   "nowMin": "@nowRaw - 1440 * floor(@nowRaw / 1440)",
   "toDep": "(@depDay - @nowDay) * 1440 + @depMin - @nowMin",
   "toArr": "(@arrDay - @nowDay) * 1440 + @arrMin - @nowMin",
   "started": "1 - step(@toDep, 1)",
   "landed": "1 - step(@toArr, 1)",
   "phase": "@started + @landed",
   "notLanded": "step(@toArr, 1)",
   "dur": "max(0, @toDep * (1 - @started) + @toArr * @started)",
   "durH": "floor(@dur / 60)",
   "durM": "floor(@dur % 60)",
   "depLoc": "@depMin + @depOff",
   "arrLoc": "@arrMin + @arrOff",
   "depLocDay": "@depDay + floor(@depLoc / 1440)",
   "arrLocDay": "@arrDay + floor(@arrLoc / 1440)",
   "depM": "@depLoc - 1440 * floor(@depLoc / 1440)",
   "arrM": "@arrLoc - 1440 * floor(@arrLoc / 1440)",
   "depH": "floor(@depM / 60)",
   "depMm": "@depM % 60",
   "arrH": "floor(@arrM / 60)",
   "arrMm": "@arrM % 60",
   "depWd": "(@depLocDay + 3) % 7",
   "arrWd": "(@arrLocDay + 3) % 7",
   "isDelayed": "step(@delayMin, 1)",
   "layoutIdx": "max(2 - step(windowHeight(), 300) - step(windowHeight(), 140), 3 - 3 * step(windowWidth(), 240))"
  }
 },
