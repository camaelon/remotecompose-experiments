 "components": {
  "CalDot": {
   "summary": "The event's calendar colour as a small dot; the plain onSurface dot in mono (host colours do not survive always-on)",
   "params": {
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "Calendar colour"
    },
    "size": {
     "type": "float",
     "default": 8,
     "static": true,
     "doc": "Diameter dp"
    }
   },
   "body": {
    "box": {
     "modifiers": [
      {
       "size": "@size"
      },
      {
       "clip": {
        "roundedRect": "@size / 2"
       }
      },
      {
       "background": {
        "$if": "theme.mono",
        "then": "@colors.onSurface",
        "else": "@color"
       }
      }
     ]
    }
   },
   "call": {
    "CalDot": {
     "color": "@colors.calColor"
    }
   }
  }
 }
