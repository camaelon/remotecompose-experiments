{
 "header": {
  "apiLevel": 7,
  "width": 200,
  "height": 200,
  "profiles": 513,
  "contentDescription": "Next calendar event tile"
 },
 "resources": {
  "colors": {
   "calColor": {
    "value": "#FF4285F4",
    "mono-dark": "#FFFFFFFF",
    "mono-light": "#FF000000"
   }
  },
  "variables": {
   "hasEvent": {
    "value": 1,
    "export": true
   },
   "startDay": {
    "value": 20757,
    "export": true
   },
   "startMin": {
    "value": 670,
    "export": true
   },
   "endDay": {
    "value": 20757,
    "export": true
   },
   "endMin": {
    "value": 720,
    "export": true
   },
   "y": "year()",
   "e1": "365 * (@y - 1970) + floor((@y - 1969) / 4)",
   "today": "@e1 - floor((@y - 1901) / 100) + floor((@y - 1601) / 400) + dayOfYear() - 1",
   "dd": "@startDay - @today",
   "toStart": "@dd * 1440 + @startMin - timeInMin()",
   "toEnd": "(@endDay - @today) * 1440 + @endMin - timeInMin()",
   "vNone": "1 - @hasEvent",
   "vEnded": "@hasEvent * (1 - step(@toEnd, 0))",
   "vNow": "@hasEvent * step(@toEnd, 0) * (1 - step(@toStart, 0))",
   "vSoon": "@hasEvent * step(@toStart, 0) * (1 - step(@toStart, 59.5))",
   "vToday": "@hasEvent * step(@toStart, 59.5) * (1 - min(1, abs(@dd)))",
   "vTomorrow": "@hasEvent * step(@toStart, 59.5) * (1 - min(1, abs(@dd - 1)))",
   "vLater": "@hasEvent * step(@toStart, 59.5) * step(@dd, 1.5)",
   "wd": "(@startDay + 3) % 7",
   "inner": "0.74 * min(windowWidth(), windowHeight())"
  }
 },
