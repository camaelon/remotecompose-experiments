  "OnboardPage": {
   "summary": "One onboarding page: an illustration over (or, on a wide window, beside) a title and a short body",
   "params": {
    "kind": {
     "type": "enum",
     "values": [
      "plan",
      "sync",
      "secure"
     ],
     "default": "plan",
     "static": true,
     "doc": "Illustration"
    },
    "title": {
     "type": "string",
     "required": true,
     "doc": "Title"
    },
    "body": {
     "type": "string",
     "required": true,
     "doc": "Body"
    }
   },
   "body": {
    "stateLayout": {
     "indexId": "@wide",
     "modifiers": [
      "fillMaxSize"
     ],
     "children": [
      {
       "column": {
        "modifiers": [
