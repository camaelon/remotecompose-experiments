                "enterAnimation": "FADE_IN",
                "exitAnimation": "FADE_OUT",
                "enterSequence": "AFTER",
                "exitSequence": "BEFORE"
               }
              }
             ],
             "children": [
              {
               "OnboardPage": {
                "kind": "secure",
                "title": "@title3",
                "body": "@body3"
               }
              }
             ]
            }
           }
          ]
         }
        },
        {
         "box": {
          "modifiers": [
           {
            "padding": [
             0,
             16
            ]
           },
           {
            "semantics": {
             "contentDescription": {
              "type": "textMerge",
              "id1": "Page ",
              "id2": {
               "type": "textMerge",
               "id1": {
                "type": "textFromFloat",
                "value": "@pageNum",
                "whole": 1,
                "decimal": 0,
                "flags": 5
               },
               "id2": " of 3"
              }
             }
            }
           }
          ],
          "children": [
           {
