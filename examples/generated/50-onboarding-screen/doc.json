             "Illustration": {
              "kind": "@kind"
             }
            }
           ]
          }
         },
         {
          "spacer": {
           "modifiers": [
            {
             "width": 32
            }
           ]
          }
         },
         {
          "column": {
           "modifiers": [
            {
             "weight": 1
            }
           ],
           "children": [
            {
             "text": {
              "value": "@title",
              "fontSize": 26,
              "fontWeight": 700,
              "color": "@colors.onSurface",
              "textAlign": "start",
              "modifiers": [
               "fillMaxWidth"
              ]
             }
            },
            {
             "spacer": {
              "modifiers": [
               {
                "height": 12
               }
              ]
             }
            },
            {
             "text": {
              "value": "@body",
              "fontSize": 16,
              "color": "@colors.muted",
              "textAlign": "start",
              "modifiers": [
               "fillMaxWidth"
              ]
