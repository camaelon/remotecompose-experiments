              8,
              8,
              8,
              24
             ]
            }
           ],
           "children": [
            {
             "Illustration": {
              "kind": "@kind"
             }
            }
           ]
          }
         },
         {
          "text": {
           "value": "@title",
           "fontSize": 26,
           "fontWeight": 700,
           "color": "@colors.onSurface",
           "textAlign": "center",
           "modifiers": [
            "fillMaxWidth"
           ]
          }
         },
         {
          "spacer": {
           "modifiers": [
            {
             "height": 12
            }
           ]
          }
         },
         {
          "text": {
           "value": "@body",
           "fontSize": 16,
           "color": "@colors.muted",
           "textAlign": "center",
           "modifiers": [
            "fillMaxWidth"
           ]
          }
         },
         {
          "spacer": {
           "modifiers": [
            {
             "height": 8
            }
           ]
          }
         }
        ],
        "verticalArrangement": "center"
       }
      },
      {
       "row": {
        "modifiers": [
         "fillMaxSize",
         {
          "padding": [
           32,
           8
          ]
         }
        ],
        "verticalAlignment": "center",
