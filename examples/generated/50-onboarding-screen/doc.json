 },
 "resources": {
  "variables": {
   "page": {
    "value": 0,
    "export": true
   },
   "pxStart": 0,
   "pageNum": "@page + 1",
   "on0": "1 - min(1, abs(@page - 0))",
   "on1": "1 - min(1, abs(@page - 1))",
   "on2": "1 - min(1, abs(@page - 2))",
   "notLast": "min(1, abs(@page - 2))",
   "wide": "step(windowWidth(), windowHeight() * 1.2)",
   "illoH": "min(windowWidth() * 0.85, windowHeight() * 0.4)"
  }
 },
 "root": [
  {
   "variable": {
    "name": "title1",
    "vtype": "string",
    "value": "Plan your week",
    "export": true
   }
  },
  {
   "variable": {
    "name": "body1",
    "vtype": "string",
    "value": "See everything coming up in one calm, simple calendar.",
    "export": true
   }
  },
  {
   "variable": {
    "name": "title2",
    "vtype": "string",
    "value": "Stay in sync",
    "export": true
   }
  },
  {
   "variable": {
    "name": "body2",
    "vtype": "string",
    "value": "Your plans follow you to every device, instantly and automatically.",
    "export": true
   }
