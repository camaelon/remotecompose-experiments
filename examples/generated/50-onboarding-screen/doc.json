            }
           }
          ]
         }
        },
        {
         "box": {
          "modifiers": [
           {
            "widthIn": [
             0,
             440
            ]
           },
           "fillMaxWidth",
           {
            "padding": [
             24,
             0
            ]
           }
          ],
          "children": [
           {
            "box": {
             "modifiers": [
              "fillMaxWidth",
