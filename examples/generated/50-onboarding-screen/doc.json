                "enterAnimation": "FADE_IN",
                "exitAnimation": "FADE_OUT",
                "enterSequence": "AFTER",
                "exitSequence": "BEFORE"
               }
              }
             ],
             "children": [
              {
               "OnboardPage": {
                "kind": "plan",
                "title": "@title1",
                "body": "@body1"
               }
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              "fillMaxSize",
              {
               "visibility": "@on1"
              },
              {
               "animationSpec": {
                "motionDuration": 300,
