{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "Stopwatch with Start, Stop, Lap and Reset buttons and a list of the last five laps"
 },
 "resources": {
  "variables": {
   "running": {
    "value": 0,
    "export": true
   },
   "startAt": {
    "value": 0,
    "export": true
   },
   "accumulated": {
    "value": 0,
    "export": true
   },
   "lapCount": {
    "value": 0,
    "export": true
   },
   "minLap": {
    "value": 1000000,
    "export": true
   },
   "maxLap": {
    "value": 0,
    "export": true
   },
   "l1": {
    "value": 0,
    "export": true
   },
   "l2": {
    "value": 0,
    "export": true
   },
   "l3": {
    "value": 0,
    "export": true
   },
   "l4": {
    "value": 0,
    "export": true
   },
   "l5": {
    "value": 0,
    "export": true
   },
   "l6": {
    "value": 0,
    "export": true
   },
   "scroll": 0,
   "now": "timeInMin() * 60 + continuousSec() % 60",
   "elapsed": "@accumulated + @running * ((@now - @startAt + 86400) % 86400)",
   "overHour": "step(@elapsed, 3599.99)",
   "underHour": "1 - @overHour",
   "canReset": "(1 - @running) * step(@accumulated, 0)",
   "canLapReset": "@running + @canReset",
   "noLaps": "1 - step(@lapCount, 0.5)",
   "marks": "step(@lapCount, 2.5)",
   "layout": "step(windowWidth(), 259) * step(windowHeight(), 399)",
   "show1": "step(@lapCount, 0.5)",
   "num1": "@lapCount - 0",
   "t1": "@l1 - @l2",
   "totLong1": "step(@l1, 3599.99)",
   "totShort1": "1 - @totLong1",
   "fast1": "@marks * (1 - step(abs(@t1 - @minLap), 0.001))",
   "slow1": "@marks * (1 - step(abs(@t1 - @maxLap), 0.001))",
   "show2": "step(@lapCount, 1.5)",
   "num2": "@lapCount - 1",
   "t2": "@l2 - @l3",
   "totLong2": "step(@l2, 3599.99)",
   "totShort2": "1 - @totLong2",
   "fast2": "@marks * (1 - step(abs(@t2 - @minLap), 0.001))",
   "slow2": "@marks * (1 - step(abs(@t2 - @maxLap), 0.001))",
   "show3": "step(@lapCount, 2.5)",
   "num3": "@lapCount - 2",
   "t3": "@l3 - @l4",
   "totLong3": "step(@l3, 3599.99)",
   "totShort3": "1 - @totLong3",
   "fast3": "@marks * (1 - step(abs(@t3 - @minLap), 0.001))",
   "slow3": "@marks * (1 - step(abs(@t3 - @maxLap), 0.001))",
   "show4": "step(@lapCount, 3.5)",
   "num4": "@lapCount - 3",
   "t4": "@l4 - @l5",
   "totLong4": "step(@l4, 3599.99)",
   "totShort4": "1 - @totLong4",
   "fast4": "@marks * (1 - step(abs(@t4 - @minLap), 0.001))",
   "slow4": "@marks * (1 - step(abs(@t4 - @maxLap), 0.001))",
   "show5": "step(@lapCount, 4.5)",
   "num5": "@lapCount - 4",
   "t5": "@l5 - @l6",
   "totLong5": "step(@l5, 3599.99)",
   "totShort5": "1 - @totLong5",
   "fast5": "@marks * (1 - step(abs(@t5 - @minLap), 0.001))",
   "slow5": "@marks * (1 - step(abs(@t5 - @maxLap), 0.001))"
  }
 },
