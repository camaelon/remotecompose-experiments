 "root": {
  "box": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    }
   ],
   "children": [
    {
     "canvas": {
      "modifiers": [
       {
        "size": 0
       }
      ],
      "commands": [
       {
        "global": {
         "commands": [
          {
           "textSubtext": {
            "text": "Start Stop  ",
            "start": "@running * 6",
            "len": 6,
            "varName": "toggleLabel6"
           }
          },
          {
           "textTransform": {
            "text": "@toggleLabel6",
            "start": 0,
            "len": -1,
            "operation": 3,
            "varName": "toggleLabel"
           }
          },
          {
           "textSubtext": {
            "text": "Reset Lap   ",
            "start": "@running * 6",
            "len": 6,
            "varName": "lrLabel6"
           }
          },
          {
           "textTransform": {
            "text": "@lrLabel6",
            "start": 0,
            "len": -1,
            "operation": 3,
            "varName": "lrLabel"
           }
          }
         ]
        }
       }
      ]
     }
    },
    {
     "stateLayout": {
      "indexId": "@layout",
      "modifiers": [
       "fillMaxSize"
      ],
      "children": [
       {
        "column": {
         "horizontalAlignment": "center",
         "verticalArrangement": "center",
         "modifiers": [
          "fillMaxSize",
          {
           "padding": 12
          },
          {
           "spacedBy": 4
          }
         ],
         "children": [
          {
           "ElapsedText": {
            "size": 30
           }
          },
          {
           "text": {
            "value": {
             "type": "textMerge",
             "id1": "Lap ",
             "id2": {
              "type": "textMerge",
              "id1": {
               "type": "textFromFloat",
               "value": "@num1",
               "whole": 3,
               "decimal": 0,
               "flags": 5
              },
              "id2": {
               "type": "textMerge",
               "id1": "  ",
               "id2": {
                "type": "textMerge",
                "id1": {
                 "type": "textFromFloat",
                 "value": "floor(@t1 / 60)",
                 "whole": 3,
                 "decimal": 0,
                 "flags": 5
                },
                "id2": {
                 "type": "textMerge",
                 "id1": ":",
                 "id2": {
                  "type": "textMerge",
                  "id1": {
                   "type": "textFromFloat",
                   "value": "floor(@t1 % 60)",
                   "whole": 2,
                   "decimal": 0,
                   "flags": 13
                  },
                  "id2": {
                   "type": "textMerge",
                   "id1": ".",
                   "id2": {
                    "type": "textFromFloat",
                    "value": "floor(@t1 * 100) % 100",
                    "whole": 2,
                    "decimal": 0,
                    "flags": 13
                   }
                  }
                 }
                }
               }
              }
             }
            },
            "fontSize": 13,
            "color": "@colors.muted",
            "maxLines": 1,
            "modifiers": [
             {
              "visibility": "@show1"
             }
            ]
           }
          },
          {
           "row": {
            "verticalAlignment": "center",
            "modifiers": [
             {
              "spacedBy": 6
             }
            ],
            "children": [
             {
              "Button": {
               "label": "@lrLabel",
               "style": "outlined",
               "enabled": "@canLapReset",
               "onClick": [
                {
                 "type": "hostNamedAction",
                 "name": "watchLapOrReset",
                 "value": "@elapsed",
                 "valueType": "float"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@minLap",
                 "value": "@running * min(@minLap, @elapsed - @l1) + (1 - @running) * 1000000"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@maxLap",
                 "value": "@running * max(@maxLap, @elapsed - @l1)"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l6",
                 "value": "@running * @l5"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l5",
                 "value": "@running * @l4"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l4",
                 "value": "@running * @l3"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l3",
                 "value": "@running * @l2"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l2",
                 "value": "@running * @l1"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l1",
                 "value": "@running * @elapsed"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@lapCount",
                 "value": "@running * (@lapCount + 1)"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@accumulated",
                 "value": "@running * @accumulated"
                }
               ]
              }
             },
             {
              "Button": {
               "label": "@toggleLabel",
               "onClick": [
                {
                 "type": "hostNamedAction",
                 "name": "watchStartStop",
                 "value": "@elapsed",
                 "valueType": "float"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@accumulated",
                 "value": "@elapsed + 0"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@startAt",
                 "value": "timeInMin() * 60 + continuousSec() % 60"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@running",
                 "value": "1 - @running"
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       },
       {
        "column": {
         "horizontalAlignment": "center",
         "modifiers": [
          "fillMaxSize",
          {
           "verticalScroll": "@scroll"
          },
          {
           "padding": 16
          },
          {
           "spacedBy": 12
          }
         ],
         "children": [
          {
           "row": {
            "verticalAlignment": "center",
            "modifiers": [
             "fillMaxWidth"
            ],
            "children": [
             {
              "Icon": {
               "name": "timer",
               "color": "@colors.primary"
              }
             },
             {
              "text": {
               "value": "Stopwatch",
               "fontSize": 20,
               "color": "@colors.onSurface",
               "modifiers": [
                {
                 "padding": [
                  8,
                  0
                 ]
                }
               ]
              }
             }
            ]
           }
          },
          {
           "box": {
            "horizontalAlignment": "center",
            "verticalAlignment": "center",
            "modifiers": [
             "fillMaxWidth",
             {
              "height": 120
             }
            ],
            "children": [
             {
              "ElapsedText": {
               "size": 56
              }
             }
            ]
           }
          },
          {
           "row": {
            "verticalAlignment": "center",
            "modifiers": [
             {
              "spacedBy": 12
             }
            ],
            "children": [
             {
              "Button": {
               "label": "Reset",
               "style": "outlined",
               "enabled": "@canReset",
               "onClick": [
                {
                 "type": "hostNamedAction",
                 "name": "reset",
                 "value": "@elapsed",
                 "valueType": "float"
                },
                {
                 "type": "valueFloatChange",
                 "target": "@running",
                 "value": 0
                },
                {
                 "type": "valueFloatChange",
                 "target": "@accumulated",
                 "value": 0
                },
                {
                 "type": "valueFloatChange",
