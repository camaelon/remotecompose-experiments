              "box": {
               "horizontalAlignment": "center",
               "modifiers": [
                {
                 "width": 112
                }
               ],
               "children": [
                {
                 "Button": {
                  "label": "@toggleLabel",
                  "onClick": [
                   {
                    "type": "hostNamedAction",
                    "name": "startStop",
                    "value": "@elapsed",
                    "valueType": "float"
                   },
                   {
                    "type": "valueFloatExpressionChange",
                    "target": "@accumulated",
                    "value": "@elapsed + 0"
                   },
                   {
                    "type": "valueFloatExpressionChange",
                    "target": "@startAt",
                    "value": "timeInMin() * 60 + continuousSec() % 60"
                   },
                   {
                    "type": "valueFloatExpressionChange",
                    "target": "@running",
                    "value": "1 - @running"
                   }
                  ]
                 }
                }
               ]
              }
             },
             {
              "Button": {
               "label": "Lap",
               "style": "outlined",
               "enabled": "@running",
               "onClick": [
                {
                 "type": "hostNamedAction",
                 "name": "lap",
                 "value": "@elapsed",
                 "valueType": "float"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@minLap",
                 "value": "min(@minLap, @elapsed - @l1)"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@maxLap",
                 "value": "max(@maxLap, @elapsed - @l1)"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l6",
                 "value": "@l5 + 0"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l5",
                 "value": "@l4 + 0"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l4",
                 "value": "@l3 + 0"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l3",
                 "value": "@l2 + 0"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l2",
                 "value": "@l1 + 0"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@l1",
                 "value": "@elapsed + 0"
                },
                {
                 "type": "valueFloatExpressionChange",
                 "target": "@lapCount",
                 "value": "@lapCount + 1"
                }
               ]
              }
             }
            ]
