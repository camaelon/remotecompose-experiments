      {
       "text": {
        "value": "@title",
        "fontSize": "@size",
        "fontWeight": 400,
        "maxLines": "@lines",
        "overflow": "ellipsis",
        "color": "@colors.onSurface",
        "modifiers": [
         {
          "weight": 1
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "AgendaRow": {
     "time": "09:30",
