{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 720,
  "profiles": 513,
  "contentDescription": "Tip calculator"
 },
 "resources": {
  "variables": {
   "bill": {
    "value": 0,
    "export": true
   },
   "people": {
    "value": 1,
    "export": true
   },
   "tip10": {
    "value": 0,
    "export": true
   },
   "tip15": {
    "value": 1,
    "export": true
   },
   "tip20": {
    "value": 0,
    "export": true
   },
   "not10": "1 - @tip10",
   "not15": "1 - @tip15",
   "not20": "1 - @tip20",
   "scroll": 0,
   "contentW": "min(560, windowWidth() - 32)",
   "pct": {
    "value": "@tip10 * 10 + @tip15 * 15 + @tip20 * 20",
    "export": true
   },
   "billC": "round(@bill * 100)",
   "tipC": "round(@bill * @pct)",
   "tipAmt": {
    "value": "@tipC / 100",
    "export": true
   },
   "total": {
    "value": "(@billC + @tipC) / 100",
    "export": true
   },
   "each": {
    "value": "round((@billC + @tipC) / max(1, @people)) / 100",
    "export": true
   },
   "billEmpty": "1 - step(@bill, 0.005)",
   "billSet": "step(@bill, 0.005)"
  }
 },
 "components": {
  "ResultRow": {
   "params": {
    "label": {
     "type": "string",
     "required": true
    },
    "amount": {
     "type": "float",
     "required": true
    },
    "size": {
     "type": "float",
     "default": 18
    },
    "weight": {
     "type": "float",
     "default": 500
    }
   },
   "body": {
    "row": {
