{
 "header": {
  "apiLevel": 7,
  "width": 320,
  "height": 170,
  "profiles": 513,
  "contentDescription": "Stock ticker: three stocks with price, percent change and price trend"
 },
 "components": {
  "StockRow": {
   "summary": "One stock line: symbol and price, a sparkline, and the percent change coloured and arrowed by its sign (up / down / flat); three layouts for wide, short and narrow widgets",
   "params": {
    "symbol": {
     "type": "string",
     "required": true,
     "doc": "The ticker symbol: a literal or a string variable (\"@sym1\") as the whole value"
    },
    "price": {
     "type": "float",
     "required": true,
     "doc": "Last price, a float variable"
    },
    "change": {
     "type": "float",
     "required": true,
     "doc": "Change in percent (positive up, negative down), a float variable"
    },
    "values": {
     "type": "float",
     "required": true,
     "doc": "The sparkline series, \"@name\" of resources.floatArrays"
    },
    "label": {
     "type": "string",
     "default": "Price history",
     "doc": "Accessibility label of the sparkline"
    },
    "layout": {
     "type": "enum",
     "values": [
      "wide",
      "compact",
      "stacked",
      "mini",
      "micro"
     ],
     "default": "wide",
     "doc": "wide: two text lines + sparkline + change on one row; compact: everything on one 18 dp line; stacked: two rows for a narrow widget; mini: symbol, price and change on one line; micro: symbol and change only"
    }
   },
   "locals": {
    "up": "step(@change, 0.005)",
    "down": "step(0 - @change, 0.005)",
    "flat": "1 - step(abs(@change), 0.005)"
   },
   "body": {
    "$if": "layout == 'wide'",
    "then": {
     "row": {
      "modifiers": [
       "fillMaxWidth",
       {
        "semantics": {
         "contentDescription": {
          "type": "textMerge",
          "id1": "@symbol",
          "id2": {
           "type": "textMerge",
           "id1": ", price ",
           "id2": {
            "type": "textMerge",
            "id1": {
             "type": "textFromFloat",
             "value": "@price",
             "whole": 9,
             "decimal": 2,
             "flags": 535
            },
            "id2": {
             "type": "textMerge",
             "id1": ", change ",
             "id2": {
              "type": "textMerge",
              "id1": {
               "type": "textFromFloat",
               "value": "@change",
               "whole": 4,
               "decimal": 2,
               "flags": 519
              },
              "id2": " percent"
             }
            }
           }
          }
         }
        }
       }
      ],
      "verticalAlignment": "center",
      "children": [
       {
        "column": {
         "modifiers": [
          {
           "width": 76
          }
         ],
         "children": [
          {
           "text": {
            "value": "@symbol",
            "fontSize": "@theme.text_md",
            "fontWeight": 700,
            "color": "@colors.onSurface",
            "maxLines": 1,
            "overflow": "ellipsis"
           }
          },
          {
           "text": {
            "value": {
             "type": "textMerge",
             "id1": "$",
             "id2": {
              "type": "textFromFloat",
              "value": "@price",
              "whole": 9,
              "decimal": 2,
              "flags": 535
             }
            },
            "fontSize": "@theme.text_sm",
            "color": "@colors.muted",
            "maxLines": 1
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "width": 8
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "weight": 1
          },
          {
           "height": 30
          }
         ],
         "children": [
          {
           "Sparkline": {
            "values": "@values",
            "fill": true,
            "color": "@colors.primary",
            "label": "@label"
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "width": 8
          }
         ]
        }
       },
       {
        "row": {
         "verticalAlignment": "center",
         "children": [
          {
           "box": {
            "modifiers": [
             {
              "visibility": "@up"
             }
            ],
            "children": [
             {
              "Icon": {
               "name": "arrow_upward",
               "size": 16,
               "color": "@colors.success"
              }
             }
            ]
