   ]
  }
 },
 "root": [
  {
   "variable": {
    "name": "visitedNames",
    "vtype": "string",
    "value": "Map of Europe. Visited: Czechia, France, Germany, Greece, Italy, Netherlands, Portugal, Spain, United Kingdom",
    "export": true
   }
  },
  {
   "box": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "@colors.background"
     }
    ],
    "children": [
     {
      "stateLayout": {
       "indexId": "@wide",
       "modifiers": [
        "fillMaxSize"
       ],
       "children": [
        {
         "box": {
          "modifiers": [
           "fillMaxSize",
           {
            "padding": 12
           }
          ],
          "horizontalAlignment": "start",
          "verticalAlignment": "top",
          "children": [
           {
            "VisitMap": {}
           },
           {
            "box": {
             "modifiers": [
              {
               "background": "@colors.surface"
              },
              {
               "clip": {
                "roundedRect": 12
               }
              },
              {
               "padding": [
                10,
                6
               ]
              }
             ],
             "children": [
              {
               "text": {
                "value": {
                 "type": "textMerge",
                 "id1": {
                  "type": "textFromFloat",
                  "value": "arraySum(@visited)",
                  "whole": 2,
                  "decimal": 0,
                  "flags": 5
                 },
                 "id2": " of 44 countries"
                },
                "fontSize": 13,
                "fontWeight": 600,
                "color": "@colors.onSurface"
               }
              }
             ]
            }
           }
          ]
         }
        },
        {
         "row": {
          "modifiers": [
           "fillMaxSize",
           {
            "padding": 12
           },
           {
            "spacedBy": 12
           }
          ],
          "verticalAlignment": "center",
          "children": [
           {
            "column": {
             "modifiers": [
              {
               "width": 104
              }
             ],
             "children": [
              {
               "text": {
                "value": {
                 "type": "textFromFloat",
                 "value": "arraySum(@visited)",
                 "whole": 2,
                 "decimal": 0,
                 "flags": 5
                },
                "fontSize": 40,
                "fontWeight": 700,
                "color": "@colors.onSurface"
               }
              },
              {
               "text": {
                "value": "of 44 countries",
                "fontSize": 13,
                "color": "@colors.muted"
               }
              },
              {
               "text": {
                "value": "visited",
                "fontSize": 13,
                "color": "@colors.muted"
               }
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "weight": 1
              }
             ],
             "children": [
              {
               "VisitMap": {}
              }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ]
}