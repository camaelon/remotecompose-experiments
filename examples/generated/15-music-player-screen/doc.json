    "value": 0,
    "export": true
   },
   "paused": "1 - @playing",
   "shuffleOff": "1 - @shuffle",
   "repeatOff": "1 - @repeat",
   "art": "min(min(windowWidth(), 480) - 48, windowHeight() * 0.42)",
   "durH": "floor(@duration / 3600)",
   "durM": "floor(@duration / 60) % 60",
   "durS": "floor(@duration) % 60",
   "durLong": "step(@duration, 3599.5)",
   "durShort": "1 - step(@duration, 3599.5)"
  }
 },
