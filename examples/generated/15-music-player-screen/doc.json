{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 720,
  "profiles": 513,
  "contentDescription": "Music player: now playing, track position, playback controls"
 },
 "resources": {
  "variables": {
   "position": {
    "value": 83,
    "export": true
   },
   "duration": {
    "value": 272,
    "export": true
   },
   "playing": {
    "value": 1,
    "export": true
   },
   "shuffle": {
    "value": 0,
    "export": true
   },
   "repeat": {
    "value": 0,
    "export": true
   },
