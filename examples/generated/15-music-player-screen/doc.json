 ],
 "components": {
  "ArtPlaceholder": {
   "summary": "Album art placeholder: a rounded surface tile with a large album icon; in mono a thin outline ring instead of a fill",
   "params": {
    "size": {
     "type": "float",
     "required": true,
     "doc": "Side in dp: a number, a @variable or an expression"
    },
    "label": {
     "type": "string",
     "default": "Album art",
     "doc": "Accessibility label of the tile"
    }
   },
   "body": {
    "$if": "theme.mono",
    "then": {
     "box": {
      "modifiers": [
       {
        "width": "@size"
       },
       {
        "height": "@size"
       },
       {
        "clip": {
         "roundedRect": 24
        }
       },
       {
        "background": "@colors.outline"
       },
       {
        "padding": 2
       },
       {
        "semantics": {
         "contentDescription": "@label"
        }
       }
      ],
      "horizontalAlignment": "center",
      "verticalAlignment": "center",
      "children": [
       {
        "box": {
         "modifiers": [
          "fillMaxSize",
          {
           "clip": {
            "roundedRect": 22
           }
          },
          {
           "background": "@colors.background"
          }
         ],
         "horizontalAlignment": "center",
         "verticalAlignment": "center",
         "children": [
          {
           "Icon": {
            "name": "album",
            "size": 96,
            "color": "@colors.muted"
           }
          }
         ]
        }
       }
      ]
     }
    },
    "else": {
     "box": {
      "modifiers": [
       {
        "width": "@size"
       },
       {
        "height": "@size"
       },
       {
        "clip": {
         "roundedRect": 24
        }
       },
       {
        "background": "@colors.surfaceHigh"
       },
       {
        "semantics": {
         "contentDescription": "@label"
        }
       }
      ],
      "horizontalAlignment": "center",
      "verticalAlignment": "center",
      "children": [
       {
        "Icon": {
         "name": "album",
         "size": 96,
         "color": "@colors.muted"
        }
       }
      ]
     }
    }
   },
   "call": {
    "ArtPlaceholder": {
     "size": 200
    }
   }
  }
 }
}