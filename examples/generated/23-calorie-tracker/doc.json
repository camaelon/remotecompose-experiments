{
 "header": {
  "apiLevel": 7,
  "width": 320,
  "height": 160,
  "profiles": 513,
  "contentDescription": "Calorie tracker"
 },
 "components": {
  "CalorieRing": {
   "summary": "A calorie ring: a track, an arc of min(progress,1) x 360 deg in color, and the part past the target as a second lap in overColor (in mono a thinner inner lap).",
   "params": {
    "progress": {
     "type": "float",
     "required": true,
     "doc": "eaten / target, may exceed 1"
    },
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "Arc colour"
    },
    "overColor": {
     "type": "color",
     "default": "@colors.error",
     "doc": "Colour of the lap past the target"
    },
    "size": {
     "type": "float",
     "default": 120,
     "static": true,
     "doc": "Diameter in dp"
    },
    "thickness": {
     "type": "float",
     "default": 10,
     "static": true,
     "doc": "Stroke width in dp"
    }
   },
   "locals": {
    "pa": {
     "value": "@progress",
     "anim": 0.3
    }
   },
   "body": {
    "canvas": {
     "modifiers": [
      {
       "size": "@size"
      }
     ],
     "commands": [
      {
       "variable": {
        "name": "s",
        "value": "min(componentWidth(), componentHeight())"
       }
      },
      {
       "translate": {
        "dx": "(componentWidth() - @s) / 2",
        "dy": "(componentHeight() - @s) / 2"
       }
      },
      {
       "scale": {
        "sx": "@s / @size",
        "sy": "@s / @size"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "alpha": 1
         },
         {
          "color": "@colors.track"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": {
           "$if": "theme.mono",
           "then": 1.5,
           "else": "@thickness"
          }
         },
         {
          "strokeCap": "round"
         }
        ]
       }
      },
      {
       "drawCircle": {
        "cx": "@size / 2",
        "cy": "@size / 2",
        "radius": "@size / 2 - @thickness / 2"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@color"
         },
         {
          "strokeWidth": {
           "$if": "theme.mono",
           "then": "@thickness / 2",
           "else": "@thickness"
          }
         }
        ]
       }
      },
      {
       "drawArc": {
        "left": "@thickness / 2",
        "top": "@thickness / 2",
        "right": "@size - @thickness / 2",
        "bottom": "@size - @thickness / 2",
        "startAngle": -90,
        "sweepAngle": "min(@pa, 1) * 360"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@overColor"
         },
         {
          "strokeWidth": {
           "$if": "theme.mono",
           "then": 2,
           "else": "@thickness"
          }
         }
        ]
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "drawArc": {
         "left": "@thickness * 1.6",
         "top": "@thickness * 1.6",
         "right": "@size - @thickness * 1.6",
         "bottom": "@size - @thickness * 1.6",
         "startAngle": -90,
         "sweepAngle": "clamp(0, 1, @pa - 1) * 360"
        }
       },
       "else": {
        "drawArc": {
         "left": "@thickness / 2",
         "top": "@thickness / 2",
         "right": "@size - @thickness / 2",
         "bottom": "@size - @thickness / 2",
         "startAngle": -90,
         "sweepAngle": "clamp(0, 1, @pa - 1) * 360"
        }
       }
      }
     ]
    }
   },
   "call": {
    "CalorieRing": {
     "progress": 0.72
    }
   }
  },
  "MacroBar": {
   "summary": "A horizontal bar of eaten against target: scaled to max(eaten, target); the part up to the target in color, the part past it in overColor (in mono an outlined segment).",
   "params": {
    "eaten": {
     "type": "float",
     "required": true,
     "doc": "grams eaten"
    },
    "target": {
     "type": "float",
     "required": true,
     "doc": "target grams"
    },
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "Fill colour"
    },
    "overColor": {
     "type": "color",
     "default": "@colors.error",
     "doc": "Colour of the part past the target"
    },
    "height": {
     "type": "float",
     "default": 8,
     "static": true,
     "doc": "Bar height in dp"
    }
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxWidth",
      {
       "height": "@height"
      }
     ],
     "commands": [
      {
       "variable": {
        "name": "w",
        "value": "componentWidth()"
       }
      },
      {
       "variable": {
        "name": "m",
        "value": "max(1, max(@eaten, @target))"
       }
      },
      {
       "variable": {
        "name": "ft",
        "value": "@target / @m * @w"
       }
      },
      {
       "variable": {
        "name": "fe",
        "value": "@eaten / @m * @w"
       }
      },
      {
       "variable": {
        "name": "ol",
        "value": "@ft + 1 + (1 - step(@eaten, @target)) * 2 * @w"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "alpha": 1
         },
         {
          "color": "@colors.track"
         },
         {
          "style": {
           "$if": "theme.mono",
           "then": "stroke",
           "else": "fill"
          }
         },
         {
          "strokeWidth": 1
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": 0.5,
        "top": 0.5,
        "right": "@w - 0.5",
        "bottom": "@height - 0.5",
        "rx": "@height / 2",
        "ry": "@height / 2"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@color"
         },
         {
          "style": "fill"
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": 0,
        "top": 0,
        "right": "min(@fe, @ft)",
        "bottom": "@height",
        "rx": "@height / 2",
        "ry": "@height / 2"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@overColor"
         },
         {
          "style": {
           "$if": "theme.mono",
           "then": "stroke",
           "else": "fill"
          }
         },
         {
          "strokeWidth": 1.5
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": "@ol",
        "top": 0.75,
        "right": "max(@fe - 0.75, @ol)",
        "bottom": "@height - 0.75",
        "rx": "@height / 2",
        "ry": "@height / 2"
       }
      }
     ]
    }
   },
   "call": {
    "MacroBar": {
     "eaten": 92,
     "target": 120
    }
   }
  },
  "MacroRow": {
   "summary": "One macro: its name and grams against target over a MacroBar, with the overshoot in error colour when over.",
   "params": {
    "label": {
     "type": "string",
     "required": true,
     "doc": "Macro name"
    },
    "eaten": {
     "type": "float",
     "required": true,
     "doc": "grams eaten"
    },
    "target": {
     "type": "float",
     "required": true,
     "doc": "target grams"
    },
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "Bar colour"
    }
   },
   "locals": {
    "over": "step(@eaten, @target)",
    "overBy": "max(0, @eaten - @target)"
   },
   "body": {
    "column": {
     "modifiers": [
      "fillMaxWidth",
      {
       "spacedBy": 3
      },
      {
       "semantics": {
        "contentDescription": {
         "type": "textMerge",
         "id1": "@label, ",
         "id2": {
          "type": "textMerge",
          "id1": {
           "type": "textFromFloat",
           "value": "@eaten",
           "whole": 5,
           "decimal": 0,
           "flags": 5
          },
          "id2": {
           "type": "textMerge",
           "id1": " of ",
           "id2": {
            "type": "textMerge",
            "id1": {
             "type": "textFromFloat",
             "value": "@target",
             "whole": 5,
             "decimal": 0,
             "flags": 5
            },
            "id2": " grams"
           }
          }
         }
        }
       }
      }
     ],
     "children": [
      {
       "row": {
        "modifiers": [
         "fillMaxWidth"
        ],
        "verticalAlignment": "center",
        "children": [
         {
          "text": {
           "value": "@label",
           "fontSize": 12,
           "color": "@colors.onSurface",
           "maxLines": 1,
           "fontWeight": 500
          }
         },
         {
          "box": {
