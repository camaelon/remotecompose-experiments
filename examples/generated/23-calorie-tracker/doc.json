              "type": "textFromFloat",
              "value": "@overBy",
              "whole": 5,
              "decimal": 0,
              "flags": 5
             },
             "id2": " over  "
            }
           },
           "fontSize": 11,
           "color": "@colors.error",
           "maxLines": 1,
           "fontWeight": 600,
           "modifiers": [
            {
             "visibility": "@over"
            }
           ]
          }
         },
         {
          "text": {
           "value": {
            "type": "textMerge",
            "id1": {
             "type": "textFromFloat",
             "value": "@eaten",
             "whole": 5,
             "decimal": 0,
             "flags": 5
            },
            "id2": {
             "type": "textMerge",
             "id1": " / ",
             "id2": {
              "type": "textMerge",
              "id1": {
               "type": "textFromFloat",
               "value": "@target",
               "whole": 5,
               "decimal": 0,
               "flags": 5
              },
              "id2": " g"
             }
            }
           },
           "fontSize": 12,
           "color": "@colors.muted",
           "maxLines": 1
          }
         }
        ]
       }
      },
      {
       "MacroBar": {
        "eaten": "@eaten",
        "target": "@target",
        "color": "@color",
        "height": 7
       }
      }
     ]
    }
   },
   "call": {
    "MacroRow": {
     "label": "Protein",
     "eaten": 92,
     "target": 120
    }
   }
