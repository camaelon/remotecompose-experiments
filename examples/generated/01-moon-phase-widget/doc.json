  "profiles": 513,
  "contentDescription": "Tonight's moon: its phase name, how much of it is lit, and the days until the next full moon"
 },
 "componentTheme": "auto",
 "resources": {
  "variables": {
   "d0": "365 * (year() - 2000) + floor((year() - 1997) / 4) + dayOfYear() - 1 - offsetToUtc() / 86400",
   "d1": "@d0 + 1",
   "la0": "0.8104301 + 0.033863192 * @d0 + 0.017469 * sin(2.241546 + 0.2280275 * @d0) + 0.003539 * sin(7.942619 + 0.19750992 * @d0)",
   "la": "@la0 + 0.001828 * sin(10.184165 + 0.42553742 * @d0) - 0.005836 * sin(6.231459 + 0.01720197 * @d0) + 0.000593 * sin(4.483093 + 0.456055 * @d0)",
   "lb0": "0.8104301 + 0.033863192 * @d1 + 0.017469 * sin(2.241546 + 0.2280275 * @d1) + 0.003539 * sin(7.942619 + 0.19750992 * @d1)",
   "lb": "@lb0 + 0.001828 * sin(10.184165 + 0.42553742 * @d1) - 0.005836 * sin(6.231459 + 0.01720197 * @d1) + 0.000593 * sin(4.483093 + 0.456055 * @d1)",
   "ln": "@la + (@lb - @la) * timeInMin() / 1440",
   "f": "@ln - floor(@ln)",
   "lit": "50 * (1 - cos(6.2831853 * @f))",
   "qa": "floor(4 * @la)",
   "qb": "floor(4 * @lb)",
   "ni": "(@qb - @qa) * 2 * (@qb % 4) + (1 - @qb + @qa) * (2 * (@qa % 4) + 1)",
   "NF": "floor(@la - 0.5) + 1.5",
   "tF1": "@d0 + (@NF - @la) * 29.530589",
   "lF1a": "0.8104301 + 0.033863192 * @tF1 + 0.017469 * sin(2.241546 + 0.2280275 * @tF1) + 0.003539 * sin(7.942619 + 0.19750992 * @tF1)",
   "lF1": "@lF1a + 0.001828 * sin(10.184165 + 0.42553742 * @tF1) - 0.005836 * sin(6.231459 + 0.01720197 * @tF1) + 0.000593 * sin(4.483093 + 0.456055 * @tF1)",
   "tF2": "@tF1 - (@lF1 - @NF) * 29.530589",
   "lF2a": "0.8104301 + 0.033863192 * @tF2 + 0.017469 * sin(2.241546 + 0.2280275 * @tF2) + 0.003539 * sin(7.942619 + 0.19750992 * @tF2)",
   "lF2": "@lF2a + 0.001828 * sin(10.184165 + 0.42553742 * @tF2) - 0.005836 * sin(6.231459 + 0.01720197 * @tF2) + 0.000593 * sin(4.483093 + 0.456055 * @tF2)",
   "tF3": "@tF2 - (@lF2 - @NF) * 29.530589",
   "toFull": "floor(@tF3 - @d0)",
   "fullIn": "step(@toFull, 1.5)",
   "fullTomorrow": "step(@toFull, 0.5) * step(1.5, @toFull)",
   "fullToday": "step(0.5, @toFull)"
  }
 },
