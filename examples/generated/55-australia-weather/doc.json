{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "contentDescription": "Weather overview of Australia: temperature and conditions in the eight state and territory capitals"
 },
 "components": {
  "AusMap": {
   "summary": "Australia's land and state borders drawn in the map box, scaled to the canvas width",
   "params": {},
   "call": {
    "AusMap": {}
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxSize"
     ],
     "commands": [
      {
       "variable": {
        "name": "k",
        "value": "componentWidth() / 1000"
       }
      },
      {
       "save": {}
      },
      {
       "scale": {
        "sx": "@k",
        "sy": "@k"
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "paint": {
         "color": "@colors.onSurface",
         "style": "stroke",
         "strokeWidth": "1.5 / @k"
        }
       },
       "else": {
        "paint": {
         "color": "@colors.track",
         "style": "fill"
        }
       }
      },
      {
       "$if": "theme.mono",
       "then": {
        "drawPath": {
         "path": {
          "$map": {
           "region": [
            110,
            -50,
            165,
            -9
           ],
           "layer": "land",
           "detail": "medium",
           "outline": true
          }
         }
        }
       },
       "else": {
        "drawPath": {
         "path": {
          "$map": {
           "region": [
            110,
            -50,
            165,
            -9
           ],
           "layer": "land",
           "detail": "medium"
          }
         }
        }
       }
      },
      {
       "paint": {
        "color": "@colors.outline",
        "style": "stroke",
        "strokeWidth": "1 / @k"
       }
      },
      {
       "drawPath": {
        "path": {
         "$map": {
          "region": [
           110,
           -50,
           165,
           -9
          ],
          "layer": "states",
          "countries": [
           "AUS"
          ],
          "detail": "medium"
         }
        }
       }
      },
      {
       "restore": {}
      }
     ]
    }
   }
  },
  "CondIcon": {
   "summary": "A WeatherIcon chosen at run time from a host code 0 sunny, 1 partly cloudy, 2 cloudy, 3 rain, 4 storm",
   "params": {
    "code": {
     "type": "float",
     "required": true,
     "doc": "condition code 0..4"
    },
    "size": {
     "type": "float",
     "default": 20,
     "static": true,
     "doc": "dp"
    },
    "name": {
     "type": "text",
     "required": true,
     "doc": "city name"
    },
    "temp": {
     "type": "float",
     "required": true,
     "doc": "degC"
    }
   },
   "call": {
    "CondIcon": {
     "code": 3,
     "name": "Sydney",
     "temp": 20
    }
   },
   "body": {
    "stateLayout": {
     "indexId": "@code",
     "children": [
      {
       "WeatherIcon": {
        "condition": "sun",
        "size": "@size",
        "label": {
         "type": "textMerge",
         "id1": "@name",
         "id2": {
          "type": "textMerge",
          "id1": ", ",
          "id2": {
           "type": "textMerge",
           "id1": {
            "type": "textFromFloat",
            "value": "@temp",
            "whole": 3,
            "decimal": 0,
            "flags": 5
           },
           "id2": " degrees, sunny"
          }
         }
        }
       }
      },
      {
       "WeatherIcon": {
        "condition": "partly",
        "size": "@size",
        "label": {
         "type": "textMerge",
         "id1": "@name",
         "id2": {
          "type": "textMerge",
          "id1": ", ",
          "id2": {
           "type": "textMerge",
           "id1": {
            "type": "textFromFloat",
            "value": "@temp",
            "whole": 3,
            "decimal": 0,
            "flags": 5
           },
           "id2": " degrees, partly cloudy"
          }
         }
        }
       }
      },
      {
       "WeatherIcon": {
        "condition": "cloud",
        "size": "@size",
        "label": {
         "type": "textMerge",
         "id1": "@name",
         "id2": {
          "type": "textMerge",
          "id1": ", ",
          "id2": {
           "type": "textMerge",
           "id1": {
            "type": "textFromFloat",
            "value": "@temp",
            "whole": 3,
            "decimal": 0,
            "flags": 5
           },
           "id2": " degrees, cloudy"
          }
         }
        }
       }
      },
      {
       "WeatherIcon": {
        "condition": "rain",
        "size": "@size",
        "label": {
         "type": "textMerge",
         "id1": "@name",
         "id2": {
          "type": "textMerge",
          "id1": ", ",
          "id2": {
           "type": "textMerge",
           "id1": {
            "type": "textFromFloat",
            "value": "@temp",
            "whole": 3,
            "decimal": 0,
            "flags": 5
           },
           "id2": " degrees, rain"
          }
         }
        }
       }
      },
      {
       "WeatherIcon": {
        "condition": "storm",
        "size": "@size",
        "label": {
         "type": "textMerge",
         "id1": "@name",
         "id2": {
          "type": "textMerge",
          "id1": ", ",
          "id2": {
           "type": "textMerge",
           "id1": {
            "type": "textFromFloat",
            "value": "@temp",
            "whole": 3,
            "decimal": 0,
            "flags": 5
           },
           "id2": " degrees, thunderstorm"
          }
         }
        }
       }
      }
     ]
    }
   }
  },
  "PinDot": {
   "summary": "A city's dot and the leader line to its chip",
   "params": {
    "lon": {
     "type": "float",
     "required": true,
     "static": true,
     "doc": "lon"
    },
    "lat": {
     "type": "float",
     "required": true,
     "static": true,
     "doc": "lat"
    },
    "ox": {
     "type": "float",
     "static": true,
     "default": 8,
     "doc": "chip left - dot, dp"
    },
    "oy": {
     "type": "float",
     "static": true,
     "default": -20,
     "doc": "chip top - dot, dp"
    },
    "r": {
     "type": "float",
     "static": true,
     "default": 3.5,
     "doc": "dot radius dp"
    },
    "leader": {
     "type": "bool",
     "static": true,
     "default": true,
     "doc": "draw the leader line"
    }
   },
   "locals": {
    "px": {
     "$mapPoint": {
      "region": [
       110,
       -50,
       165,
       -9
      ],
      "lon": "@lon",
      "lat": "@lat",
      "axis": "x"
     }
    },
    "py": {
     "$mapPoint": {
      "region": [
       110,
       -50,
       165,
       -9
      ],
      "lon": "@lon",
      "lat": "@lat",
      "axis": "y"
     }
    }
   },
   "call": {
    "PinDot": {
     "lon": 151.21,
     "lat": -33.87
    }
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxSize"
     ],
     "commands": [
      {
       "variable": {
        "name": "k",
        "value": "componentWidth() / 1000"
       }
      },
      {
       "variable": {
        "name": "x",
        "value": "@px * @k"
       }
      },
      {
       "variable": {
        "name": "y",
        "value": "@py * @k"
       }
      },
      {
       "$if": "leader",
       "then": {
        "paint": {
         "color": "@colors.muted",
         "style": "stroke",
         "strokeWidth": 1
        }
       }
      },
      {
       "$if": "leader",
       "then": {
        "drawLine": {
         "x1": "@x",
         "y1": "@y",
         "x2": "@x + @ox + 35",
         "y2": "@y + @oy + 20"
        }
       }
      },
      {
       "paint": {
        "color": "@colors.onSurface",
        "style": "fill"
       }
      },
      {
       "drawCircle": {
        "cx": "@x",
        "cy": "@y",
        "radius": "@r * step(componentWidth(), 40)"
       }
      }
     ]
    }
   }
  },
  "CityChip": {
   "summary": "A city's chip (condition icon, temperature, name) placed at its map point plus an offset",
   "params": {
    "name": {
     "type": "text",
     "required": true,
     "doc": "city name"
    },
    "temp": {
     "type": "float",
     "required": true,
     "doc": "degC"
    },
    "code": {
     "type": "float",
     "required": true,
     "doc": "0..4"
    },
    "lon": {
     "type": "float",
     "required": true,
     "static": true,
     "doc": "lon"
    },
    "lat": {
     "type": "float",
     "required": true,
     "static": true,
     "doc": "lat"
    },
    "ox": {
     "type": "float",
     "static": true,
     "default": 8,
     "doc": "dp"
    },
    "oy": {
     "type": "float",
     "static": true,
     "default": -20,
     "doc": "dp"
    },
    "w": {
     "type": "float",
     "required": true,
     "doc": "map width dp"
    }
   },
   "locals": {
    "px": {
     "$mapPoint": {
      "region": [
       110,
       -50,
       165,
       -9
      ],
      "lon": "@lon",
      "lat": "@lat",
      "axis": "x"
     }
    },
    "py": {
     "$mapPoint": {
      "region": [
       110,
       -50,
       165,
       -9
      ],
      "lon": "@lon",
      "lat": "@lat",
      "axis": "y"
     }
    }
   },
   "call": {
    "CityChip": {
     "name": "Sydney",
     "temp": 24,
     "code": 0,
     "lon": 151.21,
     "lat": -33.87,
     "w": 328
    }
   },
   "body": {
    "column": {
     "modifiers": [
      "fillMaxSize"
     ],
     "children": [
      {
       "box": {
        "modifiers": [
         {
          "height": "max(0, @w * @py / 1000 + @oy)"
         }
        ]
       }
      },
      {
       "row": {
        "children": [
         {
          "box": {
           "modifiers": [
            {
             "width": "max(0, @w * @px / 1000 + @ox)"
            }
           ]
          }
         },
         {
          "column": {
           "modifiers": [
            {
             "width": 70
            },
            {
             "height": 40
            },
            {
             "$if": "theme.mono",
             "then": {
              "background": "@colors.onSurface"
             },
             "else": {
              "background": "@colors.surfaceHigh"
             }
            },
            {
             "clip": {
              "roundedRect": 8
             }
            },
            {
             "$if": "theme.mono",
             "then": {
              "padding": 1
             },
             "else": {
              "padding": 0
             }
            },
            {
             "background": {
              "$if": "theme.mono",
              "then": "@colors.background",
              "else": "@colors.surfaceHigh"
             }
            },
            {
             "padding": [
              6,
              3
             ]
            }
           ],
           "children": [
            {
             "row": {
              "verticalAlignment": "center",
              "modifiers": [
               {
                "spacedBy": 4
               }
              ],
              "children": [
               {
                "CondIcon": {
                 "code": "@code",
                 "size": 20,
                 "name": "@name",
                 "temp": "@temp"
                }
               },
               {
                "text": {
                 "value": {
                  "type": "textMerge",
                  "id1": {
                   "type": "textFromFloat",
                   "value": "@temp",
                   "whole": 3,
                   "decimal": 0,
                   "flags": 5
                  },
                  "id2": "°"
                 },
                 "fontSize": 15,
                 "fontWeight": 700,
                 "color": "@colors.onSurface"
                }
               }
              ]
             }
            },
            {
             "text": {
              "value": "@name",
              "fontSize": 11,
              "color": "@colors.muted",
              "maxLines": 1,
              "overflow": "ellipsis"
             }
            }
           ]
          }
         }
        ]
       }
      }
     ]
    }
   }
  },
