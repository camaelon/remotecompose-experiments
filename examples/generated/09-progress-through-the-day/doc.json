  },
  "PeriodBar": {
   "summary": "A bare labelled bar for the smallest sizes",
   "params": {
    "label": {
     "type": "string",
     "required": true,
     "doc": "The period name, read by screen readers"
    },
    "progress": {
     "type": "float",
     "required": true,
     "doc": "Fraction elapsed, 0..1"
    }
   },
   "body": {
    "box": {
     "modifiers": [
      "fillMaxWidth",
      {
       "semantics": {
        "contentDescription": "@label progress"
       }
      }
     ],
     "children": [
      {
