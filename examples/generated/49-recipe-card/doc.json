{
 "header": {
  "apiLevel": 7,
  "width": 380,
  "height": 840,
  "profiles": 513,
  "contentDescription": "Recipe card: title, prep and cook times, ingredients that rescale with the number of servings, and steps you can check off"
 },
 "components": {
  "IngredientRow": {
   "summary": "One ingredient line: the amount scaled and written like a cook (eighths/thirds for volumes and counts, grams rounded, a pinch unscaled), the unit singular or plural, and the name.",
   "params": {
    "name": {
     "type": "string",
     "required": true,
     "doc": "Ingredient name (host string)"
    },
    "unit": {
     "type": "string",
     "default": "",
     "doc": "Unit for counts and volumes, singular (weights print g, a pinch prints itself)"
    },
    "units": {
     "type": "string",
     "doc": "Plural unit for counts and volumes; omitted, the unit is used for every amount (tbsp, tsp)"
    },
    "amount": {
     "type": "float",
     "required": true,
     "doc": "Base amount (host float)"
    },
    "kind": {
     "type": "float",
     "default": 1,
     "doc": "0 count, 1 volume, 2 weight (grams), 3 a pinch (never scaled)"
    },
    "scale": {
     "type": "float",
     "default": 1,
     "doc": "servings / base servings"
    }
   },
   "locals": {
    "a": "@amount * @scale",
    "w": "floor(@a + 0.0625)",
    "f": "@a - @w",
    "hasW": "step(@w, 0.5)",
    "i8": "max(1 - @hasW, round(@f * 8))",
    "t3": "round(@f * 3)",
    "u3": "step(@t3, 0.5) - step(@t3, 2.5)",
    "u": "@u3 * step(abs(@f - @i8 / 8) - abs(@f - @t3 / 3), 0.004)",
    "idx": "@i8 + @u * (7 + @t3 - @i8)",
    "isP": "step(@kind, 2.5)",
    "isG": "step(@kind, 1.5) - @isP",
    "isF": "1 - step(@kind, 1.5)",
    "showW": "@isF * @hasW",
    "g": "round(@a) + step(@a, 20) * (round(@a / 5) * 5 - round(@a))",
    "pl": "step(@w + @i8 / 8, 1.01)",
    "sg": "@isF * (1 - @pl)",
    "plF": "@isF * @pl"
   },
   "body": {
    "row": {
     "verticalAlignment": "center",
     "modifiers": [
      "fillMaxWidth",
      {
       "heightIn": [
        40,
        400
       ]
      },
      {
       "padding": {
        "top": 6,
        "bottom": 6
       }
      }
     ],
     "children": [
      {
       "row": {
        "verticalAlignment": "center",
        "modifiers": [
         {
          "width": 96
         }
        ],
        "children": [
         {
          "text": {
           "value": {
            "type": "textFromFloat",
            "value": "@w",
            "whole": 3,
            "decimal": 0,
            "flags": 5
           },
           "fontSize": 16,
           "fontWeight": 700,
           "color": "@colors.primary",
           "modifiers": [
            {
             "visibility": "@showW"
            }
           ]
          }
         },
         {
          "box": {
           "modifiers": [
            {
             "visibility": "@isF"
            }
           ],
           "children": [
            {
             "TextChoice": {
              "items": [
               "",
               "⅛",
               "¼",
               "⅜",
               "½",
               "⅝",
               "¾",
               "⅞",
               "⅓",
               "⅔"
              ],
              "index": "@idx",
              "fontSize": 16,
              "fontWeight": 700,
              "color": "@colors.primary"
             }
            }
           ]
          }
         },
         {
          "text": {
           "value": {
            "type": "textMerge",
            "id1": {
             "type": "textFromFloat",
             "value": "@g",
             "whole": 5,
             "decimal": 0,
             "flags": 21
            },
            "id2": " g"
           },
           "fontSize": 16,
           "fontWeight": 700,
           "color": "@colors.primary",
           "modifiers": [
            {
             "visibility": "@isG"
            }
           ]
          }
         },
         {
          "box": {
           "modifiers": [
            {
             "width": 4
            },
            {
             "visibility": "@isF"
            }
           ]
          }
         },
         {
          "$if": "units",
          "then": [
           {
            "text": {
             "value": "@unit",
             "fontSize": 15,
             "color": "@colors.primary",
             "maxLines": 1,
             "modifiers": [
              {
               "visibility": "@sg"
              }
             ]
            }
           },
           {
            "text": {
             "value": "@units",
             "fontSize": 15,
             "color": "@colors.primary",
             "maxLines": 1,
             "modifiers": [
              {
               "visibility": "@plF"
              }
             ]
            }
           }
          ],
          "else": [
           {
            "text": {
             "value": "@unit",
             "fontSize": 15,
             "color": "@colors.primary",
             "maxLines": 1,
             "modifiers": [
              {
               "visibility": "@isF"
              }
             ]
            }
           }
          ]
         },
         {
          "text": {
           "value": "a pinch",
           "fontSize": 15,
           "color": "@colors.primary",
           "maxLines": 1,
           "modifiers": [
            {
             "visibility": "@isP"
            }
           ]
          }
         }
        ]
       }
      },
      {
       "text": {
        "value": "@name",
        "fontSize": 16,
        "color": "@colors.onSurface",
        "modifiers": [
         {
          "weight": 1
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "IngredientRow": {
     "name": "Buttermilk",
     "unit": "cup",
     "units": "cups",
     "amount": 1.5,
     "kind": 1
    }
   }
  },
  "StepRow": {
   "summary": "A numbered recipe step you tap to check off: the number becomes a tick and the text is struck through and muted; a screen reader hears Step N, the text, and Done or Not done.",
   "params": {
    "n": {
     "type": "float",
     "required": true,
     "static": true,
     "doc": "Step number"
    },
    "text": {
     "type": "string",
     "required": true,
     "doc": "Step text (host string)"
    },
    "done": {
     "type": "variable",
     "initial": 0,
     "doc": "0/1 done state"
    }
   },
   "locals": {
    "nd": "1 - @done"
   },
   "body": {
    "box": {
     "modifiers": [
      "fillMaxWidth"
     ],
     "children": [
      {
       "canvas": {
        "modifiers": [
         {
          "size": [
           0,
           0
          ]
         }
        ],
        "commands": [
         {
          "global": {
           "commands": [
            {
             "textSubtext": {
              "text": "Not doneDone    ",
              "start": "@done * 8",
              "len": 8,
              "varName": "stepState8"
             }
            },
            {
             "textTransform": {
              "text": "@stepState8",
              "start": 0,
              "len": -1,
              "operation": 3,
              "varName": "stepState"
             }
            }
           ]
          }
         }
        ]
       }
      },
      {
       "row": {
        "verticalAlignment": "top",
        "modifiers": [
         "fillMaxWidth",
         {
          "heightIn": [
           48,
           800
          ]
         },
         {
          "semantics": {
           "contentDescription": {
            "type": "textMerge",
            "id1": "Step ",
            "id2": {
             "type": "textMerge",
             "id1": {
              "type": "textFromFloat",
              "value": "@n",
              "whole": 2,
              "decimal": 0,
              "flags": 5
             },
             "id2": {
              "type": "textMerge",
              "id1": ". ",
              "id2": "@text"
             }
            }
           },
           "stateDescription": "@stepState",
           "clickable": true
          }
         },
         {
          "onClick": [
           {
            "type": "valueFloatExpressionChange",
            "target": "@done",
            "value": "1 - @done"
           }
          ]
         },
         {
          "padding": {
           "top": 8,
           "bottom": 8
          }
         }
        ],
        "children": [
         {
          "box": {
           "horizontalAlignment": "center",
           "verticalAlignment": "center",
           "modifiers": [
            {
             "size": 32
            }
           ],
           "children": [
            {
             "box": {
              "horizontalAlignment": "center",
              "verticalAlignment": "center",
              "modifiers": [
               {
                "visibility": "@nd"
               },
               {
                "size": 32
               },
               {
                "clip": 16
               },
               {
                "background": "@colors.outline"
               },
               {
                "padding": 1.5
               },
               {
                "clip": 15
               },
               {
                "background": "@colors.surface"
               }
              ],
              "children": [
               {
                "text": {
                 "value": {
                  "type": "textFromFloat",
                  "value": "@n",
                  "whole": 2,
                  "decimal": 0,
                  "flags": 5
                 },
                 "fontSize": 14,
                 "fontWeight": 700,
                 "color": "@colors.onSurface"
                }
               }
              ]
             }
            },
            {
             "box": {
              "horizontalAlignment": "center",
              "verticalAlignment": "center",
              "modifiers": [
               {
                "visibility": "@done"
               },
               {
                "size": 32
               },
               {
                "clip": 16
               },
               {
                "background": "@colors.primary"
               }
              ],
              "children": [
               {
                "Icon": {
                 "name": "check",
                 "size": 20,
                 "color": "@colors.onPrimary"
                }
               }
              ]
             }
            }
           ]
          }
         },
         {
          "box": {
           "modifiers": [
            {
             "width": 12
            }
           ]
          }
         },
         {
          "column": {
           "modifiers": [
            {
             "weight": 1
            },
            {
             "padding": {
              "top": 5
             }
            }
           ],
           "children": [
            {
             "text": {
              "value": "@text",
              "fontSize": 16,
              "color": "@colors.onSurface",
              "modifiers": [
               {
                "visibility": "@nd"
               }
              ]
             }
            },
            {
             "text": {
              "value": "@text",
              "fontSize": 16,
              "color": "@colors.muted",
              "strikethrough": true,
              "modifiers": [
               {
                "visibility": "@done"
               }
              ]
             }
            }
           ]
          }
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "StepRow": {
     "n": 1,
     "text": "Whisk the flour, sugar, baking powder and salt in a large bowl.",
     "done": "@d1"
    }
   }
  },
  "TimeChip": {
   "summary": "A recipe time: an icon, a caption and the duration as '1 h 15 min'.",
   "params": {
    "label": {
     "type": "string",
     "required": true,
     "doc": "Caption (Prep, Cook, Total)"
    },
    "minutes": {
     "type": "float",
     "required": true,
     "doc": "Minutes (host float or expression)"
    },
    "icon": {
     "type": "string",
     "default": "schedule",
     "static": true,
     "doc": "Material Symbols icon name"
    }
   },
   "locals": {
    "h": "floor(@minutes / 60)",
    "m": "@minutes - @h * 60",
    "hasH": "step(@h, 0.5)",
    "showM": "1 - @hasH * (1 - step(@m, 0.5))"
   },
   "body": {
