           "value": {
            "type": "textMerge",
            "id1": {
             "type": "textFromFloat",
             "value": "@h",
             "whole": 2,
             "decimal": 0,
             "flags": 5
            },
            "id2": " h"
           },
           "fontSize": 16,
           "fontWeight": 700,
           "color": "@colors.onSurface",
           "maxLines": 1,
           "modifiers": [
            {
             "visibility": "@hasH"
            }
           ]
          }
         },
         {
          "text": {
           "value": {
            "type": "textMerge",
            "id1": {
             "type": "textFromFloat",
