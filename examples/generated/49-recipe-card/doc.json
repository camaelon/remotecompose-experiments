   "scale": "@servings / max(1, @baseServings)",
   "totalMin": "@prepMin + @cookMin",
   "doneCount": "@done1 + @done2 + @done3 + @done4 + @done5 + @done6",
   "doneFrac": "@doneCount / 6",
   "scaled": "1 - min(1, abs(@servings - @baseServings))",
   "notBase": "1 - @scaled",
   "allDone": "step(@doneCount, 5.5)",
   "notAllDone": "1 - @allDone",
   "wide": "step(windowWidth(), 599)",
   "panelW": "windowWidth() - 32 - @wide * ((windowWidth() - 16) / 2)"
  }
