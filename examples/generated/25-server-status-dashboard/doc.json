{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "Server status: six services with status, latency and uptime"
 },
 "components": {
  "StatusIcon": {
   "summary": "Status icon: check circle (up), triangle (degraded), cross circle (down), tinted by state",
   "params": {
    "status": {
     "type": "float",
     "required": true,
     "doc": "0 up, 1 degraded, 2 down"
    },
    "size": {
     "type": "float",
     "default": 24,
     "static": true,
     "doc": "icon size dp"
    },
    "upLabel": {
     "type": "text",
     "default": "Up",
     "doc": "spoken label when up"
    },
    "degLabel": {
     "type": "text",
     "default": "Degraded",
     "doc": "spoken label when degraded"
    },
    "downLabel": {
     "type": "text",
     "default": "Down",
     "doc": "spoken label when down"
    }
   },
   "locals": {
    "isUp": "1 - min(1, @status)",
    "isDown": "max(0, @status - 1)",
    "isDeg": "min(1, @status) - max(0, @status - 1)"
   },
   "body": {
    "box": {
     "modifiers": [
      {
       "size": "@size"
      }
     ],
     "horizontalAlignment": "center",
     "verticalAlignment": "center",
     "children": [
      {
       "box": {
        "modifiers": [
         {
          "visibility": "@isUp"
         }
        ],
        "children": [
         {
          "Icon": {
           "name": "check_circle",
           "filled": true,
           "size": "@size",
           "color": "@colors.success",
           "label": "@upLabel"
          }
         }
        ]
       }
      },
      {
       "box": {
        "modifiers": [
         {
          "visibility": "@isDeg"
         }
        ],
        "children": [
         {
          "Icon": {
           "name": "warning",
           "filled": true,
           "size": "@size",
           "color": "@colors.warning",
           "label": "@degLabel"
          }
         }
        ]
       }
      },
      {
       "box": {
        "modifiers": [
         {
          "visibility": "@isDown"
         }
        ],
        "children": [
         {
          "Icon": {
           "name": "cancel",
           "filled": true,
           "size": "@size",
           "color": "@colors.error",
           "label": "@downLabel"
          }
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "StatusIcon": {
     "status": 1
    }
   }
  },
