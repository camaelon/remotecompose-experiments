     "doc": "Minutes of daylight"
    }
   },
   "body": {
    "row": {
     "verticalAlignment": "center",
     "modifiers": [
      "fillMaxWidth"
     ],
     "children": [
      {
       "box": {
        "modifiers": [
         {
          "weight": 1
         }
