          "whole": 2,
          "decimal": 0,
          "flags": 5
         },
         "id2": {
          "type": "textMerge",
          "id1": " h ",
          "id2": {
           "type": "textMerge",
           "id1": {
            "type": "textFromFloat",
            "value": "@dayLen % 60",
            "whole": 2,
            "decimal": 0,
            "flags": 5
           },
           "id2": " min of daylight"
          }
         }
        },
        "fontSize": 12,
        "color": "@colors.muted",
        "maxLines": 1
       }
      }
     ]
    }
   },
   "call": {
    "Footer": {
     "dayLen": 636
    }
   }
  }
 },
 "resources": {
  "variables": {
   "latitude": 38.7223,
   "longitude": -9.1393,
   "utcMin": "timeInMin() - offsetToUtc() / 60",
   "leap": "1 - min(1, year() % 4)",
   "sun0": "weekDay() % 7",
   "d31m": "90 + @leap",
   "d31o": "304 + @leap",
   "marSun": "@d31m - (@sun0 + @d31m - dayOfYear() + 700) % 7",
   "octSun": "@d31o - (@sun0 + @d31o - dayOfYear() + 700) % 7",
   "moy": "(dayOfYear() - 1) * 1440 + @utcMin",
   "dst": "step(@moy, (@marSun - 1) * 1440 + 59.5) * (1 - step(@moy, (@octSun - 1) * 1440 + 59.5))",
   "lisOff": "60 * @dst",
   "lisMin": "@utcMin + @lisOff",
   "dayShift": "floor(@lisMin / 1440)",
   "now": "@lisMin - 1440 * @dayShift",
   "n": "365 * (year() - 2000) + floor((year() - 1997) / 4) + dayOfYear() - 1 + @dayShift - @lisOff / 1440",
   "L": "(280.46 + 0.9856474 * @n) % 360",
   "g": "0.0174533 * ((357.528 + 0.9856003 * @n) % 360)",
   "lam": "0.0174533 * (@L + 1.915 * sin(@g) + 0.02 * sin(2 * @g))",
   "eps": "0.0174533 * (23.439 - 0.0000004 * @n)",
   "dec": "asin(sin(@eps) * sin(@lam))",
   "ra": "57.29578 * atan2(cos(@eps) * sin(@lam), cos(@lam))",
   "E": "@L - @ra",
   "eot": "4 * (@E - 360 * floor((@E + 180) / 360))",
   "noon": "720 - 4 * @longitude - @eot + @lisOff",
   "phi": "0.0174533 * @latitude",
   "A": "sin(@phi) * sin(@dec)",
   "B": "cos(@phi) * cos(@dec)",
   "H0": "229.18312 * acos(clamp(-1, 1, (-0.0145439 - @A) / @B))",
   "rise": "@noon - @H0",
   "set": "@noon + @H0",
   "riseR": "floor(@rise + 0.5)",
   "setR": "floor(@set + 0.5)",
   "dayLen": "@setR - @riseR",
   "sNow": "@A + @B * cos((@now - @noon) * 0.0043633)",
   "alt": "57.29578 * asin(@sNow)"
  }
 },
