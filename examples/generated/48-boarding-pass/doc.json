 "resources": {
  "variables": {
   "boardDay": {
    "value": 304,
    "export": true
   },
   "boardMin": {
    "value": 465,
    "export": true
   },
   "departMin": {
    "value": 510,
    "export": true
   },
   "status": {
    "value": 0,
    "export": true
   },
   "delayMin": {
    "value": 0,
    "export": true
   },
   "toBoard": "(@boardDay - dayOfYear()) * 1440 + @boardMin - timeInMin()",
   "toDepart": "(@boardDay - dayOfYear()) * 1440 + @departMin - timeInMin()",
   "isClosed": "max(step(@status, 3.5), step(15, @toDepart))",
   "isBoarding": "(1 - @isClosed) * max(step(0, @toBoard), step(@status, 2.5))",
   "cdShow": "(1 - @isClosed) * (1 - @isBoarding)",
   "hrs": "floor(max(0, @toBoard) / 60)",
   "mins": "floor(max(0, @toBoard)) % 60",
   "cdH": "@cdShow * step(@hrs, 1)",
   "cdM": "@cdShow * (1 - step(@hrs, 1))",
   "gateChanged": "step(@status, 1.5) * step(2.5, @status)",
   "gateSame": "1 - @gateChanged",
   "isDelayed": "step(@status, 0.5) * step(1.5, @status)",
   "bH": "floor(@boardMin / 60) % 24",
   "bM": "@boardMin % 60",
   "dH": "floor(@departMin / 60) % 24",
   "dM": "@departMin % 60",
   "isDeparted": "step(0, @toDepart)",
   "disp": "@isClosed * (4 + @isDeparted) + (1 - @isClosed) * (@status + (1 - step(@status, 0.5)) * 3 * @isBoarding)",
   "p0": "1 - min(1, abs(@disp))",
   "p1": "1 - min(1, abs(@disp - 1))",
   "p2": "1 - min(1, abs(@disp - 2))",
   "p3": "1 - min(1, abs(@disp - 3))",
   "p4": "1 - min(1, abs(@disp - 4))",
   "p5": "1 - min(1, abs(@disp - 5))",
   "delayShow": "@isDelayed * (1 - @isClosed)",
   "notDelayed": "1 - @isDelayed",
   "isCompact": "1 - step(windowHeight(), 420)",
   "isFull": "step(windowHeight(), 420)"
  }
 },
