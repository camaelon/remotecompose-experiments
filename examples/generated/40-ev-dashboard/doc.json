              {
               "verticalWeight": 1.2
              }
             ],
             "children": [
              {
               "box": {
                "modifiers": [
                 {
                  "weight": 1
                 },
                 "fillMaxHeight"
                ],
                "children": [
                 {
                  "BatteryPanel": {
                   "pct": "@battery",
                   "range": "@range"
                  }
                 }
                ]
               }
              },
              {
               "box": {
                "modifiers": [
                 {
                  "width": 12
                 }
                ]
               }
              },
              {
               "box": {
                "modifiers": [
                 {
                  "weight": 1.2
                 },
                 "fillMaxHeight"
                ],
                "children": [
                 {
                  "NavPanel": {
                   "turn": "@turn",
                   "dist": "@distance",
                   "street": "@street",
                   "iconSize": 64,
                   "distSize": 36
                  }
                 }
                ]
               }
              }
             ]
            }
           }
          ]
         }
        },
        {
         "row": {
          "modifiers": [
           "fillMaxSize",
           {
            "padding": 24
           }
          ],
          "verticalAlignment": "center",
          "children": [
           {
            "box": {
             "modifiers": [
              {
               "weight": 1
              },
              "fillMaxHeight"
             ],
             "children": [
              {
               "BatteryPanel": {
                "pct": "@battery",
                "range": "@range"
               }
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "width": 16
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "weight": 1.3
              },
              "fillMaxHeight"
             ],
             "horizontalAlignment": "center",
             "verticalAlignment": "center",
             "children": [
              {
               "SpeedReadout": {
                "speed": "@speed",
                "fontSize": "min(180, windowWidth() * 0.13)"
               }
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "width": 16
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "weight": 1.2
              },
              "fillMaxHeight"
             ],
             "children": [
              {
               "NavPanel": {
                "turn": "@turn",
                "dist": "@distance",
