          "modifiers": [
           "fillMaxSize",
           {
            "padding": 20
           }
          ],
          "horizontalAlignment": "center",
          "children": [
           {
            "box": {
             "modifiers": [
              "fillMaxWidth",
              {
               "verticalWeight": 1
              }
             ],
             "horizontalAlignment": "center",
             "verticalAlignment": "center",
             "children": [
              {
               "SpeedReadout": {
                "speed": "@speed",
                "fontSize": "min(150, windowWidth() * 0.2)"
               }
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "height": 12
              }
             ]
            }
           },
           {
            "row": {
             "modifiers": [
