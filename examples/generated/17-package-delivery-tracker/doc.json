{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 180,
  "profiles": 513,
  "contentDescription": "Package delivery tracker: the four steps Ordered, Shipped, Out for delivery and Delivered with the current one highlighted, the estimated arrival and the tracking number"
 },
 "resources": {
  "variables": {
   "stage": {
    "value": 2,
    "export": true
   },
   "etaDay": {
    "value": 306,
    "export": true
   },
   "etaMin": {
    "value": 870,
    "export": true
   },
   "y4": "1 - min(1, abs(year() % 4))",
   "y100": "1 - min(1, abs(year() % 100))",
   "y400": "1 - min(1, abs(year() % 400))",
   "leap": "@y4 * (1 - @y100) + @y400",
   "c1": "step(@etaDay, 31) + step(@etaDay, 59 + @leap) + step(@etaDay, 90 + @leap) + step(@etaDay, 120 + @leap)",
   "c2": "step(@etaDay, 151 + @leap) + step(@etaDay, 181 + @leap) + step(@etaDay, 212 + @leap) + step(@etaDay, 243 + @leap)",
   "c3": "step(@etaDay, 273 + @leap) + step(@etaDay, 304 + @leap) + step(@etaDay, 334 + @leap)",
   "etaMonth": "1 + @c1 + @c2 + @c3",
   "etaBefore": "ifElse(floor(30.6 * @etaMonth - 32.3) + @leap * step(@etaMonth, 2), 31 * (@etaMonth - 1), step(3, @etaMonth))",
   "etaDom": "@etaDay - @etaBefore",
   "dayDelta": "@etaDay - dayOfYear()",
   "isToday": "1 - min(1, abs(@dayDelta))",
   "isTomorrow": "1 - min(1, abs(@dayDelta - 1))",
   "isOther": "1 - @isToday - @isTomorrow",
   "etaH": "floor(@etaMin / 60)",
   "etaM": "@etaMin % 60",
   "wide": "step(windowWidth(), 239)",
   "short": "1 - step(windowHeight(), 119)",
   "layoutIdx": "@wide * (1 + @short)"
  }
 },
 "components": {
