 "components": {
  "HourChart": {
   "params": {
    "values": {
     "type": "float",
     "required": true,
     "doc": "24 hourly values, @name of an exported float array"
    },
    "hour": {
     "type": "float",
     "default": 12,
     "doc": "current hour 0..23, highlighted"
    },
    "prefix": {
     "type": "string",
     "default": "$",
     "doc": "currency prefix for the peak label"
    },
    "label": {
     "type": "string",
     "default": "Revenue by hour",
     "doc": "accessibility label start"
    },
    "ticks": {
     "type": "list",
     "default": [
      "0",
      "6",
      "12",
      "18"
     ],
     "static": true,
     "doc": "hour labels, every 6 hours"
    }
   },
   "locals": {
    "n": "arrayLength(@values)",
    "max": "max(arrayMax(@values), 1)",
    "base": 18,
    "top": 16
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxSize",
      {
       "semantics": {
        "contentDescription": {
         "type": "textMerge",
         "id1": {
          "type": "textMerge",
          "id1": {
           "type": "textMerge",
           "id1": {
            "type": "textMerge",
            "id1": {
             "type": "textMerge",
             "id1": {
              "type": "textMerge",
              "id1": {
               "type": "textMerge",
               "id1": {
                "type": "textMerge",
                "id1": {
                 "type": "textMerge",
                 "id1": "@label",
                 "id2": ", from 0 to "
                },
                "id2": "@prefix"
               },
               "id2": {
                "type": "textFromFloat",
                "value": "@max",
                "whole": 9,
                "decimal": 0,
                "flags": 23
               }
              },
              "id2": " per hour, current hour "
             },
             "id2": {
              "type": "textFromFloat",
              "value": "@hour",
              "whole": 2,
              "decimal": 0,
              "flags": 5
             }
            },
            "id2": ":00, "
           },
           "id2": "@prefix"
          },
          "id2": {
           "type": "textFromFloat",
           "value": "arrayGet(@values, @hour)",
           "whole": 9,
           "decimal": 0,
           "flags": 23
          }
         },
         "id2": " so far"
        }
       }
      }
     ],
     "commands": [
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.muted"
         },
         {
          "style": "fill"
         },
         {
          "textSize": 11
         }
        ]
       }
      },
      {
       "drawTextAnchored": {
        "text": {
         "type": "textMerge",
         "id1": "@prefix",
         "id2": {
          "type": "textFromFloat",
          "value": "@max",
          "whole": 9,
          "decimal": 0,
          "flags": 23
         }
        },
        "x": 0,
        "y": 6,
        "panX": -1,
        "panY": 0
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.outline"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": 1
         },
         {
          "alpha": 0.5
         }
        ]
       }
      },
      {
       "drawLine": {
        "x1": 0,
        "y1": "@top",
        "x2": "componentWidth()",
        "y2": "@top"
       }
      },
      {
       "translate": {
        "dx": 0,
        "dy": "componentHeight() - @base"
       }
      },
      {
       "save": {
        "commands": [
         {
          "clipRect": {
           "left": 0,
           "top": "-componentHeight()",
           "right": "componentWidth()",
           "bottom": 0
          }
         },
         {
          "paint": {
           "ops": [
            {
             "$if": "theme.mono",
             "then": {
              "color": "@colors.onSurface"
             },
             "else": {
              "color": "@colors.primary"
             }
            },
            {
             "$if": "theme.mono",
             "then": {
              "style": "stroke"
             },
             "else": {
              "style": "fill"
             }
            },
            {
             "strokeWidth": 1
            },
            {
             "$if": "theme.mono",
             "then": {
              "alpha": 1
             },
             "else": {
              "alpha": 0.4
             }
            }
           ]
          }
         },
         {
          "loop": {
           "index": "i",
           "from": 0,
           "until": "@n",
           "commands": [
            {
             "drawRoundRect": {
              "left": "(i + 0.15) * componentWidth() / @n",
              "top": "-arrayGet(@values, i) * (componentHeight() - @base - @top) / @max",
              "right": "(i + 0.85) * componentWidth() / @n",
              "bottom": 3,
              "rx": 2,
              "ry": 2
             }
            }
           ]
          }
         },
         {
          "paint": {
           "ops": [
            {
             "$if": "theme.mono",
             "then": {
              "color": "@colors.onSurface"
             },
             "else": {
              "color": "@colors.primary"
             }
            },
            {
             "style": "fill"
            },
            {
             "alpha": 1
            }
           ]
          }
         },
         {
          "drawRoundRect": {
           "left": "(@hour + 0.05) * componentWidth() / @n",
           "top": "-max(3, arrayGet(@values, @hour) * (componentHeight() - @base - @top) / @max)",
           "right": "(@hour + 0.95) * componentWidth() / @n",
           "bottom": 3,
           "rx": 2,
           "ry": 2
          }
         }
        ]
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.outline"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": 1
         },
         {
          "alpha": 1
         }
        ]
       }
      },
      {
       "drawLine": {
        "x1": 0,
        "y1": 0,
        "x2": "componentWidth()",
        "y2": 0
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.muted"
         },
         {
          "style": "fill"
         },
         {
          "textSize": 11
         }
        ]
       }
      },
      {
       "$each": "ticks",
       "as": "t",
       "index": "k",
       "do": {
        "drawTextAnchored": {
         "text": "@t",
         "x": "(@k * 6 + 0.5) * componentWidth() / @n",
         "y": 11,
         "panX": 0,
         "panY": 0
        }
       }
      },
      {
       "paint": {
        "ops": [
         {
          "$if": "theme.mono",
          "then": {
           "color": "@colors.onSurface"
          },
          "else": {
           "color": "@colors.primary"
          }
         },
         {
          "style": "fill"
         },
         {
          "textSize": 11
         }
        ]
       }
      },
      {
       "drawCircle": {
        "cx": "(@hour + 0.5) * componentWidth() / @n",
        "cy": 17,
        "radius": 2
       }
      }
     ]
    }
   }
  },
  "ProductRow": {
