   },
   "total": "arraySum(@hourly)",
   "change": "(@total - @yesterdayTotal) * 100 / max(@yesterdayTotal, 1)"
  },
  "floatArrays": {
   "hourly": {
    "value": [
     120,
     40,
     0,
     0,
     0,
     0,
     310,
     980,
     2150,
     3420,
     4100,
     4870,
     6230,
     5980,
     3150,
     0,
