                     "priority": 1
                    }
                   }
                  ],
                  "children": [
                   {
                    "text": {
                     "value": {
                      "type": "textMerge",
                      "id1": "+",
                      "id2": {
                       "type": "textMerge",
                       "id1": {
                        "type": "textFromFloat",
                        "value": "@extra",
                        "whole": 2,
                        "decimal": 0,
                        "flags": 5
                       },
                       "id2": " extra"
                      }
                     },
                     "fontSize": 13,
                     "color": "@colors.muted",
                     "maxLines": 2
                    }
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       },
       {
        "row": {
         "modifiers": [
          "fillMaxWidth"
         ],
         "verticalAlignment": "center",
         "children": [
          {
           "IconButton": {
            "label": "Remove a glass",
            "style": "outlined",
            "enabled": "@canUndo",
            "onClick": [
             {
              "type": "valueFloatExpressionChange",
              "target": "@drunk",
              "value": "max(0, @drunk - 1)"
             },
             {
              "type": "hostNamedAction",
              "name": "removeGlass",
              "value": "@drunk",
              "valueType": "float"
             }
