                      "name": "add",
                      "size": 24,
                      "color": "@colors.onPrimary"
                     }
                    }
                   ]
                  }
                 }
                },
                {
                 "Button": {
                  "label": "+1 glass",
                  "fill": true,
                  "onClick": [
                   {
                    "type": "valueFloatExpressionChange",
                    "target": "@drunk",
                    "value": "@drunk + 1"
                   },
                   {
                    "type": "hostNamedAction",
                    "name": "addGlass",
                    "value": "@drunk",
                    "valueType": "float"
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
