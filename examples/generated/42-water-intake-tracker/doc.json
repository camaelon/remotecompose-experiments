{
 "header": {
  "apiLevel": 7,
  "width": 160,
  "height": 160,
  "profiles": 513,
  "contentDescription": "Water intake tracker"
 },
 "components": {
  "Bottle": {
   "summary": "A water bottle whose water level follows a fraction 0..1, with a gentle wave on the surface and a tick per glass",
   "params": {
    "level": {
     "type": "float",
     "required": true,
     "doc": "0..1 fill fraction (clamped); eases 0.6 s on change"
    },
    "marks": {
     "type": "float",
     "default": 8,
     "doc": "number of glasses: a tick per glass on the side"
    },
    "color": {
     "type": "color",
     "default": "@colors.primary",
     "doc": "water colour"
    }
   },
   "locals": {
    "la": {
     "value": "clamp(0, 1, @level)",
     "anim": 0.6
    }
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxSize"
     ],
     "commands": [
      {
       "variable": {
        "name": "s",
        "value": "min(componentWidth() / 100, componentHeight() / 160)"
       }
      },
      {
       "translate": {
        "dx": "(componentWidth() - 100 * @s) / 2",
        "dy": "(componentHeight() - 160 * @s) / 2"
       }
      },
      {
       "scale": {
        "sx": "@s",
        "sy": "@s"
       }
      },
      {
       "variable": {
        "name": "wy",
        "value": "156 - @la * 120"
       }
      },
      {
       "variable": {
        "name": "amp",
        "value": "2.5 * step(@la, 0.02) * (1 - step(@la, 0.98))"
       }
      },
      {
       "pathCreate": {
        "id": "bottle",
        "x": 40,
        "y": 16
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 60,
        "y": 16
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 60,
        "y": 30
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 80,
        "y": 44
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 85,
        "y": 52
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 86,
        "y": 60
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 86,
        "y": 146
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 84,
        "y": 152
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 78,
        "y": 156
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 22,
        "y": 156
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 16,
        "y": 152
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 14,
        "y": 146
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 14,
        "y": 60
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 15,
        "y": 52
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 20,
        "y": 44
       }
      },
      {
       "pathAppendLineTo": {
        "path": "bottle",
        "x": 40,
        "y": 30
       }
      },
      {
       "pathAppendClose": {
        "path": "bottle"
       }
      },
      {
       "pathExpression": {
        "id": "water",
        "expressionX": "10 + 80 * a[0] - 160 * (a[0] - 1) * step(a[0], 1)",
        "expressionY": "(1 - step(a[0], 1)) * (@wy + @amp * sin(a[0] * 15.708)) + step(a[0], 1) * 170",
        "start": 0,
        "end": 2,
        "count": 64,
        "flags": 1
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.track"
         },
         {
          "style": "fill"
         },
         {
          "alpha": 1
         }
        ]
       }
      },
      {
       "$if": "!theme.mono",
       "then": {
        "drawPath": {
         "path": "bottle"
        }
       }
      },
      {
       "save": {
        "commands": [
         {
          "clipPath": {
           "path": "bottle"
          }
         },
         {
          "paint": {
           "ops": [
            {
             "color": "@color"
            },
            {
             "style": "fill"
            }
           ]
          }
         },
         {
          "drawPath": {
           "path": "water"
          }
         }
        ]
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.onSurface"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": {
           "$if": "theme.mono",
           "then": 2,
           "else": 3
          }
         },
         {
          "strokeJoin": "round"
         }
        ]
       }
      },
      {
       "drawPath": {
        "path": "bottle"
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.onSurface"
         },
         {
          "style": "fill"
         }
        ]
       }
      },
      {
       "drawRoundRect": {
        "left": 36,
        "top": 4,
        "right": 64,
        "bottom": 17,
        "rx": 3,
        "ry": 3
       }
      },
      {
       "paint": {
        "ops": [
         {
          "color": "@colors.muted"
         },
         {
          "style": "stroke"
         },
         {
          "strokeWidth": 2
         },
         {
          "strokeCap": "round"
         }
        ]
       }
      },
      {
       "loop": {
        "index": "i",
        "from": 1,
        "until": "@marks",
        "commands": [
         {
          "drawLine": {
           "x1": 76,
           "y1": "156 - i / @marks * 120",
           "x2": 82,
           "y2": "156 - i / @marks * 120"
          }
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "Bottle": {
     "level": 0.625
    }
   }
  }
 },
 "resources": {
  "variables": {
   "drunk": {
    "value": 5,
    "export": true
   },
   "goal": {
    "value": 8,
    "export": true
   },
   "g": "max(1, @goal)",
   "frac": "@drunk / @g",
   "done": "step(@drunk, @g - 0.5)",
   "over": "step(@drunk, @g + 0.5)",
   "notDone": "1 - @done",
   "left": "max(0, @g - @drunk)",
   "extra": "max(0, @drunk - @g)",
   "canUndo": "step(@drunk, 0.5)",
   "wideBtn": "step(windowWidth(), 140)"
  }
 },
 "root": {
  "box": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 6
    }
   ],
   "children": [
    {
     "column": {
      "modifiers": [
       "fillMaxSize"
      ],
      "children": [
       {
        "row": {
         "modifiers": [
          "fillMaxWidth",
          {
           "verticalWeight": 1
          }
         ],
         "verticalAlignment": "center",
         "children": [
          {
           "box": {
            "modifiers": [
             {
              "weight": 1
             },
             "fillMaxHeight",
             {
              "semantics": {
               "contentDescription": {
                "type": "textMerge",
                "id1": "Water bottle, ",
                "id2": {
                 "type": "textMerge",
                 "id1": {
                  "type": "textFromFloat",
                  "value": "@drunk",
                  "whole": 2,
                  "decimal": 0,
                  "flags": 5
                 },
                 "id2": {
                  "type": "textMerge",
                  "id1": " of ",
                  "id2": {
                   "type": "textMerge",
                   "id1": {
                    "type": "textFromFloat",
                    "value": "@g",
                    "whole": 2,
                    "decimal": 0,
                    "flags": 5
                   },
                   "id2": " glasses drunk today"
                  }
                 }
                }
               }
              }
             }
            ],
            "children": [
             {
              "Bottle": {
               "level": "@frac",
               "marks": "@g"
              }
             }
            ]
           }
          },
          {
           "box": {
            "modifiers": [
             {
              "width": 8
             }
            ]
           }
          },
          {
           "box": {
            "modifiers": [
             {
              "weight": 1.3
             },
             "fillMaxHeight"
            ],
            "verticalAlignment": "center",
            "children": [
             {
              "collapsibleColumn": {
               "modifiers": [
                "fillMaxWidth"
               ],
               "horizontalAlignment": "start",
               "verticalArrangement": "center",
               "children": [
                {
                 "text": {
                  "value": {
                   "type": "textMerge",
                   "id1": {
                    "type": "textFromFloat",
                    "value": "@drunk",
                    "whole": 2,
                    "decimal": 0,
                    "flags": 5
                   },
                   "id2": {
                    "type": "textMerge",
                    "id1": " / ",
                    "id2": {
                     "type": "textFromFloat",
                     "value": "@g",
                     "whole": 2,
                     "decimal": 0,
                     "flags": 5
                    }
                   }
                  },
                  "fontSize": 28,
                  "fontWeight": 700,
                  "color": "@colors.onSurface",
                  "maxLines": 1,
                  "autoSize": true,
                  "minFontSize": 14,
                  "maxFontSize": 28
                 }
                },
                {
                 "text": {
                  "value": "glasses",
                  "fontSize": 14,
                  "color": "@colors.onSurface",
                  "maxLines": 1,
                  "modifiers": [
                   {
                    "collapsiblePriority": {
                     "orientation": "vertical",
