                   {
                    "collapsiblePriority": {
                     "orientation": "vertical",
                     "priority": 1
                    }
                   }
                  ],
                  "children": [
                   {
                    "text": {
                     "value": {
                      "type": "textMerge",
                      "id1": {
                       "type": "textFromFloat",
                       "value": "@left",
                       "whole": 2,
                       "decimal": 0,
                       "flags": 5
                      },
                      "id2": " to go"
                     },
                     "fontSize": 13,
                     "color": "@colors.muted",
                     "maxLines": 2
                    }
                   }
                  ]
                 }
                },
                {
                 "box": {
                  "modifiers": [
                   {
                    "visibility": "@done"
                   },
                   {
                    "collapsiblePriority": {
                     "orientation": "vertical",
                     "priority": 1
                    }
                   }
                  ],
                  "children": [
                   {
                    "row": {
                     "verticalAlignment": "center",
                     "children": [
                      {
                       "Icon": {
                        "name": "check_circle",
                        "size": 16,
                        "color": "@colors.success",
                        "filled": true
                       }
                      },
                      {
                       "box": {
                        "modifiers": [
                         {
                          "width": 4
                         }
                        ]
                       }
                      },
                      {
                       "text": {
                        "value": "Goal reached",
                        "fontSize": 13,
                        "color": "@colors.onSurface",
                        "maxLines": 2
                       }
                      }
                     ]
                    }
                   }
                  ]
                 }
                },
                {
