{
 "header": {
  "apiLevel": 7,
  "width": 320,
  "height": 160,
  "profiles": 513,
  "contentDescription": "Flight status card: flight number, departure and arrival airports and times, gate, status and the flight's progress"
 },
 "resources": {
  "variables": {
   "depMin": {
    "value": 905,
    "export": true
   },
   "arrMin": {
    "value": 1130,
    "export": true
   },
   "progress": {
    "value": 0.45,
    "export": true
   },
   "statusIndex": {
    "value": 3,
    "export": true
   },
   "depH": "floor((@depMin % 1440) / 60)",
   "depM": "floor(@depMin % 60)",
   "arrH": "floor((@arrMin % 1440) / 60)",
   "arrM": "floor(@arrMin % 60)",
   "arrNext": "step(@arrMin, 1439.5)",
   "short": "step(119.5, windowHeight())",
   "narrow": "step(239.5, windowWidth())",
   "layoutIdx": "@short + 2 * @narrow"
  }
 },
 "components": {
  "StatusMark": {
   "summary": "Status icon (and word) coloured by the status index: 0 on time, 1 delayed, 2 boarding, 3 in flight, 4 landed",
   "params": {
    "index": {
     "type": "float",
     "required": true,
     "doc": "0 on time, 1 delayed, 2 boarding, 3 in flight, 4 landed"
    },
    "word": {
     "type": "string",
     "doc": "The status word (a host text variable); left out for an icon-only mark"
    },
    "size": {
     "type": "float",
     "default": 18,
     "static": true,
     "doc": "Icon size in dp"
    },
    "fontSize": {
     "type": "float",
     "default": 13,
     "static": true,
     "doc": "Word size in sp"
    }
   },
   "locals": {
    "v0": "1 - min(1, abs(@index - 0))",
    "v1": "1 - min(1, abs(@index - 1))",
    "v2": "1 - min(1, abs(@index - 2))",
    "v3": "1 - min(1, abs(@index - 3))",
    "v4": "1 - min(1, abs(@index - 4))"
   },
   "body": {
    "box": {
     "children": [
      {
       "row": {
        "modifiers": [
         {
          "visibility": "@v0"
         },
         {
          "spacedBy": 4
         }
        ],
        "verticalAlignment": "center",
        "children": [
         {
          "Icon": {
           "name": "check_circle",
           "size": "@size",
           "color": "@colors.success",
           "label": "On time"
          }
         },
         {
          "$if": "word",
          "then": {
           "text": {
            "value": "@word",
            "fontSize": "@fontSize",
            "fontWeight": 600,
            "color": "@colors.success",
            "maxLines": 1,
            "overflow": "ellipsis"
           }
          }
         }
        ]
       }
      },
      {
       "row": {
        "modifiers": [
         {
          "visibility": "@v1"
         },
         {
          "spacedBy": 4
         }
        ],
        "verticalAlignment": "center",
        "children": [
         {
          "Icon": {
           "name": "warning",
           "size": "@size",
           "color": "@colors.error",
           "label": "Delayed"
          }
         },
         {
          "$if": "word",
          "then": {
           "text": {
            "value": "@word",
            "fontSize": "@fontSize",
            "fontWeight": 600,
            "color": "@colors.error",
            "maxLines": 1,
            "overflow": "ellipsis"
           }
          }
         }
        ]
       }
      },
      {
       "row": {
        "modifiers": [
         {
          "visibility": "@v2"
         },
         {
          "spacedBy": 4
         }
        ],
        "verticalAlignment": "center",
        "children": [
         {
          "Icon": {
           "name": "flight_takeoff",
           "size": "@size",
           "color": "@colors.warning",
           "label": "Boarding"
          }
         },
         {
          "$if": "word",
          "then": {
           "text": {
            "value": "@word",
            "fontSize": "@fontSize",
            "fontWeight": 600,
            "color": "@colors.warning",
            "maxLines": 1,
            "overflow": "ellipsis"
           }
          }
         }
        ]
       }
      },
      {
       "row": {
        "modifiers": [
         {
          "visibility": "@v3"
         },
         {
          "spacedBy": 4
         }
        ],
        "verticalAlignment": "center",
        "children": [
         {
          "Icon": {
           "name": "flight",
           "size": "@size",
           "color": "@colors.primary",
           "label": "In flight"
          }
         },
         {
          "$if": "word",
          "then": {
           "text": {
            "value": "@word",
            "fontSize": "@fontSize",
            "fontWeight": 600,
            "color": "@colors.primary",
            "maxLines": 1,
            "overflow": "ellipsis"
           }
          }
         }
        ]
       }
      },
      {
       "row": {
        "modifiers": [
         {
          "visibility": "@v4"
         },
         {
          "spacedBy": 4
         }
        ],
        "verticalAlignment": "center",
        "children": [
         {
          "Icon": {
           "name": "flight_land",
           "size": "@size",
           "color": "@colors.muted",
           "label": "Landed"
          }
         },
         {
          "$if": "word",
          "then": {
           "text": {
            "value": "@word",
            "fontSize": "@fontSize",
            "fontWeight": 600,
            "color": "@colors.muted",
            "maxLines": 1,
            "overflow": "ellipsis"
           }
          }
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "StatusMark": {
     "index": 3,
     "word": "In flight"
    }
   }
  },
  "FlightLine": {
   "summary": "A route line between two airports with a plane at the flight's progress (0..1), scaled to its box",
   "params": {
    "progress": {
     "type": "float",
     "required": true,
     "doc": "0 at departure, 1 at arrival; clamped"
    },
    "height": {
     "type": "float",
     "default": 24,
     "static": true,
     "doc": "Height of the box in dp"
    },
    "plane": {
     "type": "float",
     "default": 20,
     "static": true,
     "doc": "Plane size in dp (its length)"
    }
   },
   "locals": {
    "p": "clamp(0, 1, @progress)"
   },
   "body": {
    "box": {
     "modifiers": [
      "fillMaxWidth",
      {
       "height": "@height"
      },
      {
       "semantics": {
        "contentDescription": {
         "type": "textMerge",
         "id1": "Flight progress ",
         "id2": {
          "type": "textMerge",
          "id1": {
           "type": "textFromFloat",
           "value": "@p * 100",
           "whole": 3,
           "decimal": 0,
           "flags": 5
          },
          "id2": " percent"
         }
        }
       }
      }
     ],
     "verticalAlignment": "center",
     "children": [
      {
       "canvas": {
        "modifiers": [
         "fillMaxSize"
        ],
        "commands": [
         {
          "variable": {
           "name": "cy",
           "value": "componentHeight() / 2"
          }
         },
         {
          "variable": {
           "name": "x0",
           "value": "@plane / 2"
          }
         },
         {
          "variable": {
           "name": "x1",
           "value": "componentWidth() - @plane / 2"
          }
         },
         {
          "variable": {
           "name": "px",
           "value": "@x0 + (@x1 - @x0) * @p"
          }
         },
         {
          "variable": {
           "name": "k",
           "value": "@plane / 20"
          }
         },
         {
          "paint": {
           "ops": [
            {
             "color": "@colors.track"
            },
            {
             "style": "stroke"
            },
            {
             "strokeWidth": 2
            }
           ]
          }
         },
         {
          "drawLine": {
           "x1": "@x0",
           "y1": "@cy",
           "x2": "@x1",
           "y2": "@cy"
          }
         },
         {
          "paint": {
           "ops": [
            {
             "color": "@colors.primary"
            },
            {
             "style": "stroke"
            },
            {
             "strokeWidth": 2
            }
           ]
          }
         },
         {
          "drawLine": {
           "x1": "@x0",
           "y1": "@cy",
           "x2": "@px",
           "y2": "@cy"
          }
         },
         {
          "paint": {
           "ops": [
            {
             "color": "@colors.track"
            },
            {
             "style": "fill"
            }
           ]
          }
         },
         {
          "drawCircle": {
           "cx": "@x1",
           "cy": "@cy",
           "radius": 3
          }
         },
         {
          "paint": {
           "ops": [
            {
             "color": "@colors.primary"
            },
            {
             "style": "fill"
            }
           ]
          }
         },
         {
          "drawCircle": {
           "cx": "@x0",
           "cy": "@cy",
           "radius": 3
          }
         },
         {
          "save": {}
         },
         {
          "translate": {
           "dx": "@px",
           "dy": "@cy"
          }
         },
         {
          "scale": {
           "sx": "@k",
           "sy": "@k"
          }
         },
         {
          "paint": {
           "ops": [
            {
             "color": "@colors.surface"
            },
            {
             "style": "fill"
            }
           ]
          }
         },
         {
          "drawCircle": {
           "cx": 0,
           "cy": 0,
           "radius": 11
          }
         },
         {
          "paint": {
           "ops": [
            {
             "color": "@colors.primary"
            },
            {
             "style": "fill"
            }
           ]
          }
         },
         {
          "drawOval": {
           "left": -9,
           "top": -2.2,
           "right": 9,
           "bottom": 2.2
          }
         },
         {
          "drawOval": {
           "left": -8.5,
           "top": -4.5,
           "right": -5,
           "bottom": 4.5
          }
         },
         {
          "save": {}
         },
         {
          "rotate": {
           "angle": -20,
           "cx": 0,
           "cy": 0
          }
         },
         {
          "drawOval": {
           "left": -3,
           "top": -9,
           "right": 1,
           "bottom": 9
          }
         },
         {
          "restore": {}
         },
         {
          "restore": {}
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "FlightLine": {
     "progress": 0.45
    }
   }
  },
  "Endpoint": {
   "summary": "An airport: code, optional city, scheduled time (with a +1 badge for a next-day arrival)",
   "params": {
    "code": {
     "type": "string",
     "required": true,
     "doc": "IATA code text variable, e.g. @depCode"
    },
    "city": {
     "type": "string",
     "doc": "City name text variable; left out to drop the city line"
    },
    "nextDay": {
     "type": "float",
     "default": 0,
     "doc": "1 shows a +1 badge next to the time"
    },
    "side": {
     "type": "enum",
     "values": [
      "start",
      "end"
     ],
     "default": "start",
     "doc": "Column alignment"
    },
    "codeSize": {
     "type": "float",
     "default": 24,
     "static": true,
     "doc": "Code size in sp"
    },
    "timeSize": {
     "type": "float",
     "default": 13,
     "static": true,
     "doc": "Time size in sp"
    },
    "minutes": {
     "type": "float",
     "required": true,
     "doc": "Scheduled local time as minutes of the day (0..1439; 1440 and over is the next day)"
    },
    "noCode": {
     "type": "bool",
     "default": false,
     "static": true,
     "doc": "true drops the code line (time only)"
    }
   },
   "body": {
    "column": {
     "horizontalAlignment": "@side",
     "children": [
      {
       "$if": "!noCode",
       "then": {
        "text": {
         "value": "@code",
         "fontSize": "@codeSize",
         "fontWeight": 700,
         "color": "@colors.onSurface",
         "maxLines": 1
        }
       }
      },
      {
       "$if": "city",
       "then": {
        "text": {
         "value": "@city",
         "fontSize": 11,
         "color": "@colors.muted",
         "maxLines": 1,
         "overflow": "ellipsis"
        }
       }
      },
      {
       "row": {
        "verticalAlignment": "center",
        "children": [
         {
          "text": {
           "value": {
            "type": "textMerge",
            "id1": {
             "type": "textFromFloat",
             "value": "floor((@minutes % 1440) / 60)",
             "whole": 2,
             "decimal": 0,
             "flags": 13
            },
            "id2": {
             "type": "textMerge",
             "id1": ":",
             "id2": {
              "type": "textFromFloat",
              "value": "floor(@minutes % 60)",
              "whole": 2,
              "decimal": 0,
              "flags": 13
             }
            }
           },
           "fontSize": "@timeSize",
           "color": "@colors.onSurface",
           "maxLines": 1
          }
         },
         {
          "text": {
           "value": "+1",
           "fontSize": 9,
           "fontWeight": 700,
           "color": "@colors.onPrimary",
           "modifiers": [
            {
             "visibility": "@nextDay"
            },
            {
             "semantics": {
              "contentDescription": "arrives the next day"
             }
            },
            {
             "padding": {
              "start": 3
             }
            },
            {
             "clip": {
              "roundedRect": 4
             }
            },
            {
             "background": "@colors.error"
            },
            {
             "padding": [
              3,
              1
             ]
            }
           ]
          }
         }
        ]
       }
      }
     ]
    }
   },
   "call": {
    "Endpoint": {
     "code": "@depCode",
     "city": "@depCity",
     "minutes": 905
    }
   }
  }
 },
