{
 "header": {
  "apiLevel": 7,
  "width": 300,
  "height": 100,
  "profiles": 513,
  "contentDescription": "A slider from 0 to 100 dragged by its thumb"
 },
 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize",
   {
    "background": "#FF101828"
   }
  ],
  "commands": [
   {
    "touchExpression": {
     "name": "value",
     "defaultValue": 30,
     "min": 0,
     "max": 100,
     "expression": [
      "(touchX() - 20) / (componentWidth() - 40) * 100"
     ],
     "touchMode": 6
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FF2A3342"
      },
      {
       "style": "stroke"
      },
      {
       "strokeWidth": 6
      },
      {
       "strokeCap": "round"
      }
     ]
    }
   },
   {
    "drawLine": {
     "x1": 20,
     "y1": 60,
     "x2": "componentWidth() - 20",
     "y2": 60
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FF4DA3FF"
      }
     ]
    }
   },
   {
    "drawLine": {
     "x1": 20,
     "y1": 60,
     "x2": "20 + (componentWidth() - 40) * @value / 100",
     "y2": 60
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FFFFFFFF"
      },
      {
       "style": "fill"
      },
      {
       "textSize": 18
      }
     ]
    }
   },
   {
    "drawCircle": {
     "cx": "20 + (componentWidth() - 40) * @value / 100",
     "cy": 60,
     "radius": 11
    }
   },
   {
    "drawTextAnchored": {
     "text": {
      "type": "textFromFloat",
      "value": "@value",
      "whole": 3,
      "decimal": 0
     },
     "x": "componentWidth() / 2",
     "y": 24,
     "panX": 0,
     "panY": 0
    }
   }
  ]
 }
}
