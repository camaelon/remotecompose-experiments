{
 "header": {"apiLevel": 7, "width": 300, "height": 300, "profiles": 513,
  "contentDescription": "The word Word drawn nine times, each anchored differently where two red guide lines cross"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "x1", "value": "componentWidth() / 6"}},
   {"variable": {"name": "x2", "value": "componentWidth() / 2"}},
   {"variable": {"name": "x3", "value": "componentWidth() * 5 / 6"}},
   {"variable": {"name": "y1", "value": "componentHeight() / 6"}},
   {"variable": {"name": "y2", "value": "componentHeight() / 2"}},
   {"variable": {"name": "y3", "value": "componentHeight() * 5 / 6"}},
   {"paint": {"color": "#AAEF5350", "style": "stroke", "strokeWidth": 1}},
   {"drawLine": {"x1": 0, "y1": "@y1", "x2": "componentWidth()", "y2": "@y1"}},
   {"drawLine": {"x1": "@x1", "y1": 0, "x2": "@x1", "y2": "componentHeight()"}},
   {"drawLine": {"x1": 0, "y1": "@y2", "x2": "componentWidth()", "y2": "@y2"}},
   {"drawLine": {"x1": "@x2", "y1": 0, "x2": "@x2", "y2": "componentHeight()"}},
   {"drawLine": {"x1": 0, "y1": "@y3", "x2": "componentWidth()", "y2": "@y3"}},
   {"drawLine": {"x1": "@x3", "y1": 0, "x2": "@x3", "y2": "componentHeight()"}},
   {"paint": {"color": "#FFFFFFFF", "style": "fill", "textSize": 18}},
   {"drawTextAnchored": {"text": "Word", "x": "@x1", "y": "@y1", "panX": -1, "panY": -1}},
   {"drawTextAnchored": {"text": "Word", "x": "@x2", "y": "@y1", "panX": 0, "panY": -1}},
   {"drawTextAnchored": {"text": "Word", "x": "@x3", "y": "@y1", "panX": 1, "panY": -1}},
   {"drawTextAnchored": {"text": "Word", "x": "@x1", "y": "@y2", "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "Word", "x": "@x2", "y": "@y2", "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "Word", "x": "@x3", "y": "@y2", "panX": 1, "panY": 0}},
   {"drawTextAnchored": {"text": "Word", "x": "@x1", "y": "@y3", "panX": -1, "panY": 1}},
   {"drawTextAnchored": {"text": "Word", "x": "@x2", "y": "@y3", "panX": 0, "panY": 1}},
   {"drawTextAnchored": {"text": "Word", "x": "@x3", "y": "@y3", "panX": 1, "panY": 1}}
  ]
 }
}
