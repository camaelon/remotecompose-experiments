{
 "header": {"apiLevel": 7, "width": 360, "height": 200, "profiles": 513,
  "contentDescription": "A night skyline of towers with randomly lit windows under a starry sky"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"variable": {"name": "w", "value": "componentWidth()"}},
   {"variable": {"name": "h", "value": "componentHeight()"}},
   {"paint": {"ops": [{"linearGradient": {"x1": 0, "y1": 0, "x2": 0, "y2": "@h",
      "colors": ["#FF070B18", "#FF1C2A4A"]}}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "@w", "bottom": "@h"}},
   {"paint": {"ops": [{"shader": 0}, {"color": "#FFFFFFFF"}]}},
   {"loop": {"index": "s", "from": 0, "until": 50, "commands": [
    {"paint": {"ops": [{"alpha": "0.3 + 0.7 * seed(s * 29 + 5003, rand())"}]}},
    {"drawCircle": {"cx": "@w * seed(s * 131 + 7, rand())", "cy": "120 * seed(s * 57 + 1001, rand())",
      "radius": "0.6 + seed(s * 13 + 9001, rand())"}}
   ]}},
   {"paint": {"ops": [{"alpha": 1}, {"color": "#FFE8EDF5"}]}},
   {"drawCircle": {"cx": "@w - 60", "cy": 38, "radius": 16}},
   {"loop": {"index": "i", "from": 0, "until": "ceil(@w / 26)", "commands": [
    {"paint": {"ops": [{"color": "#FF161F30"}, {"alpha": 1}]}},
    {"drawRect": {"left": "i * 26 - 2", "right": "i * 26 + 20",
      "top": "@h - 40 - 110 * seed(i * 97 + 3, rand())", "bottom": "@h"}},
    {"paint": {"ops": [{"color": "#FFFFCA28"}]}},
    {"loop": {"index": "j", "from": 0, "until": "floor((40 + 110 * seed(i * 97 + 3, rand())) / 10) - 1", "commands": [
     {"loop": {"index": "k", "from": 0, "until": 3, "commands": [
      {"paint": {"ops": [{"alpha": "0.9 * step(seed(i * 389 + j * 41 + k * 7 + 20000, rand()), 0.55)"}]}},
      {"drawRect": {"left": "i * 26 + k * 7", "right": "i * 26 + k * 7 + 4",
        "top": "@h - 34 - 110 * seed(i * 97 + 3, rand()) + j * 10", "bottom": "@h - 29 - 110 * seed(i * 97 + 3, rand()) + j * 10"}}
     ]}}
    ]}}
   ]}}
  ]
 }
}
