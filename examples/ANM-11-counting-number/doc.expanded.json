{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 180,
  "profiles": 513,
  "contentDescription": "A savings balance that counts up to its new total when a deposit is added"
 },
 "resources": {
  "variables": {
   "total": 1250
  },
  "colors": {
   "background": {
    "light": "#FFF5F7FA",
    "dark": "#FF101828"
   },
   "muted": {
    "light": "#FF5A6475",
    "dark": "#FF8A94A6"
   },
   "onPrimary": {
    "light": "#FFFFFFFF",
    "dark": "#FF0B1A2E"
   },
   "onSurface": {
    "light": "#FF111827",
    "dark": "#FFE6EAF2"
   },
   "success": {
    "light": "#FF2E7D32",
    "dark": "#FF66BB6A"
   },
   "track": {
    "light": "#FFB0B8C4",
    "dark": "#FF2A3342"
   }
  }
 },
 "root": [
  {
   "variable": {
    "name": "shown",
    "value": {
     "value": "@total",
     "anim": 0.9
    }
   }
  },
  {
   "column": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "@colors.background"
     },
     {
      "padding": 16
     },
     {
      "spacedBy": 6
     }
    ],
    "children": [
     {
      "text": {
       "value": "Holiday savings",
       "fontSize": 15,
       "color": "@colors.muted"
      }
     },
     {
      "row": {
       "verticalAlignment": "bottom",
       "children": [
        {
         "text": {
          "value": "$",
          "fontSize": 28,
          "color": "@colors.success"
         }
        },
        {
         "text": {
          "value": {
           "type": "textFromFloat",
           "value": "round(@shown)",
           "whole": 5,
           "decimal": 0,
           "flags": 5
          },
          "fontSize": 44,
          "color": "@colors.onSurface"
         }
        }
       ]
      }
     },
     {
      "canvas": {
       "modifiers": [
        "fillMaxWidth",
        {
         "height": 8
        }
       ],
       "commands": [
        {
         "variable": {
          "name": "progressbar1_pa",
          "value": {
           "value": "@shown / 4000",
           "anim": 0.3
          }
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.track"
           },
           {
            "style": "fill"
           }
          ]
         }
        },
        {
         "drawRoundRect": {
          "left": 0,
          "top": 0,
          "right": "componentWidth()",
          "bottom": 8,
          "rx": 4,
          "ry": 4
         }
        },
        {
         "paint": {
          "ops": [
           {
            "style": "fill"
           },
           {
            "color": "@colors.success"
           }
          ]
         }
        },
        {
         "drawRoundRect": {
          "left": 0,
          "top": 0,
          "right": "max(8, componentWidth() * clamp(0, 1, @progressbar1_pa))",
          "bottom": 8,
          "rx": 4,
          "ry": 4
         }
        }
       ]
      }
     },
     {
      "row": {
       "verticalAlignment": "center",
       "modifiers": [
        "fillMaxWidth"
       ],
       "children": [
        {
         "text": {
          "value": "Goal $4000",
          "fontSize": 13,
          "color": "@colors.muted",
          "modifiers": [
           {
            "weight": 1
           }
          ]
         }
        },
        {
         "box": {
          "horizontalAlignment": "center",
          "verticalAlignment": "center",
          "modifiers": [
           {
            "padding": [
             0,
             4
            ]
           },
           {
            "height": 40
           },
           {
            "clip": 14
           },
           {
            "background": "@colors.success"
           },
           {
            "padding": [
             16,
             0
            ]
           },
           "ripple",
           {
            "semantics": {
             "contentDescription": "+ $250",
             "enabled": true,
             "clickable": true
            }
           },
           {
            "onClick": {
             "type": "valueFloatExpressionChange",
             "target": "@total",
             "value": "@total + 250"
            }
           }
          ],
          "children": [
           {
            "text": {
             "value": "+ $250",
             "maxLines": 1,
             "overflow": "ellipsis",
             "fontSize": 15,
             "color": "@colors.onPrimary"
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ]
}
