{
 "id": "ANM-11",
 "name": "counting-number",
 "version": 2,
 "title": "Counting number",
 "summary": "A savings balance that counts up to its new total when + $250 is tapped: one animated variable {\"value\": \"@total\", \"anim\": 0.9} feeds both the textFromFloat label and the library ProgressBar.",
 "prompt": "A savings goal card showing the balance in large digits and a progress bar; tapping '+ $250' adds a deposit and the number counts up to the new total while the bar grows.",
 "level": 2,
 "family": "ANM",
 "capabilities": {
  "primary": [
   "anim.value"
  ],
  "secondary": [
   "text.dynamic",
   "input.tap",
   "draw.shapes",
   "layout.decoration",
   "layout.weight",
   "a11y.labels"
  ]
 },
 "use_cases": [
  "finance",
  "card"
 ],
 "form_factor": "widget-4x2",
 "keywords": [
  "count up",
  "animated number",
  "balance",
  "savings goal",
  "odometer",
  "number ticker",
  "deposit",
  "rolling counter"
 ],
 "teaches": [
  "Count a displayed number up or down by animating a copy of it: shown = {\"value\": \"@total\", \"anim\": 0.9} and the label shows round(@shown)",
  "Keep the real value exact and animate only what's displayed: the click adds to @total, the text and bar read @shown",
  "Declare the animated copy once, at the tree root, so every reader shares the same animation (anim is ignored in resources.variables); the exact total lives in resources.variables"
 ],
 "pitfalls": [
  "Round the animated value (round(@shown)) or the label shows fractional dollars while it counts",
  "Size `whole` in textFromFloat for the largest total you expect: digits beyond it are lost",
  "Give ProgressBar the eased copy (@shown / 4000), so the bar and the number move together; it clamps at 1 and fills whatever width it gets. Its own 0.3 s easing then only smooths the last step"
 ],
 "snippets": [
  {
   "pointer": "/root/0",
   "shows": "anim.value",
   "note": "shown = {value: @total, anim: 0.9}"
  },
  {
   "pointer": "/root/1/column/children/1/row/children/1/text/value",
   "shows": "text.dynamic",
   "note": "textFromFloat(round(@shown)), 5 digits"
  },
  {
   "pointer": "/root/1/column/children/3/row/children/1/Button/onClick",
   "shows": "input.tap",
   "note": "+ $250 (Button): total = total + 250"
  },
  {
   "pointer": "/root/1/column/children/2",
   "shows": "anim.value",
   "note": "ProgressBar progress = @shown / 4000: the bar reads the same eased copy as the label"
  }
 ],
 "inputs": {
  "variables": {},
  "clock": null,
  "touch": true
 },
 "check": {
  "describe": "Starts at $1250. A tap on + $250 at 0.1 s, captured 0.3 s later, shows about $1364 and a slightly longer bar; it settles at $1500. Resized (narrow 240, wide 540) the ProgressBar spans the width and the button stays at the right, so the same tap grows the bar by the same fraction. Mono looks have no motion: the balance is already $1500.",
