 "name": "counting-number",
 "version": 2,
 "title": "Counting number",
 "summary": "A savings balance that counts up to its new total when + $250 is tapped: one animated variable {\"value\": \"@total\", \"anim\": 0.9} feeds both the textFromFloat label and the progress bar.",
 "prompt": "A savings goal card showing the balance in large digits and a progress bar; tapping '+ $250' adds a deposit and the number counts up to the new total while the bar grows.",
 "level": 2,
 "family": "ANM",
 "capabilities": {
  "primary": [
   "anim.value"
  ],
  "secondary": [
   "text.dynamic",
   "input.tap",
   "draw.shapes",
   "layout.decoration",
   "layout.weight",
   "a11y.labels"
  ]
 },
 "use_cases": [
  "finance",
  "card"
 ],
 "form_factor": "widget-4x2",
 "keywords": [
  "count up",
  "animated number",
  "balance",
  "savings goal",
  "odometer",
  "number ticker",
  "deposit",
  "rolling counter"
 ],
 "teaches": [
  "Count a displayed number up or down by animating a copy of it: shown = {\"value\": \"@total\", \"anim\": 0.9} and the label shows round(@shown)",
  "Keep the real value exact and animate only what's displayed: the click adds to @total, the text and bar read @shown",
  "Declare the animated copy once, at the tree root, so every reader shares the same animation"
 ],
 "pitfalls": [
  "Round the animated value (round(@shown)) or the label shows fractional dollars while it counts",
  "Size `whole` in textFromFloat for the largest total you expect: digits beyond it are lost",
  "Scale the bar by componentWidth(), not the header's 320: min(1, @shown / 4000) * componentWidth() fills any width"
 ],
 "snippets": [
  {
   "pointer": "/root/1",
   "shows": "anim.value",
   "note": "shown = {value: @total, anim: 0.9}"
  },
  {
   "pointer": "/root/2/column/children/1/row/children/1/text/value",
   "shows": "text.dynamic",
   "note": "textFromFloat(round(@shown)), 5 digits"
  },
  {
   "pointer": "/root/2/column/children/3/row/children/1/box/modifiers/4",
   "shows": "input.tap",
   "note": "+ $250: total = total + 250"
  }
 ],
