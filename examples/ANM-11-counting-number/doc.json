{
 "header": {"apiLevel": 7, "width": 360, "height": 180, "profiles": 513,
  "contentDescription": "A savings balance that counts up to its new total when a deposit is added"},
 "root": [
  {"variable": {"name": "total", "value": 1250}},
  {"variable": {"name": "shown", "value": {"value": "@total", "anim": 0.9}}},
  {"column": {
   "modifiers": ["fillMaxSize", {"background": "#FF101828"}, {"padding": 20}, {"spacedBy": 6}],
   "children": [
    {"text": {"value": "Holiday savings", "fontSize": 15, "color": "#FF8A99AD"}},
    {"row": {"verticalAlignment": "bottom", "children": [
     {"text": {"value": "$", "fontSize": 28, "color": "#FF66D19E"}},
     {"text": {"value": {"type": "textFromFloat", "value": "round(@shown)", "whole": 5, "decimal": 0, "flags": 5},
       "fontSize": 44, "color": "#FFFFFFFF"}}
    ]}},
    {"canvas": {
     "modifiers": ["fillMaxWidth", {"height": 14}],
     "commands": [
      {"paint": {"color": "#FF243044"}},
      {"drawRoundRect": {"left": 0, "top": 3, "right": "componentWidth()", "bottom": 11, "rx": 4, "ry": 4}},
      {"paint": {"color": "#FF66D19E"}},
      {"drawRoundRect": {"left": 0, "top": 3, "right": "min(1, @shown / 4000) * componentWidth()", "bottom": 11, "rx": 4, "ry": 4}}
     ]}},
    {"row": {"verticalAlignment": "center", "modifiers": ["fillMaxWidth"], "children": [
     {"text": {"value": "Goal $4000", "fontSize": 13, "color": "#FF8A99AD", "modifiers": [{"weight": 1}]}},
     {"box": {"horizontalAlignment": "center", "verticalAlignment": "center",
      "modifiers": [{"size": [112, 40]}, {"clip": 20}, {"background": "#FF66D19E"},
       {"semantics": {"contentDescription": "Deposit 250 dollars", "clickable": true}},
       {"onClick": {"type": "valueFloatExpressionChange", "target": "@total", "value": "@total + 250"}}],
      "children": [{"text": {"value": "+ $250", "fontSize": 16, "color": "#FF0D2A1C"}}]}}
    ]}}
   ]}}
 ]
}
