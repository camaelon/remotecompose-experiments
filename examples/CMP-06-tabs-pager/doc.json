{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 200,
  "profiles": 513,
  "contentDescription": "Tabs switching three summary panels, with page dots following the selected tab"
 },
 "resources": { "variables": { "tab": 0 } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 12 }, { "spacedBy": 12 }],
   "horizontalAlignment": "center",
   "children": [
    { "Tabs": { "labels": ["Day", "Week", "Month"], "selected": "@tab" } },
    {
     "box": {
      "modifiers": ["fillMaxWidth"],
      "children": [
       {
        "box": {
         "modifiers": ["fillMaxWidth", { "graphicsLayer": { "alpha": { "value": "1 - min(1, abs(@tab - 0))", "anim": 0.25 } } }],
         "children": [
          {
           "Card": {
            "title": "Today",
            "subtitle": "3 meetings, 2 tasks due",
            "children": [{ "ProgressBar": { "progress": 0.4 } }]
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": ["fillMaxWidth", { "graphicsLayer": { "alpha": { "value": "1 - min(1, abs(@tab - 1))", "anim": 0.25 } } }],
         "children": [
          {
           "Card": {
            "title": "This week",
            "subtitle": "12 meetings, 9 tasks",
            "children": [{ "ProgressBar": { "progress": 0.65 } }]
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": ["fillMaxWidth", { "graphicsLayer": { "alpha": { "value": "1 - min(1, abs(@tab - 2))", "anim": 0.25 } } }],
         "children": [
          {
           "Card": {
            "title": "This month",
            "subtitle": "41 meetings, 37 tasks",
            "children": [{ "ProgressBar": { "progress": 0.8 } }]
           }
          }
         ]
        }
       }
      ]
     }
    },
    { "PagerDots": { "count": 3, "current": "@tab" } }
   ]
  }
 }
}
