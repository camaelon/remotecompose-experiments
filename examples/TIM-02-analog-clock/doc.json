{
 "header": {"apiLevel": 7, "width": 200, "height": 200, "profiles": 513,
  "contentDescription": "An analog clock showing the current time"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 200, componentHeight() / 200)"}},
   {"translate": {"dx": "(componentWidth() - 200) / 2", "dy": "(componentHeight() - 200) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 100, "pivotY": 100}},
   {"paint": {"color": "#FF101828"}},
   {"drawCircle": {"cx": 100, "cy": 100, "radius": 92}},
   {"paint": {"color": "#FF8899AA", "strokeWidth": 3, "strokeCap": "round", "style": "stroke"}},
   {"loop": {"index": "i", "from": 0, "until": 12, "commands": [
    {"save": {"commands": [
     {"rotate": {"angle": "i * 30", "pivotX": 100, "pivotY": 100}},
     {"drawLine": {"x1": 100, "y1": 14, "x2": 100, "y2": 24}}
    ]}}
   ]}},
   {"save": {"commands": [
    {"rotate": {"angle": "(timeInMin() % 720) * 0.5", "pivotX": 100, "pivotY": 100}},
    {"paint": {"color": "#FFFFFFFF", "strokeWidth": 7}},
    {"drawLine": {"x1": 100, "y1": 100, "x2": 100, "y2": 54}}
   ]}},
   {"save": {"commands": [
    {"rotate": {"angle": "(timeInMin() % 60) * 6 + (timeInSec() % 60) * 0.1", "pivotX": 100, "pivotY": 100}},
    {"paint": {"color": "#FFFFFFFF", "strokeWidth": 4}},
    {"drawLine": {"x1": 100, "y1": 100, "x2": 100, "y2": 30}}
   ]}},
   {"save": {"commands": [
    {"rotate": {"angle": "(timeInSec() % 60) * 6", "pivotX": 100, "pivotY": 100}},
    {"paint": {"color": "#FFEF5350", "strokeWidth": 2}},
    {"drawLine": {"x1": 100, "y1": 100, "x2": 100, "y2": 22}}
   ]}},
   {"paint": {"color": "#FFEF5350", "style": "fill"}},
   {"drawCircle": {"cx": 100, "cy": 100, "radius": 5}}
  ]
 }
}
