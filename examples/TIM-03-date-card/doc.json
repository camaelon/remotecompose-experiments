{
 "header": {"apiLevel": 7, "width": 180, "height": 180, "profiles": 513,
  "contentDescription": "A calendar card showing today's weekday, day of the month and month"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 180, componentHeight() / 180)"}},
   {"translate": {"dx": "(componentWidth() - 180) / 2", "dy": "(componentHeight() - 180) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 90, "pivotY": 90}},
   {"paint": {"color": "#FF1C2638"}},
   {"drawRoundRect": {"left": 10, "top": 10, "right": 170, "bottom": 170, "rx": 20, "ry": 20}},
   {"paint": {"color": "#FFEF5350"}},
   {"drawRoundRect": {"left": 10, "top": 10, "right": 170, "bottom": 50, "rx": 20, "ry": 20}},
   {"drawRect": {"left": 10, "top": 30, "right": 170, "bottom": 50}},
   {"addDataList": {"id": "days", "list": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}},
   {"addDataList": {"id": "months", "list": ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]}},
   {"textLookup": {"array": "@days", "index": "weekDay() - 1", "varName": "dayName"}},
   {"textLookup": {"array": "@months", "index": "calendarMonth() - 1", "varName": "monthName"}},
   {"paint": {"color": "#FFFFFFFF", "textSize": 20}},
   {"drawTextAnchored": {"text": "@dayName", "x": 90, "y": 30, "panX": 0, "panY": 0}},
   {"paint": {"textSize": 64}},
   {"drawTextAnchored": {"text": {"type": "textFromFloat", "value": "dayOfMonth()", "whole": 2, "decimal": 0, "flags": 4},
     "x": 90, "y": 100, "panX": 0, "panY": 0}},
   {"paint": {"color": "#FF4DA3FF", "textSize": 22}},
   {"drawTextAnchored": {"text": "@monthName", "x": 90, "y": 148, "panX": 0, "panY": 0}}
  ]
 }
}
