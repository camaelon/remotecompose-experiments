    {
     "canvas": {
      "modifiers": [
       "fillMaxWidth",
       {
        "verticalWeight": 1
       }
      ],
      "commands": [
       {
        "variable": {
         "name": "m",
         "value": "calendarMonth()"
        }
       },
       {
        "variable": {
         "name": "fw",
         "value": "(weekDay() - dayOfMonth() + 35) % 7"
        }
       },
       {
        "variable": {
         "name": "leap",
         "value": "1 - min(1, year() % 4) - (1 - min(1, year() % 100)) + (1 - min(1, year() % 400))"
        }
       },
       {
        "variable": {
         "name": "nd",
         "value": "30 + (@m + floor(@m / 8)) % 2 - (1 - min(1, abs(@m - 2))) * (2 - @leap)"
        }
       },
       {
        "variable": {
         "name": "cw",
         "value": "componentWidth() / 7"
        }
       },
       {
        "variable": {
         "name": "rh",
         "value": "componentHeight() / 6"
        }
       },
       {
        "variable": {
         "name": "side",
         "value": "step(@cw, 1.6 * @rh)"
        }
       },
       {
        "variable": {
         "name": "u",
         "value": "min(@cw, @rh)"
        }
       },
       {
        "variable": {
         "name": "ts",
         "value": "clamp(10, 15, 0.26 * @u)"
        }
       },
       {
        "loop": {
         "index": "week",
         "from": 0,
         "until": 6,
         "commands": [
          {
           "loop": {
            "index": "wd",
            "from": 0,
            "until": 7,
            "commands": [
             {
              "variable": {
               "name": "day",
               "value": "week * 7 + wd + 1 - @fw"
              }
             },
             {
              "variable": {
               "name": "inMonth",
               "value": "step(@day, 0.5) * step(@nd + 0.5, @day)"
              }
             },
             {
              "variable": {
               "name": "isToday",
               "value": "1 - min(1, abs(@day - dayOfMonth()))"
              }
             },
             {
              "variable": {
               "name": "k",
               "value": "@d0 - dayOfMonth() + @day"
              }
             },
             {
              "variable": {
               "name": "k1",
               "value": "@k + 1"
              }
             },
             {
              "variable": {
               "name": "lk0",
               "value": "0.8104301 + 0.033863192 * @k + 0.017469 * sin(2.241546 + 0.2280275 * @k) + 0.003539 * sin(7.942619 + 0.19750992 * @k)"
              }
             },
             {
              "variable": {
               "name": "lk",
               "value": "@lk0 + 0.001828 * sin(10.184165 + 0.42553742 * @k) - 0.005836 * sin(6.231459 + 0.01720197 * @k) + 0.000593 * sin(4.483093 + 0.456055 * @k)"
              }
             },
             {
              "variable": {
               "name": "lk10",
               "value": "0.8104301 + 0.033863192 * @k1 + 0.017469 * sin(2.241546 + 0.2280275 * @k1) + 0.003539 * sin(7.942619 + 0.19750992 * @k1)"
              }
             },
             {
              "variable": {
               "name": "lk1",
               "value": "@lk10 + 0.001828 * sin(10.184165 + 0.42553742 * @k1) - 0.005836 * sin(6.231459 + 0.01720197 * @k1) + 0.000593 * sin(4.483093 + 0.456055 * @k1)"
              }
             },
             {
              "variable": {
               "name": "q1",
               "value": "floor(4 * @lk1)"
              }
             },
             {
              "variable": {
               "name": "ev",
               "value": "@inMonth * (@q1 - floor(4 * @lk))"
              }
             },
             {
              "variable": {
               "name": "ph",
               "value": "(@lk + @lk1) / 2"
              }
             },
             {
              "variable": {
               "name": "c",
               "value": "cos(6.2831853 * @ph)"
              }
             },
             {
              "variable": {
               "name": "x",
               "value": "@cw * (wd + 0.5)"
              }
             },
             {
              "variable": {
               "name": "nx",
               "value": "@x - @side * 0.2 * @cw"
              }
             },
             {
              "variable": {
               "name": "mx",
               "value": "@x + @side * 0.2 * @cw"
              }
             },
             {
              "variable": {
               "name": "y0",
               "value": "@rh * week"
              }
             },
             {
              "variable": {
               "name": "cy",
               "value": "@y0 + @rh * (0.52 - 0.02 * @side)"
              }
             },
             {
              "variable": {
               "name": "ny",
               "value": "@y0 + @rh * (0.17 + 0.33 * @side)"
              }
             },
             {
              "variable": {
               "name": "r",
               "value": "0.27 * @u * @inMonth"
              }
             },
             {
              "paint": {
               "ops": [
                {
                 "color": "@colors.primary"
                },
                {
                 "style": "stroke"
                },
                {
                 "strokeWidth": 1.5
                },
                {
                 "alpha": "@isToday"
                }
               ]
              }
             },
             {
              "drawRoundRect": {
               "left": "@x - @cw / 2 + 2",
               "top": "@y0 + 1",
               "right": "@x + @cw / 2 - 2",
               "bottom": "@y0 + @rh - 1",
               "rx": 8,
               "ry": 8
              }
             },
             {
              "paint": {
               "ops": [
                {
                 "style": "fill"
                },
                {
                 "textSize": "@ts"
                }
               ]
              }
             },
             {
              "drawTextAnchored": {
               "text": {
                "type": "textFromFloat",
                "value": "@day",
                "whole": 2,
                "decimal": 0,
                "flags": 5
               },
               "x": "@nx",
               "y": "@ny",
               "panX": 0,
               "panY": 0
              }
             },
             {
              "paint": {
               "ops": [
                {
                 "color": "@colors.onSurface"
                },
                {
                 "alpha": "@inMonth * (1 - @isToday)"
                }
               ]
              }
             },
             {
              "drawTextAnchored": {
               "text": {
                "type": "textFromFloat",
                "value": "@day",
                "whole": 2,
                "decimal": 0,
