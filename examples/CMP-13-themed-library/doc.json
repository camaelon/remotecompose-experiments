{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 420,
  "profiles": 513,
  "contentDescription": "The component library re-themed by overriding its colours: a warm light brand palette"
 },
 "resources": {
  "colors": {
   "background": "#FFFFF8F0",
   "surface": "#FFFFFFFF",
   "onSurface": "#FF2B1D14",
   "muted": "#FF8C7466",
   "outline": "#FFE6D5C6",
   "track": "#FFEADBCD",
   "primary": "#FFE8590C",
   "onPrimary": "#FFFFFFFF",
   "success": "#FF2F9E44",
   "warning": "#FFF59F00",
   "error": "#FFC92A2A"
  },
  "variables": { "wifi": 1, "cpu": { "value": 67, "export": true } }
 },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }, { "spacedBy": 12 }],
   "children": [
    { "text": { "value": "Brand theme", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "modifiers": [{ "spacedBy": 8 }],
      "children": [
       { "Button": { "label": "Order" } },
       { "Button": { "label": "Details", "style": "outlined" } },
       { "Button": { "label": "Later", "style": "text" } }
      ]
     }
    },
    {
     "Card": {
      "title": "Settings",
      "children": [
       {
        "KeyValueRow": { "key": "Wi-Fi", "slots": { "trailing": [{ "Switch": { "label": "Wi-Fi", "checked": "@wifi" } }] } }
       },
       { "Divider": {} },
       { "Checkbox": { "label": "Send receipts" } }
      ]
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "Gauge": { "value": "@cpu", "label": "Load %", "size": 110, "thickness": 9 } },
       { "box": { "modifiers": [{ "width": 12 }] } },
       {
        "box": {
         "modifiers": [{ "weight": 1 }],
         "children": [{ "StatTile": { "label": "Orders", "value": 342, "delta": 18 } }]
        }
       }
      ]
     }
    }
   ]
  }
 }
}
