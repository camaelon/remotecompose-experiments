{
 "header": {"apiLevel": 7, "width": 360, "height": 220, "profiles": 513,
  "contentDescription": "Small plots of eight math functions"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 220)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 220) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 110}},
   {"paint": {"ops": [{"color": "#FF1E2A3A"}]}},
   {"loop": {"index": "i", "from": 0, "until": 8, "commands": [
    {"drawRoundRect": {"left": "6 + (i % 4) * 88", "top": "8 + floor(i / 4) * 106",
     "right": "90 + (i % 4) * 88", "bottom": "106 + floor(i / 4) * 106", "rx": 8, "ry": 8}}
   ]}},
   {"pathExpression": {"id": "sin", "expressionX": "12 + (a[0] + 1) * 36", "expressionY": "68 - 28 * sin(a[0] * 3.14159)", "start": -1, "end": 1, "count": 80, "flags": 4}},
   {"pathExpression": {"id": "cos", "expressionX": "100 + (a[0] + 1) * 36", "expressionY": "68 - 28 * cos(a[0] * 3.14159)", "start": -1, "end": 1, "count": 80, "flags": 4}},
   {"pathExpression": {"id": "clamp", "expressionX": "188 + (a[0] + 1) * 36", "expressionY": "68 - 56 * clamp(-0.5, 0.5, a[0] * 1.5)", "start": -1, "end": 1, "count": 80, "flags": 4}},
   {"pathExpression": {"id": "lerp", "expressionX": "276 + (a[0] + 1) * 36", "expressionY": "96 - 56 * lerp(0.2, 0.9, (a[0] + 1) / 2)", "start": -1, "end": 1, "count": 80, "flags": 4}},
   {"pathExpression": {"id": "step", "expressionX": "12 + (a[0] + 1) * 36", "expressionY": "202 - 56 * step(a[0], 0)", "start": -1, "end": 1, "count": 201, "flags": 4}},
   {"pathExpression": {"id": "fract", "expressionX": "100 + (a[0] + 1) * 36", "expressionY": "202 - 56 * fract((a[0] + 1) * 2)", "start": -1, "end": 1, "count": 80, "flags": 4}},
   {"pathExpression": {"id": "abs", "expressionX": "188 + (a[0] + 1) * 36", "expressionY": "202 - 56 * abs(a[0])", "start": -1, "end": 1, "count": 80, "flags": 4}},
   {"pathExpression": {"id": "pow", "expressionX": "276 + (a[0] + 1) * 36", "expressionY": "202 - 56 * pow((a[0] + 1) / 2, 3)", "start": -1, "end": 1, "count": 80, "flags": 4}},
   {"paint": {"ops": [{"style": "stroke"}, {"strokeWidth": 2.5}, {"strokeCap": "round"}, {"strokeJoin": "round"}, {"color": "#FF4DA3FF"}]}},
   {"drawPath": {"path": "sin"}},
   {"paint": {"ops": [{"color": "#FF7C4DFF"}]}},
   {"drawPath": {"path": "cos"}},
   {"paint": {"ops": [{"color": "#FF26A69A"}]}},
   {"drawPath": {"path": "clamp"}},
   {"paint": {"ops": [{"color": "#FF66BB6A"}]}},
   {"drawPath": {"path": "lerp"}},
   {"paint": {"ops": [{"color": "#FFEF5350"}]}},
   {"drawPath": {"path": "step"}},
   {"paint": {"ops": [{"color": "#FFFFCA28"}]}},
   {"drawPath": {"path": "fract"}},
   {"paint": {"ops": [{"color": "#FF4DA3FF"}]}},
   {"drawPath": {"path": "abs"}},
   {"paint": {"ops": [{"color": "#FF7C4DFF"}]}},
   {"drawPath": {"path": "pow"}},
   {"paint": {"ops": [{"color": "#FFFFFFFF"}, {"style": "fill"}, {"textSize": 13}]}},
   {"drawTextAnchored": {"text": "sin", "x": 48, "y": 26, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "cos", "x": 136, "y": 26, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "clamp", "x": 224, "y": 26, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "lerp", "x": 312, "y": 26, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "step", "x": 48, "y": 132, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "fract", "x": 136, "y": 132, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "abs", "x": 224, "y": 132, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "pow", "x": 312, "y": 132, "panX": 0, "panY": 0}}
  ]
 }
}
