   "tideKind": {
    "value": [
     0,
     1,
     0,
     1
    ],
    "export": true
   }
  },
  "variables": {
   "now": "timeInMin()",
   "nEv": "arrayLength(@tideTime)",
   "ex0": "step(@nEv, 0.5)",
   "t0": "arrayGet(@tideTime, 0) + 9999 * (1 - @ex0)",
   "hi0": "@ex0 * arrayGet(@tideKind, 0)",
   "lo0": "@ex0 - @hi0",
   "dim0": "1 - 0.5 * step(@now, @t0)",
   "ex1": "step(@nEv, 1.5)",
   "t1": "arrayGet(@tideTime, min(1, @nEv - 1)) + 9999 * (1 - @ex1)",
   "hi1": "@ex1 * arrayGet(@tideKind, min(1, @nEv - 1))",
   "lo1": "@ex1 - @hi1",
   "dim1": "1 - 0.5 * step(@now, @t1)",
   "ex2": "step(@nEv, 2.5)",
   "t2": "arrayGet(@tideTime, min(2, @nEv - 1)) + 9999 * (1 - @ex2)",
   "hi2": "@ex2 * arrayGet(@tideKind, min(2, @nEv - 1))",
   "lo2": "@ex2 - @hi2",
   "dim2": "1 - 0.5 * step(@now, @t2)",
   "ex3": "step(@nEv, 3.5)",
   "t3": "arrayGet(@tideTime, min(3, @nEv - 1)) + 9999 * (1 - @ex3)",
   "hi3": "@ex3 * arrayGet(@tideKind, min(3, @nEv - 1))",
   "lo3": "@ex3 - @hi3",
   "dim3": "1 - 0.5 * step(@now, @t3)",
   "k": "step(@now, @t0) + step(@now, @t1) + step(@now, @t2) + step(@now, @t3)",
   "after": "step(@k, @nEv - 0.5)",
   "before": "1 - @after",
   "ki": "min(@k, @nEv - 1)",
   "nextT": "arrayGet(@tideTime, @ki)",
   "rising": "abs(arrayGet(@tideKind, @ki) - @after)",
   "falling": "1 - @rising",
   "um": "max(0, @nextT - @now)",
   "hasH": "@before * step(@um, 59.5)",
   "level": "arraySpline(@waterLevel, clamp(0, 1, @now / 1440))"
  }
 },
