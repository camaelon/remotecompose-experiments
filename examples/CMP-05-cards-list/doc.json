{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 480,
  "profiles": 513,
  "contentDescription": "A contacts screen: a top bar over a scrolling card of list items with avatars"
 },
 "resources": { "variables": { "opened": 0, "scroll": 0 } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }],
   "children": [
    {
     "TopBar": {
      "title": "Pioneers",
      "slots": {
       "actions": [
        {
         "box": {
          "horizontalAlignment": "center",
          "verticalAlignment": "center",
          "modifiers": [
           { "size": 40 },
           { "clip": 20 },
           "ripple",
           { "semantics": { "contentDescription": "Search", "clickable": true } },
           { "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 99 } }
          ],
          "children": [
           {
            "canvas": {
             "modifiers": [{ "size": 20 }],
             "commands": [
              {
               "paint": {
                "ops": [
                 { "color": "@colors.onSurface" },
                 { "style": "stroke" },
                 { "strokeWidth": 2 },
                 { "strokeCap": "round" }
                ]
               }
              },
              { "drawCircle": { "cx": 8, "cy": 8, "radius": 6 } },
              { "drawLine": { "x1": 13, "y1": 13, "x2": 18, "y2": 18 } }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    },
    {
     "column": {
      "modifiers": ["fillMaxWidth", { "verticalWeight": 1 }, { "verticalScroll": "@scroll" }, { "padding": 12 }],
      "children": [
       {
        "Card": {
         "title": "Computing",
         "subtitle": "5 people",
         "children": [
          {
           "ListItem": {
            "title": "Ada Lovelace",
            "subtitle": "Analytical engines",
            "padding": 0,
            "chevron": true,
            "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 1 },
            "slots": { "leading": [{ "Avatar": { "initials": "AL", "color": "@colors.secondary" } }] }
           }
          },
          { "Divider": { "inset": 56 } },
          {
           "ListItem": {
            "title": "Grace Hopper",
            "subtitle": "Compilers",
            "padding": 0,
            "chevron": true,
            "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 2 },
            "slots": { "leading": [{ "Avatar": { "initials": "GH", "color": "@colors.primary" } }] }
           }
          },
          { "Divider": { "inset": 56 } },
          {
           "ListItem": {
            "title": "Alan Turing",
            "subtitle": "Computability",
            "padding": 0,
            "chevron": true,
            "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 3 },
            "slots": { "leading": [{ "Avatar": { "initials": "AT", "color": "@colors.success" } }] }
           }
          },
          { "Divider": { "inset": 56 } },
          {
           "ListItem": {
            "title": "Katherine Johnson",
            "subtitle": "Orbital mechanics",
            "padding": 0,
            "chevron": true,
            "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 4 },
            "slots": { "leading": [{ "Avatar": { "initials": "KJ", "color": "@colors.warning" } }] }
           }
          },
          { "Divider": { "inset": 56 } },
          {
           "ListItem": {
            "title": "Edsger Dijkstra",
            "subtitle": "Shortest paths",
            "padding": 0,
            "chevron": true,
            "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 5 },
            "slots": { "leading": [{ "Avatar": { "initials": "ED", "color": "@colors.error" } }] }
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 }
}
