 "name": "status-gallery",
 "version": 1,
 "kind": "gallery",
 "title": "Status gallery",
 "summary": "The library WeatherIcon in every condition, BatteryIndicator at the host battery level and at 95, 40 and 10 % (green, amber, red), and Banner in its info, warn and error kinds.",
 "prompt": "Show status symbols: a weather icon for sunny, cloudy, rain, snow and storm, labelled; battery indicators for the device's battery and for 95, 40 and 10 percent, coloured by level; and an info, a warning and an error banner.",
 "level": 2,
 "family": "CMP",
 "components": [
  "WeatherIcon",
  "BatteryIndicator",
  "Banner"
 ],
