 "name": "charts-gallery",
 "version": 1,
 "kind": "gallery",
 "title": "Charts from one dataset",
 "summary": "The library Sparkline, BarChart and DonutChart all reading the same exported 8-value float array: a trend line beside its label, labelled weekly columns that fill the card, and a ring of the weeks' shares with the total in the centre. Setting the array redraws all three.",
 "prompt": "Show eight weeks of visits three ways from one dataset: a sparkline next to its label, a bar chart with week labels, and a donut with the total in the middle. The host should be able to push new numbers.",
 "level": 3,
 "family": "CMP",
 "components": [
  "Sparkline",
  "BarChart",
  "DonutChart"
 ],
