 ],
 "teaches": [
  "Declare the data once as an exported float array (resources.floatArrays) and pass its name to every chart: {\"BarChart\": {\"values\": \"@visits\"}}",
  "A host that sets the array (render_rc variables {visits: [...]}) redraws every chart, at any length, with no new document",
  "Charts scale to their box: Sparkline beside a weighted label at 120 × 32, BarChart with fill: true in a box with verticalWeight 1 (the height that is left), DonutChart with fill: true in a fixed-height box",
  "In a column, give the stretching child verticalWeight: plain weight is horizontal, and in a column it leaves the box 0 wide (with fillMaxWidth before it) or lets it take the whole height, pushing the next children out. Weights ignore spacedBy, so the gaps are top paddings"
 ],
 "snippets": [
  {
   "pointer": "/resources/floatArrays/visits",
   "shows": "host.variables",
   "note": "the one dataset, exported so the host can replace it"
  },
  {
   "pointer": "/root/column/children/1/row/children/1",
   "shows": "data.array",
   "note": "Sparkline reading @visits"
  },
  {
   "pointer": "/root/column/children/3/box/children/0",
   "shows": "data.loop",
   "note": "BarChart: one bar per value, in a loop over the array"
  },
  {
   "pointer": "/root/column/children/5/box/children/0",
   "shows": "draw.arc",
   "note": "DonutChart: one arc per value, the canvas rotated after each"
  },
  {
   "pointer": "/root/column/children/3",
   "shows": "layout.weight",
   "note": "verticalWeight: the bar chart takes the height that is left"
  }
 ],
