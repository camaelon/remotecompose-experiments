{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 440,
  "profiles": 513,
  "contentDescription": "One 8-week visits dataset drawn three ways: a sparkline, a labelled bar chart and a donut chart with the total"
 },
 "resources": {
  "floatArrays": {
   "visits": { "value": [42, 55, 48, 61, 58, 73, 69, 84], "export": true }
  }
 },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }],
   "children": [
    { "text": { "value": "Sparkline", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth", { "padding": { "top": 8 } }],
      "children": [
       { "text": { "value": "Visits, last 8 weeks", "fontSize": 15, "color": "@colors.muted", "modifiers": [{ "weight": 1 }] } },
       { "Sparkline": { "values": "@visits", "label": "Visits, last 8 weeks" } }
      ]
     }
    },
    { "text": { "value": "BarChart", "fontSize": 20, "color": "@colors.onSurface", "modifiers": [{ "padding": { "top": 16 } }] } },
    {
     "box": {
      "modifiers": [{ "verticalWeight": 1 }, "fillMaxWidth", { "padding": { "top": 8 } }],
      "children": [{ "BarChart": { "values": "@visits", "labels": ["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"], "fill": true, "label": "Visits per week, last 8 weeks" } }]
     }
    },
    { "text": { "value": "DonutChart", "fontSize": 20, "color": "@colors.onSurface", "modifiers": [{ "padding": { "top": 16 } }] } },
    {
     "box": {
      "modifiers": ["fillMaxWidth", { "height": 128 }, { "padding": { "top": 8 } }],
      "children": [{ "DonutChart": { "values": "@visits", "label": "visits", "fill": true } }]
     }
    }
   ]
  }
 }
}
