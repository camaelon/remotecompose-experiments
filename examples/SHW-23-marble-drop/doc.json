{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "Marble drop: a physics toy. Coloured marbles fall through a field of pegs and bounce into bins; tap to drop a marble, tilt the device to tip them."
 },
 "resources": {
  "variables": {
   "drops": 0,
   "tx": 0,
   "ty": 0
  },
  "colors": {
   "bg1": {
    "light": "#FFFBF8F1",
    "dark": "#FF0B0F1E"
   },
   "bg2": {
    "light": "#FFE9E3F3",
    "dark": "#FF1A1035"
   },
   "peg": {
    "light": "#FF6A7194",
    "dark": "#FFB9C2E8"
   },
   "divider": {
    "light": "#FF4A5384",
    "dark": "#FF49D3FF"
   },
   "m0": {
    "light": "#FFE5306C",
    "dark": "#FFFF4D8D"
   },
   "m1": {
    "light": "#FFEE8A00",
    "dark": "#FFFFB547"
   },
   "m2": {
    "light": "#FF12A372",
    "dark": "#FF4DE3A3"
   },
   "m3": {
    "light": "#FF1C7FE0",
    "dark": "#FF4DB8FF"
   },
   "m4": {
    "light": "#FF8550E6",
    "dark": "#FFB27CFF"
   }
  }
 },
 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize",
   {
    "onTouchDown": [
     {
      "type": "valueFloatExpressionChange",
      "target": "@tx",
      "value": "touchX() + 0"
     },
     {
      "type": "valueFloatExpressionChange",
      "target": "@ty",
      "value": "touchY() + 0"
     },
     {
      "type": "valueFloatExpressionChange",
      "target": "@drops",
      "value": "@drops + 1"
     }
    ]
   },
   {
    "semantics": {
     "contentDescription": "Marble drop physics toy. Tap anywhere to drop a marble there."
    }
   }
  ],
  "commands": [
   {
    "variable": {
     "name": "W",
     "value": "componentWidth()"
    }
   },
   {
    "variable": {
     "name": "H",
     "value": "componentHeight()"
    }
   },
   {
    "variable": {
     "name": "S",
     "value": "min(@W / 8, @H / 13)"
    }
   },
   {
    "variable": {
     "name": "nC",
     "value": "floor(@W / 2 / @S)"
    }
   },
   {
    "variable": {
     "name": "r",
     "value": "@S * 0.16"
    }
   },
   {
    "variable": {
     "name": "pr",
     "value": "@S * 0.085"
    }
   },
   {
    "variable": {
     "name": "cx",
     "value": "@W / 2"
    }
   },
   {
    "variable": {
     "name": "Y0",
     "value": "max(@H * 0.2, @S * 1.6)"
    }
   },
   {
    "variable": {
     "name": "nR",
     "value": "floor((@H - @Y0 - @S * 1.6) / (@S / 2))"
    }
   },
   {
    "variable": {
     "name": "Hf",
     "value": "@nR * @S / 2"
    }
   },
   {
    "variable": {
     "name": "Wh",
     "value": "@W / 2 - @r"
    }
   },
   {
    "variable": {
     "name": "nWh",
     "value": "@r - @W / 2"
    }
   },
   {
    "variable": {
     "name": "WhI",
     "value": "@W / 2 - @r - 0.5"
    }
   },
   {
    "variable": {
     "name": "R2b",
     "value": "2 * (@r + @pr) * (@r + @pr)"
    }
   },
   {
    "variable": {
     "name": "Jc",
     "value": "1.5 / (2 * @R2b)"
    }
   },
   {
    "variable": {
     "name": "kp",
     "value": "1 / (4 * @R2b)"
    }
   },
   {
    "variable": {
     "name": "mTop",
     "value": "0 - @r - @pr"
    }
   },
   {
    "variable": {
     "name": "mBot",
     "value": "@Hf + @r + @pr"
    }
   },
   {
    "variable": {
     "name": "Yexit",
     "value": "@H - @Y0 + @r"
    }
   },
   {
    "variable": {
     "name": "Ytop",
     "value": "0 - @Y0 - @r"
    }
   },
   {
    "variable": {
     "name": "dt",
     "value": "min(deltaTime(), 0.04) / 4"
    }
   },
   {
    "variable": {
     "name": "D4",
     "value": "@dt * 4"
    }
   },
   {
    "variable": {
     "name": "gk",
     "value": "@S * 16 / 9.8"
    }
   },
   {
    "variable": {
     "name": "tilt",
     "value": "step(hypot(accelerationX(), accelerationY()), 2)"
    }
   },
   {
    "variable": {
     "name": "gxd",
     "value": "0 - accelerationX() * @gk * @tilt * @dt"
    }
   },
   {
    "variable": {
     "name": "gyd",
     "value": "(accelerationY() * @tilt + 9.8 * (1 - @tilt)) * @gk * @dt"
    }
   },
   {
    "variable": {
     "name": "dm",
     "value": "1 - 0.3 * @dt"
    }
   },
   {
    "variable": {
     "name": "slot",
     "value": "(@drops % 5) * 6 + 3 + floor(@drops / 5) % 3"
    }
   },
   {
    "variable": {
     "name": "rxw",
     "value": "@W * 0.7"
    }
   },
   {
    "variable": {
     "name": "rvw",
     "value": "@S * 0.6"
    }
   },
   {
