{
 "header": {"apiLevel": 7, "width": 300, "height": 180, "profiles": 513,
  "contentDescription": "A five-star rating driven by an integer; tapping the stars cycles it from 1 to 5"},
 "root": [
  {"resources": {"integers": {"rating": {"value": 4, "export": true}}}},
  {"type": "column", "modifiers": ["fillMaxSize", {"background": "#FF101828"}, {"padding": 16}, {"spacedBy": 8}],
   "horizontalAlignment": "center", "children": [
    {"text": {"value": "Rate your stay", "fontSize": 17, "fontWeight": 700, "color": "#FFFFFFFF"}},
    {"type": "row", "horizontalArrangement": "center", "modifiers": [
      {"semantics": {"contentDescription": "Star rating, tap to change", "clickable": true}},
      {"onClick": [{"type": "valueIntegerExpressionChange", "target": "@rating", "value": "@rating % 5 + 1"}]}],
     "children": [
     {"box": {"modifiers": [{"weight": 1}, {"widthIn": [0, 44]}, {"height": 44}], "horizontalAlignment": "center", "verticalAlignment": "center", "children": [
      {"text": {"value": "★", "fontSize": 38, "color": "#FFFFCA28", "modifiers": [{"visibility": "clamp(0, 1, @rating - 0)"}]}},
      {"text": {"value": "★", "fontSize": 38, "color": "#FF2A3A4E", "modifiers": [{"visibility": "1 - clamp(0, 1, @rating - 0)"}]}}
     ]}},
     {"box": {"modifiers": [{"weight": 1}, {"widthIn": [0, 44]}, {"height": 44}], "horizontalAlignment": "center", "verticalAlignment": "center", "children": [
      {"text": {"value": "★", "fontSize": 38, "color": "#FFFFCA28", "modifiers": [{"visibility": "clamp(0, 1, @rating - 1)"}]}},
      {"text": {"value": "★", "fontSize": 38, "color": "#FF2A3A4E", "modifiers": [{"visibility": "1 - clamp(0, 1, @rating - 1)"}]}}
     ]}},
     {"box": {"modifiers": [{"weight": 1}, {"widthIn": [0, 44]}, {"height": 44}], "horizontalAlignment": "center", "verticalAlignment": "center", "children": [
      {"text": {"value": "★", "fontSize": 38, "color": "#FFFFCA28", "modifiers": [{"visibility": "clamp(0, 1, @rating - 2)"}]}},
      {"text": {"value": "★", "fontSize": 38, "color": "#FF2A3A4E", "modifiers": [{"visibility": "1 - clamp(0, 1, @rating - 2)"}]}}
     ]}},
     {"box": {"modifiers": [{"weight": 1}, {"widthIn": [0, 44]}, {"height": 44}], "horizontalAlignment": "center", "verticalAlignment": "center", "children": [
      {"text": {"value": "★", "fontSize": 38, "color": "#FFFFCA28", "modifiers": [{"visibility": "clamp(0, 1, @rating - 3)"}]}},
      {"text": {"value": "★", "fontSize": 38, "color": "#FF2A3A4E", "modifiers": [{"visibility": "1 - clamp(0, 1, @rating - 3)"}]}}
     ]}},
     {"box": {"modifiers": [{"weight": 1}, {"widthIn": [0, 44]}, {"height": 44}], "horizontalAlignment": "center", "verticalAlignment": "center", "children": [
      {"text": {"value": "★", "fontSize": 38, "color": "#FFFFCA28", "modifiers": [{"visibility": "clamp(0, 1, @rating - 4)"}]}},
      {"text": {"value": "★", "fontSize": 38, "color": "#FF2A3A4E", "modifiers": [{"visibility": "1 - clamp(0, 1, @rating - 4)"}]}}
     ]}}
    ]},
    {"box": {"horizontalAlignment": "center", "children": [
     {"text": {"value": "Poor", "fontSize": 15, "color": "#FFEF5350", "modifiers": [{"visibility": "1 - min(1, @rating / 3)"}]}},
     {"text": {"value": "Okay", "fontSize": 15, "color": "#FFB0BEC5", "modifiers": [{"visibility": "1 - min(1, abs(@rating - 3))"}]}},
     {"text": {"value": "Great", "fontSize": 15, "color": "#FF66BB6A", "modifiers": [{"visibility": "@rating / 4"}]}}
    ]}},
    {"text": {"value": "tap the stars to change", "fontSize": 11, "color": "#FF5C6B7E"}}
   ]}
 ]
}
