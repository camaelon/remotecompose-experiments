{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 470,
  "profiles": 513,
  "contentDescription": "A settings screen built from KeyValueRow, Divider, Switch and Stepper"
 },
 "resources": { "variables": { "guests": 2, "notify": 1 } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }, { "spacedBy": 12 }],
   "children": [
    { "text": { "value": "Booking", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "Card": {
      "title": "Details",
      "children": [
       { "KeyValueRow": { "key": "Room", "value": "Deluxe king" } },
       { "Divider": {} },
       { "KeyValueRow": { "key": "Nights", "value": "3" } },
       { "Divider": {} },
       {
        "KeyValueRow": { "key": "Guests", "value": { "type": "textFromFloat", "value": "@guests", "whole": 1, "decimal": 0 } }
       }
      ]
     }
    },
    {
     "Card": {
      "title": "Options",
      "children": [
       {
        "KeyValueRow": { "key": "Guests", "slots": { "trailing": [{ "Stepper": { "value": "@guests", "min": 1, "max": 4, "label": "guests" } }] } }
       },
       { "Divider": {} },
       {
        "KeyValueRow": {
         "key": "Notifications",
         "slots": { "trailing": [{ "Switch": { "label": "Notifications", "checked": "@notify" } }] }
        }
       }
      ]
     }
    }
   ]
  }
 }
}
