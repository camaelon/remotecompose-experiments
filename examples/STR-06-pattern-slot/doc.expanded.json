{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 256,
  "profiles": 513,
  "contentDescription": "Two panels from one template with a content slot: storage usage and recent downloads"
 },
 "root": [
  {
   "definePattern": {
    "name": "Panel",
    "parameters": [
     "title",
     "content"
    ],
    "children": [
     {
      "column": {
       "modifiers": [
        "fillMaxWidth",
        {
         "clip": {
          "roundedRect": 14
         }
        },
        {
         "background": "@colors.monoOutline"
        },
        {
         "padding": 1
        },
        {
         "clip": {
          "roundedRect": 13
         }
        },
        {
         "background": "@colors.surface"
        },
        {
         "padding": 13
        }
       ],
       "children": [
        {
         "text": {
          "value": "@title",
          "fontSize": 12,
          "color": "@colors.muted"
         }
        },
        {
         "box": {
          "modifiers": [
           {
            "height": 10
           }
          ]
         }
        },
        {
         "patternArgument": {
          "parameterIndex": 1
         }
        }
       ]
      }
     }
    ]
   }
  },
  {
   "column": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "@colors.background"
     },
     {
      "padding": 12
     }
    ],
    "children": [
     {
      "Panel": {
       "title": "STORAGE",
       "children": [
        {
         "patternBlock": {
          "parameterIndex": 1,
          "children": [
           {
            "row": {
             "verticalAlignment": "bottom",
             "children": [
              {
               "text": {
                "value": "41.6",
                "fontSize": 30,
                "color": "@colors.onSurface"
               }
              },
              {
               "text": {
                "value": " of 64 GB used",
                "fontSize": 13,
                "color": "@colors.muted",
                "modifiers": [
                 {
                  "padding": [
                   0,
                   0,
                   0,
                   5
                  ]
                 }
                ]
               }
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "height": 10
              }
             ]
            }
           },
           {
            "canvas": {
             "modifiers": [
              "fillMaxWidth",
              {
               "height": 8
              }
             ],
             "commands": [
              {
               "paint": {
                "ops": [
                 {
                  "color": "@colors.track"
                 },
                 {
                  "style": "fill"
                 }
                ]
               }
              },
              {
               "drawRoundRect": {
                "left": 0,
                "top": 0,
                "right": "componentWidth()",
                "bottom": 8,
                "rx": 4,
                "ry": 4
               }
              },
              {
               "paint": {
                "ops": [
                 {
                  "style": "fill"
                 },
                 {
                  "color": "@colors.primary"
                 }
                ]
               }
              },
              {
               "drawRoundRect": {
                "left": 0,
                "top": 0,
                "right": "max(8, componentWidth() * clamp(0, 1, 0.65))",
                "bottom": 8,
                "rx": 4,
                "ry": 4
               }
              }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     },
     {
      "box": {
       "modifiers": [
        {
         "height": 12
        }
       ]
      }
     },
     {
      "Panel": {
       "title": "RECENT DOWNLOADS",
       "children": [
        {
         "patternBlock": {
          "parameterIndex": 1,
          "children": [
           {
            "text": {
             "value": "quarterly-report.pdf",
             "fontSize": 15,
             "color": "@colors.onSurface"
            }
           },
           {
            "text": {
             "value": "2.4 MB · 10 min ago",
             "fontSize": 12,
             "color": "@colors.muted",
             "modifiers": [
              {
               "padding": [
                0,
                2,
                0,
                10
               ]
              }
             ]
            }
           },
           {
            "text": {
             "value": "holiday-photos.zip",
             "fontSize": 15,
             "color": "@colors.onSurface"
            }
           },
           {
            "text": {
             "value": "318 MB · yesterday",
             "fontSize": 12,
             "color": "@colors.muted",
             "modifiers": [
              {
               "padding": [
                0,
                2,
                0,
                0
               ]
              }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ],
 "resources": {
  "colors": {
   "background": {
    "light": "#FFF5F7FA",
    "dark": "#FF101828"
   },
   "monoOutline": "#00000000",
   "muted": {
    "light": "#FF5A6475",
    "dark": "#FF8A94A6"
   },
   "onSurface": {
    "light": "#FF111827",
    "dark": "#FFE6EAF2"
   },
   "primary": {
    "light": "#FF1565D8",
    "dark": "#FF4DA3FF"
   },
   "surface": {
    "light": "#FFFFFFFF",
    "dark": "#FF1C2433"
   },
   "track": {
    "light": "#FFB0B8C4",
    "dark": "#FF2A3342"
   }
  }
 }
}
