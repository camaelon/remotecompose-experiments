{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 256,
  "profiles": 513,
  "contentDescription": "Two panels from one template with a content slot: storage usage and recent downloads"
 },
 "root": [
  {
   "definePattern": {
    "name": "Panel",
    "parameters": [
     "title",
     "content"
    ],
    "children": [
     {
      "column": {
       "modifiers": [
        "fillMaxWidth",
        {
         "clip": {
          "roundedRect": 14
         }
        },
        {
         "background": "@colors.monoOutline"
        },
        {
         "padding": 1
        },
        {
         "clip": {
          "roundedRect": 13
         }
        },
        {
         "background": "@colors.surface"
        },
        {
         "padding": 13
        }
       ],
       "children": [
        {
         "text": {
          "value": "@title",
          "fontSize": 12,
          "color": "@colors.muted"
         }
        },
        {
         "box": {
          "modifiers": [
           {
            "height": 10
           }
          ]
         }
        },
        {
         "patternArgument": {
          "parameterIndex": 1
         }
        }
       ]
      }
     }
    ]
   }
  },
  {
   "column": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "@colors.background"
     },
     {
      "padding": 12
     }
    ],
    "children": [
     {
      "Panel": {
       "title": "STORAGE",
       "children": [
        {
         "patternBlock": {
          "parameterIndex": 1,
          "children": [
           {
            "row": {
             "verticalAlignment": "bottom",
             "children": [
              {
               "text": {
                "value": "41.6",
                "fontSize": 30,
                "color": "@colors.onSurface"
               }
              },
              {
               "text": {
                "value": " of 64 GB used",
                "fontSize": 13,
                "color": "@colors.muted",
                "modifiers": [
                 {
                  "padding": [
                   0,
                   0,
                   0,
                   5
                  ]
                 }
                ]
               }
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "height": 10
              }
             ]
            }
           },
           {
            "ProgressBar": {
             "progress": 0.65
            }
           }
          ]
         }
        }
       ]
      }
     },
     {
      "box": {
       "modifiers": [
        {
         "height": 12
        }
       ]
      }
     },
     {
      "Panel": {
       "title": "RECENT DOWNLOADS",
       "children": [
        {
         "patternBlock": {
          "parameterIndex": 1,
          "children": [
           {
            "text": {
             "value": "quarterly-report.pdf",
             "fontSize": 15,
             "color": "@colors.onSurface"
            }
           },
           {
            "text": {
             "value": "2.4 MB · 10 min ago",
             "fontSize": 12,
             "color": "@colors.muted",
             "modifiers": [
              {
               "padding": [
                0,
                2,
                0,
                10
               ]
              }
             ]
            }
           },
           {
            "text": {
             "value": "holiday-photos.zip",
             "fontSize": 15,
             "color": "@colors.onSurface"
            }
           },
           {
            "text": {
             "value": "318 MB · yesterday",
             "fontSize": 12,
             "color": "@colors.muted",
             "modifiers": [
              {
               "padding": [
                0,
                2,
                0,
                0
               ]
              }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ]
}
