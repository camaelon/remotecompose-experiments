{
 "header": {"apiLevel": 7, "width": 360, "height": 180, "profiles": 513,
  "contentDescription": "Screen brightness: a level bar that glides to Low, Medium or High when one is tapped"},
 "root": [
  {"variable": {"name": "level", "value": 0.25}},
  {"column": {
   "modifiers": ["fillMaxSize", {"background": "#FF101828"}, {"padding": 20}, {"spacedBy": 16}],
   "children": [
    {"text": {"value": "Brightness", "fontSize": 18, "color": "#FFE6EDF7"}},
    {"canvas": {
     "modifiers": ["fillMaxWidth", {"height": 28}],
     "commands": [
      {"variable": {"name": "fill", "value": {"value": "8 + @level * (componentWidth() - 8)", "anim": 0.6}}},
      {"paint": {"color": "#FF243044"}},
      {"drawRoundRect": {"left": 0, "top": 4, "right": "componentWidth()", "bottom": 24, "rx": 10, "ry": 10}},
      {"paint": {"color": "#FFFFC94D"}},
      {"drawRoundRect": {"left": 0, "top": 4, "right": "@fill", "bottom": 24, "rx": 10, "ry": 10}},
      {"paint": {"color": "#FFFFFFFF"}},
      {"drawCircle": {"cx": "@fill - 10", "cy": 14, "radius": 14}}
     ]}},
    {"row": {
     "modifiers": ["fillMaxWidth", {"spacedBy": 10}],
     "children": [
      {"box": {"horizontalAlignment": "center", "verticalAlignment": "center",
       "modifiers": [{"weight": 1}, {"height": 44}, {"clip": 22}, {"background": "#FF243044"},
        {"semantics": {"contentDescription": "Low brightness", "clickable": true}},
        {"onClick": {"type": "valueFloatChange", "target": "@level", "value": 0.25}}],
       "children": [{"text": {"value": "Low", "fontSize": 16, "color": "#FFFFFFFF"}}]}},
      {"box": {"horizontalAlignment": "center", "verticalAlignment": "center",
       "modifiers": [{"weight": 1}, {"height": 44}, {"clip": 22}, {"background": "#FF243044"},
        {"semantics": {"contentDescription": "Medium brightness", "clickable": true}},
        {"onClick": {"type": "valueFloatChange", "target": "@level", "value": 0.6}}],
       "children": [{"text": {"value": "Medium", "fontSize": 16, "color": "#FFFFFFFF"}}]}},
      {"box": {"horizontalAlignment": "center", "verticalAlignment": "center",
       "modifiers": [{"weight": 1}, {"height": 44}, {"clip": 22}, {"background": "#FF243044"},
        {"semantics": {"contentDescription": "High brightness", "clickable": true}},
        {"onClick": {"type": "valueFloatChange", "target": "@level", "value": 1}}],
       "children": [{"text": {"value": "High", "fontSize": 16, "color": "#FFFFFFFF"}}]}}
     ]}}
   ]}}
 ]
}
