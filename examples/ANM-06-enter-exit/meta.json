{
 "id": "ANM-06",
 "name": "enter-exit",
 "version": 1,
 "title": "Enter and exit animations",
 "summary": "A notification list where tapping a notification slides it away to the right before the others close the gap (exitSequence BEFORE), and Restore opens the gaps first and then fades the notifications back in (enterSequence AFTER).",
 "prompt": "Show three notifications; tapping one dismisses it by sliding it off to the right, then the ones below move up. A Restore button brings them all back with a fade.",
 "level": 3,
 "family": "ANM",
 "capabilities": {
  "primary": [
   "anim.visibility"
  ],
  "secondary": [
   "anim.layout",
   "layout.state",
   "input.tap",
   "layout.decoration",
   "layout.weight",
   "a11y.labels"
  ]
 },
 "use_cases": [
  "notification",
  "list"
 ],
 "form_factor": "phone",
 "keywords": [
  "dismiss",
  "swipe away",
  "remove item",
  "notification stack",
  "undo",
  "close gap",
  "slide out",
  "fade in",
  "enter sequence",
  "exit sequence"
 ],
 "teaches": [
  "Animate a component in and out of visibility with animationSpec enterAnimation / exitAnimation (FADE_IN, FADE_OUT, SLIDE_LEFT/RIGHT/TOP/BOTTOM, ROTATE) and visibilityDuration",
  "Order the exit against the layout with exitSequence BEFORE (play the exit, then let siblings close the gap) and enterSequence AFTER (open the gap, then play the entrance)",
  "Hide with an int variable read by visibility (1 visible, 0 gone) and valueIntegerChange; restoring sets all of them back to 1",
  "Put visibility and animationSpec on a box around a library row (ListItem): the component call takes no modifiers, and the box is the node that comes and goes"
 ],
 "pitfalls": [
  "visibility reads an integer variable: declare it with vtype int and change it with valueIntegerChange",
  "Every list item needs its own animationSpec, including the ones that only move: the motion of the survivors comes from their specs",
  "A component call takes params only: to hide or animate a ListItem, wrap it in a box carrying visibility, animationSpec, the surface and the clip"
 ],
 "snippets": [
  {
   "pointer": "/root/3/column/children/2/box/modifiers/1",
   "shows": "anim.visibility",
   "note": "animationSpec on the row's own box: enter FADE_IN after the gap opens, exit SLIDE_RIGHT before the gap closes, 350 ms"
  },
  {
   "pointer": "/root/3/column/children/2/box/modifiers/0",
   "shows": "layout.state",
   "note": "visibility @n2 (int)"
  },
  {
   "pointer": "/root/3/column/children/2/box/children/0/ListItem/onClick",
