   "note": "dismiss: n2 = 0, on the ListItem the box holds"
  },
  {
   "pointer": "/root/3/column/children/0/row/children/1/Button/onClick",
   "shows": "input.tap",
   "note": "Restore: n1 = n2 = n3 = 1"
  }
 ],
