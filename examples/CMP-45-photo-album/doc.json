{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "Photo album: twelve photos from two trips in a grid, two columns on a phone, more as the window widens; tap one to select it, then share it"
 },
 "resources": {
  "variables": {
   "sel": {
    "value": -1,
    "export": true
   }
  }
 },
 "components": {
  "Snapshot": {
   "summary": "A drawn stand-in for a photo: a sky gradient, a sun and hills, sea or a skyline, filling its box",
   "params": {
    "kind": {
     "type": "enum",
     "values": [
      "hills",
      "sea",
      "city"
     ],
     "default": "hills",
     "static": true,
     "doc": "The scene"
    },
    "sky": {
     "type": "color",
     "required": true,
     "doc": "Sky at the top"
    },
    "glow": {
     "type": "color",
     "required": true,
     "doc": "Sky at the horizon"
    },
    "far": {
     "type": "color",
     "required": true,
     "doc": "Far hills, the sea or the skyline"
    },
    "near": {
     "type": "color",
     "required": true,
     "doc": "Near hill, sand or the street"
    },
    "sun": {
     "type": "color",
     "default": "#FFFFF3C4",
     "doc": "Sun or moon"
    },
    "sx": {
     "type": "float",
     "default": 70,
     "static": true,
     "doc": "Sun x, 0..100"
    },
    "sy": {
     "type": "float",
     "default": 30,
     "static": true,
     "doc": "Sun y, 0..100"
    }
   },
   "body": {
    "canvas": {
     "modifiers": [
      "fillMaxSize"
     ],
     "commands": [
      {
       "save": [
        {
         "scale": {
          "sx": "componentWidth() / 100",
          "sy": "componentHeight() / 100"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "style": "fill"
           },
           {
            "alpha": 1
           },
           {
            "linearGradient": {
             "x1": 0,
             "y1": 0,
             "x2": 0,
             "y2": 100,
             "colors": [
              "@sky",
              "@glow"
             ]
            }
           }
          ]
         }
        },
        {
         "drawRect": {
          "left": 0,
          "top": 0,
          "right": 100,
          "bottom": 100
         }
        },
        {
         "paint": {
          "ops": [
           {
            "shader": 0
           },
           {
            "color": "@sun"
           }
          ]
         }
        },
        {
         "drawOval": {
          "left": "@sx - 7",
          "top": "@sy - 7 * componentWidth() / componentHeight()",
          "right": "@sx + 7",
          "bottom": "@sy + 7 * componentWidth() / componentHeight()"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@far"
           }
          ]
         }
        },
        {
         "$if": "kind == 'hills'",
         "then": [
          {
           "drawOval": {
            "left": -40,
            "top": 50,
            "right": 75,
            "bottom": 150
           }
          },
          {
           "paint": {
            "ops": [
             {
              "color": "@near"
             }
            ]
           }
          },
          {
           "drawOval": {
            "left": 25,
            "top": 64,
            "right": 150,
            "bottom": 160
           }
          }
         ]
        },
        {
         "$if": "kind == 'sea'",
         "then": [
          {
           "drawRect": {
            "left": 0,
            "top": 62,
            "right": 100,
            "bottom": 100
           }
          },
          {
           "paint": {
            "ops": [
             {
              "color": "@near"
             }
            ]
           }
          },
          {
           "drawOval": {
            "left": -30,
            "top": 84,
            "right": 130,
            "bottom": 140
           }
          }
         ]
        },
        {
         "$if": "kind == 'city'",
         "then": [
          {
           "drawRect": {
            "left": 4,
            "top": 46,
            "right": 17,
            "bottom": 100
           }
          },
          {
           "drawRect": {
            "left": 19,
            "top": 30,
            "right": 31,
            "bottom": 100
           }
          },
          {
           "drawRect": {
            "left": 33,
            "top": 54,
            "right": 43,
            "bottom": 100
           }
          },
          {
           "drawRect": {
            "left": 45,
            "top": 38,
            "right": 57,
            "bottom": 100
           }
          },
          {
           "drawRect": {
            "left": 59,
            "top": 22,
            "right": 69,
            "bottom": 100
           }
          },
          {
           "drawRect": {
            "left": 71,
            "top": 50,
            "right": 82,
            "bottom": 100
           }
          },
          {
           "drawRect": {
            "left": 84,
            "top": 36,
            "right": 96,
            "bottom": 100
           }
          },
          {
           "paint": {
            "ops": [
             {
              "color": "@near"
             }
            ]
           }
          },
          {
           "drawRect": {
            "left": 0,
            "top": 86,
            "right": 100,
            "bottom": 100
           }
          }
         ]
        }
       ]
      }
     ]
    }
   },
   "call": {
    "Snapshot": {
     "sky": "#FF4A90D9",
     "glow": "#FFBFE0F5",
     "far": "#FF5B8C5A",
     "near": "#FF3E6B3F"
    }
   }
  }
 },
