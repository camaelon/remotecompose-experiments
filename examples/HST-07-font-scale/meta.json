 "teaches": [
  "Derive a scale from the system text size: scale = fontSize() / (14 * density()) (1.0 at the default 14 sp)",
  "Size text with it: fontSize \"@titleSize\" where titleSize = 20 * @scale",
  "Size a container with it too (button height 40 * @scale) and let wrap-content columns grow around it"
 ],
