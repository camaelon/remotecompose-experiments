   }
  ]
 },
 "related": [
  "HST-01",
  "A11Y-04"
 ],
 "pitfalls": [
  "fontSize() is in pixels (the C++ renderer sets 14 * density), so divide by density() as well as by 14 to get a pure scale factor",
  "A fixed height (the button's) does not follow the font scale by itself; derive it from the same @scale, or large text is clipped inside it"
 ],
