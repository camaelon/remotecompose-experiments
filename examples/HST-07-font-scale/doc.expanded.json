{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 220,
  "profiles": 513,
  "contentDescription": "A reminder card whose text and button grow with the system font size"
 },
 "root": [
  {
   "variable": {
    "name": "scale",
    "value": "fontSize() / (14 * density())"
   }
  },
  {
   "variable": {
    "name": "titleSize",
    "value": "20 * @scale"
   }
  },
  {
   "variable": {
    "name": "bodySize",
    "value": "14 * @scale"
   }
  },
  {
   "variable": {
    "name": "buttonHeight",
    "value": "40 * @scale"
   }
  },
  {
   "column": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "@colors.background"
     },
     {
      "padding": 16
     }
    ],
    "children": [
     {
      "column": {
       "modifiers": [
        "fillMaxWidth",
        {
         "clip": {
          "roundedRect": 20
         }
        },
        {
         "background": "@colors.surface"
        },
        {
         "padding": 16
        },
        {
         "spacedBy": 8
        }
       ],
       "children": [
        {
         "text": {
          "value": "Dentist at 3 pm",
          "fontSize": "@titleSize",
          "color": "@colors.onSurface"
         }
        },
        {
         "text": {
          "value": "Leave by 2:30 to arrive on time.",
          "fontSize": "@bodySize",
          "color": "@colors.muted"
         }
        },
        {
         "box": {
          "horizontalAlignment": "center",
          "verticalAlignment": "center",
          "modifiers": [
           {
            "height": "@buttonHeight"
           },
           {
            "clip": {
             "roundedRect": 12
            }
           },
           {
            "background": "@colors.primary"
           },
           {
            "padding": [
             16,
             0
            ]
           }
          ],
          "children": [
           {
            "text": {
             "value": "Get directions",
             "fontSize": "@bodySize",
             "color": "@colors.onPrimary"
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ],
 "resources": {
  "colors": {
   "background": {
    "light": "#FFF5F7FA",
    "dark": "#FF101828"
   },
   "muted": {
    "light": "#FF5A6475",
    "dark": "#FF8A94A6"
   },
   "onPrimary": {
    "light": "#FFFFFFFF",
    "dark": "#FF0B1A2E"
   },
   "onSurface": {
    "light": "#FF111827",
    "dark": "#FFE6EAF2"
   },
   "primary": {
    "light": "#FF1565D8",
    "dark": "#FF4DA3FF"
   },
   "surface": {
    "light": "#FFFFFFFF",
    "dark": "#FF1C2433"
   }
  }
 }
}
