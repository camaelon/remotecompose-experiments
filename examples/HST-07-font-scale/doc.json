{
 "header": {"apiLevel": 7, "width": 360, "height": 220, "profiles": 513,
  "contentDescription": "A reminder card whose text and button grow with the system font size"},
 "root": [
  {"variable": {"name": "scale", "value": "fontSize() / (14 * density())"}},
  {"variable": {"name": "titleSize", "value": "20 * @scale"}},
  {"variable": {"name": "bodySize", "value": "14 * @scale"}},
  {"variable": {"name": "buttonHeight", "value": "40 * @scale"}},
  {"column": {
   "modifiers": ["fillMaxSize", {"background": "#FF101828"}, {"padding": 16}],
   "children": [
    {"column": {
     "modifiers": ["fillMaxWidth", {"clip": {"roundedRect": 16}}, {"background": "#FF1E2A3D"}, {"padding": 16}, {"spacedBy": 8}],
     "children": [
      {"text": {"value": "Dentist at 3 pm", "fontSize": "@titleSize", "color": "#FFFFFFFF"}},
      {"text": {"value": "Leave by 2:30 to arrive on time.", "fontSize": "@bodySize", "color": "#B3FFFFFF"}},
      {"box": {
       "horizontalAlignment": "center", "verticalAlignment": "center",
       "modifiers": [{"height": "@buttonHeight"}, {"clip": {"roundedRect": 12}}, {"background": "#FF4DA3FF"}, {"padding": [16, 0]}],
       "children": [{"text": {"value": "Get directions", "fontSize": "@bodySize", "color": "#FFFFFFFF"}}]
      }}
     ]
    }}
   ]
  }}
 ]
}
