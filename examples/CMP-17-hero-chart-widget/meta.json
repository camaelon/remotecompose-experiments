   "shows": "data.array",
   "note": "the host's data: the chart, the total and the peak all read it"
  },
  {
   "pointer": "/root/0",
   "shows": "host.variables",
   "note": "an exported host string, with a starting value distinct from the other"
  }
 ],
 "inputs": {
  "variables": {
   "hours": {
    "type": "float_array",
    "meaning": "kWh used in each hour, oldest first; any length. The hero is its sum, Peak its maximum"
   },
   "delta": {
    "min": -100,
    "max": 100,
    "meaning": "change in percent from the day before; below 0 is green with a down arrow"
   },
   "cost": {
    "type": "string",
    "meaning": "the cost, already formatted with its currency",
    "default": "€4.10"
   },
   "solar": {
    "type": "string",
    "meaning": "the solar share, already formatted",
    "default": "32 %"
   }
  },
  "clock": null,
  "touch": false
 },
 "check": {
  "describe": "Used in the last 24 h, 18.0 kWh, a green down arrow with -8%, and a blue line of hourly use. 360x480: header, big hero, chart, axis, three stats. 240x240: header, hero, chart, axis, no stats. 480x200: header, hero with stats beside the chart with its axis. 320x160: hero beside chart, no header or stats. 160x160: hero over chart, no axis. With delta 12 the change is red and up.",
