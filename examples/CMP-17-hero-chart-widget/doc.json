  "profiles": 513,
  "contentDescription": "Home energy over the last 24 hours: one big total with its change from the day before, a chart of each hour filling the rest, and peak, cost and solar when there is room"
 },
 "resources": {
  "floatArrays": {
   "hours": {
    "value": [
     0.3,
     0.25,
     0.22,
     0.2,
     0.2,
     0.25,
     0.5,
     1.1,
     1.3,
     0.8,
     0.6,
