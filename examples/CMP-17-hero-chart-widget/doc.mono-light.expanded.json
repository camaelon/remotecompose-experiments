  "variables": {
   "delta": {
    "value": -8,
    "export": true
   },
   "W": "windowWidth()",
   "H": "windowHeight()",
   "pad": "ifElse(ifElse(8, 12, step(min(@W, @H), 199)), 16, step(min(@W, @H), 300))",
   "iw": "@W - 2 * @pad",
   "ih": "@H - 2 * @pad",
   "wide": "step(@W, @H * 1.25) * step(@W, 280)",
   "hasHead": "step(@H, 190)",
   "headH": "@hasHead * ifElse(26, 32, step(@H, 300))",
   "ch": "@ih - @headH",
   "fs": "clamp(28, 56, min(@W * 0.16, @H * 0.22))",
   "heroH": "18 + @fs * 1.25 + 22",
   "hasStats": "@hasHead * max(@wide, step(@H, 300))",
   "statsH": "@hasStats * 44",
   "hw": "ifElse(@iw, max(150, @iw * 0.45), @wide)",
   "gap": "ifElse(4, ifElse(8, 16, @wide), step(@H, 190))",
   "heroTop": "@wide * max(0, (@ch - @heroH - @statsH) / 2)",
   "cw": "ifElse(@iw, @iw - @hw - @gap, @wide)",
   "cTop": "(1 - @wide) * (@heroH + @gap)",
   "cH": "ifElse(@ch - @cTop - @statsH, @ch, @wide)",
   "hasAxis": "step(@cH, 79) * step(@cw, 130)",
   "sTop": "ifElse(@cTop + @cH, @heroTop + @heroH, @wide)",
   "peak": "arrayMax(@hours)",
   "used": "arraySum(@hours)",
   "bignumber1_up": "step(@delta, 0)",
   "bignumber1_dn": "step(0 - @delta, 0)",
   "bignumber1_fl": "1 - @bignumber1_up - @bignumber1_dn",
   "bignumber1_mag": "abs(@delta)",
   "bignumber1_h": "18 + @fs * 1.25 + 22",
   "bignumber1_yc": "18 + @fs * 1.25 + 11"
  },
