      {
       "alpha": "@play * 0.9"
      }
     ]
    }
   },
   {
    "drawTextAnchored": {
     "text": "Tap to reverse",
     "x": "@cx",
     "y": "@H - @u * 0.06",
     "panX": 0,
     "panY": 0
    }
   },
   {
