     "ops": [
      {
       "color": "@colors.background"
      },
      {
       "alpha": "(1 - @play) * 0.8"
      }
     ]
    }
   },
   {
    "drawRect": {
     "left": 0,
     "top": 0,
     "right": "@W",
     "bottom": "@H"
    }
   },
   {
