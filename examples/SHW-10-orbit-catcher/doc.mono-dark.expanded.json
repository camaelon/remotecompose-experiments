{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 440,
  "profiles": 513,
  "contentDescription": "Orbit catcher, a one-tap game: a dot orbits a planet; tap to reverse it, catch the stars before their timer ring runs out and dodge the red comet."
 },
 "resources": {
  "variables": {
   "dir": 1,
   "taps": 0
  },
  "colors": {
   "background": "#FF000000",
   "muted": "#FF9E9E9E",
   "onSurface": "#FFFFFFFF",
   "sky1": "#FF16204A",
   "sky2": "#FF070A18",
   "dust": "#FFDDE4FF",
   "halo": "#FF40E0D0",
   "planet1": "#FF8CF2E0",
   "planet2": "#FF3487D6",
   "planet3": "#FF22307A",
   "ring": "#FFFFFFFF",
   "orbit": "#FFA8B8FF",
   "star": "#FFFFD36B",
   "starCore": "#FFFFF6D8",
   "comet": "#FFFF5A4E",
   "cometCore": "#FFFFC4B0",
   "player": "#FF7DF9FF",
   "playerCore": "#FFFFFFFF",
   "score": "#FFF2F5FF",
   "veil": "#FF070A18",
   "accent": "#FFFFD36B"
  }
 },
 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize",
   {
    "onTouchDown": [
     {
      "type": "valueFloatExpressionChange",
      "target": "@dir",
      "value": "0 - @dir"
     },
     {
      "type": "valueFloatExpressionChange",
      "target": "@taps",
      "value": "@taps + 1"
     }
    ]
   },
   {
    "semantics": {
     "contentDescription": "Orbit catcher game. Tap anywhere to start, and to reverse the orbiting dot."
    }
   }
  ],
  "commands": [
   {
    "variable": {
     "name": "W",
     "value": "componentWidth()"
    }
   },
   {
    "variable": {
     "name": "H",
     "value": "componentHeight()"
    }
   },
   {
    "variable": {
     "name": "u",
     "value": "min(@W, @H)"
    }
   },
   {
    "variable": {
     "name": "cx",
     "value": "@W / 2"
    }
   },
   {
    "variable": {
     "name": "cy",
     "value": "@H / 2 + @u * 0.04"
    }
   },
   {
    "variable": {
     "name": "Ro",
     "value": "@u * 0.31"
    }
   },
   {
    "variable": {
     "name": "dt",
     "value": "min(deltaTime(), 0.05)"
    }
   },
   {
    "variable": {
     "name": "t",
     "value": "continuousSec()"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.background"
      }
     ]
    }
   },
   {
    "drawRect": {
     "left": 0,
     "top": 0,
     "right": "@W",
     "bottom": "@H"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.onSurface"
      },
      {
       "style": "stroke"
      },
      {
       "strokeWidth": "@u * 0.008"
      }
     ]
    }
   },
   {
    "drawCircle": {
     "cx": "@cx",
     "cy": "@cy",
     "radius": "@Ro * 0.44"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.muted"
      },
      {
       "strokeWidth": "@u * 0.004"
      }
     ]
    }
   },
   {
    "drawCircle": {
     "cx": "@cx",
     "cy": "@cy",
     "radius": "@Ro"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "style": "fill"
      }
     ]
    }
   },
   {
    "createParticles": {
     "id": "game",
     "count": 1,
     "variables": [
      "th",
      "sa",
      "c",
      "score",
      "lf",
      "ha",
      "hd",
      "hit",
      "alive",
      "dT",
      "seen",
      "rs",
      "best",
      "ct",
      "pa"
     ],
     "initialValues": [
      "-1.5708",
      "0.9",
      "0",
      "0",
      "1",
      "1.5708",
      "1",
      "0",
      "0",
      "9",
      "0",
      "0",
      "0",
      "9",
      "0"
     ]
    }
   },
   {
    "particlesLoop": {
     "system": "@game",
     "equations": [
      "th + @dir * (1.8 + min(score, 24) * 0.045) * @dt * alive",
      "ifElse(ifElse(sa, th + 1.4 + fract(sin(score * 91.7 + 3.1) * 437.5) * 3.5, c), th + 2.2 + fract(@taps * 0.618) * 1.9, rs)",
      "alive * step(cos(th - sa), 0.988) * (1 - c)",
      "ifElse(score + c, 0, rs)",
      "ifElse(ifElse(lf - @dt * alive / max(1.6, 3.6 - score * 0.08), 1, c), 1, rs)",
      "ifElse(ha + hd * (0.55 + min(score, 20) * 0.02) * @dt * alive, th + 3.14159, rs)",
      "ifElse(ifElse(hd, 0 - hd, c * step(fract(sin(score * 13.7) * 91.3), 0.5)), 1, rs)",
      "alive * step(cos(th - ha), 0.9935)",
      "ifElse(alive * (1 - hit) * step(lf, 0), 1, rs)",
      "ifElse(dT + @dt, 0, alive)",
      "ifElse(seen, @taps, max(alive, step(0.7, dT)))",
      "(1 - alive) * step(@taps, seen + 0.5) * (1 - rs)",
      "max(best, score)",
      "ifElse(ct + @dt, 0, c)",
      "ifElse(pa, sa, c)"
     ],
     "commands": []
    }
   },
   {
    "variable": {
     "name": "sx",
     "value": "@cx + @Ro * cos(sa)"
    }
   },
   {
    "variable": {
     "name": "sy",
     "value": "@cy + @Ro * sin(sa)"
    }
   },
   {
    "variable": {
     "name": "px",
     "value": "@cx + @Ro * cos(th)"
    }
   },
   {
    "variable": {
     "name": "py",
     "value": "@cy + @Ro * sin(th)"
    }
   },
   {
    "variable": {
     "name": "hx",
     "value": "@cx + @Ro * cos(ha)"
    }
   },
   {
    "variable": {
     "name": "hy",
     "value": "@cy + @Ro * sin(ha)"
    }
   },
   {
    "variable": {
     "name": "qx",
     "value": "@cx + @Ro * cos(pa)"
    }
   },
   {
    "variable": {
     "name": "qy",
     "value": "@cy + @Ro * sin(pa)"
    }
   },
   {
    "variable": {
     "name": "play",
     "value": "step(alive, 0.5)"
    }
   },
   {
    "variable": {
     "name": "sr",
     "value": "@u * 0.026"
    }
   },
   {
    "variable": {
     "name": "over",
     "value": "(1 - @play) * step(@taps, 0.5)"
    }
   },
   {
    "variable": {
     "name": "start",
     "value": "(1 - @play) * step(0.5, @taps)"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.onSurface"
      },
      {
       "style": "stroke"
      },
      {
       "strokeWidth": "@u * 0.006"
      }
     ]
    }
   },
   {
    "drawCircle": {
     "cx": "@sx",
     "cy": "@sy",
     "radius": "@sr"
    }
   },
   {
    "drawArc": {
     "left": "@sx - @sr * 1.9",
     "top": "@sy - @sr * 1.9",
     "right": "@sx + @sr * 1.9",
     "bottom": "@sy + @sr * 1.9",
     "startAngle": -90,
     "sweepAngle": "360 * lf * @play"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "style": "fill"
      }
     ]
    }
   },
   {
    "drawCircle": {
     "cx": "@sx",
     "cy": "@sy",
     "radius": "@sr * 0.35"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "style": "stroke"
      },
      {
       "strokeWidth": "@u * 0.004"
      },
      {
       "alpha": "max(0, 1 - ct * 2.5)"
      }
     ]
    }
   },
   {
    "drawCircle": {
     "cx": "@qx",
     "cy": "@qy",
     "radius": "@sr + ct * @u * 0.25"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "style": "fill"
      },
      {
       "alpha": 1
      }
     ]
    }
   },
   {
    "drawRect": {
     "left": "@hx - @sr * 0.85",
     "top": "@hy - @sr * 0.85",
     "right": "@hx + @sr * 0.85",
     "bottom": "@hy + @sr * 0.85"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.background"
      }
     ]
    }
   },
   {
    "drawRect": {
     "left": "@hx - @sr * 0.35",
     "top": "@hy - @sr * 0.35",
     "right": "@hx + @sr * 0.35",
     "bottom": "@hy + @sr * 0.35"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.onSurface"
      }
     ]
    }
   },
   {
    "drawCircle": {
     "cx": "@px",
     "cy": "@py",
     "radius": "@sr * 0.9"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.onSurface"
      },
      {
       "textSize": "@u * 0.11"
      },
      {
       "alpha": "@play"
      }
     ]
    }
   },
   {
    "drawTextAnchored": {
     "text": {
      "type": "textFromFloat",
      "value": "score",
      "whole": 4,
      "decimal": 0,
      "flags": 5
     },
     "x": "@cx",
     "y": "@cy",
     "panX": 0,
     "panY": 0
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.muted"
      },
      {
       "textSize": "@u * 0.04"
      },
      {
       "alpha": 1
      }
     ]
    }
   },
   {
    "drawTextAnchored": {
     "text": {
      "type": "textMerge",
      "id1": "BEST ",
      "id2": {
       "type": "textFromFloat",
       "value": "best",
       "whole": 4,
       "decimal": 0,
       "flags": 5
      }
     },
     "x": "@cx",
     "y": "@u * 0.08",
     "panX": 0,
     "panY": 0
    }
   },
   {
    "paint": {
