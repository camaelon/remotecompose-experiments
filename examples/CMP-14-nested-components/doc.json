{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 500,
  "profiles": 513,
  "contentDescription": "Settings: two cards of list rows, each row ending in its own switch"
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    },
    {
     "spacedBy": 12
    }
   ],
   "children": [
    {
     "text": {
      "value": "Settings",
      "fontSize": 22,
      "color": "@colors.onSurface"
     }
    },
    {
     "Card": {
      "title": "Connectivity",
      "subtitle": "Each switch keeps its own state",
      "children": [
       {
        "ListItem": {
         "title": "Wi-Fi",
         "padding": 0,
         "slots": {
          "trailing": [
           {
            "Switch": {
             "label": "Wi-Fi",
             "checked": 1
            }
           }
          ]
         },
         "subtitle": "Home network"
        }
       },
       {
        "ListItem": {
         "title": "Bluetooth",
         "padding": 0,
         "slots": {
          "trailing": [
           {
            "Switch": {
             "label": "Bluetooth"
            }
           }
          ]
         },
         "subtitle": "2 devices"
        }
       },
       {
        "ListItem": {
         "title": "Airplane mode",
         "padding": 0,
         "slots": {
          "trailing": [
           {
            "Switch": {
             "label": "Airplane mode"
            }
           }
          ]
         }
        }
       }
      ]
     }
    },
    {
     "Card": {
      "title": "Notifications",
      "children": [
       {
        "ListItem": {
         "title": "Do not disturb",
         "padding": 0,
         "slots": {
          "trailing": [
           {
            "Switch": {
             "label": "Do not disturb",
             "checked": 1
            }
           }
          ]
         },
         "subtitle": "Until 7:00"
        }
       }
      ]
     }
    }
   ]
  }
 }
}
