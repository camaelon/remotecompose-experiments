{
 "header": {"apiLevel": 7, "width": 360, "height": 200, "profiles": 513, "contentDescription": "A plot of a decaying sine wave"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 200)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 200) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 100}},
   {"paint": {"color": "#FF2A3342", "style": "stroke", "strokeWidth": 1}},
   {"drawLine": {"x1": 20, "y1": 100, "x2": 340, "y2": 100}},
   {"drawLine": {"x1": 20, "y1": 20, "x2": 20, "y2": 180}},
   {"pathExpression": {"id": "wave", "expressionX": "20 + a[0] * 25.465", "expressionY": "100 - 75 * sin(a[0]) * exp(-a[0] / 4)", "start": 0, "end": 12.566, "count": 120}},
   {"paint": {"color": "#FF4DA3FF", "strokeWidth": 3, "strokeCap": "round", "strokeJoin": "round"}},
   {"drawPath": {"path": "wave"}},
   {"paint": {"color": "#FFFFFFFF", "style": "fill", "textSize": 14}},
   {"drawTextAnchored": {"text": "y = sin(x) · e^(−x/4)", "x": 340, "y": 24, "panX": 1, "panY": 0}}
  ]
 }
}
