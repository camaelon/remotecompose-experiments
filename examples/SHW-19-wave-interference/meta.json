{
 "id": "SHW-19",
 "name": "wave-interference",
 "version": 1,
 "title": "Two-source wave interference on a 3D pond",
 "summary": "A round pond in 3D whose surface is the sum of circular waves from two bobbing sources, animated from the clock and coloured by height through a 147-byte gradient texture; an XY pad sets the frequency (sideways) and the distance between the sources (up and down), and the readouts give f, d and the wavelength.",
 "prompt": "Make a physics-class demo of wave interference that is also beautiful: a 3D water surface animated as the sum of circular waves from two sources, coloured by height, with a 2D control to change the frequency and the distance between the sources.",
 "level": 5,
 "family": "SHW",
 "hand_built": "Chart3D draws z = f(x, y) over a square with flat colour bands; a round pond, colour by height through a texture, a live clock phase and the XY pad need the 3D ops by hand. The XY pad stays hand-built: no library component sets two values from one drag (two Sliders would lose the point of the demo); its colours are themed (resources.colors) and it has its own mono look.",
 "capabilities": {
  "primary": [
   "3d.surface",
   "3d.texture",
   "time.animation",
   "input.drag"
  ],
  "secondary": [
   "3d.scene",
   "3d.mesh",
   "image.bitmap",
   "text.dynamic",
   "layout.weight",
   "a11y.labels"
  ]
 },
 "use_cases": [
  "generative-art",
  "onboarding",
  "control"
 ],
 "form_factor": "phone",
 "keywords": [
  "wave interference",
  "interference",
  "two sources",
  "ripple tank",
  "ripples",
  "waves",
  "water",
  "pond",
  "physics",
