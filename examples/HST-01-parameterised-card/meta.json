{
 "id": "HST-01",
 "name": "parameterised-card",
 "version": 3,
 "title": "Host-parameterised profile card",
 "summary": "A profile card whose name, subtitle, accent colour and progress are exported host variables with good defaults, so it renders well with no host and re-renders when the host sets them.",
 "prompt": "Make a profile card template where the app can set the name, subtitle, accent colour and progress, and it still looks right with no data.",
 "level": 2,
 "family": "HST",
 "capabilities": {
  "primary": [
   "host.variables"
  ],
  "secondary": [
   "data.tokens",
   "text.dynamic",
   "data.expression",
   "data.measure",
   "draw.shapes",
   "layout.weight",
   "layout.decoration"
  ]
 },
 "use_cases": [
  "card",
  "widget"
 ],
 "form_factor": "widget-4x2",
 "keywords": [
  "host variable",
  "named variable",
  "parameter",
  "template",
  "data binding",
  "profile",
  "props",
  "host string",
  "string from the app",
  "name from the app",
  "label from the app",
  "symbol",
  "ticker symbol",
  "exported string"
 ],
 "components": [
  "Card",
  "ProgressBar"
 ],
 "teaches": [
  "Export a float to the host with resources.variables {\"progress\": {\"value\": 0.65, \"export\": true}} and pass it to a ProgressBar as progress \"clamp(0, 1, @progress)\"",
  "Export a colour with resources.colors (named colours are exported by default) and use it as \"@colors.accent\": in a background and as a component's color param",
  "Export a string with a root variable {\"vtype\": \"string\", \"export\": true} and show it with text value \"@name\"",
  "Give host-supplied strings maxLines 1 and an ellipsis: their length is unknown and the card can be narrower than the header"
 ],
 "snippets": [
  {
   "pointer": "/resources",
   "shows": "host.variables",
   "note": "the exported accent colour and progress float"
  },
  {
   "pointer": "/root/0",
   "shows": "host.variables",
   "note": "an exported string variable"
  },
  {
   "pointer": "/root/2/column/children/0/Card/children/0/row/children/2/column/children/2",
   "shows": "data.expression",
   "note": "ProgressBar progress clamp(0, 1, @progress) in the host's accent colour, safe for any host value"
  },
  {
   "pointer": "/root/2/column/children/0/Card/children/0/row/children/2/column/children/0",
   "shows": "text.dynamic",
   "note": "the host name, one line with an ellipsis"
  }
 ],
 "inputs": {
  "variables": {
   "name": {
    "type": "string",
    "meaning": "the person's name",
    "default": "Ada Lovelace"
   },
   "subtitle": {
    "type": "string",
    "meaning": "a second line (team, role)",
    "default": "Analytical Engine team"
   },
   "accent": {
    "type": "color",
    "meaning": "avatar and progress colour",
    "default": "#FF7C4DFF"
   },
   "progress": {
    "type": "float",
    "meaning": "completion, 0 to 1",
    "default": 0.65,
    "min": 0,
    "max": 1,
    "step": 0.01
   }
  },
  "clock": null,
  "touch": false
 },
 "check": {
  "describe": "Defaults show Ada Lovelace with a purple avatar and a 65% bar; variables {name: Grace Hopper, subtitle: COBOL committee, accent: #FF26A69A, progress: 0.3} change all four. Resized, the card fills the width and the text column takes the remaining width (weight 1): the progress bar stretches, and a name or subtitle too long for a narrow card ends in an ellipsis.",
  "render": {
   "variables": {
    "name": "Grace Hopper",
    "subtitle": "COBOL committee",
    "accent": "#FF26A69A",
    "progress": 0.3
   }
  },
  "renders": [
   {
    "name": "narrow",
    "width": 240,
    "height": 180
   },
   {
    "name": "wide",
    "width": 540,
    "height": 180
   }
  ]
 },
 "related": [
  "HST-02",
  "DOC-01"
 ],
 "pitfalls": [
  "clamp takes the value last: clamp(0, 1, @progress). clamp(@progress, 0, 1) always gives 0 (the middle argument is the maximum)",
  "resources.variables entries are exported only with \"export\": true, while resources.colors entries are exported unless \"export\": false",
  "A weighted child ignores the row's spacedBy (the row overflows by the gap): space the avatar from the text column with a fixed 16 dp spacer box instead",
  "textFromFloat pads the number to `whole` digits with leading spaces; flags 4 (no leading pad) keeps \"30% complete\" flush with the bar",
  "A host string in a narrow card wraps word by word and pushes the rest of the column out of the card unless it is limited to one line"
 ],
