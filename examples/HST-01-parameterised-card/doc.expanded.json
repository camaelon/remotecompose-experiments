{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 180,
  "profiles": 513,
  "contentDescription": "A profile card driven by host variables: name, subtitle, accent colour and progress"
 },
 "resources": {
  "colors": {
   "accent": "#FF7C4DFF"
  },
  "variables": {
   "progress": {
    "value": 0.65,
    "export": true
   }
  }
 },
 "root": [
  {
   "variable": {
    "name": "name",
    "vtype": "string",
    "value": "Ada Lovelace",
    "export": true
   }
  },
  {
   "variable": {
    "name": "subtitle",
    "vtype": "string",
    "value": "Analytical Engine team",
    "export": true
   }
  },
  {
   "row": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "#FF101828"
     },
     {
      "padding": 20
     }
    ],
    "verticalAlignment": "center",
    "children": [
     {
      "box": {
       "modifiers": [
        {
         "size": 64
        },
        {
         "clip": {
          "roundedRect": 32
         }
        },
        {
         "background": "@colors.accent"
        }
       ]
      }
     },
     {
      "box": {
       "modifiers": [
        {
         "width": 16
        }
       ]
      }
     },
     {
      "column": {
       "modifiers": [
        {
         "weight": 1
        },
        {
         "spacedBy": 6
        }
       ],
       "children": [
        {
         "text": {
          "value": "@name",
          "fontSize": 22,
          "color": "#FFFFFFFF",
          "maxLines": 1,
          "overflow": "ellipsis"
         }
        },
        {
         "text": {
          "value": "@subtitle",
          "fontSize": 14,
          "color": "#B3FFFFFF",
          "maxLines": 1,
          "overflow": "ellipsis"
         }
        },
        {
         "canvas": {
          "modifiers": [
           "fillMaxWidth",
           {
            "height": 20
           }
          ],
          "commands": [
           {
            "paint": {
             "ops": [
              {
               "color": "#FF2A3342"
              }
             ]
            }
           },
           {
            "drawRoundRect": {
             "left": 0,
             "top": 8,
             "right": "componentWidth()",
             "bottom": 16,
             "rx": 4,
             "ry": 4
            }
           },
           {
            "paint": {
             "ops": [
              {
               "color": "@colors.accent"
              }
             ]
            }
           },
           {
            "drawRoundRect": {
             "left": 0,
             "top": 8,
             "right": "componentWidth() * clamp(0, 1, @progress)",
             "bottom": 16,
             "rx": 4,
             "ry": 4
            }
           }
          ]
         }
        },
        {
         "row": {
          "children": [
           {
            "text": {
             "value": {
              "type": "textFromFloat",
              "value": "@progress * 100",
              "whole": 3,
              "decimal": 0,
              "flags": 4
             },
             "fontSize": 12,
             "color": "#B3FFFFFF"
            }
           },
           {
            "text": {
             "value": "% complete",
             "fontSize": 12,
             "color": "#B3FFFFFF"
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ]
}
