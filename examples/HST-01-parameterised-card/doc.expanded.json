{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 180,
  "profiles": 513,
  "contentDescription": "A profile card driven by host variables: name, subtitle, accent colour and progress"
 },
 "resources": {
  "colors": {
   "background": {
    "light": "#FFF5F7FA",
    "dark": "#FF101828"
   },
   "muted": {
    "light": "#FF5A6475",
    "dark": "#FF8A94A6"
   },
   "onSurface": {
    "light": "#FF111827",
    "dark": "#FFE6EAF2"
   },
   "surface": {
    "light": "#FFFFFFFF",
    "dark": "#FF1C2433"
   },
   "track": {
    "light": "#FFB0B8C4",
    "dark": "#FF2A3342"
   },
   "accent": "#FF7C4DFF"
  },
  "variables": {
   "progress": {
    "value": 0.65,
    "export": true
   }
  }
 },
 "root": [
  {
   "variable": {
    "name": "name",
    "vtype": "string",
    "value": "Ada Lovelace",
    "export": true
   }
  },
  {
   "variable": {
    "name": "subtitle",
    "vtype": "string",
    "value": "Analytical Engine team",
    "export": true
   }
  },
  {
   "column": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "@colors.background"
     },
     {
      "padding": 12
     }
    ],
    "verticalArrangement": "center",
    "children": [
     {
      "column": {
       "modifiers": [
        "fillMaxWidth",
        {
         "clip": {
          "roundedRect": 20
         }
        },
        {
         "background": "@colors.surface"
        },
        {
         "padding": 16
        },
        {
         "spacedBy": 8
        }
       ],
       "children": [
        {
         "row": {
          "verticalAlignment": "center",
          "children": [
           {
            "box": {
             "modifiers": [
              {
               "size": 64
              },
              {
               "clip": {
                "roundedRect": 32
               }
              },
              {
               "background": "@colors.accent"
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "width": 16
              }
             ]
            }
           },
           {
            "column": {
             "modifiers": [
              {
               "weight": 1
              },
              {
               "spacedBy": 6
              }
             ],
             "children": [
              {
               "text": {
                "value": "@name",
                "fontSize": 22,
                "color": "@colors.onSurface",
                "maxLines": 1,
                "overflow": "ellipsis"
               }
              },
              {
               "text": {
                "value": "@subtitle",
                "fontSize": 14,
                "color": "@colors.muted",
                "maxLines": 1,
                "overflow": "ellipsis"
               }
              },
              {
               "canvas": {
                "modifiers": [
                 "fillMaxWidth",
                 {
                  "height": 8
                 }
                ],
                "commands": [
                 {
                  "variable": {
                   "name": "progressbar1_pa",
                   "value": {
                    "value": "clamp(0, 1, @progress)",
                    "anim": 0.3
                   }
                  }
                 },
                 {
                  "paint": {
                   "ops": [
                    {
                     "color": "@colors.track"
                    },
                    {
                     "style": "fill"
                    }
                   ]
                  }
                 },
                 {
                  "drawRoundRect": {
                   "left": 0,
                   "top": 0,
                   "right": "componentWidth()",
                   "bottom": 8,
                   "rx": 4,
                   "ry": 4
                  }
                 },
                 {
                  "paint": {
                   "ops": [
                    {
                     "style": "fill"
                    },
                    {
                     "color": "@colors.accent"
                    }
                   ]
                  }
                 },
                 {
                  "drawRoundRect": {
                   "left": 0,
                   "top": 0,
                   "right": "max(8, componentWidth() * clamp(0, 1, @progressbar1_pa))",
                   "bottom": 8,
                   "rx": 4,
                   "ry": 4
                  }
                 }
                ]
               }
              },
              {
               "row": {
                "children": [
                 {
                  "text": {
                   "value": {
                    "type": "textFromFloat",
                    "value": "@progress * 100",
                    "whole": 3,
                    "decimal": 0,
                    "flags": 4
                   },
                   "fontSize": 12,
                   "color": "@colors.muted"
                  }
                 },
                 {
                  "text": {
                   "value": "% complete",
                   "fontSize": 12,
                   "color": "@colors.muted"
                  }
                 }
                ]
               }
              }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ]
}
