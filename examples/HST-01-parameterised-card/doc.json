{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 180,
  "profiles": 513,
  "contentDescription": "A profile card driven by host variables: name, subtitle, accent colour and progress"
 },
 "resources": {
  "colors": {
   "accent": "#FF7C4DFF"
  },
  "variables": {
   "progress": {
    "value": 0.65,
    "export": true
   }
  }
 },
 "root": [
  {
   "variable": {
    "name": "name",
    "vtype": "string",
    "value": "Ada Lovelace",
    "export": true
   }
  },
  {
   "variable": {
    "name": "subtitle",
    "vtype": "string",
    "value": "Analytical Engine team",
    "export": true
   }
  },
  {
   "column": {
    "modifiers": [
     "fillMaxSize",
     {
      "background": "@colors.background"
     },
     {
      "padding": 12
     }
    ],
    "verticalArrangement": "center",
    "children": [
     {
      "Card": {
       "children": [
        {
         "row": {
          "verticalAlignment": "center",
          "children": [
           {
            "box": {
             "modifiers": [
              {
               "size": 64
              },
              {
               "clip": {
                "roundedRect": 32
               }
              },
              {
               "background": "@colors.accent"
              }
             ]
            }
           },
           {
            "box": {
             "modifiers": [
              {
               "width": 16
              }
             ]
            }
           },
           {
            "column": {
             "modifiers": [
              {
               "weight": 1
              },
              {
               "spacedBy": 6
              }
             ],
             "children": [
              {
               "text": {
                "value": "@name",
                "fontSize": 22,
                "color": "@colors.onSurface",
                "maxLines": 1,
                "overflow": "ellipsis"
               }
              },
              {
               "text": {
                "value": "@subtitle",
                "fontSize": 14,
                "color": "@colors.muted",
                "maxLines": 1,
                "overflow": "ellipsis"
               }
              },
              {
               "ProgressBar": {
                "progress": "clamp(0, 1, @progress)",
                "color": "@colors.accent"
               }
              },
              {
               "row": {
                "children": [
                 {
                  "text": {
                   "value": {
                    "type": "textFromFloat",
                    "value": "@progress * 100",
                    "whole": 3,
                    "decimal": 0,
                    "flags": 4
                   },
                   "fontSize": 12,
                   "color": "@colors.muted"
                  }
                 },
                 {
                  "text": {
                   "value": "% complete",
                   "fontSize": 12,
                   "color": "@colors.muted"
                  }
                 }
                ]
               }
              }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    ]
   }
  }
 ]
}
