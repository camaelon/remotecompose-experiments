{
 "header": {"apiLevel": 7, "width": 360, "height": 160, "profiles": 513, "contentDescription": "A linear, a sweep and a radial gradient"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 160)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 160) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 80}},
   {"paint": {"ops": [{"linearGradient": {"x1": 20, "y1": 0, "x2": 120, "y2": 0, "colors": ["#FF4DA3FF", "#FF7C4DFF"]}}]}},
   {"drawRoundRect": {"left": 20, "top": 20, "right": 120, "bottom": 120, "rx": 12, "ry": 12}},
   {"paint": {"ops": [{"sweepGradient": {"centerX": 180, "centerY": 70,
    "colors": ["#FF4DA3FF", "#FF26A69A", "#FF66BB6A", "#FFFFCA28", "#FFEF5350", "#FF7C4DFF", "#FF4DA3FF"]}}]}},
   {"drawCircle": {"cx": 180, "cy": 70, "radius": 50}},
   {"paint": {"ops": [{"radialGradient": {"centerX": 275, "centerY": 52, "radius": 75,
    "colors": ["#FFFFFFFF", "#FF4DA3FF", "#FF1A2A6C"], "stops": [0, 0.3, 1]}}]}},
   {"drawCircle": {"cx": 290, "cy": 70, "radius": 50}},
   {"paint": {"shader": 0, "color": "#FFFFFFFF", "textSize": 13}},
   {"drawTextAnchored": {"text": "linear", "x": 70, "y": 142, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "sweep", "x": 180, "y": 142, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "radial + stops", "x": 290, "y": 142, "panX": 0, "panY": 0}}
  ]
 }
}
