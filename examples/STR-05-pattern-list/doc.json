{
 "header": {"apiLevel": 7, "width": 360, "height": 312, "profiles": 513,
  "contentDescription": "Favourite contacts: five rows built from one row template and a list of names"},
 "root": [
  {"definePattern": {"name": "ContactRow", "parameters": ["who"], "children": [
   {"row": {"verticalAlignment": "center", "modifiers": ["fillMaxWidth", {"height": 54}, {"padding": [16, 0]},
     {"semantics": {"contentDescription": "@who"}}], "children": [
    {"canvas": {"modifiers": [{"size": 36}], "commands": [
     {"textSubtext": {"text": "@who", "start": 0, "len": 1, "varName": "initial"}},
     {"paint": {"ops": [{"color": "#FF2C3E5C"}]}},
     {"drawCircle": {"cx": 18, "cy": 18, "radius": 18}},
     {"paint": {"ops": [{"color": "#FF9CC9FF"}, {"textSize": 15}]}},
     {"drawTextAnchored": {"text": "@initial", "x": 18, "y": 18, "panX": 0, "panY": 0}}
    ]}},
    {"box": {"modifiers": [{"width": 14}]}},
    {"text": {"value": "@who", "fontSize": 15, "color": "#FFE3E8EF", "maxLines": 1, "overflow": "ellipsis", "modifiers": [{"weight": 1}]}},
    {"text": {"value": "›", "fontSize": 20, "color": "#FF5C6B7E"}}
   ]}}
  ]}},
  {"column": {"modifiers": ["fillMaxSize", {"background": "#FF101828"}, {"padding": [0, 12]}], "children": [
   {"canvas": {"modifiers": [{"size": 0}], "commands": [
    {"global": {"commands": [
     {"addDataList": {"list": ["Ada Lovelace", "Barbara Liskov", "Claude Shannon", "Edsger Dijkstra", "Grace Hopper"]}}
    ]}}
   ]}},
   {"text": {"value": "FAVOURITES", "fontSize": 11, "color": "#FF8899AA", "modifiers": [{"padding": [16, 4]}]}},
   {"patternForEach": {"collection": 2097194, "localItem": "name", "children": [
    {"ContactRow": {"who": "@name"}}
   ]}}
  ]}}
 ]
}
