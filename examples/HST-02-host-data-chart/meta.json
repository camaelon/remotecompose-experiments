  "sparkline",
  "line chart",
  "time series",
  "host data",
  "float array",
  "trend",
  "mini chart",
  "trend line",
  "stock chart"
 ],
 "components": [
  "Sparkline"
 ],
 "teaches": [
  "Export a float array to the host with resources.floatArrays {\"data\": {\"value\": [...], \"export\": true}}",
  "Pass it by name to a Sparkline (\"values\": \"@data\"): the chart reads it with arrayGet in a loop, so a host array of another length or range still fills it",
  "Let the chart fill the space left under the title: a box with weight 1 then fillMaxWidth, and the Sparkline with fill: true"
 ],
 "snippets": [
  {
   "pointer": "/resources/floatArrays",
   "shows": "host.variables",
   "note": "the exported series and its default"
  },
  {
   "pointer": "/root/column/children/2/box/children/0/Sparkline",
   "shows": "data.array",
   "note": "Sparkline over @data, filling the weighted box"
  }
 ],
 "inputs": {
  "variables": {
   "data": {
    "type": "float_array",
    "meaning": "the series to plot, any length >= 2",
    "default": [
     12,
     15,
     14,
     18,
     17,
     21,
     19,
     24,
     23,
     27,
     26,
     31
    ]
   }
  },
  "clock": null,
  "touch": false
 },
 "check": {
  "describe": "The default series draws a rising line ending in a dot at the top right; render_rc with variables {data: [a falling series]} draws a falling line. Resized, the title stays at the top and the sparkline fills the rest of the box, with the end dot following.",
  "render": {},
  "renders": [
   {
    "name": "narrow",
    "width": 240,
    "height": 180
   },
   {
    "name": "tall",
    "width": 360,
    "height": 280
   }
  ]
 },
 "related": [
  "HST-01"
 ],
 "pitfalls": [
  "rc-inspect interact doesn't accept float_array variables yet (EXAMPLES_FINDINGS I8); use render_rc variables",
  "values is the NAME of a float array (\"@data\" from resources.floatArrays), not a JSON list",
  "In a column, write weight before fillMaxWidth on the chart's box: with fillMaxWidth first the box came out 0 wide and the line collapsed to the left edge",
  "Weights ignore spacedBy: space the title from the weighted chart box with a fixed 12 dp spacer box"
 ],
