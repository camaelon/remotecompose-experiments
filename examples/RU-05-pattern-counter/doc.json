{
 "header": {"apiLevel": 7, "width": 340, "height": 140, "profiles": 513,
  "contentDescription": "Three buttons from one template, each counting its own taps"},
 "root": [
  {"type": "definePattern", "name": "CounterButton", "parameters": ["label", "color"], "locals": ["taps"],
   "children": [
    {"variable": {"name": "taps", "value": 0}},
    {"box": {
     "horizontalAlignment": "center", "verticalAlignment": "center",
     "modifiers": [
      {"weight": 1}, {"widthIn": [0, 96]}, {"height": 56}, {"clip": {"roundedRect": 14}}, {"background": "@color"}, "ripple",
      {"semantics": {"contentDescription": "@label", "role": "button"}},
      {"onClick": {"type": "valueFloatExpressionChange", "target": "@taps", "value": "@taps + 1"}}
     ],
     "children": [
      {"column": {"horizontalAlignment": "center", "children": [
       {"text": {"value": "@label", "fontSize": 15, "color": "#FFFFFFFF"}},
       {"text": {"value": {"type": "textFromFloat", "value": "@taps", "whole": 3, "decimal": 0, "flags": 4},
         "fontSize": 12, "color": "#CCFFFFFF"}}
      ]}}
     ]
    }}
   ]},
  {"row": {
   "modifiers": ["fillMaxSize", {"background": "#FF101828"}, {"padding": 14}],
   "verticalAlignment": "center",
   "children": [
    {"CounterButton": {"label": "Save", "color": "#FF4DA3FF"}},
    {"box": {"modifiers": [{"width": 12}]}},
    {"CounterButton": {"label": "Share", "color": "#FF7C4DFF"}},
    {"box": {"modifiers": [{"width": 12}]}},
    {"CounterButton": {"label": "Delete", "color": "#FFEF5350"}}
   ]
  }}
 ]
}
