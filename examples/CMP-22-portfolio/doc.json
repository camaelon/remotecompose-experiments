{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "Portfolio: total value and today's change, allocation by holding, and the holdings as rows with price trend and change"
 },
 "components": {
  "Holdings": {
   "summary": "The holdings, one QuoteRow each, value and change read from arrays",
   "params": {
    "rows": {
     "type": "list",
     "required": true,
     "doc": "symbol, name, trend array"
    }
   },
   "body": {
    "column": {
     "modifiers": [
      "fillMaxWidth"
     ],
     "children": [
      {
       "$each": "rows",
       "as": "r",
       "index": "i",
       "fields": [
        "symbol",
        "name",
        "trend"
       ],
       "do": {
        "QuoteRow": {
         "symbol": "@r_symbol",
         "name": "@r_name",
         "price": "arrayGet(@holdingValue, @i)",
         "change": "arrayGet(@holdingChange, @i)",
         "values": "@r_trend",
         "decimals": 0
        }
       }
      }
     ]
    }
   }
  }
 },
