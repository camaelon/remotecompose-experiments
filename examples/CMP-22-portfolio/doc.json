   },
   "total": "arraySum(@holdingValue)",
   "gainPct": "@gain / max(@total - @gain, 0.0001) * 100",
   "W": "windowWidth()",
   "H": "windowHeight()",
   "pad": "ifElse(12, 16, step(min(@W, @H), 300))",
   "iw": "@W - 2 * @pad",
   "ih": "@H - 2 * @pad",
   "wide": "step(@W, @H * 1.25) * step(@H, 239)",
   "hasList": "step(@H, 239)",
   "noList": "1 - @hasList",
   "showLegend": "step(@H, 239)",
   "fs": "clamp(24, 38, min(@W * 0.115, @H * 0.15))",
   "leftW": "ifElse(@iw, @iw * 0.42, @wide)",
   "gap": "@wide * 20",
   "heroH": "20 + @fs * 1.25 + 24",
   "barH": "ifElse(16, 22 + 4 * 24, @showLegend)",
   "lLeft": "@wide * (@leftW + @gap)",
   "lTop": "(1 - @wide) * (@heroH + @barH + 20)",
   "lW": "@iw - @lLeft",
   "barTop": "@heroH + ifElse(ifElse(14, 6, step(150, @ih)), 8, @hasList)",
   "wideEnough": "step(@W, 279)"
  }
 },
