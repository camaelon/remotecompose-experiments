{
 "header": {"apiLevel": 7, "width": 220, "height": 220, "profiles": 513,
  "contentDescription": "A spirit level whose bubble follows the device tilt"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"variable": {"name": "s", "value": "min(componentWidth() / 220, componentHeight() / 220)"}},
   {"translate": {"dx": "(componentWidth() - 220) / 2", "dy": "(componentHeight() - 220) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 110, "pivotY": 110}},
   {"paint": {"ops": [{"color": "#FF1E2A3D"}]}},
   {"drawCircle": {"cx": 110, "cy": 110, "radius": 96}},
   {"paint": {"ops": [{"color": "#FF3A4456"}, {"style": "stroke"}, {"strokeWidth": 2}]}},
   {"drawLine": {"x1": 110, "y1": 20, "x2": 110, "y2": 200}},
   {"drawLine": {"x1": 20, "y1": 110, "x2": 200, "y2": 110}},
   {"drawCircle": {"cx": 110, "cy": 110, "radius": 24}},
   {"variable": {"name": "dx", "value": "-8 * accelerationX()"}},
   {"variable": {"name": "dy", "value": "8 * accelerationY()"}},
   {"variable": {"name": "k", "value": "72 / max(hypot(@dx, @dy), 72)"}},
   {"variable": {"name": "bx", "value": "110 + @dx * @k"}},
   {"variable": {"name": "by", "value": "110 + @dy * @k"}},
   {"paint": {"ops": [{"color": "#FF66BB6A"}, {"style": "fill"}]}},
   {"drawCircle": {"cx": "@bx", "cy": "@by", "radius": 20}},
   {"paint": {"ops": [{"color": "#66FFFFFF"}]}},
   {"drawCircle": {"cx": "@bx - 6", "cy": "@by - 6", "radius": 5}}
  ]
 }
}
