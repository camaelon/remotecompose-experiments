   "note": "UTC minutes from the local time and offsetToUtc()"
  },
  {
   "pointer": "/resources/floatArrays/utcOffsets",
   "shows": "host.variables",
   "note": "the cities' UTC offsets, exported for the app"
  },
  {
   "pointer": "/root/column/children/1",
   "shows": "map.world",
   "note": "WorldMap with night, twilight, sun and daylight"
  }
 ],
