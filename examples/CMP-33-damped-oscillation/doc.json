{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "A damped oscillation, e to the minus x over 4 times cos x, from 0 to 4 pi, between its dashed envelope, with its peaks and troughs marked; drag across the plot to read values"
 },
 "resources": {
  "variables": {
   "showFormula": "step(windowHeight(), 240)",
   "showCaption": "step(windowHeight(), 420)"
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    }
   ],
   "children": [
    {
     "text": {
      "value": "Damped oscillation",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "@colors.onSurface",
      "maxLines": 1
     }
    },
    {
     "text": {
      "value": "f(x) = e^(−x/4) · cos x",
      "fontSize": 14,
      "color": "@colors.muted",
      "maxLines": 1,
      "modifiers": [
       {
        "padding": [
         0,
         2,
         0,
         8
        ]
       },
       {
        "visibility": "@showFormula"
       }
      ]
     }
    },
    {
     "box": {
      "modifiers": [
       "fillMaxWidth",
       {
        "verticalWeight": 1
       }
      ],
      "children": [
       {
        "MathPlot": {
         "fn": [
          "exp(-x/4)*cos(x)",
          {
           "f": "exp(-x/4)",
           "label": "envelope ±e^(−x/4)",
           "color": "@colors.muted",
           "dashed": true
          },
          {
           "f": "-exp(-x/4)",
           "label": false,
           "color": "@colors.muted",
           "dashed": true
          }
         ],
         "x": [
          0,
          "4pi"
         ],
         "mark": [
          "max",
          "min"
         ],
         "scrub": true,
         "fill": true
        }
       }
      ]
     }
    },
    {
     "text": {
      "value": "Each peak is e^(−π/2) ≈ 0.21 times the one before: the cosine repeats every 2π while the envelope keeps shrinking.",
      "fontSize": 13,
      "color": "@colors.muted",
      "maxLines": 3,
      "modifiers": [
       {
        "padding": [
         0,
         8,
         0,
         0
        ]
       },
       {
        "visibility": "@showCaption"
       }
      ]
     }
    }
   ]
  }
 }
}