{
 "header": {"apiLevel": 7, "width": 300, "height": 120, "profiles": 513,
  "contentDescription": "Today's weekday name"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"addDataList": {"id": "days", "list": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]}},
   {"textLookup": {"array": "@days", "index": "weekDay() % 7", "varName": "dayName"}},
   {"paint": {"color": "#FF8899AA", "textSize": 14}},
   {"drawTextAnchored": {"text": "TODAY", "x": "componentWidth() / 2", "y": 36, "panX": 0, "panY": 0}},
   {"paint": {"color": "#FF4DA3FF", "textSize": 34}},
   {"drawTextAnchored": {"text": "@dayName", "x": "componentWidth() / 2", "y": 72, "panX": 0, "panY": 0}}
  ]
 }
}
