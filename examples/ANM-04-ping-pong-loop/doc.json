{
 "header": {"apiLevel": 7, "width": 360, "height": 180, "profiles": 513,
  "contentDescription": "Syncing: a puck that glides back and forth along a track, easing at each end, over three bouncing dots"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "swing", "value": "abs((continuousSec() / 1.5) % 2 - 1)"}},
   {"variable": {"name": "px", "value": "40 + (componentWidth() - 80) * smooth_step(@swing, 1, 0)"}},
   {"paint": {"color": "#FFE6EDF7", "textSize": 18}},
   {"drawTextAnchored": {"text": "Syncing photos", "x": 24, "y": 32, "panX": -1, "panY": 0}},
   {"paint": {"color": "#FF8A99AD", "textSize": 13}},
   {"drawTextAnchored": {"text": "128 of 420 · Wi-Fi", "x": 24, "y": 54, "panX": -1, "panY": 0}},
   {"paint": {"color": "#FF1C2636"}},
   {"drawRoundRect": {"left": 24, "top": 70, "right": "componentWidth() - 24", "bottom": 94, "rx": 12, "ry": 12}},
   {"paint": {"color": "#664DA3FF"}},
   {"drawRoundRect": {"left": "@px - 24", "top": 74, "right": "@px + 24", "bottom": 90, "rx": 8, "ry": 8}},
   {"paint": {"color": "#FF4DA3FF"}},
   {"drawCircle": {"cx": "@px", "cy": 82, "radius": 9}},
   {"paint": {"color": "#FF7C4DFF"}},
   {"loop": {"index": "i", "from": 0, "until": 3, "commands": [
    {"drawCircle": {"cx": "componentWidth() / 2 - 20 + i * 20", "radius": 6,
      "cy": "148 - 16 * max(0, sin(continuousSec() * 7.5 - i * 0.9))"}}
   ]}}
  ]
 }
}
