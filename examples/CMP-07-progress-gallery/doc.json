{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 340,
  "profiles": 513,
  "contentDescription": "ProgressBar and ProgressRing at 0, 33, 66 and 100 percent, and one driven by a variable"
 },
 "resources": { "variables": { "download": { "value": 0.42, "export": true } } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }, { "spacedBy": 12 }],
   "children": [
    { "text": { "value": "ProgressBar", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "text": { "value": "0%", "fontSize": 12, "color": "@colors.muted", "modifiers": [{ "width": 52 }] } },
       { "box": { "modifiers": [{ "weight": 1 }], "children": [{ "ProgressBar": { "progress": 0 } }] } }
      ]
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "text": { "value": "33%", "fontSize": 12, "color": "@colors.muted", "modifiers": [{ "width": 52 }] } },
       { "box": { "modifiers": [{ "weight": 1 }], "children": [{ "ProgressBar": { "progress": 0.33 } }] } }
      ]
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "text": { "value": "66%", "fontSize": 12, "color": "@colors.muted", "modifiers": [{ "width": 52 }] } },
       { "box": { "modifiers": [{ "weight": 1 }], "children": [{ "ProgressBar": { "progress": 0.66 } }] } }
      ]
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "text": { "value": "100%", "fontSize": 12, "color": "@colors.muted", "modifiers": [{ "width": 52 }] } },
       { "box": { "modifiers": [{ "weight": 1 }], "children": [{ "ProgressBar": { "progress": 1 } }] } }
      ]
     }
    },
    { "text": { "value": "ProgressRing", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "horizontalArrangement": "spaceEvenly",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "ProgressRing": { "progress": 0, "size": 48 } },
       { "ProgressRing": { "progress": 0.33, "size": 48 } },
       { "ProgressRing": { "progress": 0.66, "color": "@colors.success", "size": 48 } },
       { "ProgressRing": { "progress": 1, "color": "@colors.secondary", "size": 48 } }
      ]
     }
    },
    { "text": { "value": "Bound to the host variable download (0.42)", "fontSize": 12, "color": "@colors.muted", "maxLines": 1, "overflow": "ellipsis" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "ProgressRing": { "progress": "@download", "size": 44, "thickness": 5, "showLabel": false } },
       { "box": { "modifiers": [{ "width": 12 }] } },
       {
        "box": {
         "modifiers": [{ "weight": 1 }],
         "children": [{ "ProgressBar": { "progress": "@download", "height": 12, "color": "@colors.warning" } }]
        }
       }
      ]
     }
    }
   ]
  }
 }
}
