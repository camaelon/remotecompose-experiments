  "variables": {
   "prev": {
    "value": 187.65,
    "export": true
   },
   "volume": {
    "value": 38420000,
    "export": true
   },
   "n": "arrayLength(@prices)",
   "price": "arrayGet(@prices, @n - 1)",
   "chg": "@price - @prev",
   "pct": "ifElse(0, @chg / @prev * 100, step(abs(@prev), 0.000001))",
   "first": "arrayGet(@prices, 0)",
   "high": "arrayMax(@prices)",
   "low": "arrayMin(@prices)",
   "W": "windowWidth()",
   "H": "windowHeight()",
   "pad": "ifElse(12, 16, step(min(@W, @H), 300))",
   "iw": "@W - 2 * @pad",
   "ih": "@H - 2 * @pad",
   "wide": "step(@W, @H * 1.25)",
   "hasStats": "step(@H, 239)",
   "hasName": "step(@W, 279)",
   "hasToday": "step(@W, 279) * step(@H, 239)",
   "fs": "clamp(22, 40, min(@W * 0.115, @H * 0.14))",
   "heroH": "24 + @fs * 1.25 + 22",
   "heroW": "ifElse(@iw, max(132, @iw * 0.42), @wide)",
   "gap": "ifElse(8, 16, @hasStats)",
   "statsH": "@hasStats * 72",
   "cLeft": "@wide * (@heroW + @gap)",
   "cTop": "(1 - @wide) * (@heroH + 8)",
   "cW": "@iw - @cLeft",
   "cH": "@ih - @cTop - (1 - @wide) * (@statsH + @hasStats * 12)",
   "sTop": "ifElse(@cTop + @cH + 12, @heroH + 16, @wide)",
   "sW": "ifElse(@iw, @heroW, @wide)"
  }
 },
