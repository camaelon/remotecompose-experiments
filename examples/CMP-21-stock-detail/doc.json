{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "Stock detail: symbol, latest price, change since the previous close, an intraday chart with previous close as baseline, and open, high, low and volume"
 },
 "components": {
  "Stat": {
   "summary": "A caption and a slot on one line",
   "params": {
    "caption": {
     "type": "string",
     "required": true,
     "doc": "Name"
    },
    "price": {
     "type": "float",
     "doc": "A price printed with cents, rounded"
    }
   },
   "slots": {
    "content": {
     "doc": "The value"
    }
   },
   "body": {
    "row": {
     "verticalAlignment": "center",
     "modifiers": [
      {
       "weight": 1
      },
      {
       "height": 30
      }
     ],
     "children": [
      {
       "text": {
        "value": "@caption",
        "fontSize": 12,
        "color": "@colors.muted",
        "maxLines": 1,
        "modifiers": [
         {
          "weight": 1
         }
        ]
       }
      },
      {
       "$if": "price",
       "then": {
        "text": {
         "value": {
          "type": "textFromFloat",
          "value": "round(@price * 100) / 100",
          "whole": 7,
          "decimal": 2,
          "flags": 23
         },
         "fontSize": 13,
         "fontWeight": 500,
         "color": "@colors.onSurface",
         "maxLines": 1
        }
       }
      },
      {
       "$slot": "content"
      }
     ]
    }
   }
  }
 },
