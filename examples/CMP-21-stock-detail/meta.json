{
 "id": "CMP-21",
 "name": "stock-detail",
 "version": 1,
 "title": "Stock detail: price, change, chart and stats",
 "summary": "A stock screen from short calls: symbol, price, change since previous close, an intraday PriceChart against that close, and open, high, low and volume. Stacks on a phone, goes side by side in landscape and 4x2, and keeps price, change and line at 2x2.",
 "prompt": "A stock detail screen: ticker, price, change today, a chart of today against previous close, and open, high, low and volume. Side by side in landscape, and working as a 4x2 and 2x2 widget.",
 "level": 2,
 "family": "CMP",
 "components": [
  "CompactNumber",
  "Delta",
  "PriceChart",
  "Stat"
 ],
 "capabilities": {
  "primary": [
   "layout.stack",
   "host.variables",
