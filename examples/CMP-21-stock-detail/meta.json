 "teaches": [
  "The host sends one array and a previous close; price, change, percent, open, high and low all come from it, so they can't disagree",
  "The same tree stacks or sits side by side through lengths computed from windowWidth() and windowHeight(), and drops stats, then name, when short",
  "CompactNumber, Delta and PriceChart do the rounding, the signs and the axis, so there is no formatting here at all"
 ],
 "snippets": [
  {
   "pointer": "/resources/variables/wide",
   "shows": "expr.system",
   "note": "stacked or side by side"
  },
  {
   "pointer": "/resources/floatArrays/prices",
   "shows": "data.array",
   "note": "the host's one series"
  },
  {
   "pointer": "/root/0",
   "shows": "host.variables",
   "note": "the symbol, a host string"
  },
  {
   "pointer": "/root/2/column/children/0",
   "shows": "layout.stack",
   "note": "hero, chart and stats placed by spacer lengths in one box"
  }
 ],
