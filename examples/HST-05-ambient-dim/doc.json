{
 "header": {"apiLevel": 7, "width": 360, "height": 180, "profiles": 513,
  "contentDescription": "A transit card that dims to high contrast in low ambient light"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"conditionalOperations": {"condition": "lt", "v1": "lightLevel", "v2": 10, "commands": [{"paint": {"ops": [{"color": "#FF000000"}]}}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 180)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 180) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 90}},
   {"paint": {"ops": [{"color": "#FFE3F2FD"}]}},
   {"conditionalOperations": {"condition": "lt", "v1": "lightLevel", "v2": 10, "commands": [{"paint": {"ops": [{"color": "#FF000000"}]}}]}},
   {"drawRoundRect": {"left": 16, "top": 16, "right": 344, "bottom": 164, "rx": 20, "ry": 20}},
   {"paint": {"ops": [{"color": "#FF1565C0"}, {"textSize": 16}]}},
   {"conditionalOperations": {"condition": "lt", "v1": "lightLevel", "v2": 10, "commands": [{"paint": {"ops": [{"color": "#FFFFEB3B"}]}}]}},
   {"drawTextAnchored": {"text": "NEXT TRAIN", "x": 40, "y": 52, "panX": -1, "panY": 0}},
   {"paint": {"ops": [{"color": "#FF0D1B2A"}, {"textSize": 30}]}},
   {"conditionalOperations": {"condition": "lt", "v1": "lightLevel", "v2": 10, "commands": [{"paint": {"ops": [{"color": "#FFFFFFFF"}]}}]}},
   {"drawTextAnchored": {"text": "Central Station", "x": 40, "y": 94, "panX": -1, "panY": 0}},
   {"paint": {"ops": [{"color": "#FF455A64"}, {"textSize": 20}]}},
   {"conditionalOperations": {"condition": "lt", "v1": "lightLevel", "v2": 10, "commands": [{"paint": {"ops": [{"color": "#FFFFFFFF"}]}}]}},
   {"drawTextAnchored": {"text": "Platform 4 · 3 min", "x": 40, "y": 134, "panX": -1, "panY": 0}}
  ]
 }
}
