{
 "id": "SHW-29",
 "name": "swipe-card-stack",
 "version": 1,
 "title": "Swipe card stack: travel destinations to like or pass",
 "summary": "A Tinder-style stack of five drawn travel cards (Lofoten under the northern lights, Kyoto at dusk with a torii, Santorini's caldera, the Wadi Rum desert, Patagonia's towers), each painted from float arrays by one loop: layered sky gradients, stars, aurora ribbons, a glowing sun, three pathExpression ridges, a sea band and landmarks. The top card follows the finger and tilts with it, a LIKE or NOPE stamp fades in, the card behind scales up; a fast flick or a drag past a third of the card flies it off with its release speed, anything else springs back with a damped spring. Buttons fling the card too, and the saved / passed counts update.",
 "prompt": "Make a Tinder-style card stack of travel destinations with drawn art: I drag a card sideways and it rotates with my finger, if I fling it past a threshold it flies off left or right with a Like/Nope stamp, the next card scales up from behind, and it counts my likes. It should feel physical: fling and spring back.",
 "level": 5,
 "family": "SHW",
 "capabilities": {
  "primary": [
   "input.press",
   "time.animation",
   "data.loop"
  ],
  "secondary": [
   "input.tap",
   "draw.path",
