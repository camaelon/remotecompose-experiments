{
 "header": {"apiLevel": 7, "width": 200, "height": 200, "profiles": 513, "contentDescription": "Twelve evenly spaced clock ticks"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 200, componentHeight() / 200)"}},
   {"translate": {"dx": "(componentWidth() - 200) / 2", "dy": "(componentHeight() - 200) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 100, "pivotY": 100}},
   {"paint": {"color": "#FF4DA3FF", "style": "stroke", "strokeWidth": 6, "strokeCap": "round"}},
   {"loop": {"index": "i", "from": 0, "until": 12, "commands": [
    {"save": {}},
    {"translate": {"dx": 100, "dy": 100}},
    {"rotate": {"angle": "i * 30"}},
    {"drawLine": {"x1": 0, "y1": -80, "x2": 0, "y2": -62}},
    {"restore": {}}
   ]}},
   {"paint": {"color": "#FFFFFFFF", "style": "fill"}},
   {"drawCircle": {"cx": 100, "cy": 100, "radius": 5}}
  ]
 }
}
