{
 "id": "CMP-18",
 "name": "row-list",
 "version": 1,
 "title": "Row list",
 "summary": "A list screen the app fills: a heading and up to six uniform rows from host strings and numbers, each with an icon, a title, a subtitle, a value and details to tap open. One small RowList call adapts it to any size: columns when wide, an empty state, and the rows scroll when they do not fit.",
 "prompt": "Build a list of today's orders the app fills: a customer, the items and the total on each row, tap a row for its details, and an empty state when there are none. It must fit a widget and a phone.",
 "level": 2,
 "family": "CMP",
 "components": [
  "RowList",
  "Icon"
 ],
 "capabilities": {
  "primary": [
   "layout.flow",
   "host.variables",
   "input.tap"
  ],
  "secondary": [
   "a11y.labels",
   "a11y.state",
   "text.dynamic",
   "expr.system"
  ]
 },
 "use_cases": [
  "list",
  "widget",
  "dashboard"
 ],
 "form_factor": "phone",
 "keywords": [
  "list",
  "list of rows",
  "rows",
  "row list",
  "data rows",
  "list from the app",
  "rows from the app",
  "host list",
  "orders",
  "order list",
  "inbox",
  "contacts",
  "people list",
  "status list",
  "server status",
  "stock list",
  "world clock list",
  "departures list",
  "notification list",
  "leaderboard rows",
  "tap a row",
  "expand a row",
  "details on tap",
  "empty state",
  "nothing to show",
  "adapts to any size",
  "widget list",
  "phone list",
  "grid when wide",
  "tiles when wide",
  "settings rows"
 ],
 "teaches": [
  "Rows are named objects: {\"title\": \"@who1\", \"value\": ..., \"details\": \"@note1\"}",
  "A whole list screen in one RowList call: the adaptive decisions are the component's, so the document holds only the data",
  "Host rows: exported strings and numbers in the row fields, count: \"@n\" for how many show, the written rows are the capacity",
  "Numbers in a row are text objects: a textMerge of \"$\" and a textFromFloat goes directly in the value field",
  "A tappable row reads as one item: its label is built live from title, subtitle and value"
 ],
 "snippets": [
  {
   "pointer": "/root/18",
   "shows": "layout.flow",
   "note": "the whole screen: one RowList call with its six rows"
  },
  {
   "pointer": "/root/0",
   "shows": "host.variables",
   "note": "a host string; give each a distinct initial value"
  },
  {
