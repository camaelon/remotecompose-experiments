{
 "header": {"apiLevel": 7, "width": 360, "height": 300, "profiles": 513,
  "contentDescription": "Stroke caps, joins and widths compared"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 300)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 300) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 150}},
   {"paint": {"color": "#FFFFFFFF", "textSize": 14}},
   {"drawTextAnchored": {"text": "butt", "x": 16, "y": 40, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "round", "x": 16, "y": 75, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "square", "x": 16, "y": 110, "panX": -1, "panY": 0}},
   {"drawTextAnchored": {"text": "2", "x": 250, "y": 136, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "8", "x": 290, "y": 136, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "16", "x": 330, "y": 136, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "miter", "x": 60, "y": 276, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "round", "x": 180, "y": 276, "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": "bevel", "x": 300, "y": 276, "panX": 0, "panY": 0}},
   {"paint": {"color": "#FF4DA3FF", "style": "stroke", "strokeWidth": 16, "strokeCap": "butt"}},
   {"drawLine": {"x1": 90, "y1": 40, "x2": 190, "y2": 40}},
   {"paint": {"strokeCap": "round"}},
   {"drawLine": {"x1": 90, "y1": 75, "x2": 190, "y2": 75}},
   {"paint": {"strokeCap": "square"}},
   {"drawLine": {"x1": 90, "y1": 110, "x2": 190, "y2": 110}},
   {"paint": {"color": "#FFFFFFFF", "alpha": 0.5, "strokeWidth": 1, "strokeCap": "butt"}},
   {"drawLine": {"x1": 90, "y1": 22, "x2": 90, "y2": 128}},
   {"drawLine": {"x1": 190, "y1": 22, "x2": 190, "y2": 128}},
   {"paint": {"color": "#FF26A69A", "strokeWidth": 2, "strokeCap": "round"}},
   {"drawLine": {"x1": 250, "y1": 30, "x2": 250, "y2": 110}},
   {"paint": {"strokeWidth": 8}},
   {"drawLine": {"x1": 290, "y1": 30, "x2": 290, "y2": 110}},
   {"paint": {"strokeWidth": 16}},
   {"drawLine": {"x1": 330, "y1": 30, "x2": 330, "y2": 110}},
   {"paint": {"color": "#FF7C4DFF", "strokeJoin": "miter"}},
   {"drawRect": {"left": 30, "top": 180, "right": 90, "bottom": 245}},
   {"paint": {"strokeJoin": "round"}},
   {"drawRect": {"left": 150, "top": 180, "right": 210, "bottom": 245}},
   {"paint": {"strokeJoin": "bevel"}},
   {"drawRect": {"left": 270, "top": 180, "right": 330, "bottom": 245}}
  ]
 }
}
