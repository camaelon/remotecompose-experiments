{
 "header": {
  "apiLevel": 7,
  "width": 300,
  "height": 200,
  "profiles": 513,
  "contentDescription": "A particle burst that needs several frames to show"
 },
 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize"
  ],
  "commands": [
   {
    "paint": {
     "ops": [
      {
       "color": "#FF101828"
      }
     ]
    }
   },
   {
    "drawRect": {
     "left": 0,
     "top": 0,
     "right": "componentWidth()",
     "bottom": "componentHeight()"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FFFFFFFF"
      },
      {
       "textSize": 14
      }
     ]
    }
   },
   {
    "drawTextAnchored": {
     "text": "Burst",
     "x": 16,
     "y": 20,
     "panX": -1,
     "panY": 0
    }
   },
   {
    "createParticles": {
     "id": "burst",
     "count": 40,
     "variables": [
      "x",
      "y",
      "vx",
      "vy"
     ],
     "initialValues": [
      "componentWidth() / 2",
      "componentHeight() / 2",
      "(rand() - 0.5) * 6",
      "(rand() - 0.5) * 6"
     ]
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "#FFFFB74D"
      }
     ]
    }
   },
   {
    "particlesLoop": {
     "system": "@burst",
     "equations": [
      "x + vx",
      "y + vy",
      "vx * 0.98",
      "vy * 0.98 + 0.05"
     ],
     "commands": [
      {
       "drawCircle": {
        "cx": "x",
        "cy": "y",
        "radius": 3
       }
      }
     ]
    }
   }
  ]
 }
}
