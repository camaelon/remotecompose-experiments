{
 "header": {
  "apiLevel": 7, "width": 360, "height": 640, "profiles": 513,
  "contentDescription": "Harbor, a banking app with five destinations, Accounts, Payments, Cards, Insights and Profile, in a bottom bar on a phone, a rail when wider and a drawer when wide; Accounts shows the total balance and three accounts"
 },
 "resources": {
  "variables": { "tab": 0 },
  "floatArrays": { "spend": [620, 310, 240, 180, 95] }
 },
 "root": {
  "NavShell": {
   "title": "Harbor",
   "selected": "@tab",
   "destinations": [
    { "icon": "account_balance", "label": "Accounts", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 12 }], "children": [
     { "column": { "children": [
      { "text": { "value": "Total balance", "fontSize": 13, "color": "@colors.muted" } },
      { "text": { "value": "€12,480.35", "fontSize": 32, "fontWeight": 700, "color": "@colors.onSurface" } }
     ] } },
     { "column": { "modifiers": ["fillMaxWidth"], "children": [
      { "ListItem": { "title": "Current account", "subtitle": "FR76 •••• 3021", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "account_balance_wallet", "color": "@colors.primary" } }], "trailing": [{ "text": { "value": "€3,240.10", "fontSize": 15, "fontWeight": 600, "color": "@colors.onSurface" } }] } } },
      { "ListItem": { "title": "Savings", "subtitle": "2.5% a year", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "savings", "color": "@colors.primary" } }], "trailing": [{ "text": { "value": "€9,120.00", "fontSize": 15, "fontWeight": 600, "color": "@colors.onSurface" } }] } } },
      { "ListItem": { "title": "Joint account", "subtitle": "With Sam", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "group", "color": "@colors.primary" } }], "trailing": [{ "text": { "value": "€120.25", "fontSize": 15, "fontWeight": 600, "color": "@colors.onSurface" } }] } } }
     ] } }
    ] } } },
    { "icon": "swap_horiz", "label": "Payments", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 12 }], "children": [
     { "Button": { "label": "Send money", "fill": true, "onClick": { "type": "hostNamedAction", "name": "sendMoney" } } },
     { "text": { "value": "Recent", "fontSize": 13, "color": "@colors.muted" } },
     { "column": { "modifiers": ["fillMaxWidth"], "children": [
      { "ListItem": { "title": "Rent", "subtitle": "To Lyon Habitat", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "home", "color": "@colors.muted" } }], "trailing": [{ "text": { "value": "−€850.00", "fontSize": 15, "color": "@colors.onSurface" } }] } } },
      { "ListItem": { "title": "Salary", "subtitle": "From Atelier Nord", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "work", "color": "@colors.muted" } }], "trailing": [{ "text": { "value": "+€2,900.00", "fontSize": 15, "color": "@colors.success" } }] } } },
      { "ListItem": { "title": "Groceries", "subtitle": "Card, Marché Bio", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "shopping_cart", "color": "@colors.muted" } }], "trailing": [{ "text": { "value": "−€64.20", "fontSize": 15, "color": "@colors.onSurface" } }] } } }
     ] } }
    ] } } },
    { "icon": "credit_card", "label": "Cards", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 16 }], "children": [
     { "column": { "modifiers": [{ "width": 300 }, { "height": 176 }, { "clip": 16 }, { "background": "@colors.primary" }, { "padding": 20 }], "verticalArrangement": "spaceBetween", "children": [
      { "text": { "value": "Harbor Debit", "fontSize": 15, "fontWeight": 600, "color": "@colors.onPrimary" } },
      { "column": { "children": [
       { "text": { "value": "•••• •••• •••• 4821", "fontSize": 18, "color": "@colors.onPrimary" } },
       { "text": { "value": "Expires 09/28", "fontSize": 12, "color": "@colors.onPrimary" } }
      ] } }
     ] } },
     { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 8 }], "children": [
      { "KeyValueRow": { "key": "Spent this month", "value": "€1,445 of €2,000" } },
      { "ProgressBar": { "progress": 0.72 } }
     ] } },
     { "KeyValueRow": { "key": "Contactless", "value": "On" } },
     { "KeyValueRow": { "key": "Online payments", "value": "On" } }
    ] } } },
    { "icon": "analytics", "label": "Insights", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 12 }], "children": [
     { "column": { "children": [
      { "text": { "value": "Spent in October", "fontSize": 13, "color": "@colors.muted" } },
      { "text": { "value": "€1,445", "fontSize": 28, "fontWeight": 700, "color": "@colors.onSurface" } }
     ] } },
     { "AllocationBar": { "values": "@spend", "items": ["Housing", "Food", "Transport", "Leisure", "Other"], "label": "October spending by category" } }
    ] } } },
    { "icon": "person", "label": "Profile", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 12 }], "children": [
     { "row": { "verticalAlignment": "center", "modifiers": [{ "spacedBy": 16 }], "children": [
      { "Avatar": { "initials": "LM", "size": 56 } },
      { "column": { "children": [
       { "text": { "value": "Léa Martin", "fontSize": 18, "fontWeight": 600, "color": "@colors.onSurface" } },
       { "text": { "value": "Customer since 2019", "fontSize": 13, "color": "@colors.muted" } }
      ] } }
     ] } },
     { "KeyValueRow": { "key": "Email", "value": "lea.martin@example.com" } },
     { "KeyValueRow": { "key": "Sign-in", "value": "Face unlock" } },
     { "KeyValueRow": { "key": "Statements", "value": "Monthly, PDF" } }
    ] } } }
   ]
  }
 }
}
