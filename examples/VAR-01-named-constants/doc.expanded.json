{
 "header": {
  "apiLevel": 7,
  "width": 300,
  "height": 180,
  "profiles": 513,
  "contentDescription": "A card styled from named design tokens"
 },
 "resources": {
  "variables": {
   "radius": {
    "value": 16,
    "export": true
   },
   "gap": {
    "value": 12,
    "export": true
   },
   "chip": {
    "value": 56,
    "export": true
   }
  },
  "colors": {
   "background": "#FF101828",
   "surface": "#FF1E2A3A",
   "accent": "#FF4DA3FF",
   "onSurface": "#FFFFFFFF"
  }
 },
 "root": {
  "type": "canvas",
  "modifiers": [
   "fillMaxSize"
  ],
  "commands": [
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.background"
      }
     ]
    }
   },
   {
    "drawRect": {
     "left": 0,
     "top": 0,
     "right": "componentWidth()",
     "bottom": "componentHeight()"
    }
   },
   {
    "variable": {
     "name": "s",
     "value": "min(componentWidth() / 300, componentHeight() / 180)"
    }
   },
   {
    "translate": {
     "dx": "(componentWidth() - 300) / 2",
     "dy": "(componentHeight() - 180) / 2"
    }
   },
   {
    "scale": {
     "sx": "@s",
     "sy": "@s",
     "pivotX": 150,
     "pivotY": 90
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.surface"
      }
     ]
    }
   },
   {
    "drawRoundRect": {
     "left": "@gap",
     "top": "@gap",
     "right": "300 - @gap",
     "bottom": "180 - @gap",
     "rx": "@radius",
     "ry": "@radius"
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.onSurface"
      },
      {
       "textSize": 18
      }
     ]
    }
   },
   {
    "drawTextAnchored": {
     "text": "Design tokens",
     "x": "@gap * 3",
     "y": 48,
     "panX": -1,
     "panY": 0
    }
   },
   {
    "paint": {
     "ops": [
      {
       "color": "@colors.accent"
      }
     ]
    }
   },
   {
    "drawRoundRect": {
     "left": "@gap * 3",
     "top": 80,
     "right": "@gap * 3 + @chip",
     "bottom": "80 + @chip",
     "rx": "@radius / 2",
     "ry": "@radius / 2"
    }
   },
   {
    "drawRoundRect": {
     "left": "@gap * 4 + @chip",
     "top": 80,
     "right": "@gap * 4 + @chip * 2",
     "bottom": "80 + @chip",
     "rx": "@radius / 2",
     "ry": "@radius / 2"
    }
   },
   {
    "drawRoundRect": {
     "left": "@gap * 5 + @chip * 2",
     "top": 80,
     "right": "@gap * 5 + @chip * 3",
     "bottom": "80 + @chip",
     "rx": "@radius / 2",
     "ry": "@radius / 2"
    }
   }
  ]
 }
}
