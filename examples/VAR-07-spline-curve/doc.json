{
 "header": {"apiLevel": 7, "width": 360, "height": 200, "profiles": 513,
  "contentDescription": "A smooth curve through eight control points and a closed blob from the same values"},
 "resources": {
  "floatArrays": {
   "points": [0.2, 0.7, 0.45, 0.9, 0.3, 0.6, 0.15, 0.5],
   "blob": [0.5, 0.9, 0.35, 0.8, 0.45, 1.0, 0.3, 0.5]
  }
 },
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 200)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 200) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 100}},
   {"pathExpression": {"id": "curve", "expressionX": "20 + a[0] * 200", "expressionY": "180 - 160 * spline(@points, a[0])",
     "start": 0, "end": 1, "count": 100, "flags": 4}},
   {"paint": {"ops": [{"color": "#FF4DA3FF"}, {"style": "stroke"}, {"strokeWidth": 3}, {"strokeJoin": "round"}]}},
   {"drawPath": {"path": "curve"}},
   {"paint": {"ops": [{"color": "#FFFFFFFF"}, {"style": "fill"}]}},
   {"loop": {"index": "i", "from": 0, "until": 8, "commands": [
     {"drawCircle": {"cx": "20 + i * 200 / 7", "cy": "180 - 160 * arrayGet(@points, i)", "radius": 5}}
   ]}},
   {"pathExpression": {"id": "blob",
     "expressionX": "290 + (25 + 50 * splineLoop(@blob, a[0] / 6.2832)) * cos(a[0])",
     "expressionY": "100 + (25 + 50 * splineLoop(@blob, a[0] / 6.2832)) * sin(a[0])",
     "start": 0, "end": 6.2832, "count": 96, "flags": 1}},
   {"paint": {"ops": [{"color": "#FF7C4DFF"}]}},
   {"drawPath": {"path": "blob"}}
  ]
 }
}
