{
 "header": {"apiLevel": 7, "width": 200, "height": 200, "profiles": 513,
  "contentDescription": "Corner markers and a centred size label that follow the component's size"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"variable": {"name": "w", "value": "componentWidth()"}},
   {"variable": {"name": "h", "value": "componentHeight()"}},
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "@w", "bottom": "@h"}},
   {"paint": {"ops": [{"color": "#FF26A69A"}, {"style": "stroke"}, {"strokeWidth": 4}, {"strokeCap": "round"}]}},
   {"drawLine": {"x1": 12, "y1": 12, "x2": 30, "y2": 12}},
   {"drawLine": {"x1": 12, "y1": 12, "x2": 12, "y2": 30}},
   {"drawLine": {"x1": "@w - 12", "y1": 12, "x2": "@w - 30", "y2": 12}},
   {"drawLine": {"x1": "@w - 12", "y1": 12, "x2": "@w - 12", "y2": 30}},
   {"drawLine": {"x1": 12, "y1": "@h - 12", "x2": 30, "y2": "@h - 12"}},
   {"drawLine": {"x1": 12, "y1": "@h - 12", "x2": 12, "y2": "@h - 30"}},
   {"drawLine": {"x1": "@w - 12", "y1": "@h - 12", "x2": "@w - 30", "y2": "@h - 12"}},
   {"drawLine": {"x1": "@w - 12", "y1": "@h - 12", "x2": "@w - 12", "y2": "@h - 30"}},
   {"paint": {"ops": [{"color": "#FF4DA3FF"}, {"style": "fill"}]}},
   {"drawCircle": {"cx": "@w / 2", "cy": "@h / 2", "radius": "min(@w, @h) / 4"}},
   {"paint": {"ops": [{"color": "#FFFFFFFF"}, {"textSize": 16}]}},
   {"drawTextAnchored": {"text": {"type": "textFromFloat", "value": "@w", "whole": 3, "decimal": 0},
     "x": "@w / 2 - 6", "y": "@h / 2", "panX": 1, "panY": 0}},
   {"drawTextAnchored": {"text": "×", "x": "@w / 2", "y": "@h / 2", "panX": 0, "panY": 0}},
   {"drawTextAnchored": {"text": {"type": "textFromFloat", "value": "@h", "whole": 3, "decimal": 0},
     "x": "@w / 2 + 6", "y": "@h / 2", "panX": -1, "panY": 0}}
  ]
 }
}
