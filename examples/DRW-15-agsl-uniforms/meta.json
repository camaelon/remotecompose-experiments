 "name": "agsl-uniforms",
 "version": 3,
 "title": "Host-driven AGSL ring",
 "summary": "An AGSL glowing ring whose centre (as fractions of the canvas), radius and hue are shader uniforms bound to four exported host variables.",
 "prompt": "A neon glowing ring drawn by an AGSL shader whose position, radius and colour the app can set at runtime.",
 "level": 3,
 "family": "DRW",
 "capabilities": {
  "primary": [
   "draw.shader"
  ],
  "secondary": [
   "host.variables",
   "data.tokens",
   "data.measure",
   "draw.shapes"
  ]
 },
 "use_cases": [
  "generative-art",
  "loading-state",
  "gauge"
 ],
 "form_factor": "widget-4x2",
 "keywords": [
  "agsl",
  "runtime shader",
  "shader uniform",
  "uniform",
  "glow",
  "neon ring",
  "halo",
  "host parameter",
  "exported variable",
  "float2",
  "parameterised shader"
 ],
 "teaches": [
  "Bind a shader uniform to a host variable by giving its value as @name",
  "Build a float2 uniform from two variables with an array: uCenter [@ringX, @ringY]",
  "Export the variables with defaults in resources.variables so the host can move, resize and recolour the ring",
  "Give the host positions as fractions of the canvas and pass the canvas size as a uniform (uSize [componentWidth(), componentHeight()]), so the ring keeps its place when the document is resized"
 ],
 "pitfalls": [
  "resources.variables are only host-settable with \"export\": true; without it they are plain constants",
  "Uniform names must match the AGSL declarations exactly, including case",
  "The shader draws the background too (bg in the AGSL): the paint replaces the colour of every pixel the drawRect covers, so there is no separate background modifier",
  "A shader's main receives pixel coordinates of the box the host gives the document, not of the header: a centre exported in pixels (180, 100) is only centred at 360×200, so export fractions and scale them by a size uniform bound to componentWidth()/componentHeight()"
 ],
 "snippets": [
  {
   "pointer": "/root/commands/0/paint/shader/uniforms",
   "shows": "draw.shader",
   "note": "uCenter [@ringX, @ringY] (fractions), uSize [componentWidth(), componentHeight()], uRadius @ringRadius, uHue @ringHue"
  },
  {
   "pointer": "/resources/variables",
   "shows": "host.variables",
   "note": "four exported floats with defaults 0.5, 0.5 (fractions of the canvas), 60 and 0.6"
  }
 ],
