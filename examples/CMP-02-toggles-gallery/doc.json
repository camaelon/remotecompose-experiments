{
 "header": {
  "apiLevel": 7, "width": 360, "height": 280, "profiles": 513,
  "contentDescription": "Switch and Checkbox gallery: switches bound to variables with a live On/Off status, and checkboxes"
 },
 "resources": { "variables": { "wifi": 0, "bluetooth": 1, "terms": 1 } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }],
   "children": [
    { "text": { "value": "Switch", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth", { "height": 48 }],
      "children": [
       { "text": { "value": "Wi-Fi", "fontSize": 15, "color": "@colors.onSurface" } },
       { "box": { "modifiers": [{ "weight": 1 }] } },
       {
        "canvas": {
         "modifiers": [{ "size": [40, 20] }],
         "commands": [
          { "paint": { "ops": [{ "color": "@colors.success" }, { "textSize": 14 }, { "alpha": "@wifi" }] } },
          { "drawTextAnchored": { "text": "On", "x": 40, "y": 10, "panX": 1, "panY": 0 } },
          { "paint": { "ops": [{ "color": "@colors.muted" }, { "alpha": "1 - @wifi" }] } },
          { "drawTextAnchored": { "text": "Off", "x": 40, "y": 10, "panX": 1, "panY": 0 } }
         ]
        }
       },
       { "box": { "modifiers": [{ "width": 12 }] } },
       { "Switch": { "label": "Wi-Fi", "checked": "@wifi" } }
      ]
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth", { "height": 48 }],
      "children": [
       { "text": { "value": "Bluetooth", "fontSize": 15, "color": "@colors.onSurface" } },
       { "box": { "modifiers": [{ "weight": 1 }] } },
       {
        "canvas": {
         "modifiers": [{ "size": [40, 20] }],
         "commands": [
          { "paint": { "ops": [{ "color": "@colors.success" }, { "textSize": 14 }, { "alpha": "@bluetooth" }] } },
          { "drawTextAnchored": { "text": "On", "x": 40, "y": 10, "panX": 1, "panY": 0 } },
          { "paint": { "ops": [{ "color": "@colors.muted" }, { "alpha": "1 - @bluetooth" }] } },
          { "drawTextAnchored": { "text": "Off", "x": 40, "y": 10, "panX": 1, "panY": 0 } }
         ]
        }
       },
       { "box": { "modifiers": [{ "width": 12 }] } },
       { "Switch": { "label": "Bluetooth", "checked": "@bluetooth", "color": "@colors.success" } }
      ]
     }
    },
    { "box": { "modifiers": [{ "height": 12 }] } },
    { "text": { "value": "Checkbox", "fontSize": 20, "color": "@colors.onSurface" } },
    { "Checkbox": { "label": "Remember me" } },
    { "Checkbox": { "label": "Accept the terms", "checked": "@terms" } }
   ]
  }
 }
}
