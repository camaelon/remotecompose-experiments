 "teaches": [
  "Bind a Switch or Checkbox to a document variable (checked: \"@wifi\") so other parts of the document can read and preset it",
  "Leave `checked` out and the component keeps its own state in a variable of its own (Remember me)",
  "Show state-dependent text without string variables: two anchored texts whose paint alpha is @wifi and 1 - @wifi"
 ],
 "snippets": [
  {
   "pointer": "/root/column/children/1/row/children/4",
   "shows": "input.toggle",
   "note": "a Switch bound to a document variable"
  },
  {
   "pointer": "/root/column/children/1/row/children/2",
   "shows": "text.basic",
   "note": "the On/Off status: two texts faded by the 0/1 state"
  },
  {
   "pointer": "/root/column/children/6",
   "shows": "a11y.labels",
   "note": "a Checkbox: its label is both the visible text and the accessibility label"
  },
  {
   "pointer": "/root/column/children/5",
   "shows": "input.toggle",
   "note": "unbound: the checkbox keeps its own state"
  }
 ],
 "pitfalls": [
  "JSON has no colour or text interpolation: the On/Off status is two drawTextAnchored calls whose paint alpha is the 0/1 state and its complement",
  "The status canvas and the switch are separated by fixed spacer boxes, not spacedBy: the row holds a weight, and weights ignore spacedBy",
  "An unbound component gets a fresh per-call variable (checkbox1_checked): nothing else in the document can read it, so bind a variable as soon as anything depends on the state"
 ],
