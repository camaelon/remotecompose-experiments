{
 "header": {"apiLevel": 7, "width": 360, "height": 220, "profiles": 513,
  "contentDescription": "Two hundred randomly placed dots"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"paint": {"ops": [{"linearGradient": {"x1": 0, "y1": 0, "x2": "componentWidth()", "y2": 0,
      "colors": ["#FF26A69A", "#FF4DA3FF", "#FF7C4DFF"]}}]}},
   {"loop": {"index": "i", "from": 0, "until": 200, "commands": [
     {"drawCircle": {
       "cx": "10 + (componentWidth() - 20) * seed(1 + i, rand())",
       "cy": "10 + (componentHeight() - 20) * seed(1001 + i, rand())",
       "radius": "1.5 + 3.5 * seed(2001 + i, rand())"}}
   ]}}
  ]
 }
}
