{
 "header": {"apiLevel": 7, "width": 360, "height": 240, "profiles": 513,
  "contentDescription": "A rectangle, a rounded rectangle, a circle, an oval and a line"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 360, componentHeight() / 240)"}},
   {"translate": {"dx": "(componentWidth() - 360) / 2", "dy": "(componentHeight() - 240) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 180, "pivotY": 120}},
   {"paint": {"color": "#FF4DA3FF"}},
   {"drawRect": {"left": 30, "top": 30, "right": 110, "bottom": 100}},
   {"paint": {"color": "#FF7C4DFF", "style": "stroke", "strokeWidth": 4}},
   {"drawRoundRect": {"left": 140, "top": 30, "right": 220, "bottom": 100, "rx": 16, "ry": 16}},
   {"paint": {"color": "#FF26A69A", "style": "fill"}},
   {"drawCircle": {"cx": 290, "cy": 65, "radius": 36}},
   {"paint": {"color": "#FF66BB6A", "style": "stroke"}},
   {"drawOval": {"left": 30, "top": 140, "right": 170, "bottom": 210}},
   {"paint": {"color": "#FFEF5350", "strokeWidth": 6, "strokeCap": "round"}},
   {"drawLine": {"x1": 200, "y1": 210, "x2": 330, "y2": 140}}
  ]
 }
}
