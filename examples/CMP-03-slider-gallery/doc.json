{
 "header": {
  "apiLevel": 7,
  "width": 340,
  "height": 260,
  "profiles": 513,
  "contentDescription": "Slider gallery: an opacity slider from 0 to 1, a volume slider from 0 to 100 and a balance slider from -50 to 50, each showing its value, and a summary line reading the bound variables"
 },
 "resources": {
  "variables": {
   "opacity": 0.8,
   "volume": 40,
   "balance": -10
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    }
   ],
   "children": [
    {
     "text": {
      "value": "Slider",
      "fontSize": 20,
      "color": "@colors.onSurface"
     }
    },
    {
     "spacer": {
      "modifiers": [
       {
        "height": 8
       }
      ]
     }
    },
    {
     "text": {
      "value": "Opacity (0 to 1)",
      "fontSize": 15,
      "color": "@colors.onSurface"
     }
    },
    {
     "Slider": {
      "label": "Opacity",
      "value": "@opacity",
      "showValue": true,
      "decimals": 2
     }
    },
    {
     "text": {
      "value": "Volume (0 to 100)",
      "fontSize": 15,
      "color": "@colors.onSurface"
     }
    },
    {
     "Slider": {
      "label": "Volume",
      "value": "@volume",
      "max": 100,
      "showValue": true
     }
    },
    {
     "text": {
      "value": "Balance (-50 to 50)",
      "fontSize": 15,
      "color": "@colors.onSurface"
     }
    },
    {
     "Slider": {
      "label": "Balance",
      "value": "@balance",
      "min": -50,
      "max": 50,
      "showValue": true,
      "color": "@colors.secondary"
     }
    },
    {
     "spacer": {
      "modifiers": [
       {
        "height": 8
       }
      ]
     }
    },
    {
     "row": {
      "modifiers": [
       {
        "spacedBy": 6
       }
      ],
      "children": [
       {
        "text": {
         "value": "Volume",
         "fontSize": 13,
         "color": "@colors.muted"
        }
       },
       {
        "text": {
         "value": {
          "type": "textFromFloat",
          "value": "@volume",
          "whole": 4,
          "decimal": 0,
          "flags": 5
         },
         "fontSize": 13,
         "color": "@colors.primary"
        }
       },
       {
        "text": {
         "value": "Balance",
         "fontSize": 13,
         "color": "@colors.muted"
        }
       },
       {
        "text": {
         "value": {
          "type": "textFromFloat",
          "value": "@balance",
          "whole": 4,
          "decimal": 0,
          "flags": 5
         },
         "fontSize": 13,
         "color": "@colors.primary"
        }
       }
      ]
     }
    }
   ]
  }
 }
}
