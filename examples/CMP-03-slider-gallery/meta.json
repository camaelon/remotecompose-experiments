  "primary": [
   "input.drag"
  ],
  "secondary": [
   "text.dynamic",
   "a11y.labels",
   "text.basic"
  ]
 },
 "use_cases": [
  "control"
 ],
 "form_factor": "square",
 "keywords": [
  "slider",
  "sliders",
  "seek bar",
  "range",
  "volume",
  "balance",
  "opacity",
  "negative range",
  "settings",
  "component library"
 ],
 "teaches": [
  "min and max set the range, negative ones included (balance: -50 to 50); decimals sets the digits of the printed value (opacity: 0.8; textFromFloat drops trailing zeros)",
  "Bind each slider to a document variable and read it below the slider: the summary line follows the drags",
  "Each slider maps the finger through its own position (componentValue POS_ROOT_X), so they work stacked anywhere in the layout"
 ],
 "snippets": [
  {
   "pointer": "/root/column/children/3",
   "shows": "input.drag",
   "note": "0 to 1, two decimals"
  },
  {
   "pointer": "/root/column/children/7",
   "shows": "input.drag",
   "note": "-50 to 50: min and max can be negative"
  },
  {
   "pointer": "/root/column/children/9/row/children/1",
   "shows": "text.dynamic",
   "note": "reads @volume after the slider: the dragged value"
  },
  {
   "pointer": "/root/column/children/5",
   "shows": "a11y.labels",
   "note": "the slider's label is its accessibility label; the visible name is the text above it"
  }
 ],
 "pitfalls": [
  "Read a slider's variable after the slider in document order: the slider rebinds the name to its touch value from there on, so a text placed above it (or an expression in resources) keeps the starting value",
  "The touch mapping needs componentValue POS_ROOT_X and a touch expression owned by its canvas. Java gets both right; the TS and C++ players do since the T32, T33 and C50 fixes (2026-10-30); older ones put drags off by the slider's x, or move every slider at once"
 ],
 "inputs": {
  "variables": {
   "opacity": 0.8,
   "volume": 40,
   "balance": -10
  },
  "clock": null,
  "touch": true
 },
 "check": {
  "describe": "Opacity at 0.8, Volume at 40 and Balance at -10 (its thumb left of centre, purple), each printing its value at the end of its track, and the summary line 'Volume 40 Balance -10'. Drags were checked in the Java reference (RcTouch harness): each value follows the finger within its range and clamps at the ends, and the summary line follows. render-dragged (C++ player): a drag ending mid-track sets Volume to 50, a press past the end of Balance clamps it to 50 and one left of Opacity clamps it to 0; only the slider under the finger moves. Resized, the tracks fill the width at 240 and at 480 dp with the thumbs at the same fractions.",
