 "version": 1,
 "kind": "gallery",
 "title": "Slider gallery",
 "summary": "Three library Sliders over different ranges (0 to 1 with two decimals, 0 to 100, and -50 to 50), each bound to a document variable and printing its value, plus a summary line below them that reads the same variables.",
 "prompt": "Add three sliders, opacity from 0 to 1, volume from 0 to 100 and balance from -50 to 50, each showing its value, and a line under them repeating the volume and balance.",
 "level": 3,
 "family": "CMP",
 "components": [
  "Slider"
 ],
