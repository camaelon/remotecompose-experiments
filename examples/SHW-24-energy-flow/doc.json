           "whole": 2,
           "decimal": 1,
           "flags": 5
          },
          "fontSize": 22,
          "fontWeight": 650,
          "color": "@colors.onSurface"
         }
        },
        {
         "text": {
          "value": " kW",
          "fontSize": 15,
          "color": "@colors.muted"
         }
        }
       ]
      }
     },
     {
      "row": {
       "modifiers": [
        "fillMaxWidth"
       ],
       "children": [
        {
         "text": {
          "value": "Sources to uses, live",
          "fontSize": 13,
