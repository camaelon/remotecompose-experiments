{
 "header": {"apiLevel": 7, "width": 200, "height": 280, "profiles": 513,
  "contentDescription": "A blue ball dropped from the top that bounces three times and comes to rest"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"variable": {"name": "s", "value": "min(componentWidth() / 200, componentHeight() / 280)"}},
   {"translate": {"dx": "(componentWidth() - 200) / 2", "dy": "(componentHeight() - 280) / 2"}},
   {"scale": {"sx": "@s", "sy": "@s", "pivotX": 100, "pivotY": 140}},
   {"paint": {"color": "#FF3E4A5E", "style": "stroke", "strokeWidth": 2}},
   {"drawLine": {"x1": 20, "y1": 261, "x2": 180, "y2": 261}},
   {"paint": {"color": "#FF4DA3FF", "style": "fill"}},
   {"impulse": {"duration": 3, "start": 0, "commands": [
    {"impulseProcess": {"commands": [
     {"drawCircle": {"cx": 100, "radius": 16,
       "cy": "244 - 200 * abs(cos(animationTime() * 3.14159)) * (1 - animationTime() / 3) * (1 - animationTime() / 3)"}}
    ]}}
   ]}},
   {"conditionalOperations": {"condition": "gt", "v1": "animationTime()", "v2": 3, "commands": [
    {"drawCircle": {"cx": 100, "cy": 244, "radius": 16}}
   ]}}
  ]
 }
}
