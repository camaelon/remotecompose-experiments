{
 "header": {"apiLevel": 7, "width": 200, "height": 200, "profiles": 513,
  "contentDescription": "A red heart that pulses, growing and brightening once a second"},
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize", {"background": "#FF101828"}],
  "commands": [
   {"pathExpression": {"id": "heart",
     "expressionX": "64 * sin(a[0]) * sin(a[0]) * sin(a[0])",
     "expressionY": "-4 - 4 * (13 * cos(a[0]) - 5 * cos(2 * a[0]) - 2 * cos(3 * a[0]) - cos(4 * a[0]))",
     "start": 0, "end": 6.2832, "count": 120}},
   {"save": {"commands": [
    {"translate": {"dx": "componentWidth() / 2", "dy": "componentHeight() / 2"}},
    {"scale": {"sx": "(1 + 0.15 * sin(continuousSec() * 6.2832)) * min(componentWidth(), componentHeight()) / 200", "sy": "(1 + 0.15 * sin(continuousSec() * 6.2832)) * min(componentWidth(), componentHeight()) / 200"}},
    {"paint": {"color": "#FFEF5350", "alpha": "0.65 + 0.35 * sin(continuousSec() * 6.2832)"}},
    {"drawPath": {"path": "heart"}}
   ]}}
  ]
 }
}
