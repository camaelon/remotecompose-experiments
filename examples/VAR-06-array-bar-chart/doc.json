{
 "header": {"apiLevel": 7, "width": 360, "height": 200, "profiles": 513,
  "contentDescription": "A bar chart of twelve monthly values"},
 "resources": {
  "floatArrays": {
   "sales": [12, 18, 15, 22, 30, 27, 35, 41, 38, 29, 24, 33]
  }
 },
 "root": {
  "type": "canvas",
  "modifiers": ["fillMaxSize"],
  "commands": [
   {"paint": {"ops": [{"color": "#FF101828"}]}},
   {"drawRect": {"left": 0, "top": 0, "right": "componentWidth()", "bottom": "componentHeight()"}},
   {"paint": {"ops": [{"color": "#FF2A3342"}, {"style": "stroke"}, {"strokeWidth": 1}]}},
   {"drawLine": {"x1": 20, "y1": 20, "x2": "componentWidth() - 20", "y2": 20}},
   {"drawLine": {"x1": 20, "y1": "componentHeight() - 20", "x2": "componentWidth() - 20", "y2": "componentHeight() - 20"}},
   {"paint": {"ops": [{"color": "#FF4DA3FF"}, {"style": "fill"}]}},
   {"loop": {"index": "i", "from": 0, "until": "arrayLength(@sales)", "commands": [
     {"drawRoundRect": {
       "left": "24 + i * (componentWidth() - 40) / arrayLength(@sales)",
       "top": "componentHeight() - 20 - (componentHeight() - 40) * arrayGet(@sales, i) / arrayMax(@sales)",
       "right": "16 + (i + 1) * (componentWidth() - 40) / arrayLength(@sales)",
       "bottom": "componentHeight() - 20",
       "rx": 3, "ry": 3}}
   ]}}
  ]
 }
}
