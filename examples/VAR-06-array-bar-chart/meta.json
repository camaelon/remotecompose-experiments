 "name": "array-bar-chart",
 "version": 3,
 "title": "Bar chart from a float array",
 "summary": "Twelve monthly bars drawn by one loop over a floatArrays resource, each height normalised by arrayMax so the tallest bar fills the chart.",
 "prompt": "Draw a bar chart of twelve monthly sales values that scales the bars so the tallest one fills the chart.",
 "level": 3,
