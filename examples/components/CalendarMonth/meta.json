 "version": 1,
 "title": "CalendarMonth: a month grid and the selected day's agenda",
 "prompt": "Make a personal calendar for November 2026: a month grid with today marked and the days with plans marked, and the selected day's events listed with their times. Tapping a day shows its events; on a tablet or desktop put the event titles in the day cells and the agenda in a side panel.",
 "level": 3,
