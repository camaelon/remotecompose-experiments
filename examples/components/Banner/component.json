{
 "component": "Banner",
 "version": 1,
 "summary": "A one-line message in a rounded frame with an info, warning or error icon, an optional action and a dismiss cross: dismissing it slides it away and the space closes; setting its variable back to 1 fades it in again.",
 "params": {
  "text": {
   "type": "string",
   "required": true,
   "doc": "The message; it wraps to several lines when the width is short (the C++ renderer clips the extra line when an action sits beside it, C51)"
  },
  "kind": {
   "type": "enum",
   "values": [
    "info",
    "warn",
    "error"
   ],
   "default": "info",
   "static": true,
   "doc": "info (primary, a circled i), warn (warning, a triangle with !) or error (error, a circled !): the frame and icon colour, and the icon shape (which is what tells them apart in mono)"
  },
  "visible": {
   "type": "variable",
   "initial": {
    "type": "int",
    "value": 1
   },
   "doc": "1 shown, 0 gone. An INTEGER variable, because `visibility` reads one: bind \"@show\" declared as resources.variables {\"show\": {\"type\": \"int\", \"value\": 1}} (or a tree variable with vtype int) and change it with valueIntegerChange; omitted, the banner starts shown and keeps its own"
  },
  "dismissible": {
   "type": "bool",
   "default": true,
   "static": true,
   "doc": "Show the dismiss cross (it sets visible to 0)"
  }
 },
 "slots": {
  "action": {
   "optional": true,
   "doc": "Something to do about it, before the cross: a text Button (style text) or a short link"
  }
 },
 "capabilities": [
  "layout.decoration",
  "anim.visibility",
  "a11y.labels"
 ],
 "call": {
  "Banner": {
   "text": "You are offline",
   "kind": "warn"
  }
 },
 "body": {
  "box": {
   "modifiers": [
    {
     "visibility": "@visible"
    },
    {
     "animationSpec": {
      "motionDuration": 300,
      "visibilityDuration": 300,
      "enterAnimation": "FADE_IN",
      "exitAnimation": "SLIDE_RIGHT",
      "enterSequence": "AFTER",
      "exitSequence": "BEFORE"
     }
    },
    "fillMaxWidth",
    {
     "clip": "@theme.radius_md"
    },
    {
     "background": {
      "$if": "kind == 'error'",
      "then": "@colors.error",
      "else": {
       "$if": "kind == 'warn'",
       "then": "@colors.warning",
       "else": "@colors.primary"
      }
     }
    },
    {
     "padding": {
      "$if": "theme.mono",
      "then": 1,
      "else": 1.5
     }
    }
   ],
   "children": [
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [
       "fillMaxWidth",
       {
        "clip": "@theme.radius_outline_inner"
       },
       {
        "background": "@colors.surface"
       },
       {
        "padding": {
         "$if": "dismissible",
         "then": [
          12,
          4,
          4,
          4
         ],
         "else": [
          12,
          10
         ]
        }
       }
      ],
      "children": [
       {
        "canvas": {
         "modifiers": [
          {
           "size": [
            20,
            20
           ]
          }
         ],
         "commands": {
          "$if": "kind == 'warn'",
          "then": [
           {
            "paint": {
             "ops": [
              {
               "color": {
                "$if": "kind == 'error'",
                "then": "@colors.error",
                "else": {
                 "$if": "kind == 'warn'",
                 "then": "@colors.warning",
                 "else": "@colors.primary"
                }
               }
              },
              {
               "style": "stroke"
              },
              {
               "strokeWidth": 1.8
              },
              {
               "strokeCap": "round"
              }
             ]
            }
           },
           {
            "drawLine": {
             "x1": 10,
             "y1": 2.5,
             "x2": 18.5,
             "y2": 17
            }
           },
           {
            "drawLine": {
             "x1": 18.5,
             "y1": 17,
             "x2": 1.5,
             "y2": 17
            }
           },
           {
            "drawLine": {
             "x1": 1.5,
             "y1": 17,
             "x2": 10,
             "y2": 2.5
            }
           },
           {
            "drawLine": {
             "x1": 10,
             "y1": 7.5,
             "x2": 10,
             "y2": 11.5
            }
           },
           {
            "paint": {
             "ops": [
              {
               "style": "fill"
              }
             ]
            }
           },
           {
            "drawCircle": {
             "cx": 10,
             "cy": 14,
             "radius": 1.3
            }
           }
          ],
          "else": {
           "$if": "kind == 'error'",
           "then": [
            {
             "paint": {
              "ops": [
               {
                "color": {
                 "$if": "kind == 'error'",
                 "then": "@colors.error",
                 "else": {
                  "$if": "kind == 'warn'",
                  "then": "@colors.warning",
                  "else": "@colors.primary"
                 }
                }
               },
               {
                "style": "stroke"
               },
               {
                "strokeWidth": 1.8
               },
               {
                "strokeCap": "round"
               }
              ]
             }
            },
            {
             "drawCircle": {
              "cx": 10,
              "cy": 10,
              "radius": 8.5
             }
            },
            {
             "drawLine": {
              "x1": 10,
              "y1": 5.5,
              "x2": 10,
              "y2": 11
             }
            },
            {
             "paint": {
              "ops": [
               {
                "style": "fill"
               }
              ]
             }
            },
            {
             "drawCircle": {
              "cx": 10,
              "cy": 14,
              "radius": 1.3
             }
            }
           ],
           "else": [
            {
             "paint": {
              "ops": [
               {
                "color": {
                 "$if": "kind == 'error'",
                 "then": "@colors.error",
                 "else": {
                  "$if": "kind == 'warn'",
                  "then": "@colors.warning",
                  "else": "@colors.primary"
                 }
                }
               },
               {
                "style": "stroke"
               },
               {
                "strokeWidth": 1.8
               },
               {
                "strokeCap": "round"
               }
              ]
             }
            },
            {
             "drawCircle": {
              "cx": 10,
              "cy": 10,
              "radius": 8.5
             }
            },
            {
             "drawLine": {
              "x1": 10,
              "y1": 9,
              "x2": 10,
              "y2": 14.5
             }
            },
            {
             "paint": {
              "ops": [
               {
                "style": "fill"
               }
              ]
             }
            },
            {
             "drawCircle": {
              "cx": 10,
              "cy": 6,
              "radius": 1.3
             }
            }
           ]
          }
         }
        }
       },
       {
        "spacer": {
         "modifiers": [
          {
           "width": 12
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "weight": 1
          }
         ],
         "children": [
          {
           "text": {
            "value": "@text",
            "fontSize": "@theme.text_md",
            "color": "@colors.onSurface"
           }
          }
         ]
        }
       },
       {
        "$slot": "action"
       },
       {
        "$if": "dismissible",
        "then": {
         "box": {
          "horizontalAlignment": "center",
          "verticalAlignment": "center",
          "modifiers": [
           {
            "size": [
             40,
             40
            ]
           },
           {
            "clip": 20
           },
           {
            "semantics": {
             "contentDescription": "Dismiss: @text",
             "clickable": true
            }
           },
           {
            "onClick": {
             "type": "valueIntegerChange",
             "target": "@visible",
             "value": 0
            }
           }
          ],
          "children": [
           {
            "canvas": {
             "modifiers": [
              {
               "size": [
                16,
                16
               ]
              }
             ],
             "commands": [
              {
               "paint": {
                "ops": [
                 {
                  "color": "@colors.muted"
                 },
                 {
                  "style": "stroke"
                 },
                 {
                  "strokeWidth": 2
                 },
                 {
                  "strokeCap": "round"
                 }
                ]
               }
              },
              {
               "drawLine": {
                "x1": 3,
                "y1": 3,
                "x2": 13,
                "y2": 13
               }
              },
              {
               "drawLine": {
                "x1": 13,
                "y1": 3,
                "x2": 3,
                "y2": 13
               }
              }
             ]
            }
           }
          ]
         }
        }
       }
      ]
     }
    }
   ]
  }
 },
 "pitfalls": [
  "visible must be an INTEGER variable: `visibility` reads an int id, so a float variable (or a plain number passed as visible) hides it for good. Declare it {\"type\": \"int\", \"value\": 1} in resources.variables and change it with valueIntegerChange",
  "Dismissing slides it out to the right (exitSequence BEFORE) and then closes the gap; showing it opens the gap and then fades it in (AFTER). Components below it move smoothly only if they have an animationSpec of their own; otherwise they jump when the space closes",
  "The frame is two stacked backgrounds (a 1.5 dp ring in the kind colour around a surface fill), not a border: border can't take a theme colour",
  "In mono the kinds are told apart by the icon (circled i, triangle, circled !), since every colour is white; there is no slide or fade (mono has no motion)"
 ]
}
