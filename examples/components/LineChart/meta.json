 "version": 1,
 "title": "LineChart",
 "prompt": "Chart today's temperature hour by hour with the high and low marked, and a tide widget: the day's water level curve with high and low water, the hours under it, the metres beside it and a line at the current time.",
 "level": 3,
 "use_cases": [
  "dashboard",
  "weather"
 ],
