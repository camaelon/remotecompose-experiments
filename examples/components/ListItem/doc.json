{
 "header": {
  "apiLevel": 7, "width": 360, "height": 216, "profiles": 513,
  "contentDescription": "ListItem: a clickable row with an avatar, a subtitle and a chevron, a row with a trailing switch, and a title-only row"
 },
 "resources": { "variables": { "opened": 0, "dnd": 0 } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": [0, 12] }],
   "children": [
    {
     "ListItem": {
      "title": "Ada Lovelace",
      "subtitle": "Analyst",
      "chevron": true,
      "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 1 },
      "slots": { "leading": [{ "Avatar": { "initials": "AL" } }] }
     }
    },
    {
     "ListItem": {
      "title": "Do not disturb",
      "subtitle": "Silence calls and alerts",
      "slots": { "trailing": [{ "Switch": { "label": "Do not disturb", "checked": "@dnd" } }] }
     }
    },
    { "ListItem": { "title": "About this phone", "chevron": true, "onClick": { "type": "valueFloatChange", "target": "@opened", "value": 3 } } }
   ]
  }
 }
}
