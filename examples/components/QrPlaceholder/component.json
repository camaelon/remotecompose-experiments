       },
       {
        "style": "fill"
       },
       {
        "alpha": 1
       }
      ]
     }
    },
    {
     "drawRoundRect": {
      "left": 0,
      "top": 0,
      "right": 29,
      "bottom": 29,
      "rx": 1.5,
      "ry": 1.5
     }
    },
    {
