{
 "header": {
  "apiLevel": 7,
  "width": 480,
  "height": 200,
  "profiles": 513,
  "contentDescription": "A big number and a note, side by side when wide, stacked when narrow; the note goes when very short"
 },
 "root": {
  "box": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    }
   ],
   "children": [
    {
     "flow": {
      "horizontalArrangement": "spaceBetween",
      "modifiers": [
       "fillMaxWidth"
      ],
      "children": [
       {
        "box": {
         "modifiers": [
          {
           "visibility": "@vis_1"
          },
          {
           "width": "ifElse((windowWidth()), @adaptivesplit1_sw, @adaptivesplit1_s)"
          },
          {
           "height": "ifElse(ifElse(80, (windowHeight()), (1 - step(windowHeight(), 120))), (windowHeight()), @adaptivesplit1_s)"
          }
         ],
         "children": [
          {
           "box": {
            "modifiers": [
             "fillMaxSize",
             {
              "clip": {
               "roundedRect": 12
              }
             },
             {
              "background": "@colors.primary"
             }
            ],
            "horizontalAlignment": "center",
            "verticalAlignment": "center",
            "children": [
             {
              "text": {
               "value": "72",
               "fontSize": 40,
               "fontWeight": 700,
               "color": "@colors.onPrimary"
              }
             }
            ]
           }
          }
         ]
        }
       },
       {
        "box": {
         "modifiers": [
          {
           "visibility": "@adaptivesplit1_v2"
          },
          {
           "width": "ifElse((windowWidth()), (windowWidth()) - @adaptivesplit1_sw - 12, @adaptivesplit1_s)"
          },
          {
           "height": "ifElse((windowHeight()) - 80 * (1 - 0), (windowHeight()), @adaptivesplit1_s)"
          }
         ],
         "children": [
          {
           "box": {
            "modifiers": [
             "fillMaxSize",
             {
              "padding": 12
             }
            ],
            "verticalAlignment": "center",
            "children": [
             {
              "text": {
               "value": "Beats a minute, resting",
               "fontSize": 16,
               "color": "@colors.onSurface"
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 },
 "resources": {
  "variables": {
   "adaptivesplit1_s": "step((windowWidth()), 480 - 0.5) * (1 - 0) * (1 - (1 - step(windowHeight(), 120)))",
   "adaptivesplit1_sw": "floor((windowWidth()) * 0.5 - 12 / 2)",
   "adaptivesplit1_v2": "1 - (1 - step(windowHeight(), 120))",
   "vis_1": 1
  },
  "colors": {
   "background": {
    "light": "#FFF5F7FA",
    "dark": "#FF101828"
   },
   "onPrimary": {
    "light": "#FFFFFFFF",
    "dark": "#FF0B1A2E"
   },
   "onSurface": {
    "light": "#FF111827",
    "dark": "#FFE6EAF2"
   },
   "primary": {
    "light": "#FF1565D8",
    "dark": "#FF4DA3FF"
   }
  }
 }
}
