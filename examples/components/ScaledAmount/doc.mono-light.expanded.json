   },
   "scaledamount1_a": "max(0, 1.5 * @scale)",
   "scaledamount1_n8": "round(@scaledamount1_a * 8) / 8",
   "scaledamount1_n3": "round(@scaledamount1_a * 3) / 3",
   "scaledamount1_th": "step(abs(@scaledamount1_a - @scaledamount1_n8) - abs(@scaledamount1_a - @scaledamount1_n3), 0.001)",
   "scaledamount1_v": "max(ifElse(@scaledamount1_n8, @scaledamount1_n3, @scaledamount1_th), step(@scaledamount1_a, 0.0001) / 8)",
   "scaledamount1_w": "floor(@scaledamount1_v + 0.001)",
   "scaledamount1_f": "@scaledamount1_v - @scaledamount1_w",
   "scaledamount1_fi": "ifElse(round(@scaledamount1_f * 8), 7 + round(@scaledamount1_f * 3), @scaledamount1_th * step(@scaledamount1_f, 0.01))",
   "scaledamount1_hf": "step(@scaledamount1_fi, 0.5)",
   "scaledamount1_pl": "max(step(@scaledamount1_v, 1.001), 1 - step(@scaledamount1_v, 0.0001))",
