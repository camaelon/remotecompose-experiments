   "scaledamount3_hf": "step(@scaledamount3_fi, 0.5)",
   "scaledamount3_pl": "max(step(@scaledamount3_v, 1.001), 1 - step(@scaledamount3_v, 0.0001))",
   "scaledamount4_a": "max(0, 2.5 * @scale)",
   "scaledamount4_m": "max(round(@scaledamount4_a * 10), step(@scaledamount4_a, 0.0001))",
   "scaledamount4_v": "@scaledamount4_m / 10",
   "scaledamount4_pl": "max(step(@scaledamount4_v, 1.001), 1 - step(@scaledamount4_v, 0.0001))",
   "scaledamount4_dd": "step(@scaledamount4_m % 10, 0.5)",
   "scaledamount5_a": "max(0, 0.25 * @scale)",
