   "scaledamount5_v": "@scaledamount5_m / 100",
   "scaledamount5_dd": "step(@scaledamount5_m % 100, 0.5) * (1 + step(@scaledamount5_m % 10, 0.5))",
   "scaledamount6_a": "max(0, 247 * @scale)",
   "scaledamount6_st": "max(round(@scaledamount6_a / 5) * 5, step(@scaledamount6_a, 0.0001) * 5)",
