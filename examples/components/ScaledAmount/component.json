{
 "component": "ScaledAmount",
 "version": 1,
 "summary": "A base amount times a factor, shown as one readable value with its unit and spoken as one item: 1½ cups, ¾ L, 2.5 kg, 250 g, 3 rolls. Fractions snap to eighths and thirds; numbers round to a step or up to what you can buy. With `name` it is a whole row: the name on the left, the amount on the right.",
 "params": {
  "amount": {
   "type": "float",
   "required": true,
   "doc": "The base amount, in the unit shown: a number, a \"@variable\" or an expression"
  },
  "factor": {
   "type": "float",
   "default": 1,
   "doc": "What scales it: \"@guests / 4\", \"@area / 20\". The value shown is amount x factor"
  },
  "unit": {
   "type": "string",
   "doc": "The unit, printed after a space: \"cups\", \"L\", \"g\". Literal text"
  },
  "unitOne": {
   "type": "string",
   "doc": "The unit when the value is 1 or less (\"cup\" beside unit \"cups\"), so it reads 1 cup, ½ cup, 1½ cups. Omitted, unit is used for every value"
  },
  "format": {
   "type": "enum",
   "values": [
    "fraction",
    "number"
   ],
   "default": "number",
   "static": true,
   "doc": "number: digits, see decimals, step and roundUp. fraction: a whole number and a fraction glyph, nearest of the fractions param; about 3x the bytes of number"
  },
  "decimals": {
   "type": "float",
   "default": 0,
   "static": true,
   "doc": "number format: digits after the point, 0, 1 or 2. Trailing zeros are dropped: 2.5, 2"
  },
  "step": {
   "type": "float",
   "default": 0,
   "static": true,
   "doc": "number format: round to a multiple of this (5: 250 g, not 247 g). 0 is no step. Any value above 0 shows at least one step"
  },
  "roundUp": {
   "type": "bool",
   "default": false,
   "static": true,
   "doc": "number format: round up, not to nearest: for what is bought whole (3 rolls when 2.1 are needed)"
  },
  "fractions": {
   "type": "enum",
   "values": [
    "all",
    "eighths",
    "quarters"
   ],
   "default": "all",
   "static": true,
   "doc": "fraction format: which glyphs. all: eighths and thirds. eighths: no thirds, 0.33 reads ⅜, about 300 B less a call. quarters: only ¼ ½ ¾, about 600 B less a call"
  },
  "name": {
   "type": "string",
   "doc": "What is measured. Given, the call is a whole row, name left and amount right, spoken as two items: the name, then the amount. Omitted, just the amount, sized to its text"
  },
  "spoken": {
   "type": "string",
   "doc": "The unit as spoken, when the shown one reads badly: \"litres\" for \"L\". Omitted, the shown unit"
  },
  "spokenOne": {
   "type": "string",
   "doc": "The same for a value of 1 or less: \"litre\""
  },
  "fontSize": {
   "type": "float",
   "default": "@theme.text_md",
   "doc": "The amount's size in sp"
  },
  "color": {
   "type": "color",
   "default": "@colors.onSurface",
   "doc": "The amount's colour"
  },
  "fontWeight": {
   "type": "float",
   "doc": "The amount's weight, 100 to 900"
  },
  "rowHeight": {
   "type": "float",
   "default": 36,
   "static": true,
   "doc": "With name: the row's height in dp"
  }
 },
 "locals": {
  "a": "max(0, @amount * @factor)",
  "d": {
   "$if": "fractions == 'quarters'",
   "then": 4,
   "else": 8
  },
  "n8": {
   "$if": "format == 'fraction'",
   "then": "round(@a * @d) / @d",
   "else": 0
  },
  "n3": {
   "$if": "format == 'fraction'",
   "then": {
    "$if": "fractions == 'all'",
    "then": "round(@a * 3) / 3",
    "else": 0
   },
   "else": 0
  },
  "th": {
   "$if": "format == 'fraction'",
   "then": {
    "$if": "fractions == 'all'",
    "then": "step(abs(@a - @n8) - abs(@a - @n3), 0.001)",
    "else": 0
   },
   "else": 0
  },
  "st": {
   "$if": "step",
   "then": {
    "$if": "roundUp",
    "then": "max(ceil(@a / @step - 0.0005) * @step, 0)",
    "else": "max(round(@a / @step) * @step, step(@a, 0.0001) * @step)"
   },
   "else": {
    "$if": "roundUp",
    "then": "ceil(@a - 0.0005)",
    "else": "@a"
   }
  },
  "q": {
   "$if": "decimals == '1'",
   "then": 10,
   "else": {
    "$if": "decimals == '2'",
    "then": 100,
    "else": 1
   }
  },
  "m": {
   "$if": "format == 'number'",
   "then": "max(round(@st * @q), step(@a, 0.0001))",
   "else": 0
  },
  "v": {
   "$if": "format == 'fraction'",
   "then": {
    "$if": "fractions == 'all'",
    "then": "max(ifElse(@n8, @n3, @th), step(@a, 0.0001) / @d)",
    "else": "max(@n8, step(@a, 0.0001) / @d)"
   },
   "else": "@m / @q"
  },
  "w": {
   "$if": "format == 'fraction'",
   "then": "floor(@v + 0.001)",
   "else": 0
  },
  "f": {
   "$if": "format == 'fraction'",
   "then": "@v - @w",
   "else": 0
  },
  "fi": {
   "$if": "format == 'fraction'",
   "then": {
    "$if": "fractions == 'all'",
    "then": "ifElse(round(@f * 8), 7 + round(@f * 3), @th * step(@f, 0.01))",
    "else": "round(@f * @d)"
   },
   "else": 0
  },
  "hf": {
   "$if": "format == 'fraction'",
   "then": "step(@fi, 0.5)",
   "else": 0
  },
  "pl": {
   "$if": "unitOne || spokenOne",
   "then": "max(step(@v, 1.001), 1 - step(@v, 0.0001))",
   "else": 0
  },
  "dd": {
   "$if": "decimals == '1'",
   "then": "step(@m % 10, 0.5)",
   "else": {
    "$if": "decimals == '2'",
    "then": "step(@m % 100, 0.5) * (1 + step(@m % 10, 0.5))",
    "else": 0
   }
  }
 },
 "capabilities": [
  "text.dynamic",
  "data.expression",
  "a11y.labels"
 ],
 "call": {
  "ScaledAmount": {
   "amount": 1.5,
   "factor": "@scale",
   "unit": "cups",
   "unitOne": "cup",
   "format": "fraction"
  }
 },
 "body": {
