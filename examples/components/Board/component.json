                     },
                     "fillMaxWidth",
                     {
                      "clip": {
                       "roundedRect": 10
                      }
                     },
                     {
                      "background": "@colors.monoOutline"
                     },
                     {
                      "padding": 1
                     },
                     {
                      "clip": {
                       "roundedRect": 9
                      }
                     },
                     {
                      "background": "@colors.surface"
                     },
                     {
                      "semantics": {
                       "clickable": true,
                       "contentDescription": {
                        "$if": "r_label",
                        "then": "@r_label",
                        "else": {
                         "type": "textMerge",
                         "id1": "@r_title",
                         "id2": {
