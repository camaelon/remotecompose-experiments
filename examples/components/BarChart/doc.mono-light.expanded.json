{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 220,
  "profiles": 513,
  "contentDescription": "BarChart component: weekly visits as labelled bars filling the card, and a small unlabelled chart of daily steps"
 },
 "resources": {
  "floatArrays": {
   "visits": {
    "value": [
     42,
     55,
     48,
     61,
     58,
     73,
     69,
     84
    ],
    "export": true
   },
   "steps": [
    6200,
    8400,
    7100,
    10300,
    5600,
    12100,
    9000
   ]
  },
  "colors": {
   "background": "#FFFFFFFF",
   "muted": "#FF616161",
   "onSurface": "#FF000000",
   "outline": "#FF616161"
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    }
   ],
   "children": [
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [
       "fillMaxWidth"
      ],
      "children": [
       {
        "text": {
         "value": "BarChart",
         "fontSize": 20,
         "color": "@colors.onSurface",
         "modifiers": [
          {
           "weight": 1
          }
         ]
        }
       },
       {
        "canvas": {
         "modifiers": [
          {
           "size": [
            84,
            28
           ]
          },
          {
           "semantics": {
            "contentDescription": "Steps, last 7 days"
           }
          }
         ],
         "commands": [
          {
           "variable": {
            "name": "barchart1_n",
            "value": "arrayLength(@steps)"
           }
          },
          {
           "variable": {
            "name": "barchart1_max",
            "value": "max(arrayMax(@steps), 0.001)"
           }
          },
          {
           "translate": {
            "dx": 0,
            "dy": "componentHeight() - 0"
           }
          },
          {
           "paint": {
            "ops": [
             {
              "color": "@colors.onSurface"
             },
             {
              "style": "stroke"
             },
             {
              "strokeWidth": 1.5
             }
            ]
           }
          },
          {
           "save": {
            "commands": [
             {
              "clipRect": {
               "left": 0,
               "top": "-componentHeight()",
               "right": "componentWidth()",
               "bottom": 0
              }
             },
             {
              "loop": {
               "index": "i",
               "from": 0,
               "until": "@barchart1_n",
               "commands": [
                {
                 "drawRoundRect": {
                  "left": "(i + 0.15) * componentWidth() / @barchart1_n",
                  "top": "-arrayGet(@steps, i) * (componentHeight() - 0 - 4) / @barchart1_max",
                  "right": "(i + 0.85) * componentWidth() / @barchart1_n",
                  "bottom": 4,
                  "rx": 4,
                  "ry": 4
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "paint": {
            "ops": [
             {
              "color": "@colors.outline"
             },
             {
              "style": "stroke"
             },
             {
              "strokeWidth": 1
             }
            ]
           }
          },
          {
           "drawLine": {
            "x1": 0,
            "y1": 0,
            "x2": "componentWidth()",
            "y2": 0
           }
          }
         ]
        }
       }
      ]
     }
    },
    {
     "box": {
      "modifiers": [
       {
        "verticalWeight": 1
       },
       "fillMaxWidth",
       {
        "padding": {
         "top": 12
        }
       }
      ],
      "children": [
       {
        "canvas": {
         "modifiers": [
          "fillMaxSize",
          {
           "semantics": {
            "contentDescription": "Visits per week, last 8 weeks"
           }
          }
         ],
         "commands": [
          {
           "variable": {
            "name": "barchart2_n",
            "value": "arrayLength(@visits)"
           }
          },
          {
           "variable": {
            "name": "barchart2_max",
            "value": "max(arrayMax(@visits), 0.001)"
           }
          },
          {
           "translate": {
