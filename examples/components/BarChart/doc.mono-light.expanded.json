             {
              "color": "@colors.muted"
             },
             {
              "style": "fill"
             },
             {
              "textSize": 11
             }
            ]
           }
          },
          {
           "drawTextAnchored": {
            "text": "W1",
            "x": "(0 + 0.5) * componentWidth() / @barchart2_n",
            "y": 11,
