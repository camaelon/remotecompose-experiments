           }
          },
          {
           "drawTextAnchored": {
            "text": "W7",
            "x": "(6 + 0.5) * componentWidth() / @barchart2_n",
            "y": 11,
            "panX": 0,
            "panY": 0
           }
          },
          {
           "drawTextAnchored": {
            "text": "W8",
            "x": "(7 + 0.5) * componentWidth() / @barchart2_n",
            "y": 11,
