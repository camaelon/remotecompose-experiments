{
 "header": {
  "apiLevel": 7, "width": 360, "height": 220, "profiles": 513,
  "contentDescription": "BarChart component: weekly visits as labelled bars filling the card, and a small unlabelled chart of daily steps"
 },
 "resources": {
  "floatArrays": {
   "visits": { "value": [42, 55, 48, 61, 58, 73, 69, 84], "export": true },
   "steps": [6200, 8400, 7100, 10300, 5600, 12100, 9000]
  }
 },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }],
   "children": [
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth"],
      "children": [
       { "text": { "value": "BarChart", "fontSize": 20, "color": "@colors.onSurface", "modifiers": [{ "weight": 1 }] } },
       { "BarChart": { "values": "@steps", "width": 84, "height": 28, "color": "@colors.secondary", "label": "Steps, last 7 days" } }
      ]
     }
    },
    {
     "box": {
      "modifiers": [{ "verticalWeight": 1 }, "fillMaxWidth", { "padding": { "top": 12 } }],
      "children": [{ "BarChart": { "values": "@visits", "labels": ["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"], "fill": true, "label": "Visits per week, last 8 weeks" } }]
     }
    }
   ]
  }
 }
}
