  },
  {
   "pointer": "/root/column/children/1/row/children/1/box/children/0",
   "shows": "data.expression",
   "note": "each percent is round(100 * arrayGet(values, i) / sum) through textFromFloat merged with %"
  },
  {
   "pointer": "/root/column/children/3",
   "shows": "layout.weight",
   "note": "two weighted columns, the entries alternating; format value, the secondary colour and an accessibility label"
  },
  {
