{
 "header": {
  "apiLevel": 7, "width": 360, "height": 240, "profiles": 513,
  "contentDescription": "Legend component: a portfolio donut with its legend beside it (label and percent per slice), and a two-column legend of traffic sources with the values"
 },
 "resources": {
  "floatArrays": {
   "shares": { "value": [40, 30, 20, 10], "export": true },
   "sources": [58, 27, 15, 8, 4]
  }
 },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }],
   "children": [
    { "text": { "value": "Legend", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth", { "padding": { "top": 8 } }],
      "children": [
       { "box": { "modifiers": [{ "weight": 1 }, { "height": 96 }], "children": [{ "DonutChart": { "values": "@shares", "label": "portfolio", "fill": true } }] } },
       { "box": { "modifiers": [{ "weight": 2 }, { "padding": { "start": 16 } }], "children": [{ "Legend": { "values": "@shares", "labels": ["Stocks", "Bonds", "Cash", "Other"] } }] } }
      ]
     }
    },
    { "box": { "modifiers": [{ "height": 12 }] } },
    { "Legend": { "values": "@sources", "labels": ["Direct", "Search", "Social", "Email", "Referral"], "columns": 2, "format": "value", "color": "@colors.secondary", "label": "Traffic sources" } }
   ]
  }
 }
}
