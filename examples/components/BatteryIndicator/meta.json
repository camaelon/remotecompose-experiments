{
 "id": "BatteryIndicator",
 "name": "battery-indicator",
 "version": 1,
 "title": "Battery indicator",
 "prompt": "Show the phone's battery level as a battery icon with the percentage, green when charged, amber at half and red with a warning mark when low.",
 "level": 1,
 "use_cases": [
  "widget",
  "watch-face"
 ],
 "form_factor": "phone",
 "keywords": [
  "battery",
  "battery indicator",
  "battery icon",
  "battery level",
  "charge level",
  "low battery",
  "battery percentage",
  "status bar",
  "power"
 ],
 "teaches": [
  "{\"BatteryIndicator\": {\"level\": \"@battery\"}} draws a battery filled to an exported host float, with \"76%\" after it",
  "The fill turns amber below warnAt (50) and red below lowAt (20) through conditionalOperations around a paint change, and low also draws a !, so mono shows it by shape",
  "size scales the icon (it is half as tall as it is wide); showPercent: false leaves only the icon"
 ],
 "snippets": [
  {
   "pointer": "/resources/variables",
   "shows": "host.variables",
   "note": "battery, set by the host"
  },
