    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    },
    {
     "spacedBy": 12
    }
   ],
   "children": [
    {
     "text": {
      "value": "Rating",
      "fontSize": 20,
      "color": "@colors.onSurface"
     }
    },
    {
