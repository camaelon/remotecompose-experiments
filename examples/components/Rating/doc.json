        }
       },
       {
        "text": {
         "value": "4.5 · 1,284 reviews",
         "fontSize": 14,
         "color": "@colors.onSurface"
        }
       }
      ]
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [
       {
        "spacedBy": 8
       }
      ],
      "children": [
       {
        "text": {
         "value": "Difficulty",
         "fontSize": 14,
         "color": "@colors.muted"
        }
       },
       {
        "Rating": {
         "value": "@difficulty",
         "max": 3,
         "color": "@colors.primary",
         "label": "Difficulty"
        }
       }
      ]
     }
    }
   ]
  }
 }
}
