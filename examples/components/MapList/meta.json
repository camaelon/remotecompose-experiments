 "version": 1,
 "title": "MapList: places on a map and in a list, stacked or side by side",
 "prompt": "Show our five offices worldwide as numbered markers on a map with a list of them below (city, team, time zone). On a wide screen put the list in a side panel and let the map fill the rest. Tapping a row or a marker selects that office.",
 "level": 2,
