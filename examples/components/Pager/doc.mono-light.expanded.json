{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 360,
  "profiles": 513,
  "contentDescription": "Pager: three onboarding pages, swipe left or right or tap a dot; a screen reader hears Onboarding, Page N of 3"
 },
 "resources": {
  "variables": {
   "page": {
    "value": 0,
    "export": true
   },
   "pager1_k": "clamp(0, 3 - 1, round(@page))",
   "pager1_start": 0
  },
  "colors": {
   "background": "#FFFFFFFF",
   "muted": "#FF616161",
   "onSurface": "#FF000000",
   "primary": "#FF000000"
  }
 },
 "root": {
  "box": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 8
    }
   ],
   "children": [
    {
     "column": {
      "horizontalAlignment": "center",
      "modifiers": [
       "fillMaxSize",
       {
        "onTouchDown": {
         "type": "valueFloatExpressionChange",
         "target": "@pager1_start",
         "value": "touchX()"
        }
       },
       {
        "onTouchUp": {
         "type": "valueFloatExpressionChange",
         "target": "@page",
         "value": "clamp(0, 3 - 1, @page + clamp(-1, 1, round((@pager1_start - touchX()) / (0.5 * windowWidth()))))"
        }
       }
      ],
      "children": [
       {
        "box": {
         "modifiers": [
          "fillMaxWidth",
          {
           "verticalWeight": 1
          },
          {
           "semantics": {
            "contentDescription": {
             "type": "textMerge",
             "id1": "Onboarding, ",
             "id2": {
              "type": "textMerge",
              "id1": {
               "type": "textMerge",
               "id1": "Page ",
               "id2": {
                "type": "textFromFloat",
                "value": "@pager1_k + 1",
                "whole": 2,
                "decimal": 0,
                "flags": 5
               }
              },
              "id2": " of 3"
             }
            }
           }
          }
         ],
         "children": [
          {
           "box": {
            "modifiers": [
             "fillMaxSize",
             {
              "visibility": "1 - min(1, abs(@pager1_k - 0))"
             },
             {
              "graphicsLayer": {
               "alpha": "1 - min(1, abs(@page - 0))"
              }
             }
            ],
            "children": [
             {
              "column": {
               "horizontalAlignment": "center",
               "verticalArrangement": "center",
               "modifiers": [
                "fillMaxSize",
                {
                 "padding": 24
                },
                {
                 "spacedBy": 8
                }
               ],
               "children": [
                {
                 "text": {
                  "value": "Welcome",
                  "fontSize": 24,
                  "color": "@colors.onSurface",
                  "textAlign": "center"
                 }
                },
                {
                 "text": {
                  "value": "Plan your week in a minute",
                  "fontSize": 15,
                  "color": "@colors.muted",
                  "textAlign": "center"
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "box": {
            "modifiers": [
             "fillMaxSize",
             {
              "visibility": "1 - min(1, abs(@pager1_k - 1))"
             },
             {
              "graphicsLayer": {
               "alpha": "1 - min(1, abs(@page - 1))"
              }
             }
            ],
            "children": [
             {
              "column": {
               "horizontalAlignment": "center",
               "verticalArrangement": "center",
               "modifiers": [
                "fillMaxSize",
                {
                 "padding": 24
                },
                {
                 "spacedBy": 8
                }
               ],
               "children": [
                {
                 "text": {
                  "value": "Track your runs",
                  "fontSize": 24,
                  "color": "@colors.onSurface",
                  "textAlign": "center"
                 }
                },
                {
                 "text": {
                  "value": "Distance, pace and heart rate, live on your wrist",
                  "fontSize": 15,
                  "color": "@colors.muted",
                  "textAlign": "center"
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "box": {
            "modifiers": [
             "fillMaxSize",
             {
              "visibility": "1 - min(1, abs(@pager1_k - 2))"
             },
             {
              "graphicsLayer": {
               "alpha": "1 - min(1, abs(@page - 2))"
              }
             }
            ],
            "children": [
             {
              "column": {
               "horizontalAlignment": "center",
               "verticalArrangement": "center",
