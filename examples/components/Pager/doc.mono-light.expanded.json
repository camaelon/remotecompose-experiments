                    "value": 1,
                    "whole": 2,
                    "decimal": 0,
                    "flags": 5
                   }
                  }
                 }
                }
               ]
              }
             },
             {
              "box": {
               "modifiers": [
                {
                 "width": 24
                },
                "fillMaxHeight",
                {
                 "onClick": {
                  "type": "valueFloatChange",
                  "target": "@page",
                  "value": 1
                 }
                },
                {
                 "semantics": {
                  "contentDescription": {
