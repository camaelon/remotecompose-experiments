                 "padding": 24
                },
                {
                 "spacedBy": 8
                }
               ],
               "children": [
                {
                 "text": {
                  "value": "Share with friends",
                  "fontSize": 24,
                  "color": "@colors.onSurface",
                  "textAlign": "center"
                 }
                },
                {
                 "text": {
                  "value": "Send a route or a finish photo in one tap",
                  "fontSize": 15,
                  "color": "@colors.muted",
                  "textAlign": "center"
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       },
       {
