{
 "header": {
  "apiLevel": 7, "width": 360, "height": 136, "profiles": 513,
  "contentDescription": "TopBar: a title-only bar, and a bar with a back button and a search action"
 },
 "resources": { "variables": { "action": 0 } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "spacedBy": 24 }],
   "children": [
    { "TopBar": { "title": "Inbox" } },
    {
     "TopBar": {
      "title": "Settings",
      "slots": {
       "navigation": [
        {
         "box": {
          "horizontalAlignment": "center",
          "verticalAlignment": "center",
          "modifiers": [
           { "size": 40 }, { "clip": 20 }, "ripple",
           { "semantics": { "contentDescription": "Back", "clickable": true } },
           { "onClick": { "type": "valueFloatChange", "target": "@action", "value": 1 } }
          ],
          "children": [
           {
            "canvas": {
             "modifiers": [{ "size": 20 }],
             "commands": [
              { "paint": { "ops": [{ "color": "@colors.onSurface" }, { "style": "stroke" }, { "strokeWidth": 2 }, { "strokeCap": "round" }] } },
              { "drawLine": { "x1": 4, "y1": 10, "x2": 17, "y2": 10 } },
              { "drawLine": { "x1": 4, "y1": 10, "x2": 10, "y2": 4 } },
              { "drawLine": { "x1": 4, "y1": 10, "x2": 10, "y2": 16 } }
             ]
            }
           }
          ]
         }
        }
       ],
       "actions": [
        {
         "box": {
          "horizontalAlignment": "center",
          "verticalAlignment": "center",
          "modifiers": [
           { "size": 40 }, { "clip": 20 }, "ripple",
           { "semantics": { "contentDescription": "Search", "clickable": true } },
           { "onClick": { "type": "valueFloatChange", "target": "@action", "value": 2 } }
          ],
          "children": [
           {
            "canvas": {
             "modifiers": [{ "size": 20 }],
             "commands": [
              { "paint": { "ops": [{ "color": "@colors.onSurface" }, { "style": "stroke" }, { "strokeWidth": 2 }, { "strokeCap": "round" }] } },
              { "drawCircle": { "cx": 8, "cy": 8, "radius": 6 } },
              { "drawLine": { "x1": 13, "y1": 13, "x2": 18, "y2": 18 } }
             ]
            }
           }
          ]
         }
        }
       ]
      }
     }
    }
   ]
  }
 }
}
