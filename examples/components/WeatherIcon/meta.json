 "name": "weather-icon",
 "version": 2,
 "title": "Weather icon",
 "prompt": "Draw weather symbols for sunny, cloudy, rain, snow and thunderstorm, without images or SVG paths, labelled underneath.",
 "level": 1,
 "use_cases": [
  "widget",
  "watch-face"
 ],
 "form_factor": "phone",
 "keywords": [
  "weather",
  "weather icon",
  "weather symbol",
  "sun icon",
  "cloud icon",
  "rain icon",
  "snow icon",
  "storm",
  "thunderstorm",
  "forecast",
  "partly cloudy",
  "fog",
  "mist",
  "night",
