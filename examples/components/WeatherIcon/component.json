        "$if": "condition == 'sun'",
        "then": "Sunny",
        "else": {
         "$if": "condition == 'cloud'",
         "then": "Cloudy",
         "else": {
          "$if": "condition == 'rain'",
          "then": "Rain",
          "else": {
           "$if": "condition == 'snow'",
           "then": "Snow",
           "else": "Thunderstorm"
          }
         }
        }
       }
      }
     }
    }
