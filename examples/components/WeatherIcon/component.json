{
 "component": "WeatherIcon",
 "version": 1,
 "summary": "A square weather symbol drawn with circles, rounded rectangles and lines: sun, cloud, rain, snow or storm.",
 "params": {
  "condition": {
   "type": "enum",
   "values": [
    "sun",
    "cloud",
    "rain",
    "snow",
    "storm"
   ],
   "default": "sun",
   "static": true,
   "doc": "sun: an amber disc with eight rays; cloud: a grey cloud; rain: a cloud over three slanted blue drops; snow: a cloud over three blue flakes (dots); storm: a cloud over an amber lightning bolt"
  },
  "size": {
   "type": "float",
   "default": 48,
   "static": true,
   "doc": "Width and height in dp; the drawing is on a 24-unit grid scaled to it (and down to a smaller box)"
  },
  "label": {
   "type": "string",
   "doc": "Accessibility label; by default Sunny, Cloudy, Rain, Snow or Thunderstorm"
  }
 },
 "locals": {
  "u": "@size / 24"
 },
 "capabilities": [
  "draw.shapes",
  "draw.transform",
  "data.loop"
 ],
 "call": {
  "WeatherIcon": {
   "condition": "rain"
  }
