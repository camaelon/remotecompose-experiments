        "drawCircle": {
         "cx": "@u * 12",
         "cy": "@u * 12",
         "radius": "@u * 4.25"
        }
       },
       "else": {
        "drawCircle": {
         "cx": "@u * 12",
         "cy": "@u * 12",
         "radius": "@u * 4.75"
        }
       }
      },
      {
       "loop": {
        "index": "i",
        "from": 0,
        "until": 8,
        "step": 1,
        "commands": [
         {
          "rotate": {
           "angle": 45,
           "pivotX": "@u * 12",
           "pivotY": "@u * 12"
          }
         },
