{
 "component": "WeatherIcon",
 "version": 2,
 "summary": "A square weather symbol drawn with circles, rounded rectangles, lines and a crescent path: sun, cloud, rain, snow, storm, partly cloudy or fog, with a moon instead of the sun at night.",
 "params": {
  "condition": {
   "type": "enum",
   "values": [
    "sun",
    "cloud",
    "rain",
    "snow",
    "storm",
    "partly",
    "fog"
   ],
   "default": "sun",
   "static": true,
   "doc": "Codes, in order: sun: an amber disc with eight rays; cloud: a grey cloud; rain: a cloud over three slanted blue drops; snow: a cloud over three blue flakes (dots); storm: a cloud over an amber lightning bolt; partly: partly cloudy, a small sun (a crescent moon at night) behind a grey cloud; fog: a cloud over two horizontal grey lines. Static: to switch it at run time, put one call per condition in a stateLayout driven by a host integer"
  },
  "night": {
   "type": "float",
   "doc": "Night: a crescent moon replaces the sun in sun (clear) and partly. A number or a \"@variable\" (0 day, 1 night), read at run time, so a host flag such as \"@isNight\" switches it while the document plays; omitted or 0 draws the day icon only. Other conditions ignore it"
  },
  "size": {
   "type": "float",
   "default": 48,
   "static": true,
   "doc": "Width and height in dp; the drawing is on a 24-unit grid scaled to it (and down to a smaller box)"
  },
  "label": {
   "type": "string",
   "doc": "Accessibility label, a text or a \"@textVariable\"; by default Sunny, Cloudy, Rain, Snow, Thunderstorm, Partly cloudy or Fog (with night given: Clear for sun, since the same label must hold by day and by night; pass a label such as \"Clear night\" for a fixed night icon)"
  }
 },
 "locals": {
  "u": "@size / 24"
 },
 "capabilities": [
  "draw.shapes",
  "draw.transform",
  "data.loop"
 ],
 "call": {
  "WeatherIcon": {
   "condition": "rain"
  }
 },
 "body": {
  "canvas": {
   "modifiers": [
    {
     "size": "@size"
    },
    {
     "semantics": {
      "contentDescription": {
       "$if": "label",
       "then": "@label",
       "else": {
        "$if": "condition == 'sun'",
        "then": {
         "$if": "night",
         "then": "Clear",
         "else": "Sunny"
        },
        "else": {
         "$if": "condition == 'cloud'",
         "then": "Cloudy",
         "else": {
          "$if": "condition == 'rain'",
          "then": "Rain",
          "else": {
           "$if": "condition == 'snow'",
           "then": "Snow",
           "else": {
            "$if": "condition == 'storm'",
            "then": "Thunderstorm",
            "else": {
             "$if": "condition == 'partly'",
             "then": "Partly cloudy",
             "else": "Fog"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   ],
   "commands": [
    {
     "variable": {
      "name": "s",
      "value": "min(componentWidth(), componentHeight())"
     }
    },
    {
     "translate": {
      "dx": "(componentWidth() - @s) / 2",
      "dy": "(componentHeight() - @s) / 2"
     }
    },
    {
     "scale": {
      "sx": "@s / @size",
      "sy": "@s / @size"
     }
    },
    {
     "$if": "condition == 'sun'",
     "then": {
      "$if": "night",
      "then": [
       {
        "conditionalOperations": {
         "condition": "lt",
         "v1": "@night",
         "v2": 0.5,
         "commands": [
          {
           "paint": {
            "ops": [
             {
              "color": "@colors.warning"
             },
             {
              "style": "stroke"
             },
             {
              "strokeWidth": "@u * 1.5"
             },
             {
              "strokeCap": "round"
             }
            ]
           }
          },
          {
           "$if": "theme.mono",
           "then": {
            "drawCircle": {
             "cx": "@u * 12",
             "cy": "@u * 12",
             "radius": "@u * 4.25"
            }
           },
           "else": {
            "drawCircle": {
             "cx": "@u * 12",
             "cy": "@u * 12",
             "radius": "@u * 4.75"
            }
           }
          },
          {
           "loop": {
            "index": "i",
            "from": 0,
            "until": 8,
            "step": 1,
            "commands": [
             {
              "rotate": {
               "angle": 45,
               "pivotX": "@u * 12",
               "pivotY": "@u * 12"
              }
             },
             {
              "drawLine": {
               "x1": "@u * 12",
               "y1": "@u * 2.5",
               "x2": "@u * 12",
               "y2": "@u * 4.75"
              }
             }
