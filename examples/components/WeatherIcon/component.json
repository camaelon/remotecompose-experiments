      "name": "s",
      "value": "min(componentWidth(), componentHeight())"
     }
    },
    {
     "translate": {
      "dx": "(componentWidth() - @s) / 2",
      "dy": "(componentHeight() - @s) / 2"
     }
    },
    {
     "scale": {
      "sx": "@s / @size",
      "sy": "@s / @size"
