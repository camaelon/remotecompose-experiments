 "version": 1,
 "title": "Walkthrough",
 "prompt": "Explain why a² + b² = c² in four steps: a drawing of a 3-4-5 triangle whose squares grow in one by one, a title and a sentence per step, Back / Next (Start over on the last step), \"Step 2 of 4\" with dots, and a play button that advances every three seconds.",
 "level": 3,
 "use_cases": [
  "onboarding",
  "widget"
 ],
 "form_factor": "phone",
