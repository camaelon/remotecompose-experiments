{
 "header": {
  "apiLevel": 7, "width": 360, "height": 120, "profiles": 513,
  "contentDescription": "ProgressBar: a fixed 30% bar and a thicker green bar bound to the variable download (72%)"
 },
 "resources": { "variables": { "download": { "value": 0.72, "export": true } } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }, { "spacedBy": 8 }],
   "children": [
    { "text": { "value": "Uploading 3 of 10", "fontSize": 13, "color": "@colors.muted" } },
    { "ProgressBar": { "progress": 0.3 } },
    { "box": { "modifiers": [{ "height": 8 }] } },
    { "text": { "value": "Download", "fontSize": 13, "color": "@colors.muted" } },
    { "ProgressBar": { "progress": "@download", "height": 12, "color": "@colors.success" } }
   ]
  }
 }
}
