{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 120,
  "profiles": 513,
  "contentDescription": "ProgressBar: a fixed 30% bar and a thicker green bar bound to the variable download (72%)"
 },
 "resources": {
  "variables": {
   "download": {
    "value": 0.72,
    "export": true
   }
  },
  "colors": {
   "background": {
    "light": "#FFF5F7FA",
    "dark": "#FF101828"
   },
   "muted": {
    "light": "#FF5A6475",
    "dark": "#FF8A94A6"
   },
   "primary": {
    "light": "#FF1565D8",
    "dark": "#FF4DA3FF"
   },
   "success": {
    "light": "#FF2E7D32",
    "dark": "#FF66BB6A"
   },
   "track": {
    "light": "#FFB0B8C4",
    "dark": "#FF2A3342"
   }
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    },
    {
     "spacedBy": 8
    }
   ],
   "children": [
    {
     "text": {
      "value": "Uploading 3 of 10",
      "fontSize": 13,
      "color": "@colors.muted"
     }
    },
    {
     "canvas": {
      "modifiers": [
       "fillMaxWidth",
       {
        "height": 8
       }
      ],
      "commands": [
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.track"
          },
          {
           "style": "fill"
          }
         ]
        }
       },
       {
        "drawRoundRect": {
         "left": 0,
         "top": 0,
         "right": "componentWidth()",
         "bottom": 8,
         "rx": 4,
         "ry": 4
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.primary"
          }
         ]
        }
       },
       {
        "drawRoundRect": {
         "left": 0,
         "top": 0,
         "right": "max(8, componentWidth() * clamp(0, 1, 0.3))",
         "bottom": 8,
         "rx": 4,
         "ry": 4
        }
       }
      ]
     }
    },
    {
     "box": {
      "modifiers": [
       {
        "height": 8
       }
      ]
     }
    },
    {
     "text": {
      "value": "Download",
      "fontSize": 13,
      "color": "@colors.muted"
     }
    },
    {
     "canvas": {
      "modifiers": [
       "fillMaxWidth",
       {
        "height": 12
       }
      ],
      "commands": [
       {
        "variable": {
         "name": "progressbar2_pa",
         "value": {
          "value": "@download",
          "anim": 0.3
         }
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.track"
          },
          {
           "style": "fill"
          }
         ]
        }
       },
       {
        "drawRoundRect": {
         "left": 0,
         "top": 0,
         "right": "componentWidth()",
         "bottom": 12,
         "rx": 6,
         "ry": 6
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.success"
          }
         ]
        }
       },
       {
        "drawRoundRect": {
         "left": 0,
         "top": 0,
         "right": "max(12, componentWidth() * clamp(0, 1, @progressbar2_pa))",
         "bottom": 12,
         "rx": 6,
         "ry": 6
        }
       }
      ]
     }
    }
   ]
  }
 }
}
