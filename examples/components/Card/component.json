{
 "component": "Card",
 "version": 2,
 "summary": "A rounded surface with a title, an optional subtitle, a content slot and an actions row.",
 "params": {
  "title": {
   "type": "string",
   "required": true,
   "doc": "Header text, 17 sp, onSurface"
  },
  "subtitle": {
   "type": "string",
   "doc": "Optional second line, muted"
  },
  "color": {
   "type": "color",
   "default": "@colors.surface",
   "doc": "Surface colour"
  }
 },
 "slots": {
  "content": {
   "optional": true,
   "doc": "Body content; `children` of the call fill it too"
  },
  "actions": {
   "optional": true,
   "doc": "Buttons at the bottom, in a row"
  }
 },
 "capabilities": [
  "layout.stack",
  "layout.decoration"
 ],
 "call": {
  "Card": {
   "title": "Storage",
   "subtitle": "64 GB of 128 GB used",
   "children": [
    {
     "ProgressBar": {
      "progress": 0.5
     }
    }
   ]
  }
 },
 "body": {
  "column": {
   "modifiers": [
    "fillMaxWidth",
    {
     "clip": {
      "roundedRect": "@theme.radius_lg"
     }
    },
    {
     "$if": "theme.mono",
     "then": {
      "background": "@colors.outline"
     }
    },
    {
     "$if": "theme.mono",
     "then": {
      "padding": 1
     }
    },
    {
     "$if": "theme.mono",
     "then": {
      "clip": {
       "roundedRect": "@theme.radius_lg - 1"
      }
     }
    },
    {
     "background": "@color"
    },
    {
     "padding": {
      "$if": "theme.mono",
      "then": "@theme.space_4 - 1",
      "else": "@theme.space_4"
     }
    },
    {
     "spacedBy": "@theme.space_2"
    }
   ],
   "children": [
    {
     "text": {
      "value": "@title",
      "fontSize": 17,
      "color": "@colors.onSurface"
     }
    },
    {
     "$if": "subtitle",
     "then": {
      "text": {
       "value": "@subtitle",
       "fontSize": "@theme.text_sm",
       "color": "@colors.muted"
      }
     }
    },
    {
     "$slot": "content"
    },
    {
     "$if": "actions",
     "then": {
      "row": {
       "modifiers": [
        {
         "spacedBy": "@theme.space_2"
        },
        {
         "padding": {
          "top": "@theme.space_2"
         }
        }
       ],
       "children": [
        {
         "$slot": "actions"
        }
       ]
      }
     }
    }
   ]
  }
 },
 "pitfalls": [
  "The card fills its width and pads its content by 16 dp with 8 dp spacedBy: components inside that pad themselves (ListItem) should pass padding 0, and an outlined Button inside should pass surface: \"@colors.surface\"",
  "The content slot is a column: a row of things side by side needs its own row (with weighted boxes, not spacedBy, if anything in it is weighted)"
 ]
}
