{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 208,
  "profiles": 513,
  "contentDescription": "Card component: a storage card with a title, subtitle, body text and two action buttons"
 },
 "resources": {
  "variables": {
   "action": 0
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    },
    {
     "spacedBy": 12
    }
   ],
   "children": [
    {
     "text": {
      "value": "Card",
      "fontSize": 20,
      "color": "@colors.onSurface"
     }
    },
    {
     "Card": {
      "title": "Storage",
      "subtitle": "64 GB of 128 GB used",
      "slots": {
       "content": [
        {
         "text": {
          "value": "Photos and videos take the most space.",
          "fontSize": 14,
          "color": "@colors.onSurface"
         }
        }
       ],
       "actions": [
        {
         "Button": {
          "label": "Manage",
          "onClick": {
           "type": "valueFloatChange",
           "target": "@action",
           "value": 1
          }
         }
        },
        {
         "Button": {
          "label": "Later",
          "style": "text",
          "onClick": {
           "type": "valueFloatChange",
           "target": "@action",
           "value": 2
          }
         }
        }
       ]
      }
     }
    }
   ]
  }
 }
}
