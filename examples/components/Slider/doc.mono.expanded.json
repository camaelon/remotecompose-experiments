{
 "header": {
  "apiLevel": 7,
  "width": 300,
  "height": 140,
  "profiles": 513,
  "contentDescription": "Slider component: a volume slider bound to a variable showing its value, and a brightness slider with its own state"
 },
 "resources": {
  "variables": {
   "volume": 40,
   "slider1_x0": 0,
   "slider2_value": 0.7,
   "slider2_x0": 0
  },
  "colors": {
   "background": "#FF000000",
   "onSurface": "#FFFFFFFF",
   "primary": "#FFFFFFFF",
   "track": "#FF9E9E9E",
   "warning": "#FFFFFFFF"
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    },
    {
     "spacedBy": 4
    }
   ],
   "children": [
    {
     "text": {
      "value": "Slider",
      "fontSize": 20,
      "color": "@colors.onSurface"
     }
    },
    {
     "canvas": {
      "modifiers": [
       "fillMaxWidth",
       {
        "height": 40
       },
       {
        "semantics": {
         "contentDescription": "Volume"
        }
       }
      ],
      "commands": [
       {
        "componentValue": {
         "id": "@slider1_x0",
         "valueType": 4
        }
       },
       {
        "touchExpression": {
         "name": "volume",
         "defaultValue": "@volume",
         "min": 0,
         "max": 100,
         "expression": [
          "(touchX() - @slider1_x0 - 12) / (componentWidth() - 72) * 100"
         ],
         "touchMode": 6
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.track"
          },
          {
           "style": "stroke"
          },
          {
           "strokeWidth": 1.5
          },
          {
           "strokeCap": "round"
          }
         ]
        }
       },
       {
        "drawLine": {
         "x1": 12,
         "y1": 20,
         "x2": "componentWidth() - 60",
         "y2": 20
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.primary"
          },
          {
           "strokeWidth": 3
          }
         ]
        }
       },
       {
        "drawLine": {
         "x1": 12,
         "y1": 20,
         "x2": "12 + (componentWidth() - 72) * @volume / 100",
         "y2": 20
        }
       },
       {
        "paint": {
         "ops": [
          {
           "style": "fill"
          }
         ]
        }
       },
       {
        "drawCircle": {
         "cx": "12 + (componentWidth() - 72) * @volume / 100",
         "cy": 20,
         "radius": 7
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.onSurface"
          },
          {
           "style": "fill"
          },
          {
           "textSize": 15
          }
         ]
        }
       },
       {
        "drawTextAnchored": {
         "text": {
          "type": "textFromFloat",
          "value": "@volume",
          "whole": 4,
          "decimal": 0,
          "flags": 5
         },
         "x": "componentWidth()",
         "y": 20,
         "panX": 1,
         "panY": 0
        }
       }
      ]
     }
    },
    {
     "canvas": {
      "modifiers": [
       "fillMaxWidth",
       {
        "height": 40
       },
       {
        "semantics": {
         "contentDescription": "Brightness"
        }
       }
      ],
      "commands": [
       {
        "componentValue": {
         "id": "@slider2_x0",
         "valueType": 4
        }
       },
       {
        "touchExpression": {
         "name": "slider2_value",
         "defaultValue": "@slider2_value",
         "min": 0,
         "max": 1,
         "expression": [
          "(touchX() - @slider2_x0 - 12) / (componentWidth() - 24) * 1"
         ],
         "touchMode": 6
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.track"
          },
          {
           "style": "stroke"
          },
          {
           "strokeWidth": 1.5
          },
          {
           "strokeCap": "round"
          }
         ]
        }
       },
       {
        "drawLine": {
         "x1": 12,
         "y1": 20,
         "x2": "componentWidth() - 12",
         "y2": 20
        }
       },
       {
        "paint": {
         "ops": [
          {
           "color": "@colors.warning"
          },
          {
           "strokeWidth": 3
          }
         ]
        }
       },
       {
        "drawLine": {
         "x1": 12,
         "y1": 20,
         "x2": "12 + (componentWidth() - 24) * @slider2_value / 1",
         "y2": 20
        }
       },
       {
        "paint": {
         "ops": [
          {
           "style": "fill"
          }
         ]
        }
       },
       {
        "drawCircle": {
         "cx": "12 + (componentWidth() - 24) * @slider2_value / 1",
         "cy": 20,
         "radius": 7
        }
       }
      ]
     }
    }
   ]
  }
 }
}
