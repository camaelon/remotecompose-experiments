{
 "header": {
  "apiLevel": 7,
  "width": 300,
  "height": 140,
  "profiles": 513,
  "contentDescription": "Slider component: a volume slider bound to a variable showing its value, and a brightness slider with its own state"
 },
 "resources": {
  "variables": {
   "volume": 40
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    },
    {
     "spacedBy": 4
    }
   ],
   "children": [
    {
     "text": {
      "value": "Slider",
      "fontSize": 20,
      "color": "@colors.onSurface"
     }
    },
    {
     "Slider": {
      "label": "Volume",
      "value": "@volume",
      "max": 100,
      "showValue": true
     }
    },
    {
     "Slider": {
      "label": "Brightness",
      "value": 0.7,
      "color": "@colors.warning"
     }
    }
   ]
  }
 }
}
