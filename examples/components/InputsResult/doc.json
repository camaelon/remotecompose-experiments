{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 300,
  "profiles": 513,
  "contentDescription": "InputsResult component: a result card that stays visible over a scrolling choice"
 },
 "resources": {
  "variables": {
   "size": 1,
   "cups": 1
  }
 },
 "root": {
  "InputsResult": {
   "resultHeight": 60,
   "slots": {
    "result": [
     {
      "Card": {
       "children": [
        {
         "TextChoice": {
          "items": [
           "Small coffee",
           "Medium coffee",
           "Large coffee"
          ],
          "index": "@size",
          "fontSize": 18
         }
        }
       ]
      }
     }
    ],
    "inputs": [
     {
      "ChoiceChips": {
       "label": "Size",
       "items": [
        "Small",
        "Medium",
        "Large"
       ],
       "selected": "@size"
      }
     },
     {
      "Stepper": {
       "label": "cups",
       "min": 1,
       "max": 9,
       "value": "@cups"
      }
     }
    ]
   }
  }
 }
}
