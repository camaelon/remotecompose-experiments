                                    "x1": 19,
                                    "y1": 9,
                                    "x2": 13,
                                    "y2": 9
                                   }
                                  }
                                 ]
                                }
                               }
                              ]
                             }
                            }
                           ]
                          }
                         }
                        ]
                       }
                      }
                     ]
                    }
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       },
       {
        "variable": {
         "name": "eased",
         "value": "@stepexplainer1_pos + 0"
        }
       },
       {
        "variable": {
         "name": "stepexplainer1_shown",
         "value": "@stepexplainer1_cur + 0"
        }
       },
       {
        "box": {
         "horizontalAlignment": "center",
         "verticalAlignment": "center",
         "modifiers": [
          {
           "width": "@stepexplainer1_vw"
          },
          {
           "height": "@stepexplainer1_vh"
          },
          {
           "semantics": {
            "contentDescription": "A ring that fills with each step"
           }
          }
         ],
         "children": [
          {
           "canvas": {
            "modifiers": [
             "fillMaxSize"
            ],
            "commands": [
             {
              "variable": {
               "name": "r",
               "value": "min(componentWidth(), componentHeight()) / 2 - 4"
              }
             },
             {
              "paint": {
               "ops": [
                {
                 "color": "@colors.track"
                },
                {
                 "style": "stroke"
                },
                {
                 "strokeWidth": 6
                }
               ]
              }
             },
             {
              "drawCircle": {
               "cx": "componentWidth() / 2",
               "cy": "componentHeight() / 2",
               "radius": "@r - 3"
              }
             },
             {
              "paint": {
               "ops": [
                {
                 "color": "@colors.primary"
                },
                {
                 "strokeCap": "round"
                }
               ]
              }
             },
             {
              "drawArc": {
               "left": "componentWidth() / 2 - @r + 3",
               "top": "componentHeight() / 2 - @r + 3",
               "right": "componentWidth() / 2 + @r - 3",
               "bottom": "componentHeight() / 2 + @r - 3",
               "startAngle": -90,
               "sweepAngle": "120 * (@eased + 1)"
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 }
}
