   "stepexplainer1_pad": "ifElse(ifElse(8, 12, step(@stepexplainer1_m, 199)), ifElse(16, 28, @stepexplainer1_big), step(@stepexplainer1_m, 279))",
   "stepexplainer1_hasHd": "step((windowHeight()), 169)",
   "stepexplainer1_hd": "@stepexplainer1_hasHd * ifElse(ifElse(26, 34, step((windowHeight()), 299)), 44, @stepexplainer1_big)",
   "stepexplainer1_hdFs": "ifElse(ifElse(15, 20, step((windowHeight()), 299)), 28, @stepexplainer1_big)",
   "stepexplainer1_iw": "(windowWidth()) - 2 * @stepexplainer1_pad",
   "stepexplainer1_ih": "(windowHeight()) - 2 * @stepexplainer1_pad - @stepexplainer1_hd",
   "stepexplainer1_side": "step((windowWidth()), (windowHeight()) * 1.2) * step((windowWidth()), 279)",
   "stepexplainer1_capFs": "ifElse(15, 19, @stepexplainer1_big)",
   "stepexplainer1_titleFs": "ifElse(16, 21, @stepexplainer1_big)",
   "stepexplainer1_titleH": "ifElse(24, 32, @stepexplainer1_big)",
   "stepexplainer1_lineH": "ifElse(20, 26, @stepexplainer1_big)",
   "stepexplainer1_fullH": "3 * @stepexplainer1_lineH + 0 + 4",
   "stepexplainer1_vw": "ifElse(@stepexplainer1_iw, floor(min(@stepexplainer1_ih, @stepexplainer1_iw * 0.48)), @stepexplainer1_side)",
   "stepexplainer1_free": "@stepexplainer1_ih - 48 - 18 - @stepexplainer1_titleH",
   "stepexplainer1_long": "ifElse(step(@stepexplainer1_free - @stepexplainer1_fullH, 89.5), step(@stepexplainer1_free, @stepexplainer1_fullH - 0.5), @stepexplainer1_side)",
   "stepexplainer1_short": "(1 - @stepexplainer1_long) * ifElse(step(@stepexplainer1_free - 38, 49.5), step(@stepexplainer1_free, 38 - 0.5), @stepexplainer1_side)",
   "stepexplainer1_capH": "ifElse(ifElse(@stepexplainer1_short * 38, @stepexplainer1_fullH, @stepexplainer1_long), max(0, @stepexplainer1_free), @stepexplainer1_side)",
   "stepexplainer1_capOn": "max(@stepexplainer1_long, @stepexplainer1_short)",
   "stepexplainer1_vh": "ifElse(@stepexplainer1_free - @stepexplainer1_capH - 6, @stepexplainer1_ih, @stepexplainer1_side)",
   "stepexplainer1_tw": "ifElse(@stepexplainer1_iw, @stepexplainer1_iw - @stepexplainer1_vw - 14, @stepexplainer1_side)",
   "stepexplainer1_tx": "@stepexplainer1_side * (@stepexplainer1_vw + 14)",
   "stepexplainer1_ty": "(1 - @stepexplainer1_side) * (@stepexplainer1_vh + 6)",
   "iconbutton1_enOn": "min(1, @stepexplainer1_cur)",
   "iconbutton1_enOff": "1 - @iconbutton1_enOn",
   "vis_1": 1
