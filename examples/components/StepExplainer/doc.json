{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 640,
  "profiles": 513,
  "contentDescription": "StepExplainer: making tea in three steps, with a ring that fills with the step"
 },
 "resources": {
  "variables": {
   "at": {
    "value": 0,
    "export": true
   }
  }
 },
 "root": {
  "StepExplainer": {
   "title": "Making tea",
   "step": "@at",
   "eased": "@eased",
   "visualLabel": "A ring that fills with each step",
   "steps": [
    {
     "title": "Boil",
     "text": "Bring fresh water to the boil, then let it rest for a moment.",
     "short": "Boil fresh water."
    },
    {
     "title": "Steep",
     "text": "Pour it over the leaves and leave them for three minutes.",
     "short": "Steep for three minutes."
    },
    {
     "title": "Pour",
     "text": "Take the leaves out and pour. Milk is your own affair.",
     "short": "Remove the leaves and pour."
    }
   ],
   "slots": {
    "visual": [
     {
      "canvas": {
       "modifiers": [
        "fillMaxSize"
       ],
       "commands": [
        {
         "variable": {
          "name": "r",
          "value": "min(componentWidth(), componentHeight()) / 2 - 4"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.track"
           },
           {
            "style": "stroke"
           },
           {
            "strokeWidth": 6
           }
          ]
         }
        },
        {
         "drawCircle": {
          "cx": "componentWidth() / 2",
          "cy": "componentHeight() / 2",
          "radius": "@r - 3"
         }
        },
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.primary"
           },
           {
            "strokeCap": "round"
           }
          ]
         }
        },
        {
         "drawArc": {
          "left": "componentWidth() / 2 - @r + 3",
          "top": "componentHeight() / 2 - @r + 3",
          "right": "componentWidth() / 2 + @r - 3",
          "bottom": "componentHeight() / 2 + @r - 3",
          "startAngle": -90,
          "sweepAngle": "120 * (@eased + 1)"
         }
        }
       ]
      }
     }
    ]
   }
  }
 }
}