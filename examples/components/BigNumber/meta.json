{
 "id": "BigNumber",
 "name": "big-number",
 "version": 1,
 "title": "BigNumber",
 "prompt": "Show this month's revenue as a big dollar amount with its change in percent, and under it costs in euros (lower is better) and active users abbreviated to millions, each with an up or down arrow.",
 "level": 2,
 "use_cases": [
  "dashboard",
  "finance",
  "widget"
 ],
 "form_factor": "widget-4x2",
