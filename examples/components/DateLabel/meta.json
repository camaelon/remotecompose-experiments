 "version": 1,
 "title": "Date label",
 "prompt": "Show today's date as text in several formats: a long one with the weekday and month names, a short one, and ISO and numeric day/month/year forms.",
 "level": 1,
 "use_cases": [
  "widget",
  "watch-face"
 ],
