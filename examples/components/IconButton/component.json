{
 "component": "IconButton",
 "version": 4,
 "summary": "A round button holding only an icon (40 dp, or `size`): standard (icon alone), filled or outlined, in a touch target of at least 48 dp. Labelled for accessibility from its label; enabled (true/false, or a 0/1 variable or expression read at run time) dims it and drops the click.",
 "params": {
  "label": {
   "type": "string",
   "required": true,
   "doc": "Accessibility label (the button shows no text): say what it does, \"Add to favourites\""
  },
  "style": {
   "type": "enum",
   "values": [
    "standard",
    "filled",
    "outlined"
   ],
   "default": "standard",
   "static": true,
   "doc": "standard: the icon alone (toolbars); filled: a solid circle (the main action); outlined: a 1.5 dp ring"
  },
  "size": {
   "type": "float",
   "default": 40,
   "static": true,
   "doc": "Diameter of the round face in dp (32 to 56 is usual); the icon is scaled by size / 40, so draw it at 24 dp as for the default. Below 48 the face gets transparent padding up to a 48 dp touch target"
  },
  "color": {
   "type": "color",
   "default": "@colors.primary",
   "doc": "Fill (filled) or ring (outlined); draw the icon itself in onPrimary on a filled button"
  },
  "surface": {
   "type": "color",
   "default": "@colors.background",
   "doc": "outlined: the colour the button sits on, which fills the inside of the ring (@colors.surface in a Card)"
  },
  "enabled": {
   "type": "bool",
   "default": true,
   "static": true,
   "doc": "true/false: fixed when expanded (false: the icon is dimmed, the click dropped, announced as disabled). Or a runtime value, \"@canSend\" or an expression, exactly 0 or 1: the button follows it while it plays"
  },
  "onClick": {
   "type": "action",
   "doc": "Any click action (valueFloatChange, valueFloatExpressionChange, hostNamedAction, ...). Omitted: not clickable"
  }
 },
 "slots": {
  "icon": {
   "doc": "The icon, about 24 dp square (a canvas or an image), drawn by the caller in its colour: onSurface or the button colour for standard and outlined, onPrimary for filled"
  }
 },
 "capabilities": [
  "input.tap",
  "a11y.labels",
  "layout.decoration"
 ],
 "call": {
  "IconButton": {
   "label": "Close",
   "onClick": {
    "type": "valueFloatChange",
    "target": "@open",
    "value": 0
   },
   "slots": {
    "icon": [
     {
      "canvas": {
       "modifiers": [
        {
         "size": [
          24,
          24
         ]
        }
       ],
       "commands": [
        {
         "paint": {
          "ops": [
           {
            "color": "@colors.onSurface"
           },
           {
            "style": "stroke"
           },
           {
            "strokeWidth": 2
           },
           {
            "strokeCap": "round"
           }
          ]
         }
        },
        {
         "drawLine": {
          "x1": 7,
          "y1": 7,
          "x2": 17,
          "y2": 17
         }
        },
        {
         "drawLine": {
          "x1": 17,
          "y1": 7,
          "x2": 7,
          "y2": 17
         }
        }
       ]
      }
     }
    ]
   }
  }
 },
