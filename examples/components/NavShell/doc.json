{
 "header": {
  "apiLevel": 7, "width": 360, "height": 640, "profiles": 513,
  "contentDescription": "A music app with three destinations, Home, Search and Library: a bottom bar on a phone, a rail when wider, a drawer titled Tune when wide; Home shows recently played albums"
 },
 "resources": { "variables": { "tab": 0 } },
 "root": {
  "NavShell": {
   "title": "Tune",
   "selected": "@tab",
   "destinations": [
    { "icon": "home", "label": "Home", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 4 }], "children": [
     { "text": { "value": "Recently played", "fontSize": 13, "color": "@colors.muted" } },
     { "ListItem": { "title": "Blue Train", "subtitle": "John Coltrane", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "album", "color": "@colors.primary" } }] } } },
     { "ListItem": { "title": "Kind of Blue", "subtitle": "Miles Davis", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "album", "color": "@colors.primary" } }] } } },
     { "ListItem": { "title": "Morning Focus", "subtitle": "Playlist, 42 songs", "padding": 0, "slots": { "leading": [{ "Icon": { "name": "queue_music", "color": "@colors.primary" } }] } } }
    ] } } },
    { "icon": "search", "label": "Search", "page": { "column": { "modifiers": ["fillMaxWidth", { "spacedBy": 12 }], "children": [
     { "row": { "verticalAlignment": "center", "modifiers": ["fillMaxWidth", { "height": 48 }, { "clip": 24 }, { "background": "@colors.surfaceHigh" }, { "padding": [16, 0] }, { "spacedBy": 12 }], "children": [
      { "Icon": { "name": "search", "color": "@colors.muted" } },
      { "text": { "value": "Artists, songs or albums", "fontSize": 15, "color": "@colors.muted" } }
     ] } },
     { "text": { "value": "Browse", "fontSize": 13, "color": "@colors.muted" } },
     { "flow": { "modifiers": ["fillMaxWidth", { "spacedBy": 8 }], "children": [
      { "Chip": { "label": "Jazz" } }, { "Chip": { "label": "Classical" } }, { "Chip": { "label": "Focus" } }, { "Chip": { "label": "Podcasts" } }
     ] } }
    ] } } },
    { "icon": "library_music", "label": "Library", "page": { "column": { "modifiers": ["fillMaxWidth"], "children": [
     { "ListItem": { "title": "Liked songs", "subtitle": "128 songs", "chevron": true, "padding": 0, "slots": { "leading": [{ "Icon": { "name": "favorite", "color": "@colors.primary" } }] } } },
     { "ListItem": { "title": "Playlists", "subtitle": "6 playlists", "chevron": true, "padding": 0, "slots": { "leading": [{ "Icon": { "name": "queue_music", "color": "@colors.primary" } }] } } },
     { "ListItem": { "title": "Downloaded", "subtitle": "3.2 GB on this device", "chevron": true, "padding": 0, "slots": { "leading": [{ "Icon": { "name": "download", "color": "@colors.primary" } }] } } }
    ] } } }
   ]
  }
 }
}
