   "rowlist1_h0": "(windowHeight() * 0.5 - 8) - 2 * 0",
   "rowlist1_iw": "(windowWidth() - 24) - 2 * 0",
   "rowlist1_cols": "max(1, min(clamp(1, 3, floor((@rowlist1_iw + 16) / 220)), 3))",
   "rowlist1_fn": "floor((@rowlist1_h0 - 16 * step(3, floor(@rowlist1_h0 / 18) * @rowlist1_cols + 0.5)) / 18) * @rowlist1_cols",
   "rowlist1_headOn": "max(step((windowHeight() * 0.5 - 8), 199.5), step(floor((@rowlist1_h0 - @rowlist1_hh) / 18) * @rowlist1_cols + 0.5, min(3, @rowlist1_fn)))",
   "rowlist1_body": "@rowlist1_h0 - @rowlist1_headOn * @rowlist1_hh",
   "rowlist1_moreOn": "(1 - @rowlist1_headOn) * step(3, max(1, floor(@rowlist1_body / 18)) * @rowlist1_cols + 0.5)",
   "rowlist1_lines": "@rowlist1_body - @rowlist1_moreOn * 16",
   "rowlist1_shown": "min(3, max(1, floor(@rowlist1_lines / 18)) * @rowlist1_cols)",
   "rowlist1_rowH": "clamp(18, 72 + 0, (@rowlist1_lines - step(@rowlist1_open, 0.5) * 40) / max(1, ceil(@rowlist1_shown / @rowlist1_cols)))",
   "rowlist1_half": "floor(@rowlist1_iw / @rowlist1_cols / 2)",
   "rowlist1_cellW": "@rowlist1_half * 2",
   "rowlist1_em": "floor(clamp(11, min(15, @rowlist1_cellW / 13.4), @rowlist1_rowH / 1.85)) + 5",
   "rowlist1_ts": "@rowlist1_em - 5",
   "rowlist2_open": 0,
   "rowlist2_h0": "(windowHeight() * 0.5 - 8) - 2 * 0",
   "rowlist2_iw": "(windowWidth() - 24) - 2 * 0",
   "rowlist2_cols": "max(1, min(clamp(1, 3, floor((@rowlist2_iw + 8) / 220)), 2))",
   "rowlist2_body": "@rowlist2_h0 - 1 * 32",
   "rowlist2_lines": "@rowlist2_body - 0 * 16",
   "rowlist2_rowH": "clamp(54, 72 + 6, (@rowlist2_lines - step(@rowlist2_open, 0.5) * 40) / max(1, ceil(2 / @rowlist2_cols)))",
   "rowlist2_ih": "@rowlist2_rowH - 6",
   "rowlist2_half": "floor(@rowlist2_iw / @rowlist2_cols / 2)",
   "rowlist2_cellW": "@rowlist2_half * 2",
   "rowlist2_over": "step(2, floor(@rowlist2_lines / 54) * @rowlist2_cols + 0.5)",
   "slider1_x0": 0,
