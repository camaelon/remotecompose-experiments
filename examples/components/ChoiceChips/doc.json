{
 "header": {"apiLevel": 7, "width": 360, "height": 250, "profiles": 513,
  "contentDescription": "ChoiceChips component: a wrapping single choice and a segmented one, with the choice shown as text"},
 "resources": {"variables": {"tip": 1, "unit": 0}},
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", {"background": "@colors.background"}, {"padding": 16}, {"spacedBy": 12}],
   "children": [
    {"ChoiceChips": {"label": "Tip", "items": ["10%", "15%", "20%", "25%", "No tip"], "selected": "@tip"}},
    {"ChoiceChips": {"label": "Units", "items": ["Metric", "Imperial"], "selected": "@unit", "style": "segmented"}},
    {"TextChoice": {"items": ["Tip 10%, metric", "Tip 15%, metric", "Tip 20%, metric", "Tip 25%, metric", "No tip, metric", "Tip 10%, imperial", "Tip 15%, imperial", "Tip 20%, imperial", "Tip 25%, imperial", "No tip, imperial"], "index": "@tip + 5 * @unit"}}
   ]
  }
 }
}
