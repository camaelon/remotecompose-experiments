{
 "header": {
  "apiLevel": 7,
  "width": 300,
  "height": 196,
  "profiles": 513,
  "contentDescription": "TextChoice component: the moon phase name from a phase variable, today's weekday from the clock, and a Rising or Falling tide pill from a 0/1 variable"
 },
 "resources": {
  "variables": {
   "phase": {
    "value": 0.6,
    "export": true
   },
   "falling": {
    "value": 0,
    "export": true
   },
   "textchoice1_k": "clamp(0, 7, round((round(@phase * 8) % 8)))",
   "textchoice2_k": "clamp(0, 6, round((weekDay() - 1)))",
   "textchoice3_k": "clamp(0, 1, round(@falling))"
  },
  "colors": {
   "background": {
    "light": "#FFF5F7FA",
    "dark": "#FF101828"
   },
   "muted": {
    "light": "#FF5A6475",
    "dark": "#FF8A94A6"
   },
   "onPrimary": "#FFFFFFFF",
   "onSurface": {
    "light": "#FF111827",
    "dark": "#FFE6EAF2"
   },
   "primary": {
    "light": "#FF1565D8",
    "dark": "#FF4DA3FF"
   }
  }
 },
