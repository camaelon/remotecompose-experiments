   "phase": {
    "type": "float",
    "meaning": "lunation fraction 0..1 (0 new, 0.5 full)",
    "default": 0.6,
    "min": 0,
    "max": 1,
    "step": 0.01
   },
   "falling": {
    "type": "float",
    "meaning": "tide direction: 0 rising, 1 falling",
    "default": 0,
    "min": 0,
    "max": 1,
    "step": 1
   }
  },
  "clock": "2026-10-29T10:00:00",
  "touch": false
 },
 "check": {
  "describe": "On Thursday 29 October 2026 with phase 0.6 and falling 0: \"Moon: Waning gibbous tonight\", \"Today is Thursday here\" (blue) and \"Tide [Rising] at 14:05\" with the pill sized to Rising. The switched render (phase 0.97, falling 1, Sunday 1 November 2026) reads \"New moon\" (round(7.76) % 8 wraps to 0), \"Sunday\" and a wider \"Falling\" pill; the full render (phase 0.5, Monday 2 November) reads \"Full moon\" and \"Monday\". In every row the next text follows the shown word directly, so the hidden items take no space. The rows size to their content: at 240 dp the moon row still fits and at 420 dp nothing moves.",
