{
 "id": "TextChoice",
 "name": "text-choice",
 "version": 1,
 "title": "Text choice",
 "prompt": "Show a word picked at run time from a fixed list: the moon phase name from a phase variable, today's weekday name from the clock, and a Rising / Falling tide pill from a 0/1 variable, each laid out like a normal text in a row.",
 "level": 1,
 "use_cases": [
  "widget",
  "watch-face"
 ],
 "form_factor": "phone",
 "capabilities": {
  "primary": [
   "layout.state"
  ],
  "secondary": [
   "time.date",
   "layout.decoration"
  ]
 },
 "keywords": [
  "text choice",
  "text from list",
  "pick text by index",
  "switch text",
  "status text",
  "label from index",
  "name of day",
  "weekday name",
  "phase name",
  "moon phase name",
  "rising falling",
  "enum label",
  "conditional text"
 ],
 "teaches": [
  "{\"TextChoice\": {\"items\": [\"Rising\", \"Falling\"], \"index\": \"@falling\"}} shows one of the items, picked by a 0-based index that may be a variable or an expression",
  "A layout text cannot take textSubtext or textLookup in Java, so the choice is one text per item, each with a visibility that is exactly 1 for its index and 0 (GONE) otherwise: only the shown item takes space",
  "The visibility is an integer expression, 1 - min(1, abs(k - i)), over k = clamp(0, n - 1, round(index)), a float expression computed once per call; the player keeps a float's truncated int, which is why k is rounded first",
  "Weekday names need weekDay() - 1 (weekDay() is 1 for Monday); a fraction of a cycle becomes an index with round(@phase * 8) % 8"
 ],
 "snippets": [
  {
   "pointer": "/root/column/children/1/row/children/1",
   "shows": "layout.state",
   "note": "eight moon phase names chosen by round(@phase * 8) % 8 (0.6 shows Waning gibbous)"
  },
  {
   "pointer": "/root/column/children/2/row/children/1",
   "shows": "time.date",
   "note": "the weekday name from weekDay() - 1"
  },
  {
   "pointer": "/root/column/children/3/row/children/1",
   "shows": "layout.decoration",
   "note": "Rising / Falling from a 0/1 variable inside a pill that sizes to the word shown"
  }
 ],
