{
 "header": {
  "apiLevel": 7, "width": 360, "height": 168, "profiles": 513,
  "contentDescription": "Sparkline component: weekly visits as a small trend line next to its label, and a temperature series filling the width"
 },
 "resources": {
  "floatArrays": {
   "visits": { "value": [42, 55, 48, 61, 58, 73, 69, 84], "export": true },
   "temp": [11.5, 13, 12.2, 15.8, 17.1, 16.4, 19.9, 18.2, 21.3, 20.1, 17.6, 14.9]
  }
 },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }],
   "children": [
    { "text": { "value": "Sparkline", "fontSize": 20, "color": "@colors.onSurface" } },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": ["fillMaxWidth", { "padding": { "top": 12 } }],
      "children": [
       { "text": { "value": "Visits, 8 weeks", "fontSize": 15, "color": "@colors.muted", "modifiers": [{ "weight": 1 }] } },
       { "Sparkline": { "values": "@visits", "label": "Visits, last 8 weeks" } }
      ]
     }
    },
    {
     "box": {
      "modifiers": [{ "verticalWeight": 1 }, "fillMaxWidth", { "padding": { "top": 12 } }],
      "children": [{ "Sparkline": { "values": "@temp", "fill": true, "color": "@colors.secondary", "label": "Temperature, last 12 hours" } }]
     }
    }
   ]
  }
 }
}
