{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 168,
  "profiles": 513,
  "contentDescription": "Sparkline component: weekly visits as a small trend line next to its label, and a temperature series filling the width"
 },
 "resources": {
  "floatArrays": {
   "visits": {
    "value": [
     42,
     55,
     48,
     61,
     58,
     73,
     69,
     84
    ],
    "export": true
   },
   "temp": [
    11.5,
    13,
    12.2,
    15.8,
    17.1,
    16.4,
    19.9,
    18.2,
    21.3,
    20.1,
    17.6,
    14.9
   ]
  },
  "colors": {
   "background": "#FFFFFFFF",
   "muted": "#FF616161",
   "onSurface": "#FF000000"
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": 16
    }
   ],
   "children": [
    {
     "text": {
      "value": "Sparkline",
      "fontSize": 20,
      "color": "@colors.onSurface"
     }
    },
    {
     "row": {
      "verticalAlignment": "center",
      "modifiers": [
       "fillMaxWidth",
       {
        "padding": {
         "top": 12
        }
       }
      ],
      "children": [
       {
        "text": {
         "value": "Visits, 8 weeks",
         "fontSize": 15,
         "color": "@colors.muted",
         "modifiers": [
          {
           "weight": 1
          }
         ]
        }
       },
       {
        "canvas": {
         "modifiers": [
          {
           "size": [
            120,
            32
           ]
          },
          {
           "semantics": {
            "contentDescription": "Visits, last 8 weeks"
           }
          }
         ],
         "commands": [
          {
           "variable": {
            "name": "sparkline1_last",
            "value": "arrayLength(@visits) - 1"
           }
          },
          {
           "variable": {
            "name": "sparkline1_lo",
            "value": "arrayMin(@visits)"
           }
          },
          {
           "variable": {
            "name": "sparkline1_span",
            "value": "max(arrayMax(@visits) - @sparkline1_lo, 0.001)"
           }
          },
          {
           "translate": {
            "dx": 4,
            "dy": "componentHeight() - 4"
           }
          },
          {
           "paint": {
            "ops": [
             {
              "color": "@colors.onSurface"
             },
             {
              "style": "stroke"
             },
             {
              "strokeWidth": 2
             },
             {
              "strokeCap": "round"
             }
            ]
           }
          },
          {
           "loop": {
            "index": "i",
            "from": 0,
            "until": "@sparkline1_last",
            "commands": [
             {
              "drawLine": {
               "x1": "i * (componentWidth() - 8) / @sparkline1_last",
               "y1": "(@sparkline1_lo - arrayGet(@visits, i)) * (componentHeight() - 8) / @sparkline1_span",
               "x2": "(i + 1) * (componentWidth() - 8) / @sparkline1_last",
               "y2": "(@sparkline1_lo - arrayGet(@visits, i + 1)) * (componentHeight() - 8) / @sparkline1_span"
              }
             }
            ]
           }
          },
          {
           "paint": {
            "ops": [
             {
              "style": "fill"
             }
            ]
           }
          },
          {
           "drawCircle": {
            "cx": "componentWidth() - 8",
            "cy": "(@sparkline1_lo - arrayGet(@visits, @sparkline1_last)) * (componentHeight() - 8) / @sparkline1_span",
            "radius": 3
           }
          }
         ]
        }
       }
      ]
     }
    },
    {
     "box": {
      "modifiers": [
       {
        "verticalWeight": 1
       },
       "fillMaxWidth",
       {
        "padding": {
         "top": 12
        }
       }
      ],
      "children": [
       {
        "canvas": {
         "modifiers": [
          "fillMaxSize",
          {
           "semantics": {
            "contentDescription": "Temperature, last 12 hours"
           }
          }
         ],
         "commands": [
          {
           "variable": {
            "name": "sparkline2_last",
            "value": "arrayLength(@temp) - 1"
           }
          },
          {
           "variable": {
            "name": "sparkline2_lo",
            "value": "arrayMin(@temp)"
           }
          },
          {
           "variable": {
            "name": "sparkline2_span",
            "value": "max(arrayMax(@temp) - @sparkline2_lo, 0.001)"
           }
          },
          {
           "translate": {
            "dx": 4,
            "dy": "componentHeight() - 4"
           }
          },
          {
           "paint": {
            "ops": [
             {
              "color": "@colors.onSurface"
             },
             {
              "style": "stroke"
             },
             {
              "strokeWidth": 2
             },
             {
              "strokeCap": "round"
             }
            ]
           }
          },
          {
           "loop": {
            "index": "i",
            "from": 0,
            "until": "@sparkline2_last",
            "commands": [
             {
              "drawLine": {
               "x1": "i * (componentWidth() - 8) / @sparkline2_last",
               "y1": "(@sparkline2_lo - arrayGet(@temp, i)) * (componentHeight() - 8) / @sparkline2_span",
               "x2": "(i + 1) * (componentWidth() - 8) / @sparkline2_last",
               "y2": "(@sparkline2_lo - arrayGet(@temp, i + 1)) * (componentHeight() - 8) / @sparkline2_span"
              }
             }
            ]
           }
          },
          {
           "paint": {
            "ops": [
             {
              "style": "fill"
             }
            ]
           }
          },
          {
           "drawCircle": {
            "cx": "componentWidth() - 8",
            "cy": "(@sparkline2_lo - arrayGet(@temp, @sparkline2_last)) * (componentHeight() - 8) / @sparkline2_span",
            "radius": 3
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 }
}
