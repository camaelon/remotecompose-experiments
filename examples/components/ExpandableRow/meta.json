 "teaches": [
  "Call {\"ExpandableRow\": {\"title\": ..., \"slots\": {\"details\": [...]}}}: the whole row is the tap target, it opens on a tap and closes on the next, and the details take no space until it opens",
  "One open at a time: bind the same variable on every row (\"selected\": \"@open\") and number them (\"index\": 1, 2, 3). Tapping the open row sets it to 0",
  "Put a badge or an icon in slots.leading and a value in slots.trailing; the title takes the remaining width and ellipsizes, or takes two lines with titleLines 2"
 ],
 "snippets": [
  {
   "pointer": "/root/column/children/0",
   "shows": "layout.stack",
   "note": "a row with leading, trailing and details slots, bound to the group's variable"
  },
