   "pointer": "/root/column/children/2",
   "shows": "layout.weight",
   "note": "titleLines 2: a long title wraps in the weighted column and the row grows"
  },
  {
   "pointer": "/root/column/children/4",
   "shows": "input.tap",
   "note": "tapping sets open to 3, or to 0 when it is already open"
  },
  {
