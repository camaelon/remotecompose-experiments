{
 "header": {
  "apiLevel": 7,
  "width": 360,
  "height": 320,
  "profiles": 513,
  "contentDescription": "ExpandableRow: three rows that open one at a time, showing their details, and a row with its own state"
 },
 "resources": {
  "variables": {
   "open": 1
  }
 },
 "root": {
  "column": {
   "modifiers": [
    "fillMaxSize",
    {
     "background": "@colors.background"
    },
    {
     "padding": [
      0,
      8
     ]
    }
   ],
   "children": [
    {
     "ExpandableRow": {
      "title": "Storage",
      "selected": "@open",
      "index": 1,
      "subtitle": "64 GB of 128 GB used",
      "slots": {
       "leading": [
        {
         "Icon": {
          "name": "storage",
          "size": 24,
          "color": "@colors.primary"
         }
        }
       ],
       "trailing": [
        {
         "text": {
          "value": "50%",
          "fontSize": 14,
          "color": "@colors.onSurface"
         }
        }
       ],
       "details": [
        {
         "ProgressBar": {
          "progress": 0.5
         }
        }
       ]
      }
     }
    },
    {
     "Divider": {}
    },
    {
     "ExpandableRow": {
      "title": "Battery and power saving options for this device",
      "selected": "@open",
      "index": 2,
      "titleLines": 2,
      "slots": {
       "leading": [
        {
         "Icon": {
          "name": "battery_full",
          "size": 24,
          "color": "@colors.primary"
         }
        }
       ],
       "trailing": [
        {
         "text": {
          "value": "82%",
          "fontSize": 14,
          "color": "@colors.onSurface"
         }
        }
       ],
       "details": [
        {
         "text": {
          "value": "About 9 hours left",
          "fontSize": 13,
          "color": "@colors.muted"
         }
        }
       ]
      }
     }
    },
    {
     "Divider": {}
    },
    {
     "ExpandableRow": {
      "title": "Network",
      "selected": "@open",
      "index": 3,
      "subtitle": "Home Wi-Fi",
      "slots": {
       "leading": [
        {
         "Icon": {
          "name": "wifi",
          "size": 24,
          "color": "@colors.primary"
         }
        }
       ],
       "trailing": [
        {
         "Badge": {
          "text": "On",
          "color": "@colors.success"
         }
        }
       ],
       "details": [
        {
         "text": {
          "value": "Signal is strong",
          "fontSize": 13,
          "color": "@colors.muted"
         }
        }
       ]
      }
     }
    },
    {
     "Divider": {}
    },
    {
     "ExpandableRow": {
      "title": "Own state, no slots",
      "label": "A row that keeps its own state",
      "slots": {
       "details": [
        {
         "text": {
          "value": "Opened and closed on its own, apart from the group above",
          "fontSize": 13,
          "color": "@colors.muted"
         }
        }
       ]
      }
     }
    }
   ]
  }
 }
}