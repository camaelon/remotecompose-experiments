{
 "header": {
  "apiLevel": 7, "width": 360, "height": 400, "profiles": 513,
  "contentDescription": "Steps component: a four-step delivery tracker bound to the variable stage, a compact four-step checkout at its second step, and a vertical three-step order history"
 },
 "resources": { "variables": { "stage": { "value": 2, "export": true } } },
 "root": {
  "column": {
   "modifiers": ["fillMaxSize", { "background": "@colors.background" }, { "padding": 16 }, { "spacedBy": 10 }],
   "children": [
    { "text": { "value": "Steps", "fontSize": 20, "color": "@colors.onSurface" } },
    { "text": { "value": "Order #4821", "fontSize": 13, "color": "@colors.muted" } },
    { "Steps": { "steps": ["Ordered", "Shipped", "Out for delivery", "Delivered"], "current": "@stage" } },
    { "text": { "value": "Checkout", "fontSize": 13, "color": "@colors.muted", "modifiers": [{ "padding": { "top": 6 } }] } },
    { "Steps": { "steps": ["Cart", "Address", "Payment", "Review"], "current": 1, "size": 18, "label": "Checkout, step 2 of 4: Address" } },
    { "text": { "value": "History", "fontSize": 13, "color": "@colors.muted", "modifiers": [{ "padding": { "top": 6 } }] } },
    { "Steps": { "steps": ["Ordered", "Packed", "Shipped"], "current": 2, "orientation": "vertical", "size": 20 } }
   ]
  }
 }
}
