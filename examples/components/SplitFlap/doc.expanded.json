               "value": "clamp((animationTime() % 6 - (0.25 + r * 0.16 + i * 0.035 + fract(sin(r * 12.9 + i * 78.2) * 437.5) * 0.25)) * 22, @sf4n, 0)"
              }
             },
             {
              "variable": {
               "name": "sf4cur",
               "value": "(@sf4o + floor(@sf4f)) % 40"
              }
             },
             {
              "variable": {
               "name": "sf4nx",
               "value": "(@sf4cur + 1 - step(@sf4f, @sf4n)) % 40"
              }
             },
