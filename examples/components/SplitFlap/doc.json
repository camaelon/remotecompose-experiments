      "label": "Destinations",
      "code": "arrayGet(@cities, ((@cyc + r) % 8) * 8 + i)",
      "prev": "arrayGet(@cities, ((@cyc + r + 7) % 8) * 8 + i) * step(@cyc, 0.5)",
