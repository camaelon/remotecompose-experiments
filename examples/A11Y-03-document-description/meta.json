{
 "id": "A11Y-03",
 "name": "document-description",
 "version": 3,
 "title": "Chart with a document description",
 "summary": "A weekly steps bar chart (the library BarChart) whose header contentDescription summarises it for screen readers, since the bars themselves carry no numbers a screen reader could read.",
 "prompt": "Draw a weekly steps bar chart and give it a spoken summary for screen readers.",
 "level": 1,
 "family": "A11Y",
 "capabilities": {
  "primary": [
   "a11y.document"
  ],
  "secondary": [
   "doc.header",
   "draw.shapes",
   "text.anchor"
  ]
 },
 "use_cases": [
  "chart",
  "fitness"
 ],
 "form_factor": "widget-4x2",
 "keywords": [
  "accessibility",
  "a11y",
  "screen reader",
  "alt text",
  "chart description",
  "summary",
  "bar chart",
  "content description",
  "talkback"
 ],
 "components": [
  "BarChart"
 ],
 "teaches": [
  "Summarise a drawn-only document for screen readers with header.contentDescription",
  "Describe what the chart says (start, peak, end, with numbers), not what it looks like",
  "BarChart gives its canvas a short label (\"Steps per day this week\"); the numbers a listener needs go in the document summary"
 ],
 "snippets": [
  {
   "pointer": "/header/contentDescription",
   "shows": "a11y.document",
   "note": "the whole document's spoken summary"
  },
  {
   "pointer": "/root/column/children/1/box/children/0",
   "shows": "draw.shapes",
   "note": "BarChart over the steps array, filling the space under the title"
  }
 ],
 "inputs": {
  "variables": {},
  "clock": null,
  "touch": false
 },
 "check": {
  "describe": "Seven bars (3k, 5k, 4k, 7k, 6k, 9k, 8k) peaking on Saturday, day letters under them; validate's header shows the contentDescription (DOC_CONTENT_DESCRIPTION tag). Resized (240×180, 540×120) BarChart fills the space under the title and the day letters follow the bars.",
  "renders": [
