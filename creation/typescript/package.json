{
  "name": "rcjson-ts",
  "version": "0.1.0",
  "description": "JSON -> RemoteCompose (.rc) compiler in TypeScript, plus a live editor",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "bundle": "esbuild src/web/main.ts --bundle --outfile=web/bundle.js --format=iife --target=es2020 --global-name=RCJSON",
    "build:page": "node build-page.mjs",
    "verify": "node --experimental-strip-types verify.mts"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
