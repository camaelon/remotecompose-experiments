{
  "name": "remotecompose-experiments",
  "version": "1.0.0",
  "description": "RemoteCompose experiments, players, and developer tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node inspector/build.mjs",
    "build:player": "cd players/typescript && npm run bundle",
    "build:inspector": "node inspector/build.mjs",
    "build:inspector:ui": "node inspector/build.mjs --no-player",
    "dev:inspector": "node inspector/build.mjs --watch",
    "test:inspector": "cd inspector && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
