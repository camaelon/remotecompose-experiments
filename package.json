{
  "name": "remotecompose-experiments",
  "version": "1.0.0",
  "description": "RemoteCompose experiments, players, and developer tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "build:player": "cd players/typescript && npm run bundle",
    "build:inspector:player": "npx esbuild players/typescript/src/web/main.ts --bundle --outfile=inspector/remote_compose_player.js --format=iife --target=es2020 --global-name=RC",
    "build:inspector": "node inspector/build.mjs",
    "build": "npm run build:inspector:player && npm run build:inspector",
    "dev:inspector": "node inspector/build.mjs --watch",
    "test:inspector": "cd inspector && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
