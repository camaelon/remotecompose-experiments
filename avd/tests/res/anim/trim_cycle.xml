<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="0.75" android:duration="800"
        android:interpolator="@interpolator/trim_end"/>
    <objectAnimator android:propertyName="trimPathStart" android:valueFrom="0" android:valueTo="0.5" android:duration="800"
        android:startOffset="300" android:interpolator="@android:interpolator/fast_out_slow_in"/>
    <objectAnimator android:propertyName="trimPathOffset" android:valueFrom="0" android:valueTo="0.6" android:duration="1100"
        android:interpolator="@android:interpolator/linear"/>
</set>
