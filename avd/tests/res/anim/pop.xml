<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android" android:duration="900">
    <propertyValuesHolder android:propertyName="scaleX">
        <keyframe android:fraction="0" android:value="1"/>
        <keyframe android:fraction="0.4" android:value="0.7" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        <keyframe android:value="1.15"/>
        <keyframe android:fraction="1" android:value="1" android:interpolator="@android:anim/decelerate_interpolator"/>
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="scaleY">
        <keyframe android:fraction="0" android:value="1"/>
        <keyframe android:fraction="0.4" android:value="0.7"/>
        <keyframe android:fraction="1" android:value="1"/>
    </propertyValuesHolder>
</objectAnimator>
