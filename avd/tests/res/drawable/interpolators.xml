<?xml version="1.0" encoding="utf-8"?>
<!-- framework and XML interpolators side by side: overshoot, anticipate-overshoot, bounce, cycle, repeat restart -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" android:drawable="@drawable/bars">
    <target android:name="a" android:animation="@anim/grow_overshoot"/>
    <target android:name="b" android:animation="@anim/grow_antov"/>
    <target android:name="c" android:animation="@anim/grow_bounce"/>
    <target android:name="d" android:animation="@anim/grow_cycle"/>
</animated-vector>
