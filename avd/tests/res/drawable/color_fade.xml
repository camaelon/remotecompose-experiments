<?xml version="1.0" encoding="utf-8"?>
<!-- colour keyframes (fill), a stroke colour from transparent, root alpha -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:name="root" android:width="32dp" android:height="32dp" android:viewportWidth="32" android:viewportHeight="32">
            <path android:name="dot" android:fillColor="#FFF44336" android:strokeWidth="3"
                android:pathData="M16,4 a12,12 0 1,1 -0.1,0 z"/>
        </vector>
    </aapt:attr>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="1200" android:valueType="colorType">
                    <propertyValuesHolder android:propertyName="fillColor">
                        <keyframe android:fraction="0" android:value="#FFF44336"/>
                        <keyframe android:fraction="0.5" android:value="#FFFFEB3B"/>
                        <keyframe android:fraction="1" android:value="#FF4CAF50"/>
                    </propertyValuesHolder>
                </objectAnimator>
                <objectAnimator android:propertyName="strokeColor" android:duration="600" android:startOffset="300"
                    android:valueFrom="#00FFFFFF" android:valueTo="#FFFFFFFF"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="root">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="alpha" android:valueFrom="0.4" android:valueTo="1" android:duration="1200"/>
        </aapt:attr>
    </target>
</animated-vector>
