<?xml version="1.0" encoding="utf-8"?>
<!-- a group moved along a curved path (propertyXName / propertyYName) -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">
            <group android:name="ball">
                <path android:fillColor="#FF9C27B0" android:pathData="M0,-5 a5,5 0 1,1 -0.1,0 z"/>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="ball">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyXName="translateX" android:propertyYName="translateY" android:duration="1000"
                android:pathData="M8,40 C8,4 40,4 40,40" android:interpolator="@android:interpolator/accelerate_decelerate"/>
        </aapt:attr>
    </target>
</animated-vector>
